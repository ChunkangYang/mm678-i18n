root = true

[*.txt]
indent_style = tab
indent_size = 4
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false

[assets/scripts_datatables/**.lua]
indent_style = tab
indent_size = 4
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false

[*.py]
indent_style = tab
indent_size = 4
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false
