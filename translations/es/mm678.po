#: mm6/data/10LocLANG.icons/Spells.txt.py:5
msgctxt "spells"
msgid ""
"Creates and fires a single flaming arrow.  Unlike most spells, this spell is"
" notoriously inaccurate and has the same chance of hitting as a regular "
"arrow (using your Fire skill as a bonus to hit).  The arrow does 1-8 points "
"of damage when it hits."
msgstr ""

#: mm6/data/10LocLANG.icons/Spells.txt.py:5
#: mm6/data/10LocLANG.icons/Spells.txt.py:17
#: mm6/data/10LocLANG.icons/Spells.txt.py:29
#: mm6/data/10LocLANG.icons/Spells.txt.py:41
msgctxt "spells"
msgid "Casting cost 2 spell points"
