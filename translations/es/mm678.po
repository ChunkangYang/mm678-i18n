msgctxt "autonote or awards"
msgid "Essence of Intellect = Remove Curse + Shield "
msgstr "Esencia de Intelecto = Eliminar maldición + Escudo "

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:679
msgctxt "autonote or awards"
msgid "Essence of Personality = Remove Fear + Haste"
msgstr "Esencia de la Personalidad = Eliminar miedo + Celeridad"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:680
msgctxt "autonote or awards"
msgid "Essence of Endurance = Remove Curse + Recharge Item"
msgstr "Esencia de Resistencia = Eliminar maldición + Recargar objeto"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:681
msgctxt "autonote or awards"
msgid "Essence of Accuracy = Cure Insanity + Stoneskin"
msgstr "Esencia de Precisión = Curar locura + Piel de piedra"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:682
msgctxt "autonote or awards"
msgid "Essence of Speed = Cure Insanity + Harden Item"
msgstr "Esencia de la Velocidad = Curar locura + Endurecer objeto"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:683
msgctxt "autonote or awards"
msgid ""
"Essence of Luck = Haste + Heroism, Recharge Item + Shield, Harden Item + "
"Stoneskin"
msgstr ""
"Esencia de la Suerte = Celeridad + Heroísmo, Recargar objeto + Escudo, "
"Endurecer objeto + Piel de piedra"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:684
msgctxt "autonote or awards"
msgid ""
"Potion of Doom = Remove Curse + Remove Fear, Remove Curse + Cure Insanity, "
"Remove Fear + Cure Insanity"
msgstr ""
"Poción de la Perdición = Eliminar maldición + Eliminar miedo, Eliminar "
"maldición + Curar locura, Eliminar miedo + Curar locura"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:685
msgctxt "autonote or awards"
msgid "Divine Boost = Divine Power + Any attribute boost potion."
msgstr ""
"Impulso divino = Poder divino + Cualquier poción de aumento de atributo."

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:686
msgctxt "autonote or awards"
msgid "Divine Protection = Divine Cure + Any resistance potion."
msgstr "Protección divina = Cura divina + Cualquier poción de resistencia."

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:687
msgctxt "autonote or awards"
msgid ""
"Divine Transcendence = Divine Restoration + Cure Insanity (or Remove Fear, "
"or Remove Curse)"
msgstr ""
"Trascendencia divina = Restauración divina + Curar locura (o Eliminar miedo,"
" o Eliminar maldición)"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:688
msgctxt "autonote or awards"
msgid ""
"Potion of the Gods = Essense of Might + Harden item or Essence of Intellect "
"+ Stoneskin or Essence of Personality + Recharge item or Essence of "
"Endurance + Haste or Essence of Accuracy + Shield or Essence of Speed + "
"Heroism."
msgstr ""
"Poción de los Dioses = Esencia de la Fuerza + Endurecer objeto o Esencia de "
"Intelecto + Piel de piedra o Esencia de la Personalidad + Recargar objeto o "
"Esencia de Resistencia + Celeridad o Esencia de Precisión + Escudo o Esencia"
" de la Velocidad + Heroísmo."

