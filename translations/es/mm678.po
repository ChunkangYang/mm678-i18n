msgctxt "items"
msgid ""
"Quest Item: This large ruby is of perfect quality, clear throughout with an "
"even pigeon blood red. It contains a powerful enchantment and pulses with a "
"slumbering heartbeat rhythm."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:625
msgctxt "items"
msgid "Charged connector stone"
msgstr "Piedra de conexión cargada"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:625
msgctxt "items"
msgid "Smooth half-transparent connector stone charged by time traveling."
msgstr ""

