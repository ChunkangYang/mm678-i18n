msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:123
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:125
msgctxt "items"
msgid ""
"This warm cloak of dyed wool also offers a small amount of protection from "
"weapon attacks."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:124
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:126
msgctxt "items"
msgid "Moon Temple Cloak"
msgstr "Capa del Templo de la Luna"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:124
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:126
msgctxt "items"
msgid ""
"The blue dye used to color the glove leather cloaks worn by Moon Temple "
"clerics is derived from the frond petal flowers which grow only in the Mount"
" Nighon region of Erathia."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:125
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:127
msgctxt "items"
msgid "Alvar Cloak"
msgstr "Capa de Alvar"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:125
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:127
msgctxt "items"
msgid ""
"Made in Alvar, cloaks of this quality are often seen on the shoulders of the"
" more wealthy members of the Alvarian Merchant Guild."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:126
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:128
msgctxt "items"
msgid "Necromancer Cloak"
msgstr "Capa de nigromante"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:126
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:128
msgctxt "items"
msgid ""
"Clearly a cloak made for a practitioner of the dark arts. This fine cloak is"
" worked with arcane designs embroidered in darkened silver thread."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:127
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:129
msgctxt "items"
msgid "Vampire Cloak"
msgstr "Capa de vampiro"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:127
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:129
msgctxt "items"
msgid ""
"This high collared, jet black cloak of wyvern leather is lined in red velvet"
"--a style much favored by the elder vampires of Shadowspire."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:128
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:130
msgctxt "items"
msgid "Leather Gloves"
msgstr "Guantes de cuero"

