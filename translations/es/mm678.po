#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:631
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:633
msgctxt "items"
msgid ""
"Quest Item: An Idol of the ancient snake god who was worshipped by the "
"Serpentmen who used to dwell on the Dagger Wound Islands."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:632
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:634
