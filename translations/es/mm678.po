msgid "knight"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:2
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:2
msgctxt "skilldes"
msgid ""
"Staves are blunt two-handed pole weapons effective on both offense and "
"defense. At expert rank, skill increases your armor class. Masters have a "
"chance of stunning their opponents, and grandmasters gain a bonus to their "
"attack damage."
msgstr ""

