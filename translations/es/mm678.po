#: mm6/data/10LocLANG.icons/Spells.txt.py:22
msgctxt "spells"
msgid "Lightning Bolt"
msgstr "Descarga de relámpago"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:21
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:21
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:21
#: mm6/data/10LocLANG.icons/Spells.txt.py:22
msgctxt "spells"
msgid "Lightning"
msgstr "Relámpago"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:21
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:21
msgctxt "spells"
msgid ""
"Lightning Bolt discharges electricity from the caster’s hand to a single "
"target.  It always hits and does 1-8 points of damage per point of skill in "
"Air Magic."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:22
#: mm8/Data/10LocLANG.EnglishT/Global.txt.py:220
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:321
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:421
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:22
#: mm7/DATA/10LocLANG.events/Global.txt.py:220
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:320
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:420
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:22
msgctxt "spells"
msgid "Invisibility"
msgstr "Invisibilidad"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:22
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:22
msgctxt "spells"
msgid ""
"Invisibility works on the minds of nearby creatures, making them unable to "
"notice the party unless spoken to or attacked.  Any attack you make, "
"regardless of whether or not it hits or misses, will break this spell. This "
"spell can't be cast while hostile monsters are nearby."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:23
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:322
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:422
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:23
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:321
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:421
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:23
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:222
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:322
#: mm6/data/10LocLANG.icons/Spells.txt.py:24
msgctxt "spells"
msgid "Implosion"
msgstr "Implosión"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:23
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:23
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:23
#: mm6/data/10LocLANG.icons/Spells.txt.py:24
msgctxt "spells"
msgid ""
"Implosion is a nasty spell that affects a single target by destroying the "
"air around it, causing a sudden inrush from the surrounding air, a "
"thunderclap, and 10 points plus 1-10 points of damage per point of skill in "
"Air Magic."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:23
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:23
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:23
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
msgctxt "spells"
msgid "Fast recovery rate"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:24
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:24
msgctxt "spells"
msgid ""
"Grants the power of flight to your characters!  This spell is very expensive"
" and only works outdoors, but it is very useful.  Fly will drain one spell "
"point every five minutes it is in use (i.e. when you aren't touching the "
"ground)."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:24
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:31
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:137
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:24
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:31
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:137
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:24
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:31
msgctxt "spells"
msgid "No spell point drain"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:25
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:324
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:424
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:25
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:323
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:423
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:25
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:224
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:324
#: mm6/data/10LocLANG.icons/Spells.txt.py:26
msgctxt "spells"
msgid "Starburst"
msgstr "Estallido estelar"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:25
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:25
msgctxt "spells"
msgid ""
"Calls stars from the heavens to smite and burn your enemies.  Twenty stars "
"are called, and the damage for each star is 20 points plus 1 per point of "
"skill in Air Magic. Try not to get caught in the blast! This spell only "
"works outdoors."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:325
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:425
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:324
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:424
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:225
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:325
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Awaken"
msgstr "Despertar"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid ""
"Automatically awakens all of your characters from a normal sleep and will "
"awaken them from a magical sleep if they haven't had the sleep condition for"
" too long.  The greater your skill in Water Magic, the longer the sleep "
"condition could have been present before this spell becomes ineffective."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Works if asleep less than 3 minutes per point of skill"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Works if asleep less than 1 hour per point of skill"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Works if asleep less than 1 day per point of skill"
msgstr ""

