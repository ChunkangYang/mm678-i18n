#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:640
msgctxt "items"
msgid ""
"Quest Item: The Seasons' Stole is worn by priests during seasonal "
"festivities.  Though it doesn't have any direct power, most commonfolk "
"believe it grants luck in the planting or harvest."
msgstr ""

