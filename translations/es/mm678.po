#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:33
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:511
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:22
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:23
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:24
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:23
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:24
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:25
msgctxt "items"
msgid "Long Dagger"
msgstr "Daga larga"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:29
msgctxt "items"
msgid ""
"With a blade in length between sword and dagger, these weapons are meant for"
" the knife fighter who desires a bit of extra reach. This particular weapon "
"is of mediocre workmanship in soft steel."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:30
msgctxt "items"
msgid "Alvarian Poignard"
msgstr "Puñal alvariano"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:30
msgctxt "items"
msgid ""
"At many social functions in Alvar, it is deemed inappropriate to carry a "
"sword. It is common for Elven warriors to carry a smaller blade in case "
"things become uncivil."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:29
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:31
msgctxt "items"
msgid "Regnan Fighting Knife"
msgstr "Cuchillo de combate regnano"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:29
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:31
msgctxt "items"
msgid ""
"Not wishing to be encumbered by a shield, many Regnan pirate raiders fight "
"with a cutlass in one hand and one of these shorter blades in the other."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:30
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:32
msgctxt "items"
msgid "Twilight Kris"
msgstr "Kris del Crepúsculo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:30
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:32
msgctxt "items"
msgid ""
"This wavy bladed long dagger of the best quality steel is the product of the"
" Twilight weaponsmiths. The bat wing guard set with a blood red ruby marks "
"it as the weapon of a Vampire."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:31
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:33
msgctxt "items"
msgid "Dueling Long Dagger"
msgstr "Daga larga de duelo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:31
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:33
msgctxt "items"
msgid ""
"While they present a united front to the rest of the world, there is much "
"internal strife among the Vampires of Shadowspire. By custom, very serious "
"differences are settled in battle using these deadly blades of exquisite "
"craftwork."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:34
msgctxt "items"
msgid "Stone Axe"
msgstr "Hacha de piedra"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:32 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:33 mmmerge/Data/Text
