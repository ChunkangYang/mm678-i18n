#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:56
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:57
msgctxt "items"
msgid "Mace"
msgstr "Maza"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:67
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:69
msgctxt "items"
msgid ""
"A slight improvement over the common club, maces are better balanced, more "
"durable, and deliver greater damage."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:68
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:70
msgctxt "items"
msgid "Flail"
msgstr "Mangual"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:68
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:70
msgctxt "items"
msgid ""
"Though evolved from the farm implement which shares its name, the flail's "
"great reach and striking power make it a fearsome weapon."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:69
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:71
msgctxt "items"
msgid "Temple Mace"
msgstr "Maza del Templo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:69
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:71
msgctxt "items"
msgid ""
"The sunray corona circling the head of this well made mace serves as a "
"devotional declaration for Temple of the Sun clerics; it also greatly "
"increases the damage of its blows. "
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:70
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:72
msgctxt "items"
msgid "Reverend Sceptre"
msgstr "Cetro sacerdotal"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:70
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:72
msgctxt "items"
msgid ""
"As much a symbol of office as weapon, these finely crafted maces are carried"
" by inner circle Sun Temple priests. Its highly decorated shaft belies the "
"effectiveness of the gilded erudine-steel head."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:71
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:73
msgctxt "items"
msgid "Trollish War Mace"
msgstr "Maza de guerra trol"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:71
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:73
msgctxt "items"
msgid ""
"While most races have concentrated on developing bladed weapons, the Trolls "
"have always been content to refine the simple bludgeon. This brutal weapon "
"forged as a single piece of stalt alloy is the finest example of their "
"craft."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:72
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:74
msgctxt "items"
msgid "Sledgehammer"
msgstr "Mazo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:72 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:73 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:74 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:75 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:76 mmmerge/Data/Text
