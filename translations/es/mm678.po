#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:58
msgctxt "spells"
msgid ""
"This spell weakens the link between a target's body and soul, causing 10 + "
"2-8 points of damage per point of skill in Spirit Magic to all monsters near"
" the caster."
msgstr ""

