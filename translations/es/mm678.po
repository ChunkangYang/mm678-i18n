"You need to give The Letter to Regent Wilbur Humphrey in Ironfist Castle."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2121
#: mm6/data/10LocLANG.icons/npctext.txt.py:430
msgctxt "npc conversation"
