msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:618
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:620
msgctxt "items"
msgid ""
"Quest Item: A facet carved stone of dark glassy rock. When tapped it "
"produces a high bell tone."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:619
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:621
msgctxt "items"
msgid ""
"Quest Item: A facet carved stone of dark glassy rock. When tapped it "
"produces a medium bell tone."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:620
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:622
msgctxt "items"
msgid "Pirate Leader's Key"
