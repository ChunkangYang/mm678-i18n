msgid "Empty bucket"
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2137
#: mm6/data/10LocLANG.icons/npctext.txt.py:446
msgctxt "npc conversation"
msgid "I'll trade high quality weapons for golden pyramids or kegs of wine."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2138
#: mm6/data/10LocLANG.icons/npctext.txt.py:447
msgctxt "npc conversation"
msgid ""
"I have a wide variety of magical accessories I'll gladly trade for golden "
"pyramids or kegs of wine."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2139
#: mm6/data/10LocLANG.icons/npctext.txt.py:448
msgctxt "npc conversation"
msgid "Great to do business with you, here's your armor!"
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2140
#: mm6/data/10LocLANG.icons/npctext.txt.py:449
msgctxt "npc conversation"
msgid "Useless Crystal"
msgstr ""

