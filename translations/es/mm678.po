#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:96
msgctxt "items"
msgid "Helm"
msgstr "Yelmo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:110
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:112
msgctxt "items"
msgid ""
"This cap of soft iron and unhardened leather provides a small measure of "
"protection from blows to the head."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:111
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:113
msgctxt "items"
msgid "Lizardman Helm"
msgstr "Yelmo de hombre lagarto"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:111
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:113
msgctxt "items"
msgid ""
"Iron and leather helms of this sort are produced by blacksmiths everywhere. "
"This one is of Lizardman manufacture and sports genuine ram horns."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:112
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:114
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:93
msgctxt "items"
msgid "Full Helm"
msgstr "Yelmo cerrado"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:112
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:114
msgctxt "items"
msgid ""
"Steel helms of this design are commissioned in large numbers by the "
"Merchants of Alvar who issue them to mounted caravan guards."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:113
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:115
msgctxt "items"
msgid "Battle Helm"
msgstr "Yelmo de batalla"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:113
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:115
msgctxt "items"
msgid ""
"This full helmet is of superior materials and workmanship. The structurally "
"weaker areas around the eye and nose slits are reinforced with siertal."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:114
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:116
msgctxt "items"
msgid "Dragon Helm"
msgstr "Yelmo de dragón"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:114
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:116
msgctxt "items"
msgid ""
"The faceplate of this superior helmet hinges on nearly invisible seams so "
"that when closed it provides a snug fit and full face coverage. Only the "
"most well-aimed blows have a chance of penetrating through."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:115
msgctxt "items"
msgid "Citizen Hat"
msgstr ""

