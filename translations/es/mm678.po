#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:137
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:582
msgctxt "items"
msgid "Amulet"
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:148
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:150
msgctxt "items"
msgid ""
"These stamp formed and lacquered baubles are cheap trinkets sold to pilgrims"
" as keepsake mementos."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:149
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:151
msgctxt "items"
msgid "Jade Amulet"
msgstr "Amuleto de jade"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:149
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:151
msgctxt "items"
msgid ""
"A large polished jade stone decorates and adds value to this simple amulet."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:150
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:152
msgctxt "items"
msgid "Blood Talisman"
msgstr "Talismán de sangre"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:150
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:152
msgctxt "items"
msgid ""
"Made by necromancers to hold dark magics, other sorcerers have recognized "
"their worth for other uses."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:151
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:153
msgctxt "items"
msgid "Shadow Sect Medallion"
msgstr "Medallón de la Secta de las Sombras"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:151
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:153
msgctxt "items"
msgid ""
"Formed in white and yellow gold, inlaid with jade, and studded with "
"peridots, these amulets are worn by members of the secret Shadow Sect hidden"
" beneath their clothing."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:152
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:154
msgctxt "items"
msgid "Locus Amulet"
msgstr "Amuleto del Locus"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:152
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:154
msgctxt "items"
msgid ""
"The pinnacle of artificer tradecraft, these amulets wrought in platinum and "
"set with a perfect sapphire can contain enchantments of nearly unimaginable "
"potency."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:153
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:155
msgctxt "items"
msgid "Witch's Wand of Fire"
msgstr "Varita del Fuego de la bruja"

