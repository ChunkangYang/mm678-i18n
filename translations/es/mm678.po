#: mmmerge/Data/10LocLANG.T/Spells.txt.py:57
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:57
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:57
msgctxt "spells"
msgid ""
"Heroism increases the damage a character does on a successful attack by 5 + "
"1 point per point of skill in Spirit Magic. This spell affects the entire "
"party at once."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:58
