#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:42
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:43
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:44
msgctxt "items"
msgid "Trident"
msgstr "Tridente"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:52
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:54
msgctxt "items"
msgid ""
"Though a common farming implement, this hayfork is of sturdy construction "
"and could be an excellent, if improvised, weapon."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:53
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:55
msgctxt "items"
msgid "Infantry Fork"
msgstr "Horca de infantería"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:53
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:55
msgctxt "items"
msgid ""
"A highly specialized piece of equipment intended to equalize contests "
"between foot soldiers and mounted, armored opponents, these modified spears "
"are effective if slightly clumsy weapons."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:56
msgctxt "items"
msgid "Lizardman Trident"
msgstr "Tridente de hombre lagarto"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:56
msgctxt "items"
msgid ""
"The blacksmiths on the Dagger Wound Islands craft a wide variety of "
"spearheads. This trident is one of their most unusual designs. The barbed "
"tines cause extra damage during straight thrusting attacks."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:57
msgctxt "items"
msgid "Regnan Trident"
msgstr "Tridente de Regna"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:57
msgctxt "items"
msgid ""
"No Regnan ship leaves port without a cache of tridents. Boarding attacks "
"against their galleys seldom succeed against massed walls of their erudine "
"tines."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:56
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:58
msgctxt "items"
msgid "Triton Trident"
msgstr "Tridente de tritón"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:56
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:58
msgctxt "items"
msgid ""
"The first thing one notices when first handling this trident is that it is "
"unusually cool to the touch. The second is a sense that the dragon turtle "
"bone tines seem to seek vulnerabilities in their targets' defenses as if "
"guided by an unseen hand."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:57
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:59
msgctxt "items"
msgid "Hunting Bow"
msgstr "Arco de caza"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:57 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:58 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:59 mmmerge/Data/Text
