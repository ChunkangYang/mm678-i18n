#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:228
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:328
#: mm6/data/10LocLANG.icons/Spells.txt.py:31
msgctxt "spells"
msgid "Poison Spray"
msgstr "Rocío de Veneno"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:28
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:28
#: mm6/data/10LocLANG.icons/Spells.txt.py:31
msgctxt "spells"
msgid "Poison Spr"
msgstr "Rocío de Veneno"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:28
msgctxt "spells"
msgid ""
"Sprays poison at monsters directly in front of your characters.  Damage is "
"low, but few monsters have resistance to Water Magic, so it usually works.  "
"Each shot does 2 points of damage plus 1-2 per point of skill."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:28
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:28
msgctxt "spells"
msgid "Slow rate of recovery, 1 shot"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:28
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:28
msgctxt "spells"
msgid "Faster recovery rate, 3 shots"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:28
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:28
msgctxt "spells"
msgid "Faster recovery rate, 5 shots"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:28
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:28
msgctxt "spells"
msgid "Fastest recovery rate, 7 shots"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:29
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:327
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:427
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:29
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:326
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:426
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:29
msgctxt "spells"
msgid "Water Resistance"
msgstr "Resistencia al agua"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:29
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:29
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:29
msgctxt "spells"
msgid "Water Resist"
msgstr "Resistencia al agua"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:29
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:29
msgctxt "spells"
msgid ""
"Increases all your characters’ resistance to water damage by an amount equal"
" to your skill in Water Magic. The protection lasts one hour per point of "
"skill."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:30
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:328
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:428
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:30
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:327
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:427
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:30
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:230
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:330
#: mm6/data/10LocLANG.icons/Spells.txt.py:33
msgctxt "spells"
msgid "Ice Bolt"
msgstr "Proyectil de hielo"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:30
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:30
msgctxt "spells"
msgid ""
"Fires a bolt of ice at a single target.  The missile does 1-4 points of "
"damage per point of skill in Water Magic."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:31
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:31
msgctxt "spells"
msgid ""
"Only useful outdoors, Water Walk lets your characters walk along the surface"
" of water without sinking.  In addition to its casting cost, one spell point"
" is expended every 20 minutes while your party is in contact with water."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:330
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:430
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:32
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:329
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:429
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:32
msgctxt "spells"
msgid "Recharge Item"
msgstr "Recargar objeto"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:32
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:32
msgctxt "spells"
msgid "Recharge"
msgstr "Recargar"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:32
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:32
msgctxt "spells"
msgid ""
"Recharges any magic item that uses charges.  Every time this spell is cast, "
"the item permanently loses 50% - 1 per point of skill in Water magic of its "
"charges. "
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:32
msgctxt "spells"
msgid "Item loses 50% - 1 per point of skill"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:32
msgctxt "spells"
msgid "Item loses 30% - 1 per point of skill"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:32
msgctxt "spells"
msgid "Item loses 20% - 1 per point of skill"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:33
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:331
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:431
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:33
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:330
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:430
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:33
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:232
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:332
#: mm6/data/10LocLANG.icons/Spells.txt.py:35
msgctxt "spells"
msgid "Acid Burst"
msgstr "Estallido ácido"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:33
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:33
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:33
msgctxt "spells"
msgid ""
"Acid burst squirts a jet of extremely caustic acid at a single victim.  It "
"always hits and does 9 points of damage plus 1-9 per point of skill.  "
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:34
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:332
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:432
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:34
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:331
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:431
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:34
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:231
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:331
#: mm6/data/10LocLANG.icons/Spells.txt.py:34
msgctxt "spells"
msgid "Enchant Item"
msgstr "Encantar Objeto"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:34
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:34
msgctxt "spells"
msgid ""
"When cast, this spell has a chance of imbuing a normal item with magical "
"powers.  The chance of success is 10% per point of skill in Water Magic.  "
"Grandmasters can manage better enchantments."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:34
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:34
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:34
msgctxt "spells"
msgid "Moderate strength enchantments"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:34
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:34
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:34
msgctxt "spells"
msgid "Strong enchantments"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:35
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:35
msgctxt "spells"
msgid ""
"Town Portal teleports the party to any town where the party has drunk from "
"the central fountain.  Town Portal has a 10% chance per point of Water Magic"
" skill of working when cast, and cannot be used while hostile monsters are "
"nearby.  "
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:35
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:35
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:35
msgctxt "spells"
msgid "Does not work while hostile monsters are nearby"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:35
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:35
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:35
msgctxt "spells"
msgid "Works while hostile monsters are nearby"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:36
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:334
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:434
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:36
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:333
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:433
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:36
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:234
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:334
#: mm6/data/10LocLANG.icons/Spells.txt.py:37
msgctxt "spells"
msgid "Ice Blast"
msgstr "Explosión de hielo"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:36
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:36
msgctxt "spells"
msgid ""
"Fires a ball of ice in the direction the caster is facing.  The ball will "
"shatter when it hits something, launching 7 shards of ice in all directions "
"except the caster’s.  The shards will ricochet until they strike a creature "
"or melt.  Each shard does 12 points of damage plus 1-6 per point of skill in"
" Water Magic."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:36
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:36
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:36
msgctxt "spells"
msgid "Moderate recovery rate and 7 shards"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:36
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:36
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:36
msgctxt "spells"
msgid "Faster recovery rate and 9 shards"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:37
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:335
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:435
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:37
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:334
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:434
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:37
#: mm6/data/10LocLANG.icons/GLOBAL.TXT.py:379
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:235
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:335
#: mm6/data/10LocLANG.icons/Spells.txt.py:38
msgctxt "spells"
msgid "Lloyd's Beacon"
msgstr "Baliza de Lloyd"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:37
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:37
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:37
#: mm6/data/10LocLANG.icons/Spells.txt.py:38
msgctxt "spells"
msgid "Lloyd's"
msgstr "de Lloyd"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:37
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:37
msgctxt "spells"
msgid ""
"Lloyd’s Beacon lets you place a marker at a location you want to teleport "
"back to in the future.  Just how far in the future depends on your skill in "
"Water Magic.  Cast this spell whenever you wish to either place a marker or "
"return to one.  Each beacon will decay after 1 week per point of skill in "
"Water magic after it is placed."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:39
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:336
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:436
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:39
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:335
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:435
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:39
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:236
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:336
#: mm6/data/10LocLANG.icons/Spells.txt.py:40
msgctxt "spells"
msgid "Stun"
msgstr "Aturdir"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:39
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:39
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:39
#: mm6/data/10LocLANG.icons/Spells.txt.py:40
msgctxt "spells"
msgid ""
"Slaps a monster with magical force, forcing it to recover from the stun "
"spell before it can do anything else.  Stun also knocks monsters back a "
"little, giving you a chance to get away while the getting is good.  The "
"greater your skill in Earth Magic, the greater the effect of the spell."
msgstr ""

