#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:12
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:13
msgctxt "skilldes"
msgid "Recovery penalty eliminated"
msgstr ""

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:10
#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:11
