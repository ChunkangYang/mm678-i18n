#: mmmerge/Data/10LocLANG.T/Spells.txt.py:65
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:65
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:65
msgctxt "spells"
msgid "Mind Resist"
msgstr "Resistencia a la Mente"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:65
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:65
msgctxt "spells"
msgid ""
"Increases all your characters’ resistance to Mind Magic damage by an amount "
"equal to your skill in Mind Magic. The protection lasts one hour per point "
"of skill."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:66
