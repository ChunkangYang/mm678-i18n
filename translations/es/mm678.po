#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:13
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:14
msgctxt "items"
msgid "Broadsword"
msgstr "Espada ancha"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:12
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:14
msgctxt "items"
msgid ""
"Some swordsmen swear that the soft metal of an iron sword gives them certain"
" combat advantages. Those swordsmen never seem to be very old."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:15
msgctxt "items"
msgid "Trollish Claymore"
msgstr "Mandoble trol"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:15
msgctxt "items"
msgid ""
"Though of primitive design and craftsmanship, these Troll forged weapons are"
" effective in strong hands."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:14
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:16
msgctxt "items"
msgid "Lizardman Broadsword"
msgstr "Espada ancha de hombre lagarto"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:14
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:16
msgctxt "items"
msgid "The Lizardmen produce a weapon capable of giving sturdy service."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:15
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:17
msgctxt "items"
msgid "Knightly Broadsword"
msgstr "Espada ancha caballeresca"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:15
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:17
msgctxt "items"
msgid ""
"The weight of this sword's untapered blade would make it unwieldy if not for"
" its exacting counterbalance."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:16
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:18
msgctxt "items"
msgid "Archangel Broadsword"
msgstr "Espada ancha de arcángel"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:16
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:18
msgctxt "items"
msgid ""
"This blade of pure erudine steel can cut armor like butter and gleams with a"
" starlight glow. There are finer swords available, but their numbers can be "
"counted on a single hand."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:17
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:19
msgctxt "items"
msgid "Rusty Cutlass"
msgstr "Alfanje oxidado"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:17 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:18 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:19 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:20 mmmerge/Data/Text
