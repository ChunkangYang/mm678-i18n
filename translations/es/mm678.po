msgctxt "items"
msgid "Wand"
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:153 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:154 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:155 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:156 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:155
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159
msgctxt "items"
msgid ""
"The primitive materials of this wand is infused with dark spiritual energy. "
"To use this wand, you must equip it as though you were equipping a weapon."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:154
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156
msgctxt "items"
msgid "Witch's Wand of Sparks"
msgstr "Varita de las Chispas de la bruja"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:155
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157
msgctxt "items"
msgid "Witch's Wand of Poison"
msgstr "Varita del Veneno de la bruja"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158
msgctxt "items"
msgid "Witch's Wand of Stunning"
msgstr "Varita de aturdimiento de la bruja"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159
msgctxt "items"
msgid "Witch's Wand of Harming"
msgstr "Varita de Dañar de la bruja"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:158
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:160
msgctxt "items"
msgid "Shaman's Wand of Light"
msgstr "Varita de Luz del chamán"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:158 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:159 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:160 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:161 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:162
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:160
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:161
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:162
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:163
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:164
msgctxt "items"
msgid ""
"Something rattles ominously within the gog skull topping this wand - product"
" of Ogre mage magic. To use it, you must equip it like a weapon."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:159
