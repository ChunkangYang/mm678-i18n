#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:128
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:130
msgctxt "items"
msgid "These gloves of poorly cured leather are worn by workmen everywhere."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:129
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:131
msgctxt "items"
msgid "Troll Gauntlets"
msgstr "Guanteletes de trol"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:129
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:131
msgctxt "items"
msgid ""
"These leather gloves of Trollish make are studded with iron spikes at the "
"knuckles."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:130 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:914
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:132
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:113
msgctxt "items"
msgid "Steel Gauntlets"
msgstr "Guanteletes de acero"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:130
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:132
msgctxt "items"
msgid ""
"Made of hinged plates of steel, these gauntlets offer good protection, but "
"have a tendency to pinch."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:131
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:133
msgctxt "items"
msgid "Minotaur Gauntlets"
msgstr "Guanteletes de minotauro"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:131
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:133
msgctxt "items"
msgid ""
"Siertal-alloy makes these gauntlets light and tough. Superior workmanship "
"make them comfortable and flexible."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:132
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:134
msgctxt "items"
msgid "Crusader's Gauntlets"
msgstr "Guanteletes de cruzado"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:132
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:134
msgctxt "items"
msgid ""
"These gauntlets are master crafted from pure erudine marking them as the "
"product of Derrick Goreth's White Light Forgeworks."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:133
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:135
msgctxt "items"
msgid "Walking Boots"
msgstr "Botas de caminata"

