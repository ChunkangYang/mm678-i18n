#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1763
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:163
msgctxt "items"
msgid ""
"A magical herb of unusual properties.  Popppysnaps can be used to make "
"potions.  (To use, pick the herb up and right-click over an empty potion "
"bottle.)"
msgstr ""
"Un'erba magica dalle proprietà insolite. I Papaveri Gialli si possono usare "
"per fare delle pozioni. (Per usarla, prendete l'erba e cliccate col tasto "
"destro su un'ampolla vuota)"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1764
