#: mm7/DATA/10LocLANG.events/AUTONOTE.TXT.py:54
msgctxt "autonote or awards"
msgid ""
"Catalyst (Grey) = Mushrooms + Empty Bottle.  Different grey reagents can be "
"used for increased effect."
msgstr ""
"Catalizzatore (Grigio) = Funghi + Bottiglia vuota.  Per ottenere un effetto "
"maggiore, si possono usare reagenti grigi diversi."

#: mm7/DATA/10LocLANG.events/AUTONOTE.TXT.py:56
msgctxt "autonote or awards"
msgid ""
"Magic Potion (Blue) = Phirna Root + Empty Bottle.  Different blue reagents "
"can be used for increased effect."
msgstr ""
"Pozione magica (Blu) = Radice di Phirna + Bottiglia vuota.  Per ottenere un "
"effetto maggiore, si possono usare reagenti blu diversi."

#: mm7/DATA/10LocLANG.events/AUTONOTE.TXT.py:96
