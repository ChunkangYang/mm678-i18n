#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1456
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:655
msgctxt "items"
msgid "Central Pillar Key"
msgstr "Chiave del pilastro centrale"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1457
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:656
msgctxt "items"
msgid "East Pillar Key"
msgstr "Chiave del pilastro orientale"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1458 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1459 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1460
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:657
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:658
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:659
msgctxt "items"
msgid "Barrow Key"
msgstr "Chiave del tumulo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1461
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:660
msgctxt "items"
msgid "Contestant's Shield"
msgstr "Scudo del contendente"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1461
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:660
msgctxt "items"
msgid ""
"Quest Item:  Blood stains the back side of this battered shield.  The owner "
"must certainly have been killed while using it."
msgstr ""
"Oggetto di missione: ci sono chiazze di sangue nella parte interna di questo"
" scudo. Il suo possessore dev'essere sicuramente morto mentre le indossava."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1462
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:661
msgctxt "items"
msgid "William's Tower Key"
msgstr "Chiave della torre di William"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1463
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:662
msgctxt "items"
msgid "Catherine's Key"
msgstr "Chiave di Catherine"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1464
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:663
msgctxt "items"
msgid "Colony Zod Key"
msgstr "Chiave della Colonia Zod"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1465
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:664
msgctxt "items"
msgid "Faerie Key"
msgstr "Chiave delle Fate"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1466 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2199
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:665
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:581
msgctxt "items"
msgid "Sewer Key"
msgstr "Chiave delle fogne"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1466
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:665
msgctxt "items"
msgid ""
"Been looking for this?  No wonder it wasn't in the sewers… it was hiding out"
" in Erathia the whole time."
msgstr ""
"La cercavate? Era ovvio che non fosse dentro le fogne… si stava nascondendo "
"in giro per l'Erathia."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1467 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1468 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1469 mmmerge/Data/Text
