#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:48
#: mm6/data/10LocLANG.icons/Spells.txt.py:49
msgctxt "spells"
msgid "Moderate rate of recovery"
msgstr "Velocità di guarigione moderata "

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:12
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:12
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:12
