#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:242
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:342
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Stone to Flesh"
msgstr "Pietra in carne"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Stone - Flesh"
msgstr "Pietra - Carne"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
msgctxt "spells"
msgid ""
"Removes the stoned condition from a character if you cast this spell in "
"time.  The greater the skill and rank in Earth Magic the longer the "
"condition can have been present before the “point of no return” is reached."
"  After that, the only way to remove the condition short of Divine "
"Intervention is to visit a temple."
msgstr ""
"Quest’incantesimo annulla la condizione di pietrificazione di un "
"personaggio. Maggiore è l’abilità e il livello nella Magia della Terra e più"
" a lungo può perdurare la condizione prima di raggiungere il “punto di non "
"ritorno”. A questo punto, l'unico modo per annullare questa condizione senza"
" ricorrere all'Intervento Divino è quello di visitare un tempio."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Works if stoned less than 1 hour per point of skill"
msgstr "Funziona se pietrificato per meno di 1 ora per ogni punto abilità"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Works if stoned less than 1 day per point of skill"
msgstr "Funziona se pietrificato per meno di 1 giorno per ogni punto abilità"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:55
