msgid "Incorrect"
msgstr "Sbagliato"

#: mmmerge/Data/10LocLANG.T/6D08.STR.py:24
#: mm6/data/10LocLANG.icons/D08.STR.py:24
msgctxt "location"
msgid ""
"I go through an apple, or point out your way, I fit in a bow, then a target,"
" to stay. What am I?"
msgstr ""
"Attraverso una mela, o ciò che volete, di rado mi sbaglio, scegliete voi il "
"bersaglio. Che cosa sono?"

#: mmmerge/Data/10LocLANG.T/6D08.STR.py:25
#: mm6/data/10LocLANG.icons/D08.STR.py:25
