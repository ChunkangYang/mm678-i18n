#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1766
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:222
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:166
msgctxt "items"
msgid "An empty potion bottle."
msgstr "Un'ampolla vuota."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1767
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:167
msgctxt "items"
msgid ""
"Restores 10 hit points.  To drink, pick the potion up and right-click over a"
" character's portrait.  To mix, pick the potion up and right-click over "
"another potion."
msgstr ""
"Cura 10 punti ferita. Per bere, prendete la pozione e cliccate col pulsante "
"destro sull'immagine di un personaggio. Per miscelare, prendetela e cliccate"
" col destro su un'altra pozione."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1768
