msgid "Druid Wand of Swarms"
msgstr "Bacchetta druidica degli Sciami"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1748
msgctxt "items"
msgid "Cruel Wand of Fireballs"
msgstr "Bacchetta crudele delle Palle di fuoco"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1748 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1749 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1750 mmmerge/Data/Text
