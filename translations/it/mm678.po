#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:637
msgctxt "items"
msgid "Quest Item: A well crafted instrument."
msgstr "Oggetto della ricerca: uno strumento di ottima fattura."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:636
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:638
msgctxt "items"
msgid "Royal Wasp Jelly"
msgstr "Gelatina di vespa reale"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:636
