#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:32
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:33
msgctxt "items"
msgid "Two-Handed Axe"
msgstr "Ascia a due mani"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:37
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:39
msgctxt "items"
msgid ""
"As much an implement for working wood as a weapon, this crude axe can still "
"deliver a telling blow."
msgstr ""
"Usata più come attrezzo per tagliare la legna che non come arma, questa "
"ascia è in grado di infliggere dei colpi non indifferenti."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:38
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:40
msgctxt "items"
msgid "Footman's Axe"
msgstr "Ascia del fante"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:38
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:40
msgctxt "items"
msgid ""
"Capable of splitting armor, these two-handed axes are a favorite among "
"soldiers facing mounted knights."
msgstr ""
"Capace di spezzare le corazze, quest'ascia a due mani è la preferita dei "
"soldati che devono affrontare i nemici a cavallo."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:39
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:41
msgctxt "items"
msgid "Minotaur War Axe"
msgstr "Ascia da guerra dei minotauri"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:39
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:41
msgctxt "items"
msgid ""
"These two-handed axes are commonly used by Minotaurs who have the strength "
"necessary to handle their great weight."
msgstr ""
"Quest'ascia a due mani viene in genere utilizzata dai Minotauri, i quali "
"sono tra i pochi ad avere la forza necessaria per sopportare il suo peso "
"straordinario."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:40
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:42
msgctxt "items"
msgid "Elite Minotaur Axe"
msgstr "Ascia del Minotauro d'élite"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:40
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:42
msgctxt "items"
msgid ""
"These axes of superior workmanship are issued only to members of The "
"Blackened Horn, the elite warriors who guard Minotaur holy sites."
msgstr ""
"Quest'ascia di qualità superiore è impiegata esclusivamente dai membri del "
"Corno Annerito, i guerrieri d'élite che sorvegliano i luoghi sacri ai "
"Minotauri."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:43
msgctxt "items"
msgid "Minotaur Herdsman Axe"
msgstr "Ascia del mandriano minotauro"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:43
msgctxt "items"
msgid ""
"Minotaur herdsmen lead their troops into battle wielding these devastating "
"war axes of superlative balance and workmanship."
msgstr ""
"I capi dei Minotauri guidano il loro branco in battaglia impugnando queste "
"devastanti asce da guerra, che potremmo definire superlative per fattura ed "
"equilibrio."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:44
msgctxt "items"
msgid "Ogre Fighting Stick"
msgstr "Bastone da combattimento dell'Ogre"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:42 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:43 mmmerge/Data/Text
