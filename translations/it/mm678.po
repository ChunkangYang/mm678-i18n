#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid ""
"Causes a weapon that has no special abilities to burn with a magical fire, "
"giving the weapon the \"of Fire\" ability.  This spell lasts for one hour "
"per point of skill in Fire Magic."
msgstr ""
"Consente a un'arma non associata ad abilità specifiche di emettere una "
"fiammata magica, conferendole la caratteristica “di Fuoco”. L'incantesimo ha"
" la durata di un’ora per ogni punto abilità nella Magia del Fuoco."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid "Grants \"of Fire\""
msgstr "Conferisce \"Fuoco\""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid "Grants \"of Flame\""
msgstr "Conferisce \"Fiamma”"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid "Grants \"of Infernos\""
msgstr "Conferisce \"Inferno\""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
