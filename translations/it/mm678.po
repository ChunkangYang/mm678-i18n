#: mm6/data/10LocLANG.icons/Spells.txt.py:43
msgctxt "spells"
msgid "Deadly Swarm"
msgstr "Sciame letale"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:42
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:42
#: mm6/data/10LocLANG.icons/Spells.txt.py:43
msgctxt "spells"
msgid "Swarm"
msgstr "Sciame"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:42
msgctxt "spells"
msgid ""
"Summons a swarm of biting, stinging insects to bedevil a single target.  The"
" swarm does 5 points of damage plus 1-3 per point of skill in Earth Magic."
msgstr ""
"Richiama uno sciame di insetti che mordono e pungono per tormentare un "
"singolo bersaglio. Lo sciame causa un danno di 5 punti più 1-3 punti per "
"ogni punto abilità nella Magia della Terra."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:43
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:340
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:440
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:43
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:339
