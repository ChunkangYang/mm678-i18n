#: localization/LANG_PlaceMonTxt.txt.py:158
msgctxt "placemon"
msgid "NWC Employee"
msgstr "Dipendente NWC"

#: mmmerge/Data/Text localization/LANG_Placemon.txt.py:158 mmmerge/Data/Text
#: localization/LANG_PlaceMonTxt.txt.py:159
msgctxt "placemon"
msgid "Randy Ruckel"
msgstr "Randy Ruckel"

#: mmmerge/Data/Text localization/LANG_Placemon.txt.py:159 mmmerge/Data/Text
#: localization/LANG_PlaceMonTxt.txt.py:160
msgctxt "placemon"
msgid "Karl Fischer"
msgstr "Karl Fischer"

#: mmmerge/Data/Text localization/LANG_Placemon.txt.py:160 mmmerge/Data/Text
#: localization/LANG_PlaceMonTxt.txt.py:161
msgctxt "placemon"
msgid "David Casso"
msgstr "David Casso"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:5
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:4
msgctxt "quests"
msgid ""
"Deliver Dadeross' Letter to Elgar Fellmoon at the Merchant House in "
"Ravenshore."
msgstr ""
"Consegnare la Lettera di Dadeross a Elgar Fellmoon alla Sede dei Mercanti di"
" Lido dei Corvi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:7
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:6
msgctxt "quests"
msgid "Kill the leader of the Regnan Pirate outpost at Dagger Wound."
msgstr ""
"Uccidere il capo dell'Avamposto dei Pirati Regnani nell'Isola dei pugnali."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:8
msgctxt "quests"
msgid "Bring Brekish Onefang's portal crystal to Fredrick Talimere."
msgstr ""
"Portare a Fredrick Talimere il Cristallo del varco di Brekish Onefang."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:10
msgctxt "quests"
msgid ""
"Deliver Fellmoon's blackmail letter to Arion Hunter, leader of the wererat "
"smugglers. Report back to Fellmoon."
msgstr ""
"Consegnare la lettera di ricatto di Fellmoon ad Arion il Cacciatore, il capo"
" dei briganti Topi Mannari. Tornare a rapporto da Fellmoon."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:12
msgctxt "quests"
msgid "Report to Bastian Loudrin, the merchant guildmaster in Alvar."
msgstr ""
"Fare rapporto a Bastian Loudrin, capo della Lega dei Mercanti di Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:15
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:14
msgctxt "quests"
msgid "Form an alliance among the major factions of Jadame."
msgstr "Formare un'alleanza con le diverse fazioni di Jadame."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:16
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:15
msgctxt "quests"
msgid "Form an alliance with the Necromancers' Guild in Shadowspire."
msgstr "Formare un'alleanza con la Lega dei Negromanti di Punta Tenebrosa."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:17
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:16
msgctxt "quests"
msgid "Form an alliance with the Temple of the Sun in Murmurwoods."
msgstr "Formare un'alleanza con il Tempio del Sole del Bosco dei Mormorii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:17
msgctxt "quests"
msgid "Form an alliance with the Dragon hunters of Garrote Gorge."
msgstr ""
"Formare un'alleanza con i Cacciatori di Draghi della Gola della Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:19
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:18
msgctxt "quests"
msgid "Form an alliance with the Dragons of Garrote Gorge."
msgstr "Formare un'alleanza con i Draghi di Gola della Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:20
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:19
msgctxt "quests"
msgid "Form an alliance with the Minotaurs of Ravage Roaming."
msgstr "Formare un'alleanza con i Minotauri della Landa della Razzia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:26
msgctxt "quests"
msgid ""
"Find a witness to the lake of fire's formation. Bring him back to the "
"merchant guild in Alvar."
msgstr ""
"Trovare un testimone oculare della formazione del Lago di Fuoco. Portarlo a "
"testimoniare davanti alla Lega dei Mercanti di Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:27
msgctxt "quests"
msgid ""
"Find the skeleton transformer in the Shadowspire Necromancers' Guild. "
"Destroy it and return to Oskar Tyre."
msgstr ""
"Trovare il Trasformatore di Scheletri presso la Lega dei Negromanti di Punta"
" Tenebrosa. Distruggerlo e tornare da Oskar Tyre."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:30
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:29
msgctxt "quests"
msgid ""
"Bring the Nightshade Brazier to the Necromancers' Guild leader, Sandro. The "
"Brazier is in the Temple of the Sun."
msgstr ""
"Portare il Braciere delle Tenebre a Sandro, il capo della Lega dei "
"Negromanti. Il Braciere si trova nel Tempio del Sole."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:31
msgctxt "quests"
msgid "Rescue the Minotaurs trapped in their lair in Ravage Roaming."
msgstr ""
"Salvare i Minotauri intrappolati nella loro tana nella Landa della Razzia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:33
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:32
msgctxt "quests"
msgid ""
"Recover the Dragon Egg from Zog's fortress in Ravage Roaming and return it "
"to Charles Quixote in Garrote Gorge."
msgstr ""
"Recuperare l'uovo di Drago dalla fortezza di Zog nella Landa della Razzia e "
"riportarlo a Charles Chisciotte nella Gola della Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:35
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:34
msgctxt "quests"
msgid ""
"Find the Dragon Egg and return it to the dragon leader, Deftclaw Redreaver."
msgstr ""
"Trovare l'uovo di Drago e riportarlo al Capo dei Draghi, Deftclaw Redreaver."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:38
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:37
msgctxt "quests"
msgid "Sink the Regnan Fleet. Return to the Ravenshore council chamber."
msgstr ""
"Affondare la flotta Regnana. Tornare alla Camera di Consiglio di Lido dei "
"Corvi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:40
msgctxt "quests"
msgid ""
"Find Cauri Blackthorne then return to Dantillion in Murmurwoods with "
"information of her location."
msgstr ""
"Trovare Cauri Blackthorne, quindi tornare da Dantillion nel Bosco dei "
"Mormorii e riferire dove si trova Cauri."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:43
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:42
msgctxt "quests"
msgid "Bring the Heart of Water from the Plane of Water to Xanthor."
msgstr "Portare a Xanthor il Cuore d'Acqua dal Piano dell'Acqua."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:44
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:43
msgctxt "quests"
msgid "Bring the Heart of Air from the Plane of Air to Xanthor."
msgstr "Portare a Xanthor il Cuore d'Aria dal Piano dell'Aria."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:44
msgctxt "quests"
msgid "Bring the Heart of Earth from the Plane of Earth to Xanthor."
msgstr "Portare a Xanthor il Cuore di Terra dal Piano della Terra."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:46
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:45
msgctxt "quests"
msgid "Bring the Heart of Fire from the Plane of Fire to Xanthor."
msgstr "Portare a Xanthor il Cuore di Fuoco dal Piano del Fuoco."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:48
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:47
msgctxt "quests"
msgid "Find the cause of the cataclysm through the Crystal Gateway."
msgstr "Trovare la causa del cataclisma attraverso il Passaggio di Cristallo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:50
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:49
msgctxt "quests"
msgid "Rescue Pyrannaste, Lord of Fire."
msgstr "Salvare Pyrannaste, Signore del Fuoco."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:52
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:51
msgctxt "quests"
msgid "Rescue Gralkor the Cruel, Lord of Earth."
msgstr "Salvare Gralkor il Crudele, Signore della Terra."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:53
msgctxt "quests"
msgid "Rescue Acwalander, Lord of Water."
msgstr "Salvare Acwalander, Signore dell'Acqua."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:56
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:55
msgctxt "quests"
msgid "Rescue Shalwend, Lord of Air."
msgstr "Salvare Shalwend, Signore dell'Aria."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:63
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:62
msgctxt "quests"
msgid "Put Vilebite's ashes in the Dust village tomb then return to Overdune."
msgstr ""
"Sotterrare le ceneri di Vilebite nel cimitero di Ruggine e tornare da "
"Overdune."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:70
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:69
msgctxt "quests"
msgid ""
"Find the Ancient Troll Homeland and return to Volog Sandwind in the Ironsand"
" Desert."
msgstr ""
"Trovare l'Antica Patria Troll e tornare da Volog Sandwind nel Deserto "
"Ferroso."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:72
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:71
msgctxt "quests"
msgid ""
"Find Blazen Stormlance and recover the spear Ebonest. Return to Leane "
"Stormlance in Garrote Gorge and deliver Ebonest to Charles Quixote."
msgstr ""
"Trovare Blazen Stormlance e recuperare la lancia Ebonest. Tornare da Leane "
"Stormlance, nella Gola della Garrotta, e consegnare Ebonest a Charles "
"Chisciotte."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:74
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:73
msgctxt "quests"
msgid ""
"Inquire about a cure for Blazen Stormlance from Dervish Chevron in "
"Ravenshore."
msgstr ""
"Rivolgersi a Dervish Chevron, a Lido dei Corvi, per ottenere una cura per "
"Blazen Stormlance."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:76
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:75
msgctxt "quests"
msgid ""
"Kill all Dragon Slayers and return the Sword of Whistlebone the Slayer to "
"Deftclaw Redreaver in Garrote Gorge."
msgstr ""
"Uccidere tutti gli Assassini di Draghi e riportare la Spada di Whistlebone "
"l'Assassino a Deftclaw Redreaver, nella Gola della Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:78
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:77
msgctxt "quests"
msgid ""
"Find the Axe of Balthazar, in the Dark Dwarf Mines.  Have the Axe "
"authenticated by Dadeross.  Return the axe to Tessalar, heir to the "
"leadership of the Minotaur Herd."
msgstr ""
"Trovare l'Ascia di Balthazar nelle Miniere dei Nani Scuri.  Chiedere a "
"Dadeross di autenticare l'Ascia e  portarla a Tessalar, erede al trono del "
"Branco dei Minotauri."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:80
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:79
msgctxt "quests"
msgid ""
"Find the Prophecies of the Sun in the Abandoned Temple  and take them to "
"Stephen."
msgstr ""
"Trovare le Profezie del Sole nel Tempio Abbandonato e riportarle a Stephen."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:82
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:81
msgctxt "quests"
msgid ""
"Find the Sarcophagus of Korbu and Korbu's Remains and return them to Lathean"
" in Shadowspire."
msgstr ""
"Trovare il Sarcofago di Korbu e i suoi resti e riportare tutto a Lathean, a "
"Punta Tenebrosa."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:84
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:83
msgctxt "quests"
msgid "Find the Lost Book of Khel and return it to Vertrinus in Shadowspire."
msgstr ""
"Trovare il Libro Perduto di Khel e riportarlo a Vertrinus, a Punta "
"Tenebrosa."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:87
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:86
msgctxt "quests"
msgid ""
"Find Dadeross, the Minotaur in charge of your merchant caravan. When you saw"
" him last, he was going to talk to the village clan leader."
msgstr ""
"Trovare Dadeross, il Minotauro che guida la carovana dei mercanti. L'ultima "
"volta stava andando a parlare con il capo del villaggio."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:93
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:92
msgctxt "quests"
msgid ""
"Consult the Ironfists' court sage, Xanthor about the Ravenshore crystal."
msgstr ""
"Chiedere informazioni sul Cristallo di Lido dei Corvi a Xanthor, il saggio "
"consigliere dei sovrani Pugno di Ferro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:103
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:102
msgctxt "quests"
msgid ""
"Deliver Cure Disease Scrolls to the six huts on the outer Dagger Wound "
"Islands.  Return to Aislen on Dagger Wound Island."
msgstr ""
"Consegnare le pergamene per curare le malattie agli abitanti delle sei "
"capanne delle Isole dei Pugnali minori.  Tornare da Aislen sull'isola "
"principale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:111
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:110
msgctxt "quests"
msgid ""
"Find and return an Anointed Potion to Languid in the Dagger Wound Islands."
msgstr ""
"Trovare la Pozione Consacrata e riportarla a Languid, sull'Isola dei "
"Pugnali."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:113
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:112
msgctxt "quests"
msgid ""
"Bring Hiss on the Dagger Wound Islands the Idol of the Snake from the "
"Abandoned Temple."
msgstr ""
"Trovare l'Idolo del Serpente dal Tempio Abbandonato e portarlo a Hiss, "
"sull'Isola dei Pugnali."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:115
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:114
msgctxt "quests"
msgid ""
"Bring Thistle on the Dagger Wound Islands the basic ingredients for a potion"
" of Pure Speed."
msgstr ""
"Trovare gli ingredienti di base per preparare la Pozione della Pura Velocità"
" e portarli a Thistle, sull'Isola dei Pugnali."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:117
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:116
msgctxt "quests"
msgid ""
"Bring Rihansi in Alvar the basic ingredients for a potion of Pure Luck."
msgstr ""
"Trovare gli ingredienti per preparare la Pozione della Pura Fortuna e "
"portarli a Rihasi, ad Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:119
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:118
msgctxt "quests"
msgid ""
"Deliver fake report to the Dread Pirate Stanley in the Pirate's Rest Tavern "
"on the Island of Regna."
msgstr ""
"Consegnare il falso rapporto su Stanley il Pirata Cattivo all'osteria Alcova"
" del Pirata, sull'isola di Regna."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:121
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:120
msgctxt "quests"
msgid "Rescue Arion Hunter's daughter from Ogre Fortress in Alvar."
msgstr ""
"Salvare la figlia di Arion il Cacciatore portandola via dalla Fortezza degli"
" Orchi di Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:123
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:122
msgctxt "quests"
msgid ""
"Bring Talion in the Ironsand Desert the basic ingredients for a potion of "
"Pure Endurance."
msgstr ""
"Trovare gli ingredienti per preparare la Pozione della Pura Resistenza "
"Fisica e portarli a Talion, nel Deserto Ferroso."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:125
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:124
msgctxt "quests"
msgid ""
"Bring Kelvin in Shadowspire the basic ingredients for a potion of Pure "
"Intellect."
msgstr ""
"Trovare gli ingredienti per preparare la Pozione della Pura Intelligenza e "
"portarli a Kelvin, a Punta Tenebrosa."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:127
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:126
msgctxt "quests"
msgid ""
"Bring Castigeir in Murmurwoods the basic ingredients for a potion of Pure "
"Personality."
msgstr ""
"Trovare gli ingredienti per preparare la Pozione della Pura Personalità e "
"portarli a Castigeir, nel Bosco dei Mormorii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:129
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:128
msgctxt "quests"
msgid "Recover the shield, Eclipse, for Lathius in Ravenshore."
msgstr "Recuperare lo scudo Eclisse per Lathius di Lido dei Corvi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:131
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:130
msgctxt "quests"
msgid ""
"Kill all Ogres in the Alvar canyon area and in Ogre Fortress and return to "
"Keldon in Alvar."
msgstr ""
"Uccidere tutti gli Orchi nella zona del canyon di Alvar e nella Fortezza "
"degli Orchi, quindi tornare da Keldon ad Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:134
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:133
msgctxt "quests"
msgid ""
"Bring Galvinus in Ravage Roaming the basic ingredients for a potion of Pure "
"Accuracy."
msgstr ""
"Trovare gli ingredienti per preparare la Pozione della Pura Accuratezza e "
"portarli a Galvinus, nella Landa della Razzia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:137
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:136
msgctxt "quests"
msgid "Find the Prophecies of the Snake for Pascella Tisk."
msgstr "Trovare le Profezie del Serpente per Pascella Tisk."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:139
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:138
msgctxt "quests"
msgid ""
"Find Isthric the Tongue, brother of Rohtnax.  Return to Rohtnax in the "
"village of Blood Drop on Dagger Wound Island."
msgstr ""
"Trovare Isthric Lingualunga, fratello di Rohtnax.  Tornare da Rohtnax nel "
"villaggio Goccia di Sangue, sull'Isola dei Pugnali."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:141
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:140
msgctxt "quests"
msgid "Kill all Dire Wolves in Ravenshore. Return to Maddigan in Ravenshore."
msgstr ""
"Uccidere tutti i Lupi Feroci di Lido dei Corvi. Tornare da Maddigan a Lido "
"dei Corvi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:144
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:143
msgctxt "quests"
msgid ""
"Deliver Fire Resistance Potions to the six southernmost houses of Rust.  "
"Return to Hobert in Rust."
msgstr ""
"Consegnare le Pozioni di Resistenza al Fuoco agli abitanti delle sei case "
"più a sud del villaggio di Ruggine.  Tornare da Hobert, a Ruggine."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:152
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:151
msgctxt "quests"
msgid "Find a Dragonbane Flower for Calindril in Garrote Gorge."
msgstr ""
"Trovare un Fiore del Veleno del Drago per Calindril, nella Gola della "
"Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:154
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:153
msgctxt "quests"
msgid ""
"Find a Dragonbane Flower for the Balion Tearwing in the Garrote Gorge Dragon"
" Caves."
msgstr ""
"Trovare un Fiore del Veleno del Drago per Balion Tearwing, nella Gola della "
"Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:155
msgctxt "quests"
msgid ""
"Kill all the Dragons in the Garrote Gorge wilderness area. Return to Avalon "
"in Garrote Gorge."
msgstr ""
"Uccidere tutti i Draghi nella zona della Gola della Garrotta. Tornare da "
"Avalon, nella Gola della Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:159
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:158
msgctxt "quests"
msgid ""
"Kill all the Dragon Hunter's in the Garrote Gorge wilderness area. Return to"
" Jerin Flame-eye in the Garrote Gorge Dragon Caves."
msgstr ""
"Uccidere tutti i Cacciatori di Draghi nella zona della Gola della Garrotta. "
"Tornare da Jerin Occhio di Fiamma, nelle Caverne del Drago della Gola della "
"Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:162
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:161
msgctxt "quests"
msgid ""
"Find the Legendary Drum of Victory. Return it to Zelim in Garrote Gorge."
msgstr ""
"Trovare il leggendario Tamburo della Vittoria. Riportarlo a Zelim nella Gola"
" della Garrotta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:164
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:163
msgctxt "quests"
msgid "Find Iseldir's Puzzle Box for Benefice of Shadowspire."
msgstr ""
"Trovare la Scatola degli Indovinelli di Iseldir per Benefice di Punta "
"Tenebrosa."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:166
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:165
msgctxt "quests"
msgid "Find a Vial of Grave Dirt. Return it to Halien in Shadowspire."
msgstr ""
"Trovare una Fiala di Terra di Sepolcro. Riportarla ad Halien, a Punta "
"Tenebrosa."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:168
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:167
msgctxt "quests"
msgid "Find the Bone of Doom for Tantilion of Shadowspire."
msgstr "Trovare l'Osso del Fato per Tantilion, di Punta Tenebrosa."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:174
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:173
msgctxt "quests"
msgid "Challenge the Arcomage Champion in each tavern of Jadame."
msgstr "Sfidare il Campione di Arcomage in tutte le osterie di Jadame."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:175
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:174
msgctxt "quests"
msgid ""
"Win a game of Arcomage in all eleven taverns, then return to Tonk Blueswan "
"in Ravenshore."
msgstr ""
"Vincere una partita di Arcomage in tutte le undici osterie, quindi tornare "
"da Tonk Blueswan a Lido dei Corvi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:178
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:177
msgctxt "quests"
msgid "Find a wheel of Frelandeau Cheese. Bring it to Asael Fromago in Alvar."
msgstr ""
"Trovare una forma di Fermigiano. Consegnarla ad Asael Fromago, ad Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:179
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:178
msgctxt "quests"
msgid "Find a log of Eldenbrie Cheese. Bring it to Asael Fromago in Alvar."
msgstr ""
"Trovare una fetta di Dondonzola. Consegnarla ad Asael Fromago, ad Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:180
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:179
msgctxt "quests"
msgid "Find a ball of Dunduck Cheese. Bring it to Asael Fromago in Alvar."
msgstr ""
"Trovare una treccia di Tonzarella. Consegnarla ad Asael Fromago, ad Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:238
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:237
msgctxt "quests"
msgid "Find the treasure of the Dread Pirate Stanley."
msgstr "Trovare il tesoro di Stanley, il Pirata Cattivo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:286
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:285
msgctxt "quests"
msgid ""
"Return to Fellmoon in Ravenshore and report your success in blackmailing the"
" wererat smuggler, Arion Hunter."
msgstr ""
"Tornare da Fellmoon, ad Alvar, e riferirgli che il suo ricatto nei confronti"
" del brigante Arion il Cacciatore è andato a buon fine."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:515
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:2
msgctxt "quests"
msgid "Return a red potion to the Judge on Emerald Island."
msgstr "Portare una pozione rossa al giudice sull'Isola di Smeraldo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:516
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:3
msgctxt "quests"
msgid "Return a seashell to the Judge on Emerald Island."
msgstr "Portare una conchiglia al giudice sull'Isola di Smeraldo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:517
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:4
msgctxt "quests"
msgid "Return a longbow to the Judge on Emerald Island."
msgstr "Portare un arco lungo al giudice sull'Isola di Smeraldo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:518
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:5
msgctxt "quests"
msgid "Return a floor tile to the Judge on Emerald Island."
msgstr "Portare una mattonella al giudice sull'Isola di Smeraldo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:519
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:6
msgctxt "quests"
msgid "Return a musical instrument to the Judge on Emerald Island."
msgstr "Portare uno strumento musicale al giudice sull'Isola di Smeraldo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:520
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:7
msgctxt "quests"
msgid "Return a wealthy hat to the Judge on Emerald Island."
msgstr "Portare un cappello elegante al giudice sull'Isola di Smeraldo."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:530
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:17
msgctxt "quests"
msgid ""
"Find the missing contestants on Emerald Island and bring back proof to Lord "
"Markham."
msgstr ""
"Trovare i partecipanti scomparsi sull'Isola di Smeraldo e portare una prova "
"a Lord Markham."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:532
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:19
msgctxt "quests"
msgid ""
"Go to Lord Markham's estate in Tatalia, steal the vase there, and return it "
"to William Lasker in the Erathian Sewers."
msgstr ""
"Entrare nella residenza di Lord Markham a Tatalia, rubare il vaso e portarlo"
" a William Lasker nelle fogne erathiane."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:533
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:20
msgctxt "quests"
msgid ""
"Go to Watchtower 6 in the Deyja Moors, and move the weight from the top of "
"the tower to the bottom of the tower.  Then return to William Lasker in the "
"Erathian Sewers."
msgstr ""
"Andare alla Torre di Guardia 6 nelle brughiere di Deyja, e spostare il peso "
"dalla cima alla base della torre. Tornare poi da William Lasker nelle fogne "
"dell'Erathia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:535
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:22
msgctxt "quests"
msgid ""
"Go to the Celestial Court in Celeste and kill Lady Eleanor Carmine.  Return "
"with proof to Seknit Undershadow in the Deyja Moors."
msgstr ""
"Andare alla Corte di Celeste e uccidere Lady Eleanor Carminia. Tornare con "
"una prova da Seknit Undershadow nelle brughiere di Deyja."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:536
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:23
msgctxt "quests"
msgid ""
"Kill Wromthrax the Heartless in his cave in Tatalia, then talk to Sir "
"Charles Quixote."
msgstr ""
"Uccidere Wromthrax il Senza Cuore nella sua caverna a Tatalia e riferire poi"
" a Sir Charles Quixote."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:538
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:25
msgctxt "quests"
msgid ""
"Rescue Alice Hargreaves from William's Tower in the Deyja Moors then talk to"
" Sir Charles Quixote."
msgstr ""
"Recuperare Alice Hargreaves dalla torre di William nelle brughiere di Deyja "
"e fare rapporto a Sir Charles Quixote."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:540
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:27
msgctxt "quests"
msgid ""
"Capture Alice Hargreaves from her residence in Castle Gryphonheart and "
"return her to William's Tower in the Deyja Moors."
msgstr ""
"Rapire Alice Hargreaves dalla sua residenza nel Castello Cuor di Grifone e "
"portarla alla torre di William nelle brughiere di Deyja."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:541
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:28
msgctxt "quests"
msgid "Find the lost meditation spot in the Dwarven Barrows."
msgstr "Trovare il punto di meditazione perduto nei tumuli dei Nani."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:542
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:29
msgctxt "quests"
msgid ""
"Go to the Temple of Baa in Avlee and kill the High Priest of Baa, then "
"return to Bartholomew Hume in Harmondale."
msgstr ""
"Andare al Tempio di Baa ad Avlee, uccidere il Gran Sacerdote di Baa e "
"tornare da Bartholomew Hume a Vallechiara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:543
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:30
msgctxt "quests"
msgid ""
"Crack the code in the School of Sorcery in the Bracada Desert to reveal the "
"location of the Tomb of Ashwar Nog'Nogoth.  Discover the tomb's location, "
"enter it, and then return it to Stephan Sand in the Pit."
msgstr ""
"Violare il codice della Scuola di Magia nel deserto di Bracada per rivelare "
"la posizione della tomba di Ashwar Nog'Nogoth. Trovare la tomba, entrare e "
"tornare da Stephan Sand nel Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:544
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:31
msgctxt "quests"
msgid ""
"Retrieve the Perfect Bow from the Titans' Stronghold in Avlee and return it "
"to Lawrence Mark in Harmondale."
msgstr ""
"Recuperare l'Arco Perfetto dalla roccaforte dei titani di Avlee e portarlo a"
" Lawrence Mark a Vallechiara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:545
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:32
msgctxt "quests"
msgid ""
"Sabotage the lift in the Red Dwarf Mines in the Bracada Desert then return "
"to Steagal Snick in Avlee."
msgstr ""
"Sabotare il montacarichi delle Miniere del Nano Rosso nel deserto di Bracada"
" e tornare da Steagal Snick ad Avlee."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:546
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:33
msgctxt "quests"
msgid ""
"Retrieve the Perfect Bow from the Titans' Stronghold in Avlee and return it "
"to Steagal Snick in Avlee."
msgstr ""
"Recuperare l'Arco Perfetto dalla roccaforte dei titani di Avlee e portarlo a"
" Steagal Snick ad Avlee."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:547
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:34
msgctxt "quests"
msgid ""
"Win five arena challenges then return to Leda Rowan in the Bracada Desert."
msgstr ""
"Vincere cinque duelli nell'arena e tornare da Leda Rowan nel deserto di "
"Bracada."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:548
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:35
msgctxt "quests"
msgid ""
"Destroy all the undead in the Haunted House in the Barrow Downs and return "
"to Frederick Org in Erathia."
msgstr ""
"Distruggere tutti i non-morti della casa stregata nei Colli Rocciosi e "
"tornare da Frederick Org in Erathia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:549
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:36
msgctxt "quests"
msgid ""
"Raid the Elven Treasury at Castle Navan in the Tularean Forest and return to"
" Frederick Org in Erathia."
msgstr ""
"Saccheggiare la tesoreria degli Elfi al Castello di Rugiada nella foresta di"
" Tular e tornare in Erathia da Frederick Org."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:550
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:37
msgctxt "quests"
msgid ""
"Calm the trees in the Tularean Forest by speaking to the Oldest Tree then "
"return to Lysander Sweet in the Bracada Desert."
msgstr ""
"Calmare gli alberi della foresta di Tular parlando con l'albero anziano e "
"tornare poi da Lysander Sweet nel deserto di Bracada."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:551
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:38
msgctxt "quests"
msgid ""
"Solve the secret to the entrance of the Faerie Mound in Avlee and speak to "
"the Faerie King."
msgstr ""
"Risolvere il segreto dell'ingresso al Colle delle Fate ad Avlee e parlare "
"col Re delle Fate."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:552
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:39
msgctxt "quests"
msgid ""
"Collect 10,000 gold worth of bounties from the Bounty Hunts in the town "
"halls, then return to Ebednezer Sower in the Tularean Forest."
msgstr ""
"Raccogliere 10.000 monete d'oro in taglie nei vari municipi, e tornare da "
"Ebednezer Sower nella foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:553
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:40
msgctxt "quests"
msgid ""
"Find the Heart of the Forest in the Mercenary Guild in Tatalia and return it"
" to the Oldest Tree in the Tularean Forest."
msgstr ""
"Trovare il Cuore dalla Foresta nella Gilda dei Mercenari di Tatalia e "
"riportarlo all'albero anziano della foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:556
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:43
msgctxt "quests"
msgid ""
"Purify the Altar of Evil in the Temple of the Moon on Evenmorn Isle then "
"return to Rebecca Devine in Celeste."
msgstr ""
"Purificare l'Altare del Male nel Tempio della Luna dell'Isola di Smeraldo e "
"tornare da Rebecca Devine a Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:557
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:44
msgctxt "quests"
msgid ""
"Find the lost pirate map in the Tidewater Caverns in Tatalia and return to "
"Daedalus Falk in the Deyja Moors."
msgstr ""
"Trovare la mappa perduta dei pirati nelle Caverne di Acquabassa di Tatalia e"
" tornare da Daedalus Falk nelle brughiere di Deyja."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:558
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:45
msgctxt "quests"
msgid ""
"Deface the Altar of Good in the Temple of the Sun on Evenmorn Isle then "
"return to Daedalus Falk in the Deyja Moors."
msgstr ""
"Profanare l'Altare del Bene nel Tempio del Sole sull'Isola delle Nebbie e "
"tornare da Daedalus Falk nelle brughiere di Deyja."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:559
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:46
msgctxt "quests"
msgid ""
"Collect the six golem pieces and construct a complete golem, then return to "
"Thomas Grey in the School of Sorcery."
msgstr ""
"Costruire un golem completo recuperando i sei pezzi, e tornare poi da Thomas"
" Grey alla Scuola di Magia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:561
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:48
msgctxt "quests"
msgid ""
"Find the Book of Divine Intervention in the Breeding Zone in the Pit and "
"return it to Thomas Grey in the School of Sorcery."
msgstr ""
"Trovare il libro dell'Intervento Divino nella Zona di Allevamento del "
"Baratro e portarlo a Thomas Grey alla Scuola di Magia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:562
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:49
msgctxt "quests"
msgid ""
"Retrieve the lich jars from the Proving Grounds in Celeste and bring them "
"back to Halfgild Wynac in the Pit."
msgstr ""
"Recuperare le urne dei lich dai Muri di Nebbia di Celeste e restituirle ad "
"Halfgild Wynac al Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:563
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:50
msgctxt "quests"
msgid ""
"Visit the three stonehenge monoliths in Tatalia, the Evenmorn Islands, and "
"Avlee, then return to Anthony Green in the Tularean Forest."
msgstr ""
"Visitare i tre monoliti di Tatalia, Isola di Smeraldo e Avlee, e tornare da "
"Anthony Green nella foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:568
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:55
msgctxt "quests"
msgid ""
"Retrieve the bones of the Dwarf King from the tunnels between Stone City and"
" Nighon and place them in their proper resting place in the Barrow Downs, "
"then return to Anthony Green in the Tularean Forest."
msgstr ""
"Recuperare le ossa del Re dei Nani dalle gallerie tra la Città di Pietra e "
"Nighon e riportarle nel giusto sarcofago nei Colli Rocciosi. Tornare poi da "
"Anthony Green nella foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:569
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:56
msgctxt "quests"
msgid ""
"Retrieve the dragon egg from the Dragon Cave in the Land of the Giants and "
"return it to Tor Anwyn in Mount Nighon."
msgstr ""
"Recuperare l'uovo di drago in una delle caverne della terra dei Giganti e "
"riportarlo a Tor Anwyn di Monte Nighon."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:589
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:76
msgctxt "quests"
msgid ""
"Clean out Castle Harmondale and return to the Butler in the tavern, On the "
"House, in Harmondale."
msgstr ""
"Liberare il Castello di Vallechiara e tornare da Butler nella taverna Come a"
" Casa di Vallechiara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:590
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:77
msgctxt "quests"
msgid ""
"Rescue the dwarves from the Red Dwarf Mines and return to the Dwarf King in "
"Stone City in the Barrow Downs."
msgstr ""
"Salvare i nani dalla Miniera del Nano Rosso e tornare dal Re dei Nani nella "
"Città di Pietra dei Colli Rocciosi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:591
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:78
msgctxt "quests"
msgid ""
"Retrieve plans from Fort Riverstride and return them to Eldrich Parson in "
"Castle Navan in the Tularean Forest."
msgstr ""
"Recuperare i piani da Forte Guardafiume e portarli a Eldrich Parson nel "
"Castello di Rugiada della foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:592
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:79
msgctxt "quests"
msgid ""
"Rescue Loren Steel from the Tularean Caves in the Tularean Forest and return"
" him to Queen Catherine."
msgstr ""
"Salvare Loren Steel dalle Caverne di Tular nella foresta omonima e "
"riportarlo dalla regina Caterina."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:593
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:80
msgctxt "quests"
msgid ""
"Retrieve Gryphonheart's Trumpet from the battle in the Tularean Forest and "
"return it to whichever side you choose."
msgstr ""
"Recuperare la tromba da battaglia di Cuor di Grifone dalla foresta di Tular "
"e restituirla qualunque sia la fazione scelta."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:608
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:95
msgctxt "quests"
msgid ""
"Give false Riverstride plans to Eldrich Parson in Castle Navan in the "
"Tularean Forest."
msgstr ""
"Consegnare i finti piani di Forte Guardafiume a Eldrich Parson al Castello "
"di Rugiada della foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:609
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:96
msgctxt "quests"
msgid ""
"Return the Loren imposter to Queen Catherine in Castle Gryphonheart in "
"Erathia."
msgstr ""
"Consegnare il falso Loren alla regina Caterina nel Castello Cuor di Grifone "
"in Erathia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:615
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:102
msgctxt "quests"
msgid ""
"Complete the Walls of Mist without killing a single opponent and return to "
"Gavin Magnus in Castle Lambent in Celeste."
msgstr ""
"Completare i Muri di Nebbia senza uccidere un solo avversario e tornare da "
"Gavin Magnus al Castello Splendente di Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:617
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:104
msgctxt "quests"
msgid ""
"Retrieve the altar piece from the Temple of Light in Celeste and the Temple "
"of Dark in the Pit and return them to Resurectra in Castle Lambent in "
"Celeste."
msgstr ""
"Recuperare i pezzi dell'altare dal Tempio della Luce di Celeste e dal Tempio"
" del Buio al Baratro e consegnarli a Resurectra nel Castello Splendente a "
"Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:618
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:105
msgctxt "quests"
msgid ""
"Go to Colony Zod in the Land of the Giants and slay Xenofex then return to "
"Resurectra in Castle Lambent in Celeste."
msgstr ""
"Andare alla Colonia Zod nella Terra dei Giganti, uccidere Xenofex e tornare "
"da Resurectra al Castello Splendente di Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:620
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:107
msgctxt "quests"
msgid ""
"Investigate the Wine Cellar in Tatalia and return to Crag Hack in Castle "
"Lambent in Celeste."
msgstr ""
"Esaminare la cantina di Tatalia e tornare da Crag Hack nel Castello "
"Splendente di Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:622
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:109
msgctxt "quests"
msgid ""
"Retrieve the Case of Soul Jars from Castle Gloaming in the Pit and return to"
" Sir Caneghem in Celeste."
msgstr ""
"Recuperare la cassa delle urne spirituali dal Castello del Crepuscolo nel "
"Baratro e tornare a Celeste da Sir Caneghem."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:623
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:110
msgctxt "quests"
msgid ""
"Assassinate Tolberti in his house in the Pit and return his control cube to "
"Robert the Wise in Celeste."
msgstr ""
"Assassinare Tolberti nella sua abitazione al Baratro e riportare il suo cubo"
" di controllo a Robert il Saggio a Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:636
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:123
msgctxt "quests"
msgid ""
"Retrieve the altar piece from the Temple of Light in Celeste and the Temple "
"of Dark in the Pit and return them to Kastore in the Pit."
msgstr ""
"Recuperare i pezzi dell'altare dal Tempio della Luce di Celeste e dal Tempio"
" del Buio del Baratro e consegnarli a Kastore al Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:637
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:124
msgctxt "quests"
msgid ""
"Go to Colony Zod in the Land of the Giants and slay Xenofex then return to "
"Kastore in the Pit."
msgstr ""
"Andare alla Colonia Zod nella Terra dei Giganti, uccidere Xenofex e tornare "
"da Kastore al Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:638
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:125
msgctxt "quests"
msgid ""
"Retrieve the Case of Soul Jars from the Warlocks in Thunderfist Mountain and"
" bring them to Maximus in the Pit."
msgstr ""
"Recuperare la cassa delle giare spirituali dagli Stregoni di Monte Pugno di "
"Tuono e portarla da Maximus al Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:639
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:126
msgctxt "quests"
msgid ""
"Destroy the magical defenses inside Clanker's Laboratory and return to Dark "
"Shade in the Pit."
msgstr ""
"Distruggere le difese magiche del laboratorio di Clanker e tornare da Dark "
"Shade nel Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:641
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:128
msgctxt "quests"
msgid ""
"Assassinate Robert the Wise in his house in Celeste and return to Tolberti "
"in the Pit."
msgstr ""
"Assassinare Robert il Saggio nella sua abitazione di Celeste e portare il "
"suo cubo di controllo a Tolberti nel Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:642
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:129
msgctxt "quests"
msgid "Complete the Breeding Zone and return to Archibald in the Pit."
msgstr ""
"Completare la prova della la Fossa d' Allevamento e tornare da Arcibaldo al "
"Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:644
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:131
msgctxt "quests"
msgid ""
"Go to the Lincoln in the sea west of Avlee and retrieve the Oscillation "
"Overthruster and return it to Resurectra in Celeste."
msgstr ""
"Entrare nella Lincoln nel mare a ovest di Avlee, recuperare l'oscillatore "
"dimensionale e portarlo da Resurectra a Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:645
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:132
msgctxt "quests"
msgid ""
"Go to the Lincoln in the sea west of Avlee and retrieve the Oscillation "
"Overthruster and return it to Kastore in the Pit."
msgstr ""
"Entrare nella Lincoln nel mare a ovest di Avlee, recuperare Oscillation "
"Overthruster e portarlo da Kastore al Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:660
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:147
msgctxt "quests"
msgid ""
"Talk to the Dwarves in Stone City in the Barrow Downs to find a way to "
"repair Castle Harmondale."
msgstr ""
"Parlare ai Nani della Città di Pietra dei Colli Rocciosi per trovare il modo"
" di ristrutturare il Castello di Vallechiara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:665
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:152
msgctxt "quests"
msgid ""
"Enter the Pit from the Hall of the Pit in the Deyja Moors, then talk to "
"Archibald in Castle Gloaming in the Pit."
msgstr ""
"Entrare nell'Atrio del Baratro nelle brughiere di Deyja, e poi parlare con "
"Arcibaldo al Castello del Crepuscolo nel Baratro."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:666
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:153
msgctxt "quests"
msgid ""
"Enter Celeste from the grand teleporter in the Bracada Desert, then talk to "
"Gavin Magnus in Castle Lambent in Celeste."
msgstr ""
"Raggiungere Celeste col grande teletrasporto del deserto di Bracada, e "
"parlare con Magnus nel Castello Splendente."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:667
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:154
msgctxt "quests"
msgid "Choose a judge to succeed Judge Grey as Arbiter in Harmondale."
msgstr "Scegliere il successore del giudice Grey come Arbitro di Vallechiara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:669
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:156
msgctxt "quests"
msgid ""
"Retrieve the Lantern of Light from the Barrow Downs and return it to Tarin "
"Withern in Harmondale."
msgstr ""
"Recuperare la Lanterna della Luce dai Colli Rocciosi e restituirla a Tarin "
"Withern di Vallechiara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:670
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:157
msgctxt "quests"
msgid ""
"Retrieve Haldar's Remains from the Maze in Nighon and return them to Mazim "
"Dusk in Nighon."
msgstr ""
"Recuperare le spoglie di Haldar dal labirinto di Nighon e riportarle a Mazim"
" Dusk di Nighon."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:671
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:158
msgctxt "quests"
msgid ""
"Retrieve Davrik's Signet ring from the Bandit Caves in the northeast of "
"Erathia and return it to Davrik Peladium in Harmondale."
msgstr ""
"Recuperare l'anello con sigillo dalle caverne dei banditi a nord est "
"dell'Erathia e restituirlo a Davrik Peladium di Vallechiara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:672
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:159
msgctxt "quests"
msgid ""
"Take Sealed Letter to Lord Markham in Lord Markham's Manor in Tatalia for "
"collector Norbert Thrush."
msgstr ""
"Portare la lettera del collezionista Norbert Thrush a Lord Markham nel suo "
"maniero di Tatalia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:673
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:160
msgctxt "quests"
msgid "Return Parson's Quill to Norbert Thrush in Erathia."
msgstr "Riportare il calamo di Parson a Norbert Thrush in Erathia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:693
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:180
msgctxt "quests"
msgid ""
"Take the sealed letter to the Faerie King in the Hall under the Hill in "
"Avlee."
msgstr ""
"Portare la lettera sigillata al Re delle Fate nella Sala sotto il Colle di "
"Avlee."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:694
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:181
msgctxt "quests"
msgid "Take the Faerie Pipes to Johann Kerrid in the Tularean Forest."
msgstr "Portare il flauto fatato a Johann Kerrid della foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:695
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:182
msgctxt "quests"
msgid ""
"Go to the Mercenary Guild in Tatalia and talk to Niles Stantley within two "
"weeks."
msgstr ""
"Andare alla Gilda dei Mercenari di Tatalia e contattare Niles Stantley entro"
" due settimane."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:696
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:183
msgctxt "quests"
msgid ""
"Steal the Tapestry from your associate's Castle and return it to Niles "
"Stantley in the Mercenary Guild in Tatalia."
msgstr ""
"Rubare l'arazzo dal castello del vostro associato e portarlo a Niles "
"Stantley presso la Gilda dei Mercenari di Tatalia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:700
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:187
msgctxt "quests"
msgid ""
"Kill all the Troglodytes underneath Stone City and return to Spark "
"Burnkindle in Stone City."
msgstr ""
"Uccidere tutti i trogloditi sotto la Città di Pietra e tornare da Spark "
"Burnkindle alla Città di Pietra."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:701
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:188
msgctxt "quests"
msgid ""
"Kill all the Griffins in Erathia and the Bracada Desert and return to Seth "
"Drakkson in the Deyja Moors."
msgstr ""
"Uccidere tutti i grifoni dell'Erathia e del deserto di Bracada e tornare da "
"Seth Drakkson nelle brughiere di Deyja."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:708
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:195
msgctxt "quests"
msgid ""
"Find the fate of Darron's brother in the White Cliff Caves, then return to "
"Darron Temper in Harmondale."
msgstr ""
"Scoprire che fine ha fatto il fratello di Darron nelle caverne delle Cime "
"Bianche a sud di Vallechiara e tornare da Darron Temper."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:709
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:196
msgctxt "quests"
msgid ""
"Retrieve the Seasons' Stole from the Hall of the Pit and return it to Gary "
"Zimm in the Bracada Desert."
msgstr ""
"Recuperare la Stola delle Stagioni dall'Atrio del Baratro e restituirla a "
"Gary Zimm nel deserto di Bracada."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:714
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:201
msgctxt "quests"
msgid ""
"Retrieve the three statuettes and place them on the shrines in the Bracada "
"Desert, Tatalia, and Avlee, then return to Thom Lumbra in the Tularean "
"Forest."
msgstr ""
"Recuperare le tre statuine e collocarle nei santuari del deserto di Bracada,"
" di Tatalia e di Avlee, e tornare da Thom Lumbra alla foresta di Tular."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:718
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:205
msgctxt "quests"
msgid ""
"Retrieve the three paintings and return them to Ferdinand Visconti in "
"Tatalia."
msgstr ""
"Recuperare i tre dipinti e riportarli a Ferdinand Visconti di Tatalia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:719
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:206
msgctxt "quests"
msgid ""
"Win a game of Arcomage in all thirteen taverns, then return to Gina Barnes "
"in Erathia."
msgstr ""
"Vincere una partita di ArcoMago in tutte le tredici taverne, e tornare da "
"Gina Barnes in Erathia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:759
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:246
msgctxt "quests"
msgid "Congratulations"
msgstr "Congratulazioni"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1107
#: mm6/data/10LocLANG.icons/Quests.txt.py:82
msgctxt "quests"
msgid "Show Sulman's letter to Andover Potbello in New Sorpigal."
msgstr "Mostrare la lettera di Sulman ad Andover Potbello a Nuova Sorpigal."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1108
#: mm6/data/10LocLANG.icons/Quests.txt.py:83
msgctxt "quests"
msgid "Bring Sulman's letter to Regent Wilbur Humphrey at Castle Ironfist."
msgstr ""
"Portare la lettera di Sulman al Reggente Wilbur Humphrey al Castello di "
"Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1109
#: mm6/data/10LocLANG.icons/Quests.txt.py:84
msgctxt "quests"
msgid ""
"Find the Combination to the vault door in Goblinwatch and return to the Town"
" Hall in New Sorpigal."
msgstr ""
"Trovare la combinazione per la porta sotterranea di Forte Goblin e tornare "
"al Municipio di Nuova Sorpigal."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1110
#: mm6/data/10LocLANG.icons/Quests.txt.py:85
msgctxt "quests"
msgid ""
"Get the Chime of Harmony from the Temple of Baa and return to the New "
"Sorpigal Town Hall."
msgstr ""
"Distruggere l'Altare del Male del Tempio di Baa e tornare al Municipio di "
"Nuova Sorpigal con le Campanelle dell'Armonia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1112
#: mm6/data/10LocLANG.icons/Quests.txt.py:87
msgctxt "quests"
msgid ""
"Find Lord Kilburn's Shield and return to Wilbur Humphrey in Castle Ironfist "
"to report."
msgstr ""
"Trovare lo scudo di Lord Kilburn e tornare a riferire a Wilbur Humphrey al "
"Castello di Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1114
#: mm6/data/10LocLANG.icons/Quests.txt.py:89
msgctxt "quests"
msgid ""
"Rescue a Damsel in Distress and return with her to Wilbur Humphrey in Castle"
" Ironfist."
msgstr ""
"Salvare una Damigella in pericolo e portarla da Wilbur Humphrey al Castello "
"di Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1115
#: mm6/data/10LocLANG.icons/Quests.txt.py:90
msgctxt "quests"
msgid ""
"Slay Longfang Witherhide in his cave near Castle Darkmoor and return to "
"Wilbur Humphrey in Castle Ironfist."
msgstr ""
"Uccidere Longfang Witherhide nella sua caverna vicina al Castello di "
"Darkmoor e tornare da Wilbur Humphrey al Castello di Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1116
#: mm6/data/10LocLANG.icons/Quests.txt.py:91
msgctxt "quests"
msgid "Entertain Nicolai."
msgstr "Far divertire Nicolai."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1121
#: mm6/data/10LocLANG.icons/Quests.txt.py:96
msgctxt "quests"
msgid "Find and return Prince Nicolai to Castle Ironfist."
msgstr "Trovare e riportare il Principe Nicolai al Castello di Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1122
#: mm6/data/10LocLANG.icons/Quests.txt.py:97
msgctxt "quests"
msgid "Find the Third Eye and bring it to Prince Nicolai in Castle Ironfist."
msgstr ""
"Trovare il Terzo Occhio e consegnarlo al Principe Nicolai al Castello di "
"Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1124
#: mm6/data/10LocLANG.icons/Quests.txt.py:99
msgctxt "quests"
msgid ""
"Capture the Prince of Thieves and bring him to Lord Anthony Stone at Castle "
"Stone."
msgstr ""
"Catturare il Principe dei Ladri e portarlo da Lord Anthony al Castello di "
"Stone."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1131
#: mm6/data/10LocLANG.icons/Quests.txt.py:106
msgctxt "quests"
msgid ""
"Hire a Stonecutter and a Carpenter, bring them to Temple Stone in Free Haven"
" to repair the Temple, and then return to Lord Anthony Stone at Castle "
"Stone."
msgstr ""
"Assoldare un tagliapietra e un carpentiere, portarli al Tempio di Stone a "
"Free Haven per farlo riparare e tornare da Lord Anthony al Castello di "
"Stone."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1133
#: mm6/data/10LocLANG.icons/Quests.txt.py:108
msgctxt "quests"
msgid ""
"Take the Sacred Chalice from the monks in their island temple east of Free "
"Haven, return it to Temple Stone in Free Haven, and then return to Lord "
"Stone at Castle Stone."
msgstr ""
"Prendere il Calice Sacro ai monaci del tempio sull'isola a est di Free "
"Haven, riportarlo al Tempio di Stone a Free Haven e tornare da Lord Antony "
"al Castello di Stone."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1136
#: mm6/data/10LocLANG.icons/Quests.txt.py:111
msgctxt "quests"
msgid "Find and return the Hourglass of Time to Lord Albert Newton in Mist."
msgstr ""
"Trovare e riportare la Clessidra del tempo a Lord Albert Newton di Mist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1137
#: mm6/data/10LocLANG.icons/Quests.txt.py:112
msgctxt "quests"
msgid ""
"Drink from the Fountain of Magic and return to Lord Albert Newton in Mist."
msgstr ""
"Bere dalla Fontana della Magia e tornare da Lord Albert Newton di Mist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1138
#: mm6/data/10LocLANG.icons/Quests.txt.py:113
msgctxt "quests"
msgid ""
"Retrieve the Crystal of Terrax and return to Lord Albert Newton in Mist."
msgstr ""
"Recuperare il Cristallo di Terrax e riportarlo a Lord Albert Newton di Mist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1139
#: mm6/data/10LocLANG.icons/Quests.txt.py:114
msgctxt "quests"
msgid ""
"Destroy the Devil's Outpost and return to Lord Osric Temper at Castle "
"Temper."
msgstr ""
"Distruggere l'Avamposto dei Demoni e tornare da Lord Osric al Castello di "
"Temper."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1140
#: mm6/data/10LocLANG.icons/Quests.txt.py:115
msgctxt "quests"
msgid ""
"Get Knight's nomination from Chadwick and return to Lord Osric Temper at "
"Castle Temper."
msgstr ""
"Ottenere la referenza di Cavaliere da Chadwick e tornare da Lord Osric al "
"Castello di Temper."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1141
#: mm6/data/10LocLANG.icons/Quests.txt.py:116
msgctxt "quests"
msgid "Defeat the Warlord and bring proof to Osric Temper"
msgstr ""
"Sconfiggere il Signore della Guerra e fornirne la prova a Osric Temper."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1142
#: mm6/data/10LocLANG.icons/Quests.txt.py:117
msgctxt "quests"
msgid ""
"Fix the prices of all 9 stables in the Kingdom and return to Lady Fleise in "
"Silver Cove."
msgstr ""
"Modificare i prezzi delle 9 stalle del regno e tornare da Lady Fleise a "
"Silver Cove."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1144
#: mm6/data/10LocLANG.icons/Quests.txt.py:119
msgctxt "quests"
msgid ""
"Visit the Altar of the Sun in the circle of stones north of Silver Cove on "
"an equinox or solstice (HINT:  March 20th is an equinox)."
msgstr ""
"Visitare l'Altare del Sole nel cerchio di pietre a nord di Silver Cove "
"durante un equinozio o un solstizio (NB: il 20 Marzo è un equinozio)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1145
#: mm6/data/10LocLANG.icons/Quests.txt.py:120
msgctxt "quests"
msgid ""
"Visit the Altar of the Moon in the Temple of the Moon at midnight of a full "
"moon."
msgstr ""
"Visitare l'Altare della Luna nel Tempio della Luna a mezzanotte e con la "
"luna piena."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1146
#: mm6/data/10LocLANG.icons/Quests.txt.py:121
msgctxt "quests"
msgid ""
"End winter for Lord Stromgard at Castle Stromgard, and return to him with "
"the good news."
msgstr ""
"Far terminare l'inverno e tornare da Lord Stormgard con la buona notizia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1147
#: mm6/data/10LocLANG.icons/Quests.txt.py:122
msgctxt "quests"
msgid ""
"Retrieve the key to the Dragon Towers from Icewind Keep south of Whitecap, "
"and bring it to Lord Stromgard at Castle Stromgard."
msgstr ""
"Recuperare le chiavi delle Torri dei Draghi da Forte Ventoso a sud di White "
"Cap e riportarle a Lord Stromgard al Castello di Stromgard."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1148
#: mm6/data/10LocLANG.icons/Quests.txt.py:123
msgctxt "quests"
msgid ""
"Reset all of the Dragon Towers at each town and return to Lord Stromgard in "
"Castle Stromgard."
msgstr ""
"Modificare le Torri dei Draghi di tutte le città e tornare da Lord Stromgard"
" al Castello di Stromgard."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1150
#: mm6/data/10LocLANG.icons/Quests.txt.py:125
msgctxt "quests"
msgid ""
"Kill Snergle in Snergle's Caverns and return with his axe to Avinril "
"Smythers at The Haunt tavern in the Mire of the Damned."
msgstr ""
"Uccidere Snergle nelle sue caverne e tornare con la sua ascia da Avinril "
"Smythers alla taverna nella Palude dei Dannati."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1151
#: mm6/data/10LocLANG.icons/Quests.txt.py:126
msgctxt "quests"
msgid ""
"Storm the Silver Helm Outpost near Mist and return with evidence of their "
"corruption to the Constable of Mist."
msgstr ""
"Attaccare l'Avamposto degli Elmi d'Argento nei pressi di Mist e tornare con "
"le prove della loro corruzione al Municipio della città."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1152
#: mm6/data/10LocLANG.icons/Quests.txt.py:127
msgctxt "quests"
msgid ""
"Retrieve the candelabra from the Abandoned Temple for Andover Potbello in "
"New Sorpigal."
msgstr ""
"Recuperare il candelabro di Andover Potbello dal Tempio Abbandonato vicino a"
" Nuova Sorpigal."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1154
#: mm6/data/10LocLANG.icons/Quests.txt.py:129
msgctxt "quests"
msgid ""
"Retrieve the harp from the Dragoon's Caverns south of Castle Ironfist and "
"return it to Andrew Besper in Castle Ironfist."
msgstr ""
"Recuperare l'arpa dalle Caverne dei Dragoni a sud del castello di Ironfist e"
" riportarla ad Andrew Besper a Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1155
#: mm6/data/10LocLANG.icons/Quests.txt.py:130
msgctxt "quests"
msgid ""
"Retrieve Ethric's skull from his tomb west of Free Haven for Gabriel Cartman"
" in Free Haven."
msgstr ""
"Recuperare il teschio di Ethric dalla sua tomba a ovest di Free Haven per "
"Gabriel Cartman di Free Haven."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1156
#: mm6/data/10LocLANG.icons/Quests.txt.py:131
msgctxt "quests"
msgid ""
"Kill the Queen of the Spiders in the Abandoned Temple in New Sorpigal and "
"return with her heart to Buford T. Allman in New Sorpigal."
msgstr ""
"Uccidere la Regina dei Ragni nel Tempio Abbandonato vicino a Nuova Sorpigal "
"e riportarne il cuore a Buford T. Allman di Nuova Sorpigal."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1157
#: mm6/data/10LocLANG.icons/Quests.txt.py:132
msgctxt "quests"
msgid ""
"Deface the altar in the Monolith west of Silver Cove and return to Eleanor "
"Vanderbilt in Silver Cove."
msgstr ""
"Sfigurare l'altare del Monolito a ovest di Silver Cove e tornare da Eleanor "
"Vanderbilt di Silver Cove."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1160
#: mm6/data/10LocLANG.icons/Quests.txt.py:135
msgctxt "quests"
msgid ""
"Destroy the crystal in the Temple of the Fist and return to Winston Schezar "
"in Bootleg Bay."
msgstr ""
"Distruggere il cristallo del Tempio del Pugno e tornare da Winston Schezar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1162
#: mm6/data/10LocLANG.icons/Quests.txt.py:137
msgctxt "quests"
msgid ""
"Rescue Emmanuel from the Temple of the Snake near Blackshire and return him "
"to Joanne Cravitz in Blackshire."
msgstr ""
"Recuperare Emmanuel Cravitz dal Tempio del Serpente vicino a Blackshire e "
"riportarlo da sua moglie Joanne a Blackshire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1163
#: mm6/data/10LocLANG.icons/Quests.txt.py:138
msgctxt "quests"
msgid ""
"Find the lost artifact in the Dragoons' Keep near Castle Temper and return "
"it to Zoltan Phelps in Free Haven."
msgstr ""
"Trovare Il manufatto perduto alla Fortezza dei Dragoni vicino al Castello di"
" Temper e riportarlo a Zoltan Phelps di Free Haven."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1164
#: mm6/data/10LocLANG.icons/Quests.txt.py:139
msgctxt "quests"
msgid ""
"Rescue Sharry from the Shadow Guild Hideout and return with her to Frank "
"Fairchild in New Sorpigal."
msgstr ""
"Salvare Sharry dal Covo della Gilda dell'Ombra e riportarla da Frank "
"Fairchild di Nuova Sorpigal."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1165
#: mm6/data/10LocLANG.icons/Quests.txt.py:140
msgctxt "quests"
msgid ""
"Rescue Angela from the Abandoned Temple and return her to Violet Dawson in "
"New Sorpigal."
msgstr ""
"Recuperare Angela dal Tempio Abbandonato e riportarla da Violet Dawson di "
"Nuova Sorpigal."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1166
#: mm6/data/10LocLANG.icons/Quests.txt.py:141
msgctxt "quests"
msgid ""
"Rescue Sherell from the cannibals on the islands east of Free Haven and "
"return with her to Carlo Tormini in Free Haven."
msgstr ""
"Salvare Sherell dai cannibali delle isole orientali di Free Haven e "
"riportarla da Carlo Tormini a Free Haven."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1167
#: mm6/data/10LocLANG.icons/Quests.txt.py:142
msgctxt "quests"
msgid ""
"Destroy the Werewolf's altar in the Lair of the Wolf and return to Maria "
"Trepan in Blackshire."
msgstr ""
"Distruggere l'Altare dei Licantropi nella Tana del Lupo e tornare da Maria "
"Trepan in Blackshire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1169
#: mm6/data/10LocLANG.icons/Quests.txt.py:144
msgctxt "quests"
msgid ""
"Find the Pearl of Putrescence in the Lair of the Wolf and bring it to the "
"Ghost of Balthasar, also in the Lair of the Wolf."
msgstr ""
"Trovare la Perla della Putredine nella Tana del Lupo e riportarla al "
"fantasma di Balthasar, sempre al suo interno."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1170
#: mm6/data/10LocLANG.icons/Quests.txt.py:145
msgctxt "quests"
msgid ""
"Retrieve the jewelled egg from Castle Kriegspire and return it to Emil Lime "
"in Kriegspire village."
msgstr ""
"Recuperare l'uovo ingioiellato dal Castello di Kriegspire e riportarlo a "
"Emil Lime nel villaggio di Kriegspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1171
#: mm6/data/10LocLANG.icons/Quests.txt.py:146
msgctxt "quests"
msgid ""
"Unward the doors in the Hall of the Fire Lord and return to the Lord of "
"Fire, also in the Hall of the Fire Lord."
msgstr "Sbloccare le porte della Sala del Signore del Fuoco e tornare da lui."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1188
#: mm6/data/10LocLANG.icons/Quests.txt.py:163
msgctxt "quests"
msgid ""
"Find Memory Crystal Alpha in the Supreme Temple of Baa and restore it to a "
"module altar at the Oracle beneath the High Council.."
msgstr ""
"Trovare Cristallo di Memoria Alfa nel Tempio Supremo di Baa e reinserirlo "
"nell'altare modulare dell'Oracolo sotto al Gran Consiglio."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1189
#: mm6/data/10LocLANG.icons/Quests.txt.py:164
msgctxt "quests"
msgid ""
"Find Memory Crystal Beta in Castle Alamos and restore it to a module altar "
"at the Oracle beneath the High Council."
msgstr ""
"Trovare il Cristallo di Memoria Beta nel Castello di Kriegspire e "
"reinserirlo nell'altare modulare dell'Oracolo sotto al Gran Consiglio."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1190
#: mm6/data/10LocLANG.icons/Quests.txt.py:165
msgctxt "quests"
msgid ""
"Find Memory Crystal Delta in Castle Darkmoor and restore it to a module "
"altar at the Oracle beneath the High Council."
msgstr ""
"Trovare il Cristallo di Memoria Delta nel Castello di Darkmoor e reinserirlo"
" nell'altare modulare dell'Oracolo sotto al Gran Consiglio."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1191
#: mm6/data/10LocLANG.icons/Quests.txt.py:166
msgctxt "quests"
msgid ""
"Find Memory Crystal Epsilon in Castle Kriegspire and restore it to a module "
"altar at the Oracle beneath the High Council."
msgstr ""
"Trovare il Cristallo di Memoria Epsilon nel Castello di Alamos e reinserirlo"
" nell'altare modulare dell'Oracolo sotto al Gran Consiglio."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1192
#: mm6/data/10LocLANG.icons/Quests.txt.py:167
msgctxt "quests"
msgid ""
"Retrieve the Control Cube from the Tomb of Varn in Dragonsand and return to "
"the Oracle beneath the High Council."
msgstr ""
"Recuperare il Cubo di Controllo dalla tomba di Varn nelle Sabbie del Drago e"
" riportarlo all'Oracolo sotto il Gran Consiglio."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1226
#: mm6/data/10LocLANG.icons/Quests.txt.py:201
msgctxt "quests"
msgid ""
"Find a cure for Slicker Silvertongue in the Superior Temple of Baa east of "
"Castle Kriegspire and return to Wilbur Humphrey with the good news."
msgstr ""
"Trovare la cura per Slicker Silvertongue nel Tempio Superiore di Baa a est "
"del Castello di Kriegspire e tornare da Wilbur Humphrey."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1227
#: mm6/data/10LocLANG.icons/Quests.txt.py:202
msgctxt "quests"
msgid ""
"Bring the the letter detailing Silvertongue's treason to the High Council in"
" Free Haven."
msgstr ""
"Portare la lettera che spiega del tradimento di Silvertongue al Gran "
"Consiglio di Free Haven."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1230
#: mm6/data/10LocLANG.icons/Quests.txt.py:205
msgctxt "quests"
msgid ""
"Find and destroy the Book of Liches in Castle Darkmoor and return to Terry "
"Ros in Darkmoor village."
msgstr ""
"Trovare e distruggere il Libro dei Lich nel Castello di Darkmoor e tornare "
"da Terry Ros al villaggio di Darkmoor."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1245
#: mm6/data/10LocLANG.icons/Quests.txt.py:220
msgctxt "quests"
msgid ""
"Place the statuettes in Sweet Water, Kriegspire, Dragonsand, Mire of the "
"Damned, and Bootleg Bay and return to Twillen in Blackshire."
msgstr ""
"Sistemare le statuine a Dolce Acqua, Kriegspire, Sabbie del Drago, Palude "
"dei Dannati e alla Baia di Bootleg e tornare poi da Twillen a Blackshire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1261
#: mm6/data/10LocLANG.icons/Quests.txt.py:236
msgctxt "quests"
msgid ""
"Obtain Arcane Magic from Archibald in the Royal Library in Castle Ironfist"
msgstr ""

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1714
msgctxt "quests"
msgid ""
"Mysterious woman asked you to travel in time and fulfill destinies of other "
"heroes. Well..."
msgstr ""

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1715
msgctxt "quests"
msgid ""
"Enter The Controlled Breach, find Runaway Chaos and bring it to the Uneasy "
