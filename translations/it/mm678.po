#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:617
msgctxt "items"
msgid "Lich Jar"
msgstr "Urna del Lich"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:629 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1404 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1418 mmmerge/Data/Text
