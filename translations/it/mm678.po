#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:698
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:699
msgctxt "items"
msgid "Crate"
msgstr "Cassa"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:648
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:650
msgctxt "items"
msgid ""
"A crate of from the Shadowspire artificers. Small flaws in workmanship have "
"made them incapable of holding enchantments."
msgstr ""
"Una cassa realizzata dagli artigiani di Punta Tenebrosa. Alcuni difetti di "
"lavorazione l'hanno resa inadatta a contenere incantesimi."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:649
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:651
msgctxt "items"
msgid "Dried Sunfish"
msgstr "Pesce luna essiccato"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:649
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:651
msgctxt "items"
msgid ""
"A crate of dried sunfish harvested from the Ifarine Sea. Some find the "
"chewy, salty fish a delicacy."
msgstr ""
"Un cassa di Pescesole essiccato pescato nel Mare di Ifarine. Alcuni trovano "
"che questo pesce salato e un po' gommoso sia una vera prelibatezza."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:650
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:652
msgctxt "items"
msgid "Silver Dust of the Sea"
msgstr "Polvere d'argento del mare"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:650
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:652
msgctxt "items"
msgid ""
"A crate full of bagged Silver Dust. Made by the Necromancers' Guild, it is "
"said to have value to some sea travelers."
msgstr ""
"Una cassa piena di sacchi di Polvere d'Argento. Costruita dalla Lega dei "
"Negromanti, si dice che sia preziosa per alcuni navigatori."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:651
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:653
msgctxt "items"
msgid "Forged Vouchers"
msgstr "Buoni contraffatti"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:651
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:653
msgctxt "items"
msgid "Vouchers"
msgstr "Titoli"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:651
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:653
msgctxt "items"
msgid ""
"Forged credit documents used by the ogre mage Zog to embezzle gold from "
"Alvarian merchant customers."
msgstr ""
"Titoli di credito falsi usati dall'orco mago Zog per appropriarsi "
"indebitamente del denaro dei clienti dei Mercanti di Alvar."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:652
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:654
msgctxt "items"
msgid "Ground Wyvern Horn"
msgstr "Corno di viverna macinato"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:652
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:654
msgctxt "items"
msgid "A powerful potion reagent used by the Necromancers of Shadowspire."
msgstr ""
"Un potente reagente usato nelle pozioni dai Negromanti di Punta Tenebrosa."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:653
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:655
msgctxt "items"
msgid "Prophecies of the Snake"
msgstr "Profezie del Serpente"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:653
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:655
msgctxt "items"
msgid ""
"Quest Item: One of many books of prophecy circulating recently, the "
"Prophecies of the Snake may indeed tell the future of Jadame."
msgstr ""
"Oggetto della ricerca: uno dei molti libri di profezie che circolano di "
"questi tempi. \"Profezie del Serpente\", però, potrebbe dire la verità sul "
"futuro di Jadame."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:654
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:656
msgctxt "items"
msgid "Ogre Ear"
msgstr "Orecchio dell'Ogre"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:654
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:656
msgctxt "items"
msgid "Ear"
msgstr "Orecchio"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:654
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:656
msgctxt "items"
msgid ""
"Used to keep track of kills, some bounty hunters collect these gruesome "
"reminders of battles past."
msgstr ""
"Per tenere il conto degli orchi abbattuti, alcuni cacciatori di taglie si "
"portano a casa questi ripugnanti souvenir."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:655
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:657
msgctxt "items"
msgid "Wasp Stingers"
msgstr "Pungiglioni di vespa"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:655
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:657
msgctxt "items"
msgid "Stinger"
msgstr "Pungiglione"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:655
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:657
msgctxt "items"
msgid "The stinger of a giant wasp."
msgstr "Il pungiglione di una vespa gigante."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:656
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:658
msgctxt "items"
msgid "Green Apple"
msgstr "Mela verde"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:656 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1433 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2105
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:658
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:632
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:487
msgctxt "items"
msgid "Apple"
msgstr "Mela"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:656
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:658
msgctxt "items"
msgid ""
"Jadamean green apples are crunchy, slightly tart and a good source of "
"nutrition.  (To use the apple, pick it up and left-click over a character's "
"portrait in the inventory screen.)"
msgstr ""
"Le mele verdi di Jadame sono succose, leggermente aspre e ad alto contenuto "
"nutrizionale.  (Per mangiare la mela, raccoglierla e fare clic con il "
"pulsante destro del mouse sul ritratto di un personaggio, nella schermata "
"dell'inventario.)"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:657 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1449 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2084
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:659
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:648
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:466
msgctxt "items"
msgid "Horseshoe"
msgstr "Ferro di cavallo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:657 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1449 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2084
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:648
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:466
msgctxt "items"
msgid ""
"This flawless horseshoe is made of silver. To use, pick the horseshoe up and"
" right-click over a character's portrait."
msgstr ""
"Questo ferro di cavallo perfetto è fatto d'argento. Per usarlo, "
"raccoglietelo e cliccate di destro sul ritratto di un personaggio."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:658
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:660
msgctxt "items"
msgid "Enchanted Amulet"
msgstr "Amuleto incantato"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:658
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:660
msgctxt "items"
msgid ""
"A pretty bauble favored by the Pirates of Regna for it appearance, not for "
"any magical enchantment it may have."
msgstr ""
"È uno dei ciondoli preferiti dei Pirati Regnani, ma solo per il suo aspetto,"
" non per qualche potere magico."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:659 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:801
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:803
msgctxt "items"
msgid "Wheel of Frelandeau"
msgstr "Forma di Frelandeau"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:659 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:660 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
msgctxt "items"
msgid "Cheese"
msgstr "Formaggio"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:659
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:661
msgctxt "items"
msgid ""
"Quest Item: A wheel of prized unicorn's-milk frelandeau cheese. Sliced onto "
"crackers, it is the perfect compliment to a snifter of fine tobersk brandy."
msgstr ""
"Oggetto della ricerca: una forma del formaggio Fermigiano, fatto con buon "
"latte di unicorno e apprezzato in tutto il mondo. Mangiato a scaglie, si "
"accompagna perfettamente a un buon bicchierino della migliore grappa di "
"Tobersk."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:660 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:802
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:804
msgctxt "items"
msgid "Log of Eldenbrie"
msgstr "Tronchetto di Eldenbrie"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:660
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
msgctxt "items"
msgid ""
"Quest Item: A log of Vori eldenbrie cheese. Though many have tried to "
"duplicate its subtle, smoky flavor, only the master Frost Giant cheese "
"masters of the frozen Vori wastes know the secrets of its formulation."
msgstr ""
"Oggetto della ricerca: una fetta di Dondonzola di Vori. Nonostante abbiano "
"tentato in molti di imitare il suo gusto deciso ma gradevole, solo i Maestri"
" formaggiai dei Giganti di Ghiaccio della landa di Vori conoscono la formula"
" segreta."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:661 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:803
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:805
msgctxt "items"
msgid "Ball of Dunduck"
msgstr "Palla di Dunduck"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
msgctxt "items"
msgid ""
"Quest Item: A ball of dunduck cheese. Made in small batches by the goblins "
"of Erathia, most consider it an acquired taste."
msgstr ""
"Oggetto della ricerca: una treccia di Tonzarella. Preparata con cura dai "
"goblin di Erathia, molti credono che si tratti di un sapore naturale."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:664
msgctxt "items"
msgid "Emperor Thorn's Key"
msgstr "Chiave dell'imperatore Thorn"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:664
msgctxt "items"
msgid "Quest Item: The key you took from the Unicorn King's body."
msgstr "Oggetto della ricerca: la chiave sottratta al Re degli Unicorni."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:665
msgctxt "items"
msgid "Cannonball of Dominion"
msgstr "Palla di cannone del Dominio"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:665
msgctxt "items"
msgid "Cannonball"
msgstr "Palla di cannone"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:665
msgctxt "items"
msgid ""
"Quest Item: The strange cannonball you took from the Regnan fortress. It is "
"unlike any ammunition you've seen before."
msgstr ""
"Oggetto della ricerca: una strana palla di cannone presa nella fortezza di "
"Regna. È diversa da qualsiasi altra munizione mai vista in circolazione."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:664
msgctxt "items"
msgid "Infused Metal Rod"
msgstr "Verga metallica infusa"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:664
msgctxt "items"
msgid "Metal Rod"
msgstr "Verga metallica"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:664
msgctxt "items"
msgid "Metal stick."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:665
msgctxt "items"
msgid "Large Round Crystal"
msgstr "Grande cristallo rotondo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:665
msgctxt "items"
msgid "Round crystal"
msgstr "Cristallo rotondo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:665
msgctxt "items"
msgid "Large smooth and perfectly round crystal."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:666
msgctxt "items"
msgid "Whisp wrappings"
msgstr "Bende di Whisp"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:666
msgctxt "items"
msgid "Pieces of rotten cloth."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:667
msgctxt "items"
msgid "Telelocator"
msgstr "Telelocalizzatore"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:667
msgctxt "items"
msgid "Metal stick with smooth gem on top of it."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:687 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1489
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:689
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:688
msgctxt "items"
msgid "Iron-laced ore"
msgstr "Minerale venato di ferro"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:687 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:688 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:689 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:690 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:691 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:692 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1489 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1490 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1491 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1492 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1493 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1494
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:689
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:690
