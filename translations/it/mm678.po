#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:313
#: mm6/data/10LocLANG.icons/Spells.txt.py:14
msgctxt "spells"
msgid "Incinerate"
msgstr "Incenerimento"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:13
msgctxt "spells"
msgid ""
"Among the strongest direct damage spells available, Incinerate inflicts "
"massive damage on a single target.  Only the strongest of monsters can "
"expect to survive this spell.  Damage is 15 points plus 1-15 per point of "
"skill in Fire Magic."
msgstr ""
"Uno degli incantesimi che causano i maggiori danni diretti. L'Incenerimento "
"causa danni ingenti solo al bersaglio selezionato. Solo i mostri più forti "
"possono sperare di sopravvivere a quest’incantesimo. Causa un danno di 5 "
"punti più 1-15 punti per ogni punto abilità nella Magia del Fuoco."

