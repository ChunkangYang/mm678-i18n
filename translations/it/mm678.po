#: mmmerge/Data/Text localization/LANG_MessageScrolls.txt.py:50
#: mm8/Data/10LocLANG.EnglishT/scroll.txt.py:50
msgctxt "scroll"
msgid ""
" Plan: Use old siege door system to drain lair.  Lever Order: A, B, C, E, G,"
" D, J, C, E, F, D, I, C, Lowest  Reset: A  Tritons: Watch out!"
msgstr ""
"Piano: usare il vecchio sistema di porte per prosciugare il rifugio."
"                                                                                                                                                                                                                                                "
"Ordine della leva: A, B, C, E, G, D, J, C, E, F, D, I, C, il più basso"
"                                                                                                                                                                                                                                                "
"Ripristina: A"
"                                                                                                                                                                                                                                                "
