#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:447
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:52
#: mm6/data/10LocLANG.icons/GLOBAL.TXT.py:446
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:248
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:348
#: mm6/data/10LocLANG.icons/Spells.txt.py:53
msgctxt "spells"
msgid "Bless"
msgstr "Benedizione"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:52
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:52
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:52
#: mm6/data/10LocLANG.icons/Spells.txt.py:53
msgctxt "spells"
msgid ""
"Blessed characters have an increased chance to hit monsters in hand to hand "
"combat and with missiles.  A character’s bonus to hit is increased by 5 + 1 "
"per point of skill in Spirit Magic."
msgstr ""
"I personaggi benedetti hanno maggiori possibilità di colpire i mostri nei "
"combattimenti corpo a corpo oppure sparando dei proiettili. Il bonus colpi "
"di un personaggio aumenta di 5 + 1 punto per ogni punto abilità nella Magia "
"dello Spirito."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:52
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:52
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:52
msgctxt "spells"
msgid "Duration 1 hour plus 5 minutes per point of skill"
msgstr "Durata 1 ora + 5 minuti per ogni punto abilità"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:52
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:81
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:52
