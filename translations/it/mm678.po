msgstr "Il Maestro del Buio, Seth Darkenmore, vive nel Baratro sotto Deyja!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1486
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:582
msgctxt "npc conversation"
msgid ""
