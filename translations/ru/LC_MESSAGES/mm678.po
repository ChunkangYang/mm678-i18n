#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:11
#: mm6/data/10LocLANG.icons/Spells.txt.py:12
msgctxt "spells"
msgid "Meteor Shwr"
msgstr "Метеор"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:11
msgctxt "spells"
msgid "Summons flaming rocks from the sky which fall in a large radius surrounding your chosen target.  Try not to be near the victim when you use this spell.  A single meteor does 8 points of damage plus 1 per point of skill in Fire Magic.  This spell only works outdoors."
msgstr "Обрушивает на выбранную цель пылающие камни с неба. Лучше быть подальше от цели этого заклинания. Каждый метеор наносит 8 пунктов вреда + 1 за каждую единицу навыка в Огненной Магии. Работает заклинание только под открытым небом."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:11
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:11
msgctxt "spells"
msgid "Moderate rate of recovery and 16 meteors"
msgstr "Средняя скорость восстановления и 16 метеоров"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:11
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:11
msgctxt "spells"
msgid "Fast rate of recovery and 20 rocks"
msgstr "Быстрое восстановление и 20 метеоров"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:12
