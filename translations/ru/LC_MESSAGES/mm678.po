msgctxt "items"
msgid "Hat"
msgstr "Шапка"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:115
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:117
msgctxt "items"
msgid "A loose fitting hat made of sturdy cloth."
msgstr "Шапка, сделанная из ткани."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:116
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:118
msgctxt "items"
msgid "Festival Hat"
msgstr "Шляпа"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:116
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:118
msgctxt "items"
msgid "Hats decorated with cheap glass gems are worn by Regnans on festival occassions--of which they have many."
msgstr "Шляпа, украшенная дешевой бижутерией, каких в Регне полным-полно."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:117
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:119
msgctxt "items"
msgid "Merchantman's Hat"
msgstr "Шапка торговца"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:117
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:119
msgctxt "items"
msgid "This pleated cap of velvet, lined and edged with black rabbit fur is decorated with a small enameled medallion. "
msgstr "Эта роскошная шляпа сделана из бархата, украшена мехом черного кролика и небольшой пряжкой. "

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:118
msgctxt "items"
