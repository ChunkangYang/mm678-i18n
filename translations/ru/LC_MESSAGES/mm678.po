#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2670
#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2672
#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2678
#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2679
#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2694
#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2695
#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2697
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
msgctxt "npc conversation"
msgid "n/a"
msgstr "н/д"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2395
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "Thank you, %06.\nNow, what did you want?"
msgstr "Спасибо, %06. Чего же вы хотите от меня?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2397
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
msgctxt "npc conversation"
msgid "<gulp> I get it. Yes, %06.\nWhat do you want of me?"
msgstr "<сдерживая слёзы> Я всё понял. Да, %06. Что вам нужно от меня?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2400
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "%02, eh?\nI'll remember that."
msgstr "%02, да? Я помню."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2401
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "%02 again.\nWhat do you want?"
msgstr "Снова %02. Что вам угодно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2402
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
msgctxt "npc conversation"
msgid "My patience is at its end.\nGo away and stop bothering me."
msgstr "Моё терпение кончается. Уходите и оставьте меня в покое!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2403
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
msgctxt "npc conversation"
msgid "More!\nMore gold!\nYes!\nGive me %04 more!"
msgstr "Ещё! Ещё золото! Да! Дайте мне ещё %04!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2404
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
msgctxt "npc conversation"
msgid "Ooooh, %06, no need to threaten me again, I'll talk."
msgstr "Ой, %06, не нужно новых угроз, я всё расскажу."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2405
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "I will not talk to nobodies.\nLeave me."
msgstr "Я не разговариваю с ничтожествами. Оставьте меня."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2406
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "Monsters!\nI have heard of your crimes.\nI would slay you if I could."
msgstr "Чудовища! Я наслышан о ваших злодеяниях! Порвал бы вас в клочки, если б только мог!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2407
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "Your infamy precedes you, %02.\nAnything to serve one so wicked as you, %06."
msgstr "Ваша дурная слава идёт впереди вас, %02. Помогу, чем смогу, такому злодею, как вы, %06."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2408
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "%07 %02.\nI am gratified to know you.\nWhat is mine is yours."
msgstr "%07 %02. Мне приятно встретиться с вами. Всё моё принадлежит и вам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2409
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "Hissssss….Please, don't slay me.\nI am a worm, not worth your trouble.\nI grovel at your feet, mighty %10."
msgstr "Пожа-а-алуйста, не убивайте меня! Я - червь, недостойный ваших усилий. Падаю ниц пред вами, о могучий %10."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2410
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "I don't speak with evil humans.\nGo away before I become…violent."
msgstr "Я не разговариваю с негодяями. Убирайтесь, пока я не рассвирепел."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2411
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Oh, hooray.\nIt's the good guys.\nYou're lucky I'm in a good mood right now.\nLeave me before it changes."
msgstr "Ох-хо! Вы хорошие парни. И вам повезло, что я сейчас в хорошем настроении. Уходите, пока оно не испортилось."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2412
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "Most humans are evil…and a simple lack of criminal reputation isn't enough to make me trust you.\nLeave me."
msgstr "Большинство людей порочны... Отсутствие дурной славы ещё не повод верить вам. Оставьте меня."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2413
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "%02. I smell traces of an awful goodness seeping from your pores.\nI can't stand it!\nGo and commit some acts of unspeakable evil.\nMaybe then I'll talk to\nyou."
msgstr "%02. Из ваших пор исходит запах чрезвычайной благопристойности. Не переношу! Ступайте и совершите какое-нибудь ужасное злодеяние. Может быть, тогда я поговорю с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2414
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "Back again, %02?\nI thought you were smarter than that.\nI can smell the evil on you.\nIt makes me hungry!"
msgstr "Опять здесь, %02? Я думал, вы умнее. Я чувствую запах зла, исходящий от вас. Он возбуждает мой аппетит."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2415
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "My mood grows sour as I contemplate your lack of evil.\nI have nothing to say to you."
msgstr "Когда я раздумываю над тем, как вам не хватает зла, моё настроение портится. Мне нечего сказать вам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2416
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "The stories I hear about you are %11, but that isn't good enough.\nBe on your way."
msgstr "Я слышал, что вы %11, но это недостаточно хорошо. Ступайте."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2417
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "I can sense goodness upon you, %02.\nBring yourself down to %11, and then return to me."
msgstr "Я чувствую, что от вас веет добродетелью, %02. Опуститесь до уровня %11 и возвращайтесь ко мне."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2418
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
msgctxt "npc conversation"
msgid "Your groveling has touched my heart.\nI will talk to you for a moment."
msgstr "Ваше унижение тронуло моё сердце. Я уделю вам немного времени."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2420
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "Yes, good.\nWhat do you want?"
msgstr "Да, хорошо. Что вам угодно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2422
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
msgctxt "npc conversation"
msgid "Please, don't slay me!\nI will tell you what you want to know!"
msgstr "Пожалуйста, не убивайте меня! Я скажу вам всё, что пожелаете знать."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2425
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "Hi.\nName's %01.\n"
msgstr "Привет. Меня зовут %01. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2426
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "How're you doin', %02?"
msgstr "Как дела, %02?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2428
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
msgctxt "npc conversation"
msgid "Price is the same every time, %06.\n%04 gold!"
msgstr "Цена всегда одинакова, %06. %04 золота!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2429
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
msgctxt "npc conversation"
msgid "Hey, uh, we're still friends, right?\nWhat do you need?"
msgstr "Эй, мы ведь по-прежнему друзья, так? Что вам нужно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2430
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "Go away kid, ya bother me.\nCome back when you're not as wet behind the ears."
msgstr "Убирайся, мелюзга, мне не до тебя. Возвращайся, когда молоко на губах высохнет."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2431
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "It's <gulp>…%06 %02 and %09 band of merry pranksters!\nYou are so well known around here!\nA real…honor, my %10."
msgstr "<Всхлипывает> Это... %06 %02 и %09 - удалые парни! Вас знают все кругом. Какая... честь, мой %10."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2432
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "Ah, the notorious %06 %02.\nAnything for you, %02!"
msgstr "А, печально известный %06 %02. Буду рад помочь, %02!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2433
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "Your exploits are known far and wide, %06 %02.\n%01 at your service, my %10."
msgstr "Ваши подвиги известны по всей округе, %06 %02. %01 к вашим услугам, мой %10."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2434
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "%07 %02!\nSo good to see you in person!\nWhich is surprising, since you are so famous and powerful and good, while I am so weak and pitiful.\nNot worth your time, no, not at all. Aheh-heh…Heh."
msgstr "%07 %02! Какое счастье видеть вас собственной персоной! Это так неожиданно, ведь вы великий и известный, а я... Не стоит тратить на меня время, поверьте. Ох-хо, нет, на самом деле."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2435
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "You've a %11 reputation, %06.\nI don't want anything to do with you."
msgstr "У вас %11 репутация, %06. Не хочу иметь с вами ничего общего."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2436
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "<sneer> Stinkin' goody two-shoes.\nThey say you %08.\nWell isn't that just wonderful?\nYou people make me sick.\nGo your way before I do something you'll regret!"
msgstr "<усмехаясь> Чую запах двуногих тварей. Все говорят, что вы %08. Разве это не здорово? Как устаешь от вас, людишек. Проваливайте, пока с вами чего-нибудь..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2437
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "Nothing I've heard about you makes me want to speak with you, %02.\nI'm not saying you are bad people;\nI'm just saying that you might not be good.\nPerhaps if you improved your reputation…"
msgstr "Я не слышал о вас ничего такого, чтобы захотеть поговорить с вами, %02. Я не утверждаю, что вы плохие люди; я просто говорю, что, возможно, вы не хорошие. Может быть, если бы вы улучшили свою репутацию..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2438
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "<squinting>\nHmm.\nI've heard that you have a bad reputation.\nThat's a good start, but not quite enough.\nYour reputation is going to have to get a lot worse before I trust you!"
msgstr "<Прищуриваясь> Хмм. Я слышал, у вас дурная репутация. Это хорошее начало, но этого недостаточно. Ваша репутация должна стать намного хуже, если хотите, чтобы я доверял вам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2439
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "There's a lot of talk about you people and none of it is good.\nI can't be seen with you.\nLet's go our separate ways, shall we?"
msgstr "О вас, людях, говорят много разного, но ничего хорошего. Не хочу, чтобы меня видели с вами. Давайте пойдём в разные стороны, а?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2440
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "Oh, back again, huh?\nHave you been deputized yet?\nFavored by the King?\nWell, I'll tell you--Mayors and Kings may welcome your type, but I sure don't.\nWatch your back."
msgstr "О, вы снова здесь? Вам дали какую-то должность? Или Король вам благоволит? Короче, вот что. Такие, как вы, может и нравятся мэрам и королям, но уж точно не мне. Поберегитесь!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2441
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "Ah, %02.\nUntil the rumors and gossip about you grow more positive, I don't want to talk to you. "
msgstr "А, %02. Не хочу с вами разговаривать, пока слухи о вас не станут лучше. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2442
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "Look, all my friends are uncertain about trusting you.\nUntil you do something to earn our faith, something illegal, I just can't be seen with you.\nIt makes me look bad."
msgstr "Слушайте, мои товарищи не уверены, что вам можно доверять. Пока вы не сделаете что-нибудь, чтобы заслужить наше доверие, - что-то незаконное, - нас не должны видеть вместе. Мне не пристало быть в такой компании."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2444
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
msgctxt "npc conversation"
msgid "I gave at the Guild.\nI'm not interested. I'm broke.\nIt's not my problem.\nGet a job.\nI don't care…Don't you get it?\nGo away, I don't want to talk to you!"
msgstr "Я не подаю в это время суток. Вы меня не интересуете. Я на мели. Это не моя проблема. Устройтесь на работу. Мне плевать... Что тут непонятного? Проваливайте, мне не о чем с вами говорить."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2445
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "A pleasure doing business with you, %06.\nWhat can I do for you?"
msgstr "Мне приятно вести с вами дела, %06. Чем могу помочь вам?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2447
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
msgctxt "npc conversation"
msgid "Ok, ok!\nWhatever you say, boss."
msgstr "Хорошо, хорошо! Всё, что скажете, господин."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2450
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "<bowing> %01, at your service."
msgstr "<кланяясь> %01, к вашим услугам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2451
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "Always a pleasure, %06 %02."
msgstr "Всегда рад, %06 %02."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2453
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
msgctxt "npc conversation"
msgid "Ahh, yes.\n< %01 rubs %03 hands together> More important business and discussion, I suppose.\nThe price, as always, is %04."
msgstr "О, да! <%01 и %03 жмут руки> Более важные дела и разговоры, как я понимаю. Цена, как обычно, %04."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2454
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
msgctxt "npc conversation"
msgid "Oh, dear!\nWhat more do you want?"
msgstr "О, боже! Что ещё вам нужно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2455
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "My merchandise is both rare and high quality.\nSo are my customers.\nSince you are low quality customers, it would seem we are unable to conduct business."
msgstr "Мои товары редких свойств и высокого качества. Значит, вы - покупатели. Вряд ли мы договоримся о сделке: вы не те покупатели, с которыми я привык иметь дело."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2456
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "Oh, my, %02!\nPlease don't rob me!\nI have nothing of value!\nAll I own is debt!\nHave mercy, my %10!"
msgstr "О, боже мой, %02! Пожалуйста, не грабьте меня! У меня нет ничего ценного! Я в долгах, как в шелках! Сжальтесь, мой %10!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2457
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "%07 %02!\nThat was really something when you slaughtered everyone in that small village!\nHad it coming, if you ask me.\nThat was you…wasn't it?\nWell, anyway, what can I do for you?"
msgstr "%07 %02! Ваша расправа над той деревенькой запомнилась всем! Вошла в историю, так сказать. Ведь это были вы, не так ли? Итак, чем могу быть полезен?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2458
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "I heard about how you %08.\nIt is an honor and a pleasure.\nAnything for you, my %10."
msgstr "Ходят слухи, что вы %08. Это честь и удовольствие для меня. Всё, что угодно, мой %10."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2459
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "Please, please, don't kill me, your worship! <sob>\nI am a wretch, not worth tiring your sword arm.\nIf you leave me alone, I will die on my own soon anyway!\nHave mercy, mighty %10!\nHave mercy!"
msgstr "Пожалуйста, пощадите, не убивайте меня, ваша честь! <всхлипывая> Я жалкое ничтожество, не тупите об меня свой меч! Если вы не тронете меня, я всё равно скоро умру - мне осталось недолго. Сжальтесь, о великий %10! Сжальтесь!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2460
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "%02...\nI've heard things about you, none of them good.\nPlease remove yourself from my presence.\nImmediately."
msgstr "%02... Я слышал о вас многое, но среди этого не было ничего хорошего. Пожалуйста, уйдите от меня. Сейчас же."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2461
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Psssst!\nHey, you wanna buy a <squints> wait a minute…never mind."
msgstr "Эй! Хотите купить немного <прищуривается>... Хотя, нет, я передумал."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2462
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "I only deal with people I know and trust.\nSince I haven't heard anything good about you, I have\nno reason to trust you.\nGood day."
msgstr "Я имею дело только с теми, кого знаю и кому доверяю. Поскольку я не слышал о вас ничего хорошего, у меня нет причин доверять вам. Всего доброго."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2463
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "%10 %02.\nI've heard of you.\nThey say your reputation is %11.\nThat says a lot, but I need to hear more before I feel I can safely deal with you.\nCome back to me after you have proven yourself some more."
msgstr "%10 %02. Я наслышан о вас. Говорят, у вас репутация %11. Это о многом говорит, но чтобы спокойно иметь с вами дело, я должен узнать о вас больше. Возвращайтесь ко мне, когда докажете, что вы что-то из себя представляете."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2464
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "I do not speak to ruffians!\nYour reputation is %11, well below my standards."
msgstr "Я не разговариваю с головорезами. Ваша репутация - %11, намного ниже моих требований."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2465
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "Are you talking to me?\nGo bother someone else.\nI have nothing for you."
msgstr "Вы говорите со мной? Поищите кого-нибудь другого. У меня нет для вас ничего."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2466
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "Persons of quality are not telling me that you are a person of quality.\nSince I only deal with people whose reputations are %12 or better, we have nothing further to talk about."
msgstr "Хорошие люди не говорили мне о вас ничего хорошего. Поскольку я общаюсь только с теми, чья репутация %12 или лучше, мне не о чем говорить с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2467
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "I just can't trust you.\nMaybe if your reputation were to fall to %11, or worse we could talk.\n<bowing> Until then %10."
msgstr "Я просто не могу верить вам. Может, если ваша репутация снизится до %11 или ниже, мы сможем поговорить. <кланяясь> До встречи %10."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2469
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
msgctxt "npc conversation"
msgid "What about me makes you think I care about you or your problems?\nBegone, or I shall set the town guard on you."
msgstr "С чего вы решили, что меня заботят ваши проблемы? Проваливайте или я прикажу стражникам заняться вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2470
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "Thank you!\nPlease, tell me what it is you are seeking."
msgstr "Спасибо! Скажите мне, что вы хотите?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2472
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
msgctxt "npc conversation"
msgid "I see.\nNo need for violence.\nWhat is it you need?"
msgstr "Всё ясно. Не нужно насилия. Что вы хотите?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2475
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "I am %01.\nWhat do you want?"
msgstr "Я - %01. Что вам угодно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2476
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "<sigh> Back so soon?"
msgstr "<вздох> Уже вернулись?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2477
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
msgctxt "npc conversation"
msgid "I told you already--I don't have time for you.\nMaybe tomorrow."
msgstr "Я уже сказал: у меня нет времени на вас. Может быть, завтра."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2479
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
msgctxt "npc conversation"
msgid "Grrrr…someday…All right, what is it?"
msgstr "Когда-нибудь... Ладно, что ещё?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2480
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "You may have heard of me.\nSome call me…%02.\nBeing famous, I only associate with other famous and important people.\nYou are neither.\nBegone."
msgstr "Возможно, вы слышали обо мне. Некоторые называют меня... %02. Я известен и знаюсь только с известными и знатными людьми. Вы не принадлежите ни к первым, ни ко вторым. Уходите."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2481
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "I never thought that I might one day come face to face with one as evil as you, %02.\nThis is not a happy day.\nWhat are your demands?"
msgstr "Никогда не знал, что придёт день, когда я встречу такого злодея, как вы, %02. Не самый счастливый день в моей жизни. Что вы требуете?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2482
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "A delight to finally meet the mighty %06 %02 in the flesh.\nThe denizens of the netherworld can't stop praising your exploits, and they eagerly await your inevitable arrival…Until then, how may I serve you, my %10?"
msgstr "Как я счастлив наконец встретить %06 %02 собственной персоной. Жители преисподней без конца восхваляют ваши подвиги и с нетерпением ожидают вашего прибытия. А пока чем я могу служить вам, мой %10?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2483
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "To know you is to love you, honorable %06 %02!\nYou are the ones who %08.\nYou have but to ask and from me you will receive!"
msgstr "Все, кто знает вас, искренне любит вас, уважаемый %06 %02! Это вы %08. Просите у меня всё, что угодно!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2484
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "Wait!\nPlease don't attack me!\nI'll stop the experiments,\nI swear!\nNo more evil sorcery for me..I'm done with that, you can count on me, %10 %02.\n"
msgstr "Постойте! Не нападайте на меня, пожалуйста! Я прекращу свои опыты, клянусь! Я не буду заниматься чёрной магией, с ней покончено. Вы можете на меня рассчитывать, %10 %02. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2485
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "Bah!\nI haven't time enough for the likes of you!\nI will only speak to people of good repute--people who's reputation is %12…or better."
msgstr "Тьфу! Не желаю разговаривать с такими, как вы. Я общаюсь только с приличными людьми, которые известны как %12 или даже лучше."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2486
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "May the dark gods save us from the righteous!\nIs there no end to you people?\nGet away from me before I put a hex on you!"
msgstr "Да избавят нас боги зла от нашествия этих благочестивых! Сколько ещё вы будете ходить ко мне, люди? Убирайтесь, пока я не наложил на вас заклятье!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2487
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "I am afraid I cannot associate with people whose charm and reputation do not approach my own.\nIt would taint my aura.\nSorry."
msgstr "Боюсь, я не могу иметь дела с теми, чьё обаяние и репутация не соответствуют моему уровню. Это может навредить моей ауре. Извините."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2488
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "%02, I am %01.\nI am constrained by pacts and promises I have made from dealing over much with the innocent.\nI only tell you this because I heard that your reputation is %11.\nThat's bad, but not bad enough.\nReturn after performing a few more despicable acts.\nThen we will talk."
msgstr "%02, я - %01. Я скован договорами и обещаниями. Говорю вам это лишь потому, что слышал: ваша репутация %11. Это плохо, но недостаточно плохо. Возвращайтесь, когда сделаете ещё несколько злодеяний. Тогда и поговорим."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2489
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "I grow wrathful thinking about all the negative things the wind whispers about you.\nYour reputation is %11!\nNot very nice.\nNow begone, before my wrath turns to action!"
msgstr "Я прихожу в гнев, когда думаю о всей той гадости, которую ветер разносит о вас. Ваша репутация %11. Не так уж и хорошо. Теперь убирайтесь, пока моя ярость не перешла в действие!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2490
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "Wasn't I rude enough the last time we spoke?\nI detest you!\nYour angelic faces turn my stomach!\nYour innocence nauseates me! Leave!"
msgstr "Я что, был слишком вежлив, когда мы виделись в последний раз? Я вас не переношу! От ваших ангельских лиц меня тошнит! Ваша благопристойность вызывает у меня отвращение. Проваливайте!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2491
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "%02.\nYour reputation suffers.\nProlonged association with the likes of you imperils the purity of my aura.\nI don't want to speak with you."
msgstr "%02. Ваша репутация слабовата. Длительное общение с подобными вам угрожают чистоте моей ауры. Не хочу разговаривать с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2492
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "Your aura lacks the mottled purple and yellow spots I must see before I am allowed to speak with you.\nYou must do more evil, %02, before we can safely talk."
msgstr "Вашей ауре не достаёт пурпурных и жёлтых точек, а без этого условия я не имею возможности общаться с вами. Вам следует творить больше зла, %02, иначе мы не сможем общаться друг с другом."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2493
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
msgctxt "npc conversation"
msgid "<sigh> Very well.\nBut this is it for today!\nI don't have time for you."
msgstr "<вздох> Ладно. Но это всё на сегодня. У меня нет времени для вас."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2496
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
msgctxt "npc conversation"
msgid "Money alone will not sway me, scoundrel!"
msgstr "Деньгами меня не купишь, мерзавец!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2497
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
msgctxt "npc conversation"
msgid "Hmmm.\nYou have a point.\nWhat do you want?"
msgstr "Хмммм. Вы убедили меня. Что вам угодно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2500
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "%02.\nCharmed, I'm sure."
msgstr "%02. Уверен, вы очарованы."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2501
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "What is it, %02?"
msgstr "Что это, %02?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2502
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
msgctxt "npc conversation"
msgid "No.\nI won't let you waste any more of my time.\nPerhaps tomorrow."
msgstr "Нет. Нечего тратить моё драгоценное время. Возможно, завтра."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2504
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
msgctxt "npc conversation"
msgid "Now what?\nHave you returned to slay me?\nI will surely call out your name before you strike me down!\nSomeone will come to save me!"
msgstr "Что на этот раз? Вы вернулись, чтобы лишить меня жизни? Перед тем, как умереть, я буду громко кричать ваше имя! Кто-нибудь услышит и спасёт меня!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2505
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "I haven't time for simple folk such as yourselves!\nPerhaps when you have become more sophisticated…"
msgstr "У меня нет времени на простолюдинов типа вас. Может быть, позже, если вы станете кем-нибудь посерьёзнее."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2506
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "Oh dear, the infamous %06 %02 and accomplices…I suppose begging for my life isn't enough.\nWhat do you want of me?"
msgstr "О, боже, пресловутый %06 %02 сотоварищи... Кажется, просто умолять о пощаде недостаточно. Что вам нужно от меня?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2507
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "My %10, everyone with an open mind in the Kingdom follows your deliciously outrageous behavior.\nSuch a wonderful history your deeds will make.\nHow may I serve you?"
msgstr "Мой %10, любой здравомыслящий житель королевства считает образцом ваше бесчеловечное поведение. Ваши подвиги несомненно войдут в историю. Могу я быть вам полезен?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2508
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "Your deeds are known far and wide, my %10.\nI will gladly serve you."
msgstr "Мой %10, ваши дела известны повсюду. С радостью помогу вам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2509
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "I know you're thinking you should strike me down like the dog I am, %10, but surely a saint like yourself can find it in your heart to overlook past indiscretions… Can't you?"
msgstr "Я знаю, вы хотите убить меня, как собаку, %10, но ведь у вас доброе сердце, и оно сможет простить грехи прошлого... Ведь так?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2510
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "People have been talking about how you like to commit crimes, %02.\nI don't like how that sounds, so I don't want to talk to you."
msgstr "Люди поговаривают о ваших пристрастиях к преступлениям, %02. Мне это не нравится, поэтому я не хочу разговаривать с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2511
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "I doubt you would approve of my researches into the darker magics, just as I would not approve of your intolerant ways.\nI have nothing further to say to you."
msgstr "Сомневаюсь, что вам понравятся мои исследования в области чёрной магии. Так же, как мне не нравится ваша фанатичность. Больше мне нечего сказать вам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2512
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "The court of public opinion about you is divided, %02.\nSome say you are good people, others are not so sure. I, for one, will wait for more good rumors about you before I will speak with you."
msgstr "Мнение общества о вас, %02, разделилось. Кто-то говорит, что вы неплохие люди, а другие не так уверены в этом. Что касается меня, я предпочитаю услышать о вас что-нибудь хорошее, прежде чем вступать в разговоры."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2513
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "Look--I'm bad company.\nEvil, pure and simple, through and through.\nHow would it look to all my friends to be caught associating with people who lack the kind of %12 reputation we have?\nThat's right--simply dreadful."
msgstr "Послушайте, я плохой человек. Злой и дурной во всех отношениях. Как я посмотрю в глаза своим товарищам, если они застанут меня с кем-то, чья репутация ниже, чем наша %12. Совершенно верно - это будет ужасно."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2514
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "The talk about you and your friends is that you are not decent folk, %02.\nI, for one, will have nothing to do with you."
msgstr "Говорят, что вы и ваши друзья - плохие парни, %02. Что касается меня, я не собираюсь иметь с вами никаких дел."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2515
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "It is a pleasure withholding information from righteous do-gooders like you!\nBeg me to reconsider and I might condescend to speak with you."
msgstr "Какое счастье утаивать то, что знаешь, от праведников типа вас. Переубедите меня и, возможно, я опущусь до разговора с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2516
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "<sigh>\nThough your reputation is at least %11, I promised my mother that I wouldn't talk to people whose reputation wasn't at least %12.\nSorry."
msgstr "<со вздохом> Пусть ваша репутация как минимум %11, я обещал мамочке не разговаривать с теми, чья репутация ниже, чем %12. Извините."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2517
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "Your reputation is only %12!\nI can't be seen with you.\nEveryone I know would laugh at me!\nI only associate with people whose reputation is %11 or worse."
msgstr "Ваша репутация лишь %12! Не хочу, чтобы меня видели с вами. Меня же засмеют! Я знаюсь только с теми, чья репутация %11 или ниже."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2518
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
msgctxt "npc conversation"
msgid "Fine, but make it quick."
msgstr "Ладно, но давайте побыстрее."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2521
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
msgctxt "npc conversation"
msgid "Money means little.\nKnowledge is power to me.\n"
msgstr "Деньги мало что значат. Знание - вот истинная ценность для меня. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2522
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
msgctxt "npc conversation"
msgid "Understood %06.\nI want to live.\nWhat do you need?"
msgstr "Я понял вас, %06. Я хочу жить. Что вам нужно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2525
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "Hello there!\nA mighty fine %05, if you ask me!\nI'm %01."
msgstr "Эй, привет! Классный %05, если вас интересует. Я - %01."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2526
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "Good to see you again!\nHahahaha!\nUhm…What did you say your name was?"
msgstr "Рад новой встрече! Ха-ха-ха-ха! Гм... Как, вы говорите, вас зовут?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2527
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
msgctxt "npc conversation"
msgid "My generosity ends here.\nI've already helped you today and I am sick of seeing you.\nLeave me."
msgstr "Моя щедрость заканчивается. Я уже помог вам сегодня и больше не желаю вас видеть. Оставьте меня."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2528
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
msgctxt "npc conversation"
msgid "<looking both ways> %04, then, and lets make this quick!"
msgstr "<Оглядываясь в разные стороны> Ладно, %04, и давайте по-быстрому."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2530
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "<yawns>\nNot interested.\nGo away--I'm waiting for someone important to speak to."
msgstr "<Зевает> Меня это не интересует. Уходите, - я ожидаю важную персону."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2531
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "%02!\nVillain! How dare you speak to me?"
msgstr "%02! Негодяй! Как смеешь ты разговаривать со мной?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2532
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "Infamous %06, It is an honor to know you and a pleasure to serve you.\nWhat do you desire?"
msgstr "Знаменитый %06, какая честь встретить вас и какое удовольствие служить вам! Что вам угодно ?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2533
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "Ah, the famous and honorable %06 %02!\n<bowing> Whatsoever you desire that is in my power to give, I freely grant."
msgstr "О, известный и уважаемый %06 %02! <кланяясь> С радостью сделаю всё, о чём вы попросите."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2534
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "%02.\n<spits on the ground>"
msgstr "%02. <сплёвывает на землю>"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2535
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "O Ho!\n%13! Er, %13.\nI think.\nWhatever.\nThere's gossip about you--all of it bad.\nGet thee hence, lest I spit thee on the point of my sword!"
msgstr "Ого! %13! Э-э, %13. Кажется. Ну да неважно. О вас говорят много плохого. Так что убирайтесь, пока я не насадил вас на меч."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2536
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "%13, eh? <loosening %03 sword> Better take to your heels…I don't much care for you law-abiding types."
msgstr "%13, да? <вынимая меч %03> Убирайтесь-ка подобру-поздорову... Не переношу таких, как вы, законопослушных типов."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2537
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "Hello!\nI'm %01!\nI've heard of you, %13, and while you haven't done anything too terribly wrong, or at least that I've heard, you haven't done much good, either.\nSo get out there and do some good deeds!\nMaybe then I'll talk to you."
msgstr "Приветствую вас! Я - %01. Я наслышан о вас, %13, и хоть вы не сделали ничего по-настоящему ужасного, по крайней мере, я об этом не слышал, но и хорошего вы сделали мало. Так что ступайте и сделайте что-нибудь достойное. Может быть, тогда я поговорю с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2538
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "%13, it is good to meet you at last.\nYour reputation is %11.\nCould be worse.\nMatter of fact, it makes me think you are some kind of wimp!\nYeah, until I hear worse, I don't want to be seen with you.\nGet out of my sight!"
msgstr "%13, здорово наконец-то встретиться с вами. Ваша репутация %11. Могло быть и похуже. Между прочим, это наводит меня на мысль, что вы слабак. Так что, пока я не услышу о вас что-нибудь плохое, я не хочу, чтобы нас видели вместе. Убирайтесь с глаз моих долой."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2539
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "Back again, %13?\nIs this some sort of challenge?\nHave you come to insult me?\nFriend %13, I warn you--you're walking a narrow bridge with me, and the chasm is very deep…very deep indeed!"
msgstr "Опять здесь, %13? Вы пытаетесь бросить мне вызов? Хотите оскорбить меня? Дружище %13, предупреждаю: вы идёте по узкому мосточку, а пропасть под ним глубока. Очень глубока."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2540
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "I am this far--this far from hacking your saintly head from your shoulders!\nLeave me while you still can."
msgstr "Я всего в шаге - маленьком шаге - от того, чтобы отрубить вашу дурацкую голову! Оставьте меня в покое, пока вы ещё можете это сделать сами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2541
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "%13!\nMaybe someday I will have something to say to you!\nMaybe.\nBut not until your reputation improves."
msgstr "%13! Возможно, когда-нибудь мне будет о чём поговорить с вами. Возможно. Но не раньше, чем вы улучшите свою репутацию."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2542
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "%13!\nYou've returned!\nReturned with a reputation of %11…Hmmm.\nLooks wimpy to me.\nDo something to impress me, 'cause I don't associate with the weak, or the helpless.\nUntil then, take off, eh?"
msgstr "%13! Вы снова здесь?! Вернулись с репутацией %11... М-да. Слабак, не иначе. Сделайте что-нибудь, что произведёт на меня впечатление. Потому что я не общаюсь со слабыми и беспомощными. А пока прощайте..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2543
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
msgctxt "npc conversation"
msgid "I suppose I could speak to you for a few minutes.\nHurry up."
msgstr "Думаю, что могу поговорить с вами пару минут. Поторапливайтесь."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2545
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "Yes, now what is it you need, %13?"
msgstr "Хорошо, чего же вы хотите от меня, %13?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2548
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
msgctxt "npc conversation"
msgid "<drawing %03 sword> I don't take kindly to threats…"
msgstr "<вынимая %03 меч> Я не люблю угрозы..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2550
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "Peace, %06.\nMy name is %14 %01.\n"
msgstr "Мир вам, %06. Меня зовут %14 %01. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2551
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "A glorious %05, %02.\nHow may I help you?"
msgstr "Прославленный %05, %02. Чем могу помочь?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2552
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
msgctxt "npc conversation"
msgid "Though your need is obviously great, It would be a disservice to others to attend solely to your needs.\nPerhaps some other time."
msgstr "Пусть вы и правда нуждаетесь в помощи, но это будет несправедливо по отношению к другим, если я буду заниматься лишь вашими проблемами. Может, когда-нибудь в другой раз."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2553
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
msgctxt "npc conversation"
msgid "Have you returned for more spiritual advice? The donation is still %04."
msgstr "Вы пришли за новым духовным советом? Плата прежняя, %04."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2555
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "I have important matters to attend to, child.\nSomeday you'll be important too, but you aren't yet, so go now, in peace."
msgstr "У меня много серьёзных дел, дитя моё. Когда-нибудь ты тоже станешь важным человеком, но сейчас ты никто. Иди с миром."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2556
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "It is the Devil himself before me!\nI do not fear you, nor will I help you!"
msgstr "Передо мной сам дьявол! Я не боюсь тебя и не буду помогать тебе!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2557
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "My Master…your work in the name of darkness is unparalleled.\nYour evil is superior to mine.\nTo serve you is my one and only desire."
msgstr "Мой повелитель... ваши труды во имя тьмы не имеют себе равных. Ваше зло зловреднее даже моего. Служить вам - всё, о чём я мечтаю."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2558
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "Praise the Light!\nA gift from Heaven to be in the presence of the sweet and honorable %10 %06! "
msgstr "Слава Свету! Какой дар небес - быть рядом с великим и уважаемым %10 %06! "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2559
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "The higher you climb, the farther you will fall…And you have climbed oh so high!\nRest assured, sainted one, that I will not be there to catch you when you fall!"
msgstr "Чем выше взберёшься, тем больнее падать... А вы взобрались ой, как высоко! Будьте уверены, ваше святейшество, я не буду ловить вас, когда будете падать."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2560
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "I have heard that you stopped walking in the Light.\nReturn to me when you have found your way."
msgstr "Я слышал, вы сошли с пути Света. Возвращайтесь ко мне, когда обретёте свой путь."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2561
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Begone, fool!\nI will not speak to cowards unwilling to travel the shadowed path."
msgstr "Проваливай, дубина! Я не общаюсь с трусами, не желающими идти по пути тьмы."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2562
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "You haven't an aura of evil or good strong enough for my spells to detect.\nUntil I know one way or the other, I must decline to speak with you."
msgstr "Я не чувствую над вами ни злой, ни доброй ауры. Пока я не узнаю, хороши вы или плохи, я не могу общаться с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2563
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "%02, your reputation is %11, indicating to me that there is hope you will join the darkness yet!\nStill, there are traces of goodness in your soul that are troublesome.\nEliminate them and return.\nThen we can talk."
msgstr "%02, ваша репутация %11. Это подсказывает мне, что ещё есть надежда, что вы вступите на путь тьмы. Но всё же, в вашей душе есть следы добродетели, и это тревожит меня. Избавьтесь от них и возвращайтесь. Тогда и поговорим."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2564
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "Still dealing in shadows?\nI know you can do better, %02.\nGo in peace, and return once you have renounced your evil ways."
msgstr "По-прежнему занимаетесь тёмными делишками? Я знаю, вы можете быть лучше, %02. Идите с миром и возвращайтесь, когда отречётесь от своих злодеяний."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2565
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "You try my patience, craven one.\nI am tempted to experiment with the powers the netherworld has granted me…"
msgstr "Вы испытываете моё терпение, малодушный трус! Меня так и подмывает попробовать в деле силу, которой наделила меня преисподняя..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2566
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "My dear %02.\nYou must tend to your soul before I can attend to your needs.\nGo, and return only when your feet are more firmly on the righteous path."
msgstr "Мой милый %02. Вам следует подумать о душе, прежде чем я смогу задуматься о ваших нуждах. Ступайте и возвращайтесь, когда бесповоротно ступите на праведный путь."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2567
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "%02, your personal darkness is shot through with streaks of light.\nI won't have it!\nI refuse to deal with the uncommitted, the uncertain, and the weak!\nReturn to me after you have proven your evil and stained your soul!"
msgstr "%02, темноту вашей души пробивают лучи света. Я этого не потерплю. Мне незачем иметь дело с нерешительными, неуверенными в себе и слабыми. Возвращайтесь, когда докажете, что ваша душа как следует запятнана злом."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2568
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
msgctxt "npc conversation"
msgid "How could I not respond to such a piteous cry for help?\nWhat do you require, %15?"
msgstr "Как я мог остаться глух к такой слёзной мольбе о помощи? Чего вы просите, %15?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2570
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "I see now that you are not a malicious defiler of all I hold dear, but rather a misguided soul that has lost %09 way.\nHow may I help you, child?"
msgstr "Теперь я вижу, что вы не планируете лишить меня всего имущества. Скорее, вы заблудшая душа, сбившаяся с пути %09. Чем я могу помочь, дитя моё?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2573
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
msgctxt "npc conversation"
msgid "I will not bow to threats."
msgstr "Угрозами меня не убедить."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2575
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "<sigh> Yes?"
msgstr "<Вздыхая> Да?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2576
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "Ah, yes, %02.\nCan I help you?"
msgstr "Ах, да, %02. Чем могу быть полезен?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2578
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
msgctxt "npc conversation"
msgid "I'm afraid I will require a second payment, %06.\n%04 now, or the conversation ends here."
msgstr "Боюсь, мне придётся попросить вас доплатить %06. Выкладывайте %04, или разговор окончен."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2580
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "Sorry, I'm looking for famous Heroes, not unknown peasants.\nBe off with you now."
msgstr "Извините, я ищу известных героев, а не каких-то крестьян. Проваливайте."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2581
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "Oh, the notorious %02.\nYes, I've heard of you, and I'm not impressed.\nI hope you are brought to justice soon!"
msgstr "О, пресловутый %02. Да, я слышал о тебе и не считаю тебя чем-то особенным. Надеюсь, с тобой скоро разберутся по справедливости!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2582
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "By the Word, your deeds are an inspiration to us all!\nKeep up the good work--with your help, the Kingdom will surely fall soon!"
msgstr "Честное слово, ваши подвиги вдохновляют всех нас. Продолжайте своё дело. С вашей помощью королевство вскоре исчезнет с лица земли!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2583
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "An honor, great %10.\nHow may I serve you?"
msgstr "Какая честь, великий %10. Могу я быть вам полезен?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2584
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "Oh, saints preserve us, it's the %10 of Heaven, come to do justice! <smirks> Let me worship you, your Highness…"
msgstr "О боги, сохраните нас! Это небесный %10 пришёл свершить справедливость. <притворно улыбаясь> Позвольте служить вам, ваше высочество..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2585
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "My sources tell me that you may have committed a number of crimes.\nYou must clear those problems up before I can speak with you."
msgstr "Мне сообщают, что на вас лежит грех многих преступлений. Прежде чем я стану говорить с вами, избавьтесь от этих грехов."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2586
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Sorry, %06 but it doesn't matter to me if you %08.\nAs a matter of fact, I consider your holier-than-thou attitude quite insulting…%06."
msgstr "Извините, %06, но меня интересует, правда ли вы %08? Между прочим, для меня довольно оскорбительно ваше лицемерное отношение... %06."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2587
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "A smart official only associates with people of quality reputation.\nYour reputation is only %11.\nNot good enough for me.\nSorry."
msgstr "Умный чиновник общается только с приличными людьми. А ваша репутация лишь %11. Этого недостаточно. Извините."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2588
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "%02.\nI understand you may be something less than a good citizen, and perhaps something more than a common criminal…There are always uses for such as you--if not for me than for my…associates.\nBut I need more proof!\nCommit some more crimes--then we can talk.\nAnd don't tell anyone we spoke about this--I'll deny our little conversation if accused."
msgstr "%02. Понимаю, что вы, наверное, нечто меньшее, чем хороший гражданин, и, возможно, нечто большее, чем обычный преступник... Такие люди всегда нужны - если не мне, то моим... партнёрам. Но мне нужны дополнительные доказательства. Совершите новые преступления, тогда и поговорим. И не рассказывайте никому о нашем уговоре - я ни за что не подтвержу, что разговаривал с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2589
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "%02? The record is still quite clear:\nYour reputation is %11.\nOur conversation must end here."
msgstr "%02? Что же неясного? Ваша репутация %11. Наш разговор окончен."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2590
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "<sigh> Back again?!?"
msgstr "<вздыхает> Вы снова здесь?!?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2591
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "I will only associate with people who won't embarrass me!\nYou will.\nMaybe if people start telling me your reputation is %12.\nUntil then…"
msgstr "Я общаюсь лишь с теми, кто точно не поставит меня в неловкое положение. А вы можете. Может быть, когда люди скажут мне, что ваша репутация стала %12... А пока..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2592
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "I retain doubts about your commitment to a life on the shady side.\nI must hear that your reputation is %12 or less!\nOtherwise I can have nothing to do with you!"
msgstr "Меня терзают сомнения по поводу вашей готовности вечно пребывать на стороне тьмы. Я должен услышать, что ваша репутация не выше %12. В противном случае, мне не о чем с вами говорить."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2594
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
msgctxt "npc conversation"
msgid "Beg all you like.\nI still won't help you."
msgstr "Просите, что угодно. Всё равно ничего не дам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2595
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "Thank you.\nHow may I be of service?"
msgstr "Спасибо. Чем могу быть полезен?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2598
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
msgctxt "npc conversation"
msgid "A threat?\nYou had best be gone before I set the watch on you!"
msgstr "Это угроза? Вы бы лучше проваливали, пока я не позвал стражу!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2600
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "What is it?"
msgstr "Что это?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2601
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "Back again, %02?"
msgstr "Опять здесь, %02?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2603
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
msgctxt "npc conversation"
msgid "%04 is still the price."
msgstr "Цена не изменилась: %04."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2605
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "%02?\nNever heard of you.\nNow go away and stop wasting my time."
msgstr "%02? Никогда не слышал. Уходите и не тратьте моё время на пустяки."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2606
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "<drawing %03 sword> %02! Prepare to die!"
msgstr "<вынимая меч %03> %02! Приготовься к смерти!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2607
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "%10 %02.<pulling a flask from inside %03 jerkin> A toast to those who do what they want when they want!"
msgstr "%10 %02.<доставая фляжку из куртки %03> За тех, кто делает то, что хочет и когда хочет!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2608
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "%10 %02.\nAn honor."
msgstr "%10 %02. Это честь для меня."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2609
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "<drawing %03 sword> %02!\nIn the name of Zenofex, prepare to die!"
msgstr "<вынимая меч %03> %02! Во имя Ценофекса, приготовься принять смерть!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2610
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "I heard you may have been less than lawful, recently.\nIf it could be proven, I would arrest you right now. "
msgstr "Я слышал, в последнее время вы были далеки от законопослушности. Если это подтвердится, я арестую вас немедленно. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2611
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Word is you %08.\nThat makes me sick!\nIf you aren't away from me soon, I'll do a lot more than just arrest you!"
msgstr "Поговаривают, что вы %08. А мне это не нравится. Если вы не уберётесь сейчас же, я не просто арестую вас!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2612
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "I have been instructed to talk only with persons of sound reputation.\nYours is %11, while I must demand %12.\nBe on your way."
msgstr "Мне велено общаться только с теми, у кого надёжная репутация. У вас - лишь %11, а мне требуется %12. Ступайте."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2613
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "I have been ordered to speak only with persons of, ah, the right kind of reputation.\nYours is merely %11.\nBe on your way."
msgstr "Мне велено общаться только с теми, у кого... м-м-м, подходящая репутация. Ваша же - всего %11. Ступайте."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2614
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "I still think I should arrest you."
msgstr "Думаю, мне стоит вас арестовать."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2615
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "I can't believe you're back.\nMy sword hand is starting to itch…"
msgstr "Не могу поверить, что вы вернулись! У меня рука так и чешется достать меч!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2616
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "I can't talk to you.\nI know your reputation is only %11. It must be better.\nOrders.\nSorry."
msgstr "Мне нечего сказать вам. Я знаю, что ваша репутация лишь %11. Нужно поработать над ней. У меня дела. Извините."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2617
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "I can't talk to you.\nI know your reputation is only %11. It must be worse.\nOrders.\nSorry."
msgstr "Мне нечего сказать вам. Я знаю, что ваша репутация лишь %11. Она должна быть хуже. У меня дела. Извините."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2619
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
msgctxt "npc conversation"
msgid "<kicking at you> Get away from me!"
msgstr "<отпинывая вас> Проваливай от меня!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2620
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
msgctxt "npc conversation"
msgid "Thanks.\nWhat is it you wanted?"
msgstr "Спасибо. Чего тебе надобно?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2623
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
msgctxt "npc conversation"
msgid "HA!\n<drawing %03 sword> Threaten me, will you?"
msgstr "HA! <вынимая %03 меч> Угрожаете мне?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2625
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "Hello friend! <making a curious gesture with thumb and nose> Baaaa! The end of the world draws nigh!"
msgstr "Привет, дружище! <Делая странный жест при помощи большого пальца и носа> Бааа! Близится конец света!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2626
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "Ah, %16. The Signs are dark indeed, aren't they?"
msgstr "А, %16. Приметы предвещают дурное, не так ли?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2629
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
msgctxt "npc conversation"
msgid "No need to threaten me a second time--I'll cooperate.\nAfter all, Baa will rule the Kingdom in the end.\nNothing you or I can say or do will change that."
msgstr "Не нужно новых угроз, я сделаю, что вам нужно. В конце концов, Баа будет править королевством. И ни вы, ни я не можем ничего изменить."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2630
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "Hmmm?\nWhat? Here, go away, I don't have time for the little people--that means you!\nYou aren't famous enough."
msgstr "Гм? Что? Знаете, проваливайте подобру-поздорову! Мне некогда болтать со всякой мелюзгой типа вас. Вы недостаточно известны."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2631
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "%02!\n<shrieking> Please don't kill me! I'll tell you anything!"
msgstr "%02! <пронзительно> Пожалуйста, не убивайте меня! Я расскажу вам всё."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2632
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "<smiling>\nThe end of the world nears--with a little help from you and me, %10 %02.\nIs there anything I can do for you?"
msgstr "<улыбаясь> Близится конец света - не без нашего с вами участия, %10 %02. Могу ли я чем-то помочь вам?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2633
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "Wonderful %10 %02!\nYou have come to save the world!\nPraise be!\nI only hope you aren't too late."
msgstr "Великолепный %10 %02! Вы пришли, чтобы спасти мир! Слава вам! Молюсь только, чтобы не было слишком поздно."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2634
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "Too bad you're on the losing side, %02!\nBut listen, I'll tell you anything you want--the Temple of Baa will reign soon no matter what you do!\nJust please don't kill me. "
msgstr "Не повезло, что вы среди проигравших, %02! Но послушайте, я скажу всё, что захотите. Храм Баа вскоре обретёт власть, что бы вы ни делали! Только, пожалуйста, не убивайте меня! "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2635
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "Oh, my!\nEveryone is saying terrible things about you and your friends, %02.\nI'm afraid I can't speak with you."
msgstr "Боже мой! О вас и ваших друзьях, %02, говорят, ходят ужасные слухи! Боюсь, мне не о чем с вами разговаривать."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2636
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Baaaa! <grinning nastily> Baaa! The herd calls, friend.\nWhy not go and do some good deeds or something?\nG'won!\nGit!"
msgstr "Ба-а-а-а! Бе-е-е! <противно ухмыляясь> Бе-е-е! Ба-а-а! Стадо зовёт тебя, дружище! Иди и сделай что-нибудь разумное, доброе, вечное! Вали! Не понял?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2637
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "I absolutely, categorically refuse to speak with persons whose reputation is less than %12."
msgstr "Я наотрез, категорически отказываюсь разговаривать с людьми, чья репутация ниже %12."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2638
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "Baaa, friend %02!\nI've heard that you might be just the kind of people we are looking for.\nBut I'm not sure.\nYou need to get a reputation for doing those things our cult requires…I'm sure you get the idea!"
msgstr "Ба-а-а, дружище %02! Слышал, вы как раз из тех, кого мы ищем. Но я пока не уверен. Вам нужно заслужить репутацию, а для этого сделайте кое-что из предусмотренного нашим культом. Думаю, вы понимаете, о чём я."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2639
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "<whispering> I'm still not allowed to speak with you, %02!\nNow please go, before I'm seen with you!"
msgstr "<шёпотом> Мне по-прежнему нельзя с вами разговаривать, %02! Пожалуйста, уходите, пока нас не застали вместе."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2640
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "Are you soft in the head?\nI said go away!\nI don't need any good deeds done today."
msgstr "У вас есть мозги в голове? Я же сказал, убирайтесь! Мне не нужны сегодня благие дела."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2641
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "Everyone in my secret cult tells me that you aren't nice enough to be with.\nSo go get nicer and I'll start talking to you."
msgstr "Все приверженцы нашего тайного культа говорят, что с вами нельзя иметь дело. Станьте лучше, и я буду с вами разговаривать."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2642
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "Your reputation isn't appropriate for my organization, %02, therefore I can't be seen talking to you.\nCome back when your reputation has…improved."
msgstr "Ваша репутация не приемлема для нашей организации, %02, поэтому нас не должны видеть вместе. Возвращайтесь, когда ваша репутация станет... лучше."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2644
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
msgctxt "npc conversation"
msgid "I already told you I don't really care for you.\nBother someone else."
msgstr "Я уже сказал, мне нет до тебя никакого дела! Доставай кого-нибудь другого."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2646
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
msgctxt "npc conversation"
msgid "My devotion to Baa is greater than any amount of money.\nI will never accept your bribe, never!"
msgstr "Мою преданность Баа не измерить никакими деньгами. Меня не подкупишь, никогда!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2647
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
msgctxt "npc conversation"
msgid "Ok, Ok!\nPlease, don't kill me.\nI'm not supposed to die yet."
msgstr "Хорошо, хорошо! Пожалуйста, не убивайте меня! Я ещё слишком молод для смерти."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2650
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "Hello! My name is %01, and I am pleased to meet you, %02."
msgstr "Приветствую вас! Меня зовут %01, рад встрече с вами, %02."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2651
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "A fine %05, %02, is it not?"
msgstr "Отличный %05, %02, не правда ли?"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2652
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
msgctxt "npc conversation"
msgid "I'm no longer in a good mood.\nGo trouble someone else."
msgstr "Моё хорошее настроение закончилось. Найдите кого-нибудь другого."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2655
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "Don't bother me, simpleton!\nI reserve my time solely for known, capable Heroes--not for unknown, incompetent, peasants."
msgstr "Не отвлекай меня, простолюдин! Я готов общаться лишь с известными, прославленными героями, а не с какими-то безграмотными крестьянами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2656
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "<eyes widening> %02? Villain!\nThe world would be a better place without you!"
msgstr "<округляя глаза> %02? Негодяй! Как только земля тебя носит!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2657
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "<bowing deeply> %10 %02! Your evil is known throughout the land!\nConsider me your most ardent supporter."
msgstr "<низко кланяясь> %10 %02! Ваши злодеяния известны всей стране! Считайте меня своим самым преданным сторонником."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2658
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "An honor to know you, %02.\nI am at your service."
msgstr "Для меня честь познакомиться с вами, %02. Весь к вашим услугам."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2659
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "%02.\nYour shining goodness is giving me a headache. <rubbing %03 temples>\nI think I'm going to have to slay you to cure it."
msgstr "%02. От вашей сиятельной добродетели у меня болит голова. <потирая виски %03> Думаю, лучшим лекарством от головной боли будет убить вас."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2660
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "There is a rumor going 'round saying that you are a criminal.\nI'm afraid I don't associate with criminals."
msgstr "Поговаривают, что вы - преступник. Боюсь, мне не о чем разговаривать с бандитами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2661
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Everyone says your reputation is %11.\nI hate that.\nBut, because you amuse me, I'll let you live awhile longer--as long as you go pester someone else."
msgstr "Все говорят, ваша репутация %11. Терпеть не могу! Но вы развеселили меня, поэтому я разрешу вам пожить ещё немного. Если вы пойдёте донимать кого-нибудь другого."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2662
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "My name is %01.\nIt would be a violation of my sacred oaths to speak with people whose reputation is less than %12.\nTherefore, I must bid you good day."
msgstr "Меня зовут %01. Заговорить с тем, чья репутация ниже %12, было бы нарушением моего священного обета. Поэтому я вынужден распрощаться с вами."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2663
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "%02.\nAs a Champion of evil, it pleases me to hear that your reputation is %11, but you just aren't evil enough for me!\nGet worse!\nI'm talking atrocities!\nCause a calamity or do something dastardly, then we can talk."
msgstr "%02. Как чемпиону зла, мне приятно слышать, что ваша репутация %11, но всё же для меня это недостаточно дурно. Станьте ещё хуже! Я имею в виду всякие зверства! Вызовите какое-нибудь несчастье или ещё что-нибудь подлое, тогда и поговорим."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2664
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "%02, your reputation is %11.\nMy instincts tell me to slay you on the spot, but in the interests of charity, I'll give you a chance to redeem yourself by letting you live.\nFor now."
msgstr "%02, ваша репутация %11. Инстинкты подсказывают мне убить вас на месте, но я проявлю милосердие, дам вам шанс искупить свою вину и оставлю вас в живых. Пока."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2665
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "You've returned to try my patience, I see."
msgstr "Вижу, вы вернулись, чтобы испытать моё терпение."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2666
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "Hmm.\n%02.\nI have sworn an oath to avoid those of ill repute.\nYour reputation is %11, which is beneath me.\nPerhaps if it improves..."
msgstr "Гмм... %02. Я дал обет избегать тех, у кого дурная слава. Ваша репутация - %11, а этого маловато. Может, когда она станет лучше..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2667
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "%02, your evil wavers.\nMore.\nMore I say!\nYou need to be at least %12 for me to want to talk to you, so get to work!\n"
msgstr "%02, вы не решительны в своём зле. Больше. Больше, я сказал! Вам нужно добиться как минимум %12, если хотите, чтобы я стал разговаривать с вами. Так что поработайте над собой. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2668
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
msgctxt "npc conversation"
msgid "Hmmm.\nAll right.\nBut only because my mood is good."
msgstr "Хмммм. Ладно. Благодарите моё хорошее настроение."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2671
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
msgctxt "npc conversation"
msgid "I think not.\nNo amount of money could change my opinion of you."
msgstr "Не думаю. Никакая сумма не заставит меня передумать."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2673
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
msgctxt "npc conversation"
msgid "You would challenge me?\nI am ready for the likes of you!"
msgstr "Бросаете мне вызов? Готов сражаться с такими, как вы!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2675
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
msgctxt "npc conversation"
msgid "%02.\nI am pleased to make your acquaintance."
msgstr "%02. Мне приятно познакомиться."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2676
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
msgctxt "npc conversation"
msgid "%02.\nI hope you aren't going to waste my time…"
msgstr "%02. Надеюсь, вы не будете тратить моё время зря..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2677
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
msgctxt "npc conversation"
msgid "Your audience is over.\nBe off with you and trouble me no further today."
msgstr "Разговор с вами окончен. Идите на все четыре стороны и оставьте меня в покое."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2680
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
msgctxt "npc conversation"
msgid "I am looking to speak with Heroes, not children.\nIf you want my time, go do something heroic."
msgstr "Я готов разговаривать с героями, а не с детьми. Если хотите пообщаться со мной, совершите какой-нибудь подвиг."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2681
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
msgctxt "npc conversation"
msgid "Hmmm.\nThe infamous and wicked %02. I am surprised that one of the Heroes of the land has not yet slain you.\nI shall be sure to help raise the bounty on your heads."
msgstr "Хмммм. Бесчестный и злой %02. Удивлён, что ты ещё не умер от руки какого-нибудь славного героя нашей страны. С удовольствием помогу собирать деньги на вознаграждение за ваши головы."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2682
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
msgctxt "npc conversation"
msgid "A pleasure to know the intriguing and adventurous %10 %02.\nWhen I first heard about your wickedness, I was very impressed!"
msgstr "Рад познакомиться с интриганом и авантюристом %10 %02. Впервые услышав о вашей подлости, я был очень впечатлён!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2683
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
msgctxt "npc conversation"
msgid "Ah! An honor and a privilege to see you, %02.\nMy considerable resources are at your disposal."
msgstr "А! Я польщён этой возможностью познакомиться с вами, %02. Всё, что в моей власти, - в вашем распоряжении."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2684
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
msgctxt "npc conversation"
msgid "Clearly, you are the enemy, O Champion of righteousness! Your speedy death would please me."
msgstr "Не сомнений, вы мой враг! О, высшая справедливость! Ваша быстрая смерть порадует меня."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2685
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
msgctxt "npc conversation"
msgid "My sources tell me that you have committed a number of crimes.\nThey say you may even have KILLED.\nI am afraid that with that record, I cannot help you."
msgstr "Мне сообщают, что на вас лежит грех многих преступлений. Поговаривают, что на вас есть даже кровь невинных. Боюсь, при такой дурной славе нам не о чем разговаривать."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2686
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
msgctxt "npc conversation"
msgid "Not everyone appreciates how you %08.\nI am one of those people.\nI doubt we have much to say to one another."
msgstr "Не всем понравилось, как вы %08. И я из тех, кто не нашёл в этом ничего хорошего. Вряд ли нам есть, о чём поговорить."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2687
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
msgctxt "npc conversation"
msgid "I will not sully my excellent reputation by conversing with one whose reputation is merely %11."
msgstr "Я не могу позволить себе запятнать своё имя, общаясь с теми, чья репутация лишь %11."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2688
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
msgctxt "npc conversation"
msgid "I can see you might be the type of person I commonly associate with, %02, but the rumors of your behavior vary.\nI must hear more before I will tolerate your presence.\nPerhaps you could dominate and bully some peasants…"
msgstr "Вижу, %02, что вы из тех, с кем я обычно имею дело. Но о ваших поступках ходят противоречивые слухи. Прежде чем я начну терпеть ваше присутствие, я должен услышать о вас больше. Может, вы смогли бы запугать и подчинить себе каких-нибудь крестьян..."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2689
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
msgctxt "npc conversation"
msgid "It is unseemly for me to be seen talking to criminals like yourselves.\nNow get out of my sight!"
msgstr "Мне не подобает общаться с такими преступниками, как вы. Убирайтесь с глаз моих долой сейчас же."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2690
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
msgctxt "npc conversation"
msgid "I still do not quite care for you %02.\nYour reputation amongst the common folk is %11, which is a bad business in my book.\n"
msgstr "Вы по-прежнему меня не интересуете, %02. Ваша репутация среди народа - %11, а по моим меркам это - дрянь. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2691
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
msgctxt "npc conversation"
msgid "My friends all tell me your reputation is %11, %02.\nThat's not good enough!\nPerhaps a good deed or two would make your presence more acceptable to civilized society."
msgstr "Друзья говорят мне, что ваша репутация %11, %02. Этого недостаточно. Может быть, пара-тройка добрых дел сделают ваше присутствие в приличном обществе более уместным."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2692
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
msgctxt "npc conversation"
msgid "I cannot believe you would enter my presence with a reputation of merely %11!\nThe insult is dire indeed, %10.\nLeave, and return when your reputation is %12!"
msgstr "Не могу поверить, что вы предстали предо мной с репутацией всего %11! Это оскорбление, %10! Идите и не возвращайтесь, пока не повысите свою репутацию до %12."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2693
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
msgctxt "npc conversation"
msgid "Today I will grant your wish. I will speak with you.\nBriefly."
msgstr "Я исполню сегодня ваше желание. Я поговорю с вами. По-быстрому."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2696
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
msgctxt "npc conversation"
msgid "Your paltry wealth isn't enough to even tempt me.\nI will not be bribed."
msgstr "Ваших ничтожных ценностей не хватит, чтобы соблазнить меня. Меня не подкупить."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2698
#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
msgctxt "npc conversation"
msgid "I will not bow to your threats!"
msgstr "Меня не убедить угрозами!"

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2699
msgctxt "npc conversation"
msgid "Jars. Yessss. You have helped us greatly."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2700
msgctxt "npc conversation"
msgid "Join guild"
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2701
msgctxt "npc conversation"
msgid "Well, sorcerers among you seeking for power of dark arts? Pay 10000 bill and step into our chambers."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2702
msgctxt "npc conversation"
msgid "We will not allow any rambler to sneak here. Pay and study or scram!"
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2703
msgctxt "npc conversation"
msgid "Perfect! Now i call all sorcerers among you necromancers, don't pretend to be good anymore."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2704
msgctxt "npc conversation"
msgid "Welcome, necromancers."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2708
msgctxt "npc conversation"
msgid "Well, this is %s."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:2709
msgctxt "npc conversation"
msgid "Done!"
msgstr "Готово!"

