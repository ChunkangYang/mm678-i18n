msgid "time"
msgstr "время"

#: mmmerge/Data/10LocLANG.T/6D08.STR.py:29
#: mm6/data/10LocLANG.icons/D08.STR.py:29
msgctxt "location"
msgid "Alive without breath, as cold as death, never thirsty ever drinking, all in mail never clinking, ever travelling, never walking, mouth ever moving, never talking.  What am I? "
msgstr "Живу я не дыша, холодная как смерть; хоть пью всегда, но не имею жажды; в кольчуге вся, но не звенит она; на месте не стою, но не хожу по свету; губами шевелю, но не издам ни звука.  Кто я? "

