#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:313
#: mm6/data/10LocLANG.icons/Spells.txt.py:14
msgctxt "spells"
msgid "Incinerate"
msgstr "Испепеление"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:13
msgctxt "spells"
msgid "Among the strongest direct damage spells available, Incinerate inflicts massive damage on a single target.  Only the strongest of monsters can expect to survive this spell.  Damage is 15 points plus 1-15 per point of skill in Fire Magic."
msgstr "Одно из мощнейших известных поражающих заклинаний, Испепеление наносит тяжелейшие повреждения одной цели. Немногие существа способны это пережить. Вред составляет 15 пунктов + 1-15 за каждую единицу навыка в Огненной Магии."

