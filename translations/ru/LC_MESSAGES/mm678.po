msgctxt "spells"
msgid "Duration 1 hour per point of  skill"
msgstr "Время действия 1 час за единицу навыка"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:3
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:3
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:3
#: mm6/data/10LocLANG.icons/Spells.txt.py:4
msgctxt "spells"
msgid "Brighter light"
msgstr "Более яркий свет"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:3
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:3
#: mm6/data/10LocLANG.icons/Spells.txt.py:4
msgctxt "spells"
msgid "Brightest light"
msgstr "Яркий свет"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:3
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:16
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:54
