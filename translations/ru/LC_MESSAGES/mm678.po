#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:48
#: mm6/data/10LocLANG.icons/Spells.txt.py:49
msgctxt "spells"
msgid "Moderate rate of recovery"
msgstr "Средняя скорость восстановления"

