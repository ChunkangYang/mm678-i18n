#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:16
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:54
#: mm6/data/10LocLANG.icons/Spells.txt.py:52
msgctxt "spells"
msgid "Faster recovery"
msgstr "Быстрое восстановление"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:304
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:404
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:4
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:303
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:403
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:4
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:206
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:306
#: mm6/data/10LocLANG.icons/Spells.txt.py:7
msgctxt "spells"
msgid "Fire Bolt"
msgstr "Огненная Стрела"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:4
msgctxt "spells"
msgid "Launches a burst of fire at a single target.  Damage is 1-3 points of damage per point of skill in Fire Magic.   Firebolt is safe, effective and has a low casting cost."
msgstr "Выстреливает огнем в выбранную цель. Повреждения составляют 1-3 пункта за единицу навыка в Огненной Магии. Огненная Стрела - дешевое, эффективное и безопасное заклинание."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:4
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:30
