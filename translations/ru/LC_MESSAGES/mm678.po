#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:130
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:131
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:132
msgctxt "items"
msgid "Ring"
msgstr "Кольцо"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:138
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:140
msgctxt "items"
msgid "A simple bauble of very little value."
msgstr "Простое и дешевое кольцо."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:139
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:141
msgctxt "items"
msgid "Gold Ring"
msgstr "Золотое кольцо"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:139
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:141
msgctxt "items"
msgid "A ring of soft gold rendered with half-hearted craftsmanship as a means of conveniently carrying a small amount of wealth."
msgstr "Кольцо из мягкого золота, украшенное половинкой сердца, благодаря искусству ювелира содержит на самом деле не так уж много металла."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:140
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:924
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:142
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:123
msgctxt "items"
msgid "Pearl Ring"
msgstr "Кольцо с жемчужиной"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:140
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:142
msgctxt "items"
msgid "A silver ring set with a good quality pearl."
msgstr "Серебряное кольцо с хорошей жемчужиной."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:141
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:143
msgctxt "items"
msgid "Gemstone Ring"
msgstr "Кольцо с драгоценными камнями"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:141
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:143
msgctxt "items"
msgid "This gold ring is decorated with a variety of tiny gems giving it a multicolored sparkle."
msgstr "Золотое кольцо с множественными мелкими драгоценными камнями, которые отливают разными цветами."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:142
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:144
msgctxt "items"
msgid "Amethyst Ring"
msgstr "Кольцо с аметистами"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:142
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:144
msgctxt "items"
msgid "A ring set with three amethysts. The largest is an excellent stone - richly and evenly purple with a perfect cut."
msgstr "Кольцо из золота с тремя аметистами. Самый крупный из камней удивительно чистой воды и с прекрасной огранкой."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:143
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:145
msgctxt "items"
msgid "Necromatic Ring"
msgstr "Кольцо некроманта"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:143
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:145
msgctxt "items"
msgid "Though made of semi-precious silver, this ring is highly valuable because it is well suited to holding enchantments of medium power."
msgstr "Несмотря на то, что оно изготовлено из серебра, оно очень дорогое, так как может поддерживать некоторые заклинания."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:144
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:146
msgctxt "items"
msgid "Ruby Ring"
msgstr "Кольцо с рубином"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:144
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:146
msgctxt "items"
msgid "This simply elegant ring is set with a single, oval ruby of high quality - pigeon blood red, perfectly cut and clear of imperfections."
msgstr "Это простое элегантное золоте кольцо с единственным овальным рубином, крупным, чистой воды и с прекрасной огранкой."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:145
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:147
msgctxt "items"
msgid "Vampire's Ring"
msgstr "Кольцо вампира"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:145
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:147
msgctxt "items"
msgid "Worn only by elder Vampires of great power, it is said that a part of their life force is invested in the ring's creation. This would certainly explain their ability to hold powerful enchantments."
msgstr "Их носят только старшие из вампиров. Говорят, что каждое такое кольцо несет в себе часть жизненной силы создателя, отданной при изготовлении.  Это неплохое объяснение, почему же оно может выдерживать многие сильные заклинания."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:146
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:148
msgctxt "items"
msgid "Sun Opal Ring"
msgstr "Кольцо с солнечным опалом"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:146
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:148
msgctxt "items"
msgid "Sun opals shine with a mild inner light. They are extremely rare and coveted by elemental magicians."
msgstr "Солнечный опал светится мягким переливчатым светом. Такие кольца очень редки и используются для стихийной магии."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:147
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:149
msgctxt "items"
msgid "Focal Ring"
msgstr "Кольцо Фокуса"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:147
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:149
msgctxt "items"
msgid "The \"stone\" of this platinum ring is actually a tiny interplanar portal which draws power from realms beyond. The strength limit of the enchantments such rings can hold is the skill and knowledge of the enchanter."
msgstr "В \"камне\" этого платинового кольца на самом деле находится встроенный портал, впитывающий силу и знания из окружающего мира. Предел прочности такого кольца ограничен только знаниями и силой мага."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:148
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:150
msgctxt "items"
msgid "Brass Charm"
msgstr "Латунное ожерелье"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:148
