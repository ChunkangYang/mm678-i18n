#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:409
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:10
msgctxt "spells"
msgid "Immolation"
msgstr "Всесожжение"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:10
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:10
msgctxt "spells"
msgid "Surrounds your characters with a very hot fire that is only harmful to others.  The spell will deliver 1-6 points of damage per point of skill to all nearby monsters for as long as they remain in the area of effect. "
msgstr "Окружает персонажей жарким пламенем, который причиняет вред всем окружающим, но не им самим. Все существа в непосредственном контакте с вами получают 1-6 пунктов вреда за каждую единицу навыка в Огненной Магии, пока не покинут область действия заклинания."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:10
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:10
msgctxt "spells"
msgid "Duration 1 minute per point of skill"
msgstr "Время действия 1 минута за единицу навыка"

