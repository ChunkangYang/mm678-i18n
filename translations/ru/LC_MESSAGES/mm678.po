#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:385
#: mm6/data/10LocLANG.icons/Spells.txt.py:93
msgctxt "spells"
msgid "Day of the Gods"
msgstr "День Богов"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:92
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:92
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:92
#: mm6/data/10LocLANG.icons/Spells.txt.py:93
msgctxt "spells"
msgid "Day -o- Gods"
msgstr "День Богов"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:92
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:92
msgctxt "spells"
msgid "Temporarily increases all seven stats on all your characters by three times your skill in Light Magic.  This spell lasts until you rest."
msgstr "На время увеличивает все характеристики всех ваших персонажей на величину, равную утроенному навыку мага в Магии Света. Заклинание действует, пока группа не устроится отдыхать."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:92
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:92
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:92
#: mm6/data/10LocLANG.icons/Spells.txt.py:93
#: mm6/data/10LocLANG.icons/Spells.txt.py:95
#: mm6/data/10LocLANG.icons/Spells.txt.py:105
msgctxt "spells"
msgid "All spells cast at three times skill"
msgstr "Для всех заклинаний навыки возрастают втрое"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:92
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:94
