#: mm6/data/10LocLANG.icons/GLOBAL.TXT.py:127
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:221
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:321
#: mm6/data/10LocLANG.icons/Spells.txt.py:23
msgctxt "spells"
msgid "Jump"
msgstr "Прыжок"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:19
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:19
msgctxt "spells"
msgid "Jump launches your party 60 feet into the air, allowing you to reach high ledges and jump large crevasses.  Your party takes no falling damage from the jump."
msgstr "Прыжок забрасывает вашу группу на 60 футов в воздух, позволяя достигать верхних этажей домов или перескакивать через высокие препятствия. Падение после прыжка вреда не наносит."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
