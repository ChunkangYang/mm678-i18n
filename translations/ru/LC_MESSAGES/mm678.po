msgid "Detect Life"
msgstr "Обнаружение Жизни"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
msgctxt "spells"
msgid "Allows the party to see an opponent's current health as an exact hit point number when you right-click on a creature."
msgstr "Позволяет точно определять количество оставшихся у монстра единиц здоровья по щелчку на него правой кнопкой мыши."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:51
msgctxt "spells"
msgid "Duration 10 minutes per point of skill."
msgstr "Время действия 10 минут за единицу навыка."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:112
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
