#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1455
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:551
msgctxt "npc conversation"
msgid "The Master of the Identify Item skill, Samuel Benson, can be found on a ridge in the central region of the Bracada desert."
msgstr "Pour devenir Maître en compétence Identifier Objet, vous devez suivre les enseignements de Samuel Benson, qui habite sur une colline au centre du Désert de Bracada."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1456
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:552
msgctxt "npc conversation"
msgid "The Grandmaster of the Identify Item skill, Payge Blueswan, can be found in the elven territory of Avlee.\nHis home is just northwest of the elven city of Spaward."
msgstr "Si vous souhaitez devenir Grand Maître en compétence Identifier Objet, suivez les enseignements de Payge Blueswan. Sa demeure se trouve au nord-ouest de la cité elfe de Spaward."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1457
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:553
msgctxt "npc conversation"
msgid "The Master of the Merchant skill, Berthold Caverhill, can be found on the eastern most island of the Evenmorn Islands."
msgstr "Pour devenir Maître en Marchandage, rencontrez Berthold Caverhill, sur l'île la plus orientale de l'Archipel d'Evenmorn."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1458
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:554
msgctxt "npc conversation"
msgid "The Grandmaster of the Merchant skill, Brigham the Frugal, can be found in a tower in the Bracada desert, on a ridge in the northern region."
msgstr "Le Grand Maître de la compétence Marchandage, Brigham le Frugal, demeure dans une tour dans le nord du Désert de Bracada."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1459
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:555
msgctxt "npc conversation"
msgid "The Master teacher of the Repair Item Skill, Thomas Moore, can be found in the swampy delta of the southern region of Tatalia."
msgstr "Le Grand-Maître de la compétence Réparer Objet, Thomas Moore, se trouve dans le delta marécageux du sud de Tatalia. "

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1460
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:556
msgctxt "npc conversation"
msgid "The Grandmaster of the Repair Item Skill, Gareth the Fixer, teaches from his home in the capitol city of Steadwick in Erathia."
msgstr "Le Grand Maître de la compétence Réparation, Gareth Reparetout, réside à Steadwick, la capitale d'Erathia."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1461
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:557
