#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:168
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:169
msgctxt "items"
msgid "A wand of highly polished thornbark wrapped with platinum wire. To use it, you must equip it like a weapon."
