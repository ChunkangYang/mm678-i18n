#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:342
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Stone to Flesh"
msgstr "Pierre en chair"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Stone - Flesh"
msgstr "Pierre en chair"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
msgctxt "spells"
msgid "Removes the stoned condition from a character if you cast this spell in time.  The greater the skill and rank in Earth Magic the longer the condition can have been present before the “point of no return” is reached.  After that, the only way to remove the condition short of Divine Intervention is to visit a temple."
msgstr "Elimine la condition Pétrifié d’un personnage si jeté à temps. Plus la compétence et le rang en magie de la Terre sont élevés, plus la durée d’existence de la condition peut être longue avant le “ point de non-retour ”. Après cela, hormis une intervention divine, seule une visite à un temple peut éliminer la condition."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Works if stoned less than 1 hour per point of skill"
msgstr "Fonctionne si le personnage est pétrifié depuis moins d’1 heure par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Works if stoned less than 1 day per point of skill"
msgstr "Fonctionne si le personnage est pétrifié depuis moins d’1 jour par point de compétence"

