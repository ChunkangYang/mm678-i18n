msgid "Duration 1 hour plus 15 minutes per point of skill"
msgstr "Effectif 1 heure plus 15 minutes par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:53
#: mm8/Data/10LocLANG.EnglishT/Global.txt.py:224
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:349
