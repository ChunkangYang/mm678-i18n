#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:163
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:164
msgctxt "items"
msgid "Something rattles ominously within the gog skull topping this wand - product of Ogre mage magic. To use it, you must equip it like a weapon."
msgstr "Cette baguette, issue de la magie de l'Ogre mage, est surplombée d'un crâne de gog aux bruits lugubres. Pour l'utiliser, équipez-la comme s'il s'agissait d'une arme."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:159
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:161
msgctxt "items"
msgid "Shaman's Wand of Ice"
