msgctxt "items"
msgid "Cheese"
msgstr "Fromage"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:659
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:661
msgctxt "items"
msgid "Quest Item: A wheel of prized unicorn's-milk frelandeau cheese. Sliced onto crackers, it is the perfect compliment to a snifter of fine tobersk brandy."
msgstr "Objet de quête : meule de fameux frelandeau au lait de licorne. En tranches sur des biscuits salés, c’est le parfait accompagnement d’un petit verre de bon brandy de tobersk."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:660
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:802
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:804
msgctxt "items"
msgid "Log of Eldenbrie"
msgstr "Bûche d'eldenbrie"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:660
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
msgctxt "items"
msgid "Quest Item: A log of Vori eldenbrie cheese. Though many have tried to duplicate its subtle, smoky flavor, only the master Frost Giant cheese masters of the frozen Vori wastes know the secrets of its formulation."
msgstr "Objet de quête : bûche d’eldenbrie de Vori. Beaucoup ont essayé de reproduire son goût subtil et fumé, mais seuls les maîtres fromagers des géants du Gel des déserts de Vori connaissent les secrets de sa recette."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:661
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:803
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:805
msgctxt "items"
msgid "Ball of Dunduck"
msgstr "Boule de dunduck"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
msgctxt "items"
msgid "Quest Item: A ball of dunduck cheese. Made in small batches by the goblins of Erathia, most consider it an acquired taste."
msgstr "Objet de quête : boule de dunduck. Fabriqué par petits lots par les gobelins d’Erathia, la plupart pense qu’on y prend goût."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:664
msgctxt "items"
msgid "Emperor Thorn's Key"
