#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:612
msgctxt "items"
msgid "Heartstone"
msgstr "Cœur de pierre"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:607
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:609
msgctxt "items"
msgid "Quest Item: The Heart of Fire is a gem of pure elemental force clear of imperfections and weighing at least a hundred carets. No doubt, a magic item made from it would be incredibly potent."
msgstr "Objet de quête : le Cœur de feu est une gemme de force élémentaire pure. Sans aucune imperfection, il pèse au moins cent carats. Il est certain qu'un objet magique de ce type renferme un pouvoir immense."

