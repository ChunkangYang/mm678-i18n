#: mm6/data/10LocLANG.icons/Spells.txt.py:53
msgctxt "spells"
msgid "Bless"
msgstr "Bénédiction"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:52
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:52
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:52
#: mm6/data/10LocLANG.icons/Spells.txt.py:53
msgctxt "spells"
msgid "Blessed characters have an increased chance to hit monsters in hand to hand combat and with missiles.  A character’s bonus to hit is increased by 5 + 1 per point of skill in Spirit Magic."
msgstr "Les personnages bénis ont davantage de chances de frapper les monstres en corps à corps et avec des projectiles. Le bonus d'attaque d’un personnage augmente de 5 + 1 par point de compétence en magie du Spiritisme."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:52
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:52
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:52
msgctxt "spells"
msgid "Duration 1 hour plus 5 minutes per point of skill"
msgstr "Effectif 1 heure plus 5 minutes par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:52
