#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1476
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:572
msgctxt "npc conversation"
msgid "The Grandmaster of the Armsmaster Skill, Lasiter the Slayer, makes his home in the eastern region of Eeofol."
msgstr "Si vous souhaitez devenir Grand Maître en compétence Maître d'Armes, suivez les enseignements de Lasiter le Pourfendeur, qui réside dans l'est d'Eofol."

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1477
