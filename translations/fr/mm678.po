#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:354
#: mm6/data/10LocLANG.icons/Spells.txt.py:59
msgctxt "spells"
msgid "Turn Undead"
msgstr "Repousser morts-vivants"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:54
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:54
msgctxt "spells"
msgid "Forces all visible undead monsters to flee until the duration of Turn Undead runs out.  This spell lasts for 3 minutes plus one minute per point of skill in Spirit Magic."
msgstr "Force tous les monstres morts-vivants visibles à s’enfuir jusqu’à dissipation du sort. Ce sort dure 3 minutes plus 1 minute par point de compétence en magie du Spiritisme."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:54
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:135
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:135
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:54
msgctxt "spells"
msgid "Duration 3 minutes plus 1 per point of skill"
msgstr "Effectif 3 minutes plus 1 par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:54
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:54
msgctxt "spells"
msgid "Duration 3 minutes plus 3 per point of skill"
msgstr "Effectif 3 minutes plus 3 par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:54
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:70
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:54
