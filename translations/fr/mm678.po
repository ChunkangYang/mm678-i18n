#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:70
msgctxt "spells"
msgid "Duration 3 minutes plus 5 per point of skill"
msgstr "Effectif 3 minutes plus 5 par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:351
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:451
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:55
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:350
