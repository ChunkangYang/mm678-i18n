#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:292
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:392
#: mm6/data/10LocLANG.icons/Spells.txt.py:101
msgctxt "spells"
msgid "Toxic Cloud"
msgstr "Nuage toxique"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:100
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:100
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:100
#: mm6/data/10LocLANG.icons/Spells.txt.py:101
msgctxt "spells"
msgid "A poisonous cloud of noxious gases is formed in front of the caster and moves slowly away from your characters.  The cloud does 25 points of damage plus 1-10 per point of skill in Dark Magic and lasts until something runs into it."
msgstr "Un nuage toxique de gaz nocifs se forme devant le jeteur et s’éloigne lentement de vos personnages. Le nuage provoque 25 points de dégâts plus 1-10 par point de compétence en magie de l’Ombre. Il se dissipe en heurtant quelque chose."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:393
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:493
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:392
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:492
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:101
msgctxt "spells"
msgid "Vampiric Weapon"
msgstr "Arme vampirique"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:101
msgctxt "spells"
msgid "Vamp Weap"
msgstr "Arme vamp."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
msgctxt "spells"
msgid "Enchants a weapon with the Vampiric ability.  Damage inflicted on monsters struck by this weapon will be given to the weapon's wielder as extra hit points, up to his or her normal hit point maximum."
msgstr "Confère par magie l’aptitude Vampirique à une arme. Les dégâts infligés aux monstres frappés par cette arme donnent à l’utilisateur de l’arme des points de santé supplémentaires, dans la limite de son nombre normal de points de santé maximum."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:6
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:101
msgctxt "spells"
msgid "Permanent"
msgstr "Permanent"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:102
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:394
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:494
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:102
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:393
