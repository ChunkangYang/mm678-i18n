#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:437
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:41
msgctxt "spells"
msgid "Earth Resistance"
msgstr "Protection contre la Terre"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:41
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:41
msgctxt "spells"
msgid "Earth Resist"
msgstr "Prot. Terre"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:41
msgctxt "spells"
msgid "Increases all of your characters’ resistance to Earth Magic damage by an amount equal to your skill in Earth. The effect lasts one hour per point of skill."
msgstr "Augmente la protection de tous vos personnages contre les dégâts de la Terre, d’un montant égal à votre compétence en magie de la Terre. L’effet dure une heure par point de compétence."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:339
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:439
