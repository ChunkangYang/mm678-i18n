#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:634
msgctxt "items"
msgid "Quest Item: A large ring of polished brass. It seems to be part of a door knocker."
msgstr "Objet de quête : grand anneau de cuivre poli. Il semble faire partie d’un heurtoir."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:633
