#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:2
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:4
msgctxt "items"
msgid "Produced in great numbers, these slightly overbalanced swords are the arms of militiamen across the land."
msgstr "Fabriquées en grand nombre, ces épées un peu trop lourdes sont les armes des gardes du pays."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:3
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:5
msgctxt "items"
msgid "Trollish War Sword"
msgstr "Epée de guerre trollienne"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:3
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:5
msgctxt "items"
msgid "Though of primitive craftsmanship, the great weight of this weapon's blade gives it excellent striking power."
msgstr "En dépit d’une fabrication primitive, la masse considérable de la lame de cette arme lui confère une excellente puissance de frappe."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:6
msgctxt "items"
msgid "Dark Elven Longsword"
msgstr "Epée des elfes de l’Ombre"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:6
msgctxt "items"
msgid "The weapon of a merchantman from the Dark Elven city of Alvar. It's wavy edged blade holds a good edge."
msgstr "L’arme d’un marchand d’Alvar, ville des elfes de l’Ombre. Sa lame ondulée a un bon tranchant."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:5
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:7
msgctxt "items"
msgid "Templar's Sword"
msgstr "Epée de Templar"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:5
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:7
msgctxt "items"
msgid "A sword for a true swordsman. Its lack of ornamentation bespeaks of the singular purpose of its design."
msgstr "L’épée d’une fine lame. Son absence d’ornements témoigne de l’objectif singulier pour lequel elle a été conçue."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:8
msgctxt "items"
msgid "Champion's Sword"
msgstr "Epée de champion"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:8
msgctxt "items"
msgid "These are made exclusively for members of the Erathian Order of the Blade. Since by tradition they are buried with their fallen wielders on hallowed and guarded grounds, they are rare articles indeed."
msgstr "Ces épées sont réservées aux membres de l’Ordre de la lame d’Erathia. La tradition veut qu’à la mort de leurs détenteurs, elles soient enterrées à leurs côtés en terre bénie et gardée. Ce sont donc des objets très rares."

