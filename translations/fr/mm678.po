#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:395
#: mm6/data/10LocLANG.icons/Spells.txt.py:104
msgctxt "spells"
msgid "Shrinking Ray"
msgstr "Rayon réducteur"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:102
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:102
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:102
#: mm6/data/10LocLANG.icons/Spells.txt.py:104
msgctxt "spells"
msgid "Shrink Ray"
msgstr "Rayon réduc."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:102
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:102
msgctxt "spells"
msgid "Shrinks even the grandest of monsters down to more manageable sizes. Duration of this spell is 5 minutes per point of skill in Dark Magic. Depending on the caster's expertise, a shrunken monster deals one half, one third, or one quarter its normal damage while shrunk."
msgstr "Réduit les monstres même les plus extraordinaires à une taille plus facile à maîtriser. Ce sort dure 5 minutes par point de compétence en magie de l’Ombre. Selon l’expertise du jeteur, un monstre réduit inflige la moitié, le tiers ou le quart des dégâts provoqués normalement."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:102
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:102
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:102
#: mm6/data/10LocLANG.icons/Spells.txt.py:104
msgctxt "spells"
msgid "Reduces monster size to one half normal"
msgstr "Réduit un monstre à la moitié de sa taille normale"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:102
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:102
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:102
#: mm6/data/10LocLANG.icons/Spells.txt.py:104
msgctxt "spells"
msgid "Reduces monster size to one third normal"
msgstr "Réduit un monstre au tiers de sa taille normale"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:102
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:102
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:102
#: mm6/data/10LocLANG.icons/Spells.txt.py:104
msgctxt "spells"
msgid "Reduces monster size to one fourth normal"
msgstr "Réduit un monstre au quart de sa taille normale"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:102
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:102
msgctxt "spells"
msgid "Will affect other monsters near the target"
msgstr "Affecte les autres monstres proches de la cible"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:103
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:395
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:495
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:103
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:394
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:494
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:103
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:294
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:394
#: mm6/data/10LocLANG.icons/Spells.txt.py:103
msgctxt "spells"
msgid "Shrapmetal"
msgstr "Eclats"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:103
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:103
msgctxt "spells"
msgid "Fires a blast of hot, jagged metal in front of the caster, striking any creature that gets in the way.  Each piece inflicts 1-6 points of damage per point of skill in Dark Magic."
msgstr "Lance un jet de métaux brûlants et dentelés devant le jeteur. Le jet frappe toute créature qui s’interpose. Chaque éclat provoque 1-6 points de dégâts par point de compétence en magie de l’Ombre."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:103
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:103
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:103
#: mm6/data/10LocLANG.icons/Spells.txt.py:103
msgctxt "spells"
msgid "Faster recovery rate and 5 fragments"
msgstr "Temps de récupération rapide et 5 éclats"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:103
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:103
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:103
msgctxt "spells"
msgid "Faster recovery rate and 7 fragments"
msgstr "Temps de récupération rapide et 7 éclats"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:103
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:103
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:103
msgctxt "spells"
msgid "Fastest recovery rate and 9 fragments"
msgstr "Temps de récupération très rapide et 9 éclats"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:104
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:396
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:496
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:104
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:395
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:495
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:104
msgctxt "spells"
msgid "Control Undead"
msgstr "Contrôler morts-vivants"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:104
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:104
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:104
msgctxt "spells"
msgid "Cntrl Undead"
msgstr "Cntrl m-viv"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:104
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:104
msgctxt "spells"
msgid "Takes control of an undead target's mind for 3 minutes per point of skill in Dark Magic.  Controlled undead will fight monsters that are hostile to the caster for the duration of the spell, and will not fight with the caster even if attacked by the caster or his friends."
msgstr "Prend le contrôle de l’esprit d’un mort-vivant visé pendant 3 minutes par point de compétence en magie de l’Ombre. Le mort-vivant contrôlé combat les monstres hostiles au jeteur pendant toute la durée du sort. Il ne combat pas le jeteur, même si celui-ci ou ses amis l’attaquent."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:104
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:104
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:104
#: mm6/data/10LocLANG.icons/Spells.txt.py:69
#: mm6/data/10LocLANG.icons/Spells.txt.py:102
msgctxt "spells"
msgid "Duration 3 minutes per point of skill"
msgstr "Effectif 3 minutes par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:104
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:104
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:104
msgctxt "spells"
msgid "Faster recovery rate, duration 5 minutes per point of skill"
msgstr "Temps de récupération rapide, effectif 5 minutes par point de compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:104
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:104
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:104
msgctxt "spells"
msgid "Fastest recovery rate, lasts until party leaves map"
msgstr "Temps de récupération très rapide, effectif jusqu’au départ de l’équipe de la carte"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:105
#: mm8/Data/10LocLANG.EnglishT/Global.txt.py:232
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:397
