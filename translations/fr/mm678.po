#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:643
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:645
msgctxt "items"
msgid "Quest Item: A sea raider captain's hat. Inside the band are stitched the words \"D. P. Stanley.\""
msgstr "Objet de quête : chapeau de capitaine écumeur des mers. A l’intérieur du ruban sont brodés les mots “ D. P. Stanley ”."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:644
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:646
msgctxt "items"
msgid "Tobersk Fruit"
msgstr "Tobersk"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:644
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:646
msgctxt "items"
msgid "Fruit"
msgstr "Fruit"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:644
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:646
msgctxt "items"
msgid "The fruit of the tobersk bush which only grows on the Dagger Wound Islands. It is the main export item of the islands' Lizardmen."
msgstr "Le fruit de l’arbuste de tobersk qui pousse uniquement sur les îles de la Plaie de la Dague. C’est la principale marchandise exportée de ces îles par les hommes-lézards."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:645
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:647
msgctxt "items"
msgid "Tobersk Pulp"
