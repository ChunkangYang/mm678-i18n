#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:245
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:345
#: mm6/data/10LocLANG.icons/Spells.txt.py:49
msgctxt "spells"
msgid "Death Blossom"
msgstr "Eclosion mortelle"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:48
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:48
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:48
#: mm6/data/10LocLANG.icons/Spells.txt.py:49
msgctxt "spells"
msgid "Death Blsm"
msgstr "Ecl. mort."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:48
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:48
msgctxt "spells"
msgid "Launches a magical stone which bursts in air, sending shards of explosive earth raining to the ground.  The damage is 20 points plus 2 per point of skill in Earth Magic for each shard.  This spell can only be used outdoors."
msgstr "Lance une pierre magique qui éclate en l’air. Elle envoie des éclats de terre explosive au sol. Chaque éclat provoque 20 points de dégâts plus 2 par point de compétence en magie de la Terre. Ce sort fonctionne uniquement à l’extérieur."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:48
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:48
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:48
msgctxt "spells"
msgid "Faster recovery rate, double effect of skill"
msgstr "Temps de récupération rapide, double effet de la compétence"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:49
