#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:488
msgctxt "items"
msgid "Cloak"
msgstr "披风"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1708
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:108
msgctxt "items"
msgid "A used leather cloak.  It smells faintly of mothballs and dust."
msgstr "一件旧式的皮质披风，仅可挡风遮雨。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1709
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:109
msgctxt "items"
msgid "Phantom Cloak"
msgstr "幽灵披风"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1709
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:109
msgctxt "items"
msgid "Indigo dye from the Regnan Archipelago was used to stain this wool cloak the color of a summer night's sky."
msgstr "取自雷格那半岛的靛青把这件披风染得如同夏日的夜空。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1710
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:110
msgctxt "items"
msgid "Elven Cloak"
msgstr "精灵披风"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1710
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:110
msgctxt "items"
msgid "Woven from plant fibers found in the forests of Erathia, these cloaks are the traditional garb of the Elven Rangers."
msgstr "由取自埃拉西亚森林中的植物纤维制成，是精灵族巡逻队的传统装束。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1711
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:111
msgctxt "items"
msgid "Cardinal Cloak"
msgstr "主教披风"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1711
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:111
msgctxt "items"
msgid "A cloak formerly worn by high officials of the Church of the Sun of Karigor prior to the dissolution of the Church in 1083 A.S.  Nearly all these cloaks were enchanted in one way or another."
msgstr "在寂静时代1083年卡力格的太阳教派瓦解以前，此类披风只有太阳教派的高级官员才能穿着。所有这类披风都附有这种或那种的魔法。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1712
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:112
msgctxt "items"
msgid "Doom's Day Cloak"
msgstr "世界末日披风"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1712
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:112
msgctxt "items"
msgid "A cloak formerly worn by high officials of the Church of the Moon of Karigor prior to the dissolution of the Church in 1083 A.S.  Nearly all these cloaks were enchanted in one way or another."
msgstr "在寂静时代1083年卡力格的月亮教派瓦解以前，此类披风只有月亮教派的高级官员才能穿着。所有这类披风都附有这种或那种的魔法。"

