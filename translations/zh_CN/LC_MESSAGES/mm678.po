#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:3
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:3
msgctxt "location"
msgid "You find jerked beef in the sack (+10 food)."
msgstr "你在袋子里找到了风干牛肉（+10食物）。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:4
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:4
msgctxt "location"
msgid "Mead filled barrel."
msgstr "装满蜂蜜酒的木桶。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:5
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:5
msgctxt "location"
msgid "You drink the mead and are feeling good."
msgstr "你喝下蜂蜜酒，感觉很舒服。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:6
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:6
msgctxt "location"
msgid "Stew filled bowl."
msgstr "装满炖肉的碗。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:7
msgctxt "location"
msgid "The stew tasts good - you feel better (+5 hits)."
msgstr "炖肉的味道不错——你感觉好些了（+5生命）。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:8
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:8
msgctxt "location"
msgid "Crates filled with wood chips."
msgstr "装满木屑的板条箱。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:9
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:9
msgctxt "location"
msgid "The sack is empty."
msgstr "袋子是空的。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:10
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:10
msgctxt "location"
msgid "The bowl is empty."
msgstr "碗是空的。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:11
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:11
msgctxt "location"
msgid "There is of nothing of value in the crates."
msgstr "板条箱里没有任何值钱的东西。"

#: mmmerge/Data/10LocLANG.T/ZDDB02.STR.py:12
#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:12
msgctxt "location"
msgid "The mead barrel is empty."
msgstr "蜂蜜酒桶是空的。"

#: mmmerge/Data/10LocLANG.T/ZDDB03.STR.py:7
msgctxt "location"
msgid "The stew tastes good - you feel better (+5 hits)."
msgstr "炖肉的味道不错——你感觉好些了（+5生命）。"

#: mmmerge/Data/10LocLANG.T/ZDDB04.STR.py:2
msgctxt "location"
msgid "Bench"
msgstr "长凳"

#: mmmerge/Data/10LocLANG.T/ZDDB04.STR.py:3
msgctxt "location"
msgid "You find a small wooden dowl."
msgstr "你找到了一根小木栓。"

#: mmmerge/Data/10LocLANG.T/ZDDB04.STR.py:5
msgctxt "location"
msgid "There seems to be a small hole in the crate."
msgstr "板条箱上似乎有个小孔。"

#: mmmerge/Data/10LocLANG.T/ZDDB04.STR.py:6
msgctxt "location"
msgid "You fit the dowl into the hole and a small key pops out."
msgstr "你把木栓插入孔中，弹出了一把小钥匙。"

#: mmmerge/Data/10LocLANG.T/ZDDB04.STR.py:7
msgctxt "location"
msgid "The crate is padlocked - you need a key."
msgstr "板条箱上了挂锁——你需要一把钥匙。"

#: mmmerge/Data/10LocLANG.T/ZDDB04.STR.py:8
msgctxt "location"
msgid "You fit the key into the padlock and it pops open."
msgstr "你把钥匙插入挂锁，锁应声弹开。"

#: mmmerge/Data/10LocLANG.T/ZDDB05.STR.py:2
msgctxt "location"
msgid "Crumbling boulder."
msgstr "摇摇欲坠的巨石。"

#: mmmerge/Data/10LocLANG.T/ZDDB05.STR.py:3
msgctxt "location"
msgid "The vent brings in fresh air."
msgstr "通风口带来了新鲜空气。"

#: mmmerge/Data/10LocLANG.T/ZDDB05.STR.py:4
msgctxt "location"
msgid "Poisonous spores force you back."
msgstr "毒孢子把你逼退了回去。"

#: mmmerge/Data/10LocLANG.T/ZDDB05.STR.py:5
msgctxt "location"
msgid "Vent."
msgstr "通风口。"

#: mmmerge/Data/10LocLANG.T/ZDDB05.STR.py:6
msgctxt "location"
msgid "The air smells stale and makes you cough."
msgstr "空气中弥漫着一股霉味，让你咳嗽起来。"

#: mmmerge/Data/10LocLANG.T/ZDDB05.STR.py:7
msgctxt "location"
msgid "A small nymph comes out of a hole in the floor thanking you for clearing the spores, he shakes your hand vigorously then disappears down the hole (which somehow disappears after him). +500 experience."
msgstr "一个小精灵从地板上的一个洞里钻出来，感谢你清除了孢子，他用力地和你握手，随后消失在那个洞里（那个洞也随之神秘地消失了）。+500经验。"

#: mmmerge/Data/10LocLANG.T/ZDDB05.STR.py:8
msgctxt "location"
msgid "Small switch."
msgstr "小开关。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:2
msgctxt "location"
msgid "The mine shakes and shifts around you."
msgstr "矿井震动起来，四周开始移位。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:3
msgctxt "location"
msgid "Looks like an earthquake hit this mine."
msgstr "这座矿井看起来像是遭遇过地震。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:4
msgctxt "location"
msgid "Water filled barrel."
msgstr "装满水的木桶。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:5
msgctxt "location"
msgid "Sack filled with mining equipment."
msgstr "装满采矿工具的袋子。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:6
msgctxt "location"
msgid "Mine"
msgstr "矿井"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:7
msgctxt "location"
msgid "This room looks really unstable."
msgstr "这个房间看起来非常不稳固。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:9
msgctxt "location"
msgid "As you pull the lever rocks fall from above."
msgstr "你拉动拉杆时，岩石从上方坠落。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:10
msgctxt "location"
msgid "You mine the gold with no problem."
msgstr "你毫无困难地采到了金子。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:11
msgctxt "location"
msgid "Some loose debris overhead falls on you."
msgstr "头顶上方的碎石掉落在你身上。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:12
msgctxt "location"
msgid "The vein dried up."
msgstr "矿脉已经枯竭。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:13
msgctxt "location"
msgid "You were fast enough to dodge the bigger rocks."
msgstr "你反应够快，躲开了较大的岩石。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:14
msgctxt "location"
msgid "Even though the water is dirty it still refreshes."
msgstr "虽然水很脏，但依然让人感到清爽。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:15
msgctxt "location"
msgid "The dirty water leaves a bad taste in your mouth."
msgstr "这脏水在你嘴里留下了一股难闻的味道。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:16
msgctxt "location"
msgid "The doors seem stuck."
msgstr "这扇门似乎卡住了。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:17
msgctxt "location"
msgid "The switch is locked in place."
msgstr "这个开关被锁死了，动不了。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:18
msgctxt "location"
msgid "Boulders."
msgstr "巨石"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:19
msgctxt "location"
msgid "This cave-in blocks any further access into the mine."
msgstr "这处塌方堵住了通往矿井深处的路。"

#: mmmerge/Data/10LocLANG.T/ZDDB06.STR.py:20
msgctxt "location"
msgid "Small rocks and debris fall from above. "
msgstr "小块岩石和碎屑从上方坠落。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:2
msgctxt "location"
msgid "There is a strong smell of gas pervading the air."
msgstr "空气中弥漫着一股浓烈的瓦斯味。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:3
msgctxt "location"
msgid "Small glittering pool."
msgstr "闪闪发光的小水潭。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:4
msgctxt "location"
msgid "The water cools you down."
msgstr "这水让你感到凉爽。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:5
#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:2
msgctxt "location"
msgid "Switch."
msgstr "开关"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:6
msgctxt "location"
msgid "The torches Ignite and so does the swamp gas."
msgstr "火把点燃了，沼气也随之被引燃。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:7
#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:11
msgctxt "location"
msgid "Hundreds of snakes crawl out of the floor and bite you."
msgstr "数百条蛇从地板里爬出来咬你。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:8
msgctxt "location"
msgid "Swamp gas forces you back couching and gagging."
msgstr "沼气把你逼得连连咳嗽、作呕，只得退了回去。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:9
msgctxt "location"
msgid "You drink the water, with no effect."
msgstr "你喝了水，没有任何效果。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:10
msgctxt "location"
msgid "The switch does not work."
msgstr "这个开关不管用。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:12
msgctxt "location"
msgid "A voice hisses -Walk the path of the snake-."
msgstr "一个声音嘶声说道——“走蛇之路”。"

#: mmmerge/Data/10LocLANG.T/ZDDB07.STR.py:13
msgctxt "location"
msgid "A voice whispers -I am the spirit of the swamp, congratulations, take what you may and leave in peace-"
msgstr "一个声音低语道：“我是沼泽之灵，恭喜你，你可以取走想要的东西，然后安然离去。”"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:2
msgctxt "location"
msgid "Shard filled caskets."
msgstr "装满碎片的匣子。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:3
msgctxt "location"
msgid "Barrel is filled with crystal shards (worthless)."
msgstr "木桶里装满了水晶碎片（毫无价值）。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:4
msgctxt "location"
msgid "Table with implements atop."
msgstr "桌上摆着一些工具。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:5
msgctxt "location"
msgid "You see a scattered of refining tools and small crystal shavings."
msgstr "你看到散落的精炼工具和细小的水晶碎屑。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:6
msgctxt "location"
msgid "Sacks."
msgstr "麻袋。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:7
msgctxt "location"
msgid "The sacks are filled with flawed crystal shards (worthless)."
msgstr "麻袋里装满了有瑕疵的水晶碎片（毫无价值）。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:8
msgctxt "location"
msgid "Crystal."
msgstr "记忆水晶"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:9
msgctxt "location"
msgid "You mine the crystal in its raw form (+300 gold)."
msgstr "你开采出了原始形态的水晶（+300金币）。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:10
msgctxt "location"
msgid "You refine the crystal you harvested (+200 to its value)."
msgstr "你提炼了采集到的水晶（价值+200）。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:11
msgctxt "location"
msgid "Someone has gone to a lot of trouble carving all these murals"
msgstr "有人费了很大工夫雕刻出这些壁画"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:12
msgctxt "location"
msgid " This razor sharp crystal is too immature to harvest."
msgstr " 这块锋利的水晶还未成熟，无法采集。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:13
msgctxt "location"
msgid "You study the mural and get a good feeling inside."
msgstr "你研究这幅壁画，心中涌起一股美好的感觉。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:14
msgctxt "location"
msgid "Carved mural."
msgstr "雕刻壁画。"

#: mmmerge/Data/10LocLANG.T/ZDDB08.STR.py:16
msgctxt "location"
msgid "The cabinet is filled with old and broken harvesting tools."
msgstr "柜子里装满了老旧破损的采集工具。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:3
msgctxt "location"
msgid "With some muscle you move the switch down."
msgstr "你使出力气，把开关往下推。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:4
msgctxt "location"
msgid "The switch is stuck, you need someone stronger to move it."
msgstr "开关卡住了，需要更强壮的人才能推动它。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:5
msgctxt "location"
msgid "Crates."
msgstr "木箱"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:6
msgctxt "location"
msgid "The crates are all empty."
msgstr "箱子都是空的。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:8
msgctxt "location"
msgid "You need a special key to open this door."
msgstr "你需要一把特殊的钥匙才能打开这扇门。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:10
msgctxt "location"
msgid "Light red liquid filled keg."
msgstr "小桶里装满了淡红色液体。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:11
msgctxt "location"
msgid "Your muscles expand as you take a drink."
msgstr "喝下之后，你的肌肉膨胀起来。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:12
msgctxt "location"
msgid "The liquid has lost its effectiveness."
msgstr "这液体已经失效。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:13
msgctxt "location"
msgid "You flip the switch and hear grating off in the distance."
msgstr "你扳动开关，听到远处传来摩擦刮擦声。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:14
msgctxt "location"
msgid "A skeletal knight steps out of a forming mist and says -To let you pass I will need you to say a prayer over my bones found close by, when this is done you can pass-"
msgstr "一个骷髅骑士从渐渐弥漫的迷雾中走出，说道：“要放你通过，你需要为我那些散落在附近的骸骨念一段祷词，完成之后你就可以通过了。”"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:15
msgctxt "location"
msgid "Old bones."
msgstr "古老的骨头"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:16
msgctxt "location"
msgid "The bones feel incredibly cold to the touch."
msgstr "这些骸骨摸起来冰冷刺骨。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:17
msgctxt "location"
msgid "You say a prayer over the bones. "
msgstr "你为这些骸骨念了一段祷词。 "

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:18
msgctxt "location"
msgid "The skeletal knight appears from the mist, nods and disappears into the mist again."
msgstr "骷髅骑士从迷雾中现身，点了点头，又消失在迷雾之中。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:19
msgctxt "location"
msgid "Something slimey moves behind this brick wall."
msgstr "有黏糊糊的东西在这堵砖墙后面移动。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:20
msgctxt "location"
msgid "Wall with missing bricks."
msgstr "墙上缺了几块砖。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:21
msgctxt "location"
msgid "You find a grey key where one of the bricks used to be."
msgstr "在缺失的砖块处，你找到了一把灰色钥匙。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:22
msgctxt "location"
msgid "You find a silver key where one of the bricks used to be."
msgstr "在缺失的砖块处，你找到了一把银色钥匙。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:23
msgctxt "location"
msgid "Chest."
msgstr "箱子"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:24
msgctxt "location"
msgid "You need a key to open this chest."
msgstr "你需要一把钥匙才能打开这个箱子。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:25
msgctxt "location"
msgid "A skeletal looking cleric steps out of a quick forming mist and says - I was tortured down here long ago and my bones were scattered throughout this level, I will let you pass only when you have destroyed what remains of me and return here, you will feel which bones they are when you see them...-  He fades away."
msgstr "一个骷髅模样的牧师从骤然弥漫的迷雾中走出，说道：“很久以前我在这里遭受折磨，我的骸骨散落在这一层各处，只有当你摧毁我的遗骸并回到这里，我才会放你通过，你一看到那些骸骨，就会知道是哪些……”说完便渐渐消散。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:26
msgctxt "location"
msgid "You find and destroy one of the clerics bones. "
msgstr "你找到并摧毁了牧师的一块骸骨。 "

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:27
msgctxt "location"
msgid "The cleric appears again and nods at you -Thank you I will never forget your kindness I can rest in peace at last -  He then fades away."
msgstr "牧师再次出现，向你点头道：“谢谢你，我永远不会忘记你的善举，我终于可以安息了。”说完便渐渐消散。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:28
msgctxt "location"
msgid "You get a bad feeling from the bones."
msgstr "你从这些骸骨中感到一阵不祥的预感。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:29
msgctxt "location"
msgid "Iron Maiden"
msgstr "铁处女"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:30
msgctxt "location"
msgid "There's nothing but spikes in the Iron maiden."
msgstr "铁处女里除了尖刺什么都没有。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:31
msgctxt "location"
msgid "You search the Burial niche and find some gold."
msgstr "你搜查了墓龛，找到了一些金币。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:32
msgctxt "location"
msgid "The bones seems to charge with electricity !!."
msgstr "这些骸骨似乎带上了电！！。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:33
msgctxt "location"
msgid "These are really old bones...really old."
msgstr "这些骸骨真的很古老……非常古老。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:34
msgctxt "location"
msgid "You gain knowledge from these ancient bones."
msgstr "你从这些古老的骸骨中获得了知识。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:35
msgctxt "location"
msgid "Long dead adventurer."
msgstr "早已死去的冒险者。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:36
msgctxt "location"
msgid "You search the body and find some gold."
msgstr "你搜查了尸体，找到了一些金币。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:38
msgctxt "location"
msgid "A mist forms and a shadowy figure of a skeletal noblemen steps in front of you saying -The undead are restless in this tomb, before I can let you leave you must visit each one of them- the noblemen shoves you back and then vanishes."
msgstr "迷雾弥漫开来，一个骷髅贵族的阴影出现在你面前，说道：“这座墓穴中的不死生物躁动不安，在我放你离开之前，你必须逐一拜访他们。”那贵族将你推开，随即消失不见。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:39
msgctxt "location"
msgid "The skeletal noblemen appears from the mist, nods his head, then vanishes."
msgstr "骷髅贵族从迷雾中现身，点了点头，随即消失不见。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:41
msgctxt "location"
msgid "Skeleton in a cage."
msgstr "笼子里的骷髅。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:42
msgctxt "location"
msgid "The skeleton grabs for you."
msgstr "这具骷髅向你伸手抓来。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:43
msgctxt "location"
msgid "A strange force reaches out of the wall and grabs you."
msgstr "一股奇怪的力量从墙里伸出，抓住了你。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:46
msgctxt "location"
msgid "You find some half decent food in the sack."
msgstr "你在麻袋里找到了一些还算过得去的食物。"

#: mmmerge/Data/10LocLANG.T/ZDDB10.STR.py:47
msgctxt "location"
msgid "A scrawled message on the brick reads   2=1  3=2  1=3"
msgstr "砖块上潦草地写着一条讯息：2=1  3=2  1=3"

#: mmmerge/Data/10LocLANG.T/ZDTL01.STR.py:4
msgctxt "location"
msgid "Dresser"
msgstr "梳妆台"

#: mm6/mm6lang.ini.py:9 mm7/mm7lang.ini.py:11
msgctxt "mm_lang.ini"
msgid "Select a spell then click here to set an Attack Spell"
msgstr "选择一个法术，然后点击这里将其设为攻击法术"

#: mm6/mm6lang.ini.py:10 mm7/mm7lang.ini.py:12
msgctxt "mm_lang.ini"
msgid "Set %s as the Attack Spell"
msgstr "将%s设为攻击法术"

#: mm6/mm6lang.ini.py:11 mm7/mm7lang.ini.py:13
msgctxt "mm_lang.ini"
msgid "Set as Attack Spell (instead of %s)"
msgstr "设为攻击法术（替代%s）"

#: mm6/mm6lang.ini.py:12 mm7/mm7lang.ini.py:14 mm8/mm8lang.ini.py:12
#: mmmerge/mm8lang.ini.py:12
msgctxt "mm_lang.ini"
msgid "Remove Attack Spell (%s)"
msgstr "移除攻击法术（%s）"

#: mm6/mm6lang.ini.py:13 mm7/mm7lang.ini.py:22 mm8/mm8lang.ini.py:20
#: mmmerge/mm8lang.ini.py:20
msgctxt "mm_lang.ini"
msgid "N/A"
msgstr "无"

#: mm7/mm7lang.ini.py:10
msgctxt "mm_lang.ini"
msgid "%s stole an item (%s)!"
msgstr "%s偷走了一件物品（%s）！"

#: mm7/mm7lang.ini.py:15 mm8/mm8lang.ini.py:13 mmmerge/mm8lang.ini.py:13
msgctxt "mm_lang.ini"
msgid "Duration:"
msgstr "持续时间："

#: mm7/mm7lang.ini.py:16 mm8/mm8lang.ini.py:14 mmmerge/mm8lang.ini.py:14
msgctxt "mm_lang.ini"
msgid " %d:yr"
msgstr " %d:年"

#: mm7/mm7lang.ini.py:17 mm8/mm8lang.ini.py:15 mmmerge/mm8lang.ini.py:15
msgctxt "mm_lang.ini"
msgid " %d:mo"
msgstr " %d:月"

#: mm7/mm7lang.ini.py:18 mm8/mm8lang.ini.py:16 mmmerge/mm8lang.ini.py:16
msgctxt "mm_lang.ini"
msgid " %d:dy"
msgstr " %d:日"

#: mm7/mm7lang.ini.py:19 mm8/mm8lang.ini.py:17 mmmerge/mm8lang.ini.py:17
msgctxt "mm_lang.ini"
msgid " %d:hr"
msgstr " %d:时"

#: mm7/mm7lang.ini.py:20 mm8/mm8lang.ini.py:18 mmmerge/mm8lang.ini.py:18
msgctxt "mm_lang.ini"
msgid " %d:mn"
msgstr " %d:分"

#: mm7/mm7lang.ini.py:21 mm8/mm8lang.ini.py:19 mmmerge/mm8lang.ini.py:19
msgctxt "mm_lang.ini"
msgid "Energy"
msgstr "能量药剂"

#: mm8/mm8lang.ini.py:9 mmmerge/mm8lang.ini.py:9
msgctxt "mm_lang.ini"
msgid "No Attack Spell"
msgstr "无攻击法术"

#: mm8/mm8lang.ini.py:10 mmmerge/mm8lang.ini.py:10
msgctxt "mm_lang.ini"
msgid "Set as Attack Spell"
msgstr "设为攻击法术"

#: mm8/mm8lang.ini.py:11 mmmerge/mm8lang.ini.py:11
msgctxt "mm_lang.ini"
msgid "Change Attack Spell (%s)"
msgstr "更改攻击法术（%s）"

#: mmmerge/Data/Text localization/LANG_MessageScrolls.txt.py:65
msgctxt "scroll"
msgid "Essence of Might increases a character’s Might by 15, while subtracting 5 from his Intellect. This potion requires six reagents to mix, four of any one color supplemented by one from each of the remaining colors."
msgstr "力量精髓药剂一次性增加15点角色的力量，减5点智力。这种药剂需要至少6个试剂作为配方，这包括任意某种颜色的试剂4个，外加另两种颜色的试剂各一个。"

#: mmmerge/Data/Text localization/LANG_MessageScrolls.txt.py:66
msgctxt "scroll"
msgid "Essence of Intellect increases a character’s Intellect by 15, while subtracting 5 from his Might. This potion requires six reagents to mix, four of any one color supplemented by one from each of the remaining colors."
msgstr "智力精髓药剂一次性增加15点角色的智力，减5点力量。这种药剂需要至少6个试剂作为配方，这包括任意某种颜色的试剂4个，外加另两种颜色的试剂各一个。"

#: mmmerge/Data/Text localization/LANG_MessageScrolls.txt.py:67
msgctxt "scroll"
msgid "Essence of Personality increases a character’s Personality by 15, while subtracting 5 from his Speed. This potion requires six reagents to mix, four of any one color supplemented by one from each of the remaining colors."
msgstr "个性精髓药剂一次性增加15点角色的个性，减5点速度。这种药剂需要至少6个试剂作为配方，这包括任意某种颜色的试剂4个，外加另两种颜色的试剂各一个。"

#: mmmerge/Data/Text localization/LANG_MessageScrolls.txt.py:68
msgctxt "scroll"
msgid "Essence of Accuracy increases a character’s Accuracy by 15, while subtracting 5 from his Endurance. This potion requires six reagents to mix, four of any one color supplemented by one from each of the remaining colors."
msgstr "精确精髓药剂一次性增加15点角色的精确，减5点耐力。这种药剂需要至少6个试剂作为配方，这包括任意某种颜色的试剂4个，外加另两种颜色的试剂各一个。"

#: mmmerge/Data/Text localization/LANG_MessageScrolls.txt.py:69
msgctxt "scroll"
msgid "Essence of Endurance increases a character’s Endurance by 15, while subtracting 5 from his Accuracy. This potion requires six reagents to mix, four of any one color supplemented by one from each of the remaining colors."
msgstr "耐力精髓药剂一次性增加15点角色的耐力，减5点精确。这种药剂需要至少6个试剂作为配方，这包括任意某种颜色的试剂4个，外加另两种颜色的试剂各一个。"

#: mmmerge/Data/Text localization/LANG_MessageScrolls.txt.py:70
msgctxt "scroll"
msgid "Essence of Speed increases a character’s Speed by 15, while subtracting 5 from his Personality. This potion requires six reagents to mix, four of any one color supplemented by one from each of the remaining colors."
msgstr "速度精髓药剂一次性增加15点角色的速度，减5点个性。这种药剂需要至少6个试剂作为配方，这包括任意某种颜色的试剂4个，外加另两种颜色的试剂各一个。"
