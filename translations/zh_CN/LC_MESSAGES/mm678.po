#: mmmerge/Data/10LocLANG.T/Spells.txt.py:7
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:7
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:7
msgctxt "spells"
msgid "Duration 1 hour + 4 minutes per skill point"
msgstr "持续时间为魔法等级乘以4分钟再加1小时"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Drops a Fire Spike on the ground that waits for a creature to get near it before exploding.  Fire Spikes last until you leave the map or they are triggered."
msgstr "在地上设下埋伏，敌人走过时就会爆炸。直到你离开地图它们才会消失。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Causes 1-6 points of damage per point of skill, 5 spikes maximum"
msgstr "每次最多可以使用5个。施法者每提高一个火系魔法等级可以增加1-6点杀伤力"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Causes 1-8 points of damage per point of skill, 7 spikes maximum"
msgstr "每次最多可以使用7个。施法者每提高一个火系魔法等级可以增加1-8点的杀伤力"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Causes 1-10 points of damage per point of skill, 9 spikes maximum"
msgstr "每次最多可以使用9个。施法者每提高一个火系魔法等级可以增加1-10点的杀伤力"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:10
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:10
msgctxt "spells"
msgid "Surrounds your characters with a very hot fire that is only harmful to others.  The spell will deliver 1-6 points of damage per point of skill to all nearby monsters for as long as they remain in the area of effect. "
msgstr "在你的队伍周围罩上一层烈火以伤害敌人。施法者每提高一个火系魔法等级可以增加1-6点的杀伤力。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:10
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:10
msgctxt "spells"
msgid "Duration 1 minute per point of skill"
msgstr "持续时间是施法者火系魔法等级乘以1分钟"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:11
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:11
msgctxt "spells"
msgid "Moderate rate of recovery and 16 meteors"
msgstr "召唤16个流星攻击敌人。恢复速度一般"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:11
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:11
msgctxt "spells"
msgid "Fast rate of recovery and 20 rocks"
msgstr "可召唤20个流星。快速恢复"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:12
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:12
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:12
msgctxt "spells"
msgid "Fast rate of recovery"
msgstr "快速恢复"

