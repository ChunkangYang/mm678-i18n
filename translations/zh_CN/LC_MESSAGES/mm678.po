#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:677
msgctxt "items"
msgid "Quest Item:  A small black cube of an unidentifiable metal."
msgstr "要寻找的物品：神奇的晶体，材料不明。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1479
