#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1479
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1480
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:678
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:679
msgctxt "items"
msgid "Quest Item:  A strange object made of an unfamiliar purplish metal.  It appears to only half complete."
msgstr "要寻找的物品：由一种略带紫色的金属做成的奇异物品，看来只完成了一半。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1486
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:685
msgctxt "items"
msgid "Map to Evenmorn Island"
msgstr "埃弗蒙岛的地图"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:687
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1489
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:689
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:688
msgctxt "items"
msgid "Iron-laced ore"
msgstr "铁矿石"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:687
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:688
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:689
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:690
