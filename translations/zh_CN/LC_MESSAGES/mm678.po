#: mm6/data/10LocLANG.icons/Spells.txt.py:58
msgctxt "spells"
msgid "Duration 1 hour + 5 minutes per point of skill"
msgstr "持续时间为1小时加上5分钟乘以魔法等级"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:43
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:56
