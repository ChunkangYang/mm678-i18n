#: mm6/data/10LocLANG.icons/Spells.txt.py:32
#: mm6/data/10LocLANG.icons/Spells.txt.py:48
msgctxt "spells"
msgid "Duration 10 minutes per point of skill"
msgstr "持续时间为十分钟乘以魔法等级"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:20
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:20
#: mm6/data/10LocLANG.icons/Spells.txt.py:21
msgctxt "spells"
msgid "Halves damage from incoming ranged attacks (such as rocks and arrows) by slowing the missiles down just before they hit."
msgstr "它能减慢飞弹的速度，从而使远距离攻击性武器（如弓箭，岩石等）的攻击力减半。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:43
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:56
