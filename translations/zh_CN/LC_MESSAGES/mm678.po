msgid "A fine Erathian steel broadsword of excellent quality and edge."
msgstr "精巧的埃拉西亚钢质宽刃剑。质量优异，异常锋利。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1614
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:14
msgctxt "items"
msgid "Mighty Broadsword"
msgstr "力量之剑"

