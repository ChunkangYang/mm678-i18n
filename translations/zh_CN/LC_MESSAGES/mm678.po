#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:38
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:39
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:40
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:39
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:40
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:41
msgctxt "items"
msgid "Halberd"
msgstr "戟"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1639
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:39
msgctxt "items"
msgid "Combination poleax and spear, the halberd can inflict terrible wounds, but recovers slowly from swings.  This one is of average quality and workmanship (+1D6 if used two-handed)."
msgstr "它集战斧和长矛于一身，杀伤力巨大，但需较长的恢复时间。它质量一般，造型古朴（双手使用时+1D6）。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1640
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:40
msgctxt "items"
msgid "Massive Halberd"
msgstr "宽戟"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1640
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:40
msgctxt "items"
msgid "Of solid construction, this halberd has a particularly heavy blade.  Wielded by a mighty warrior, it could surely be used to slay the toughest of monsters (+1D6 if used two-handed)."
msgstr "此兵器坚硬无比，锋刃经特殊处理，特别沉重。如果由力大无比的勇士使用，可杀死最难对付的怪兽（双手使用时+1D6）。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1641
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:41
msgctxt "items"
msgid "Elite Halberd"
msgstr "精英之戟"

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:41
msgctxt "items"
msgid "A small stamp on the blade of this weapon indicates it was constructed in the famous Mekorig Foundry by the master himself, Mekorig the Blind.  You would be hard pressed to find a finer Halberd anywhere in the world (+1D6 if used two-handed)."
msgstr "此兵器锋刃上的标记说明它是由闻名遐迩的麦克林兵器锻造厂的老板，盲师麦克林亲手打造的。它乃是天下一流的长戟（双手使用时+1D6）。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:52
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:53
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:54
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:55
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:56
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:842
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:843
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:844
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1642
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1643
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1644
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:56
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:57
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:58
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:41
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:42
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:43
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:42
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:43
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:44
msgctxt "items"
msgid "Trident"
msgstr "三叉戟"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1642
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:42
msgctxt "items"
msgid "Common war tridents, like this one, are good quality weapons issued by the Imperial Regnan Navy to facilitate the collection of Imperial tariffs on the high seas.  Most merchants and other governments refer to this activity as piracy…(+1D6 if used two-handed)."
msgstr "这种战斗三叉戟质量上乘，由雷格那的帝国海军专用，他们经常持此兵器在公海巡逻，向来往船只征收关税。许多商人和各地的首领都认为这是一种海盗行为（双手使用时+1D6）。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1643
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:43
msgctxt "items"
msgid "Ornate Trident"
msgstr "簪银三叉戟"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1643
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:43
msgctxt "items"
msgid "A high quality war trident of the style given to officers of the Imperial Regnan Navy.  This one was probably taken from the officer during an Imperial Taxation battle that went poorly for the Navy (+1D6 if used two-handed)."
msgstr "一把高质量的战斗三叉戟，专为雷格那的帝国海军军官设计。这把三叉戟可能是在某次帝国税务战争海军失利后，从军官那里夺来的（双手使用时+1D6）。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1644
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:44
msgctxt "items"
msgid "Titanic Trident"
msgstr "巨型三叉戟"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1644
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:44
msgctxt "items"
msgid "This beautiful trident is mostly made of Kergar, a rare, bluish metal that does not rust or lose its edge over time (+1D6 if used two-handed)."
msgstr "此件精美的三叉戟由科尔——一种罕见的蓝色金属——打制而成。它不会生锈，也不会随着时间的推移而缺刃（双手使用时+1D6）。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:845
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:846
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:847
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:848
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:849
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1645
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1646
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1647
