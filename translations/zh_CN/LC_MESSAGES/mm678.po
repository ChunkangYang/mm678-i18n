#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:65
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:66
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:67
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:68
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:535
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:49
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:50
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:51
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:50
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:51
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:52
msgctxt "items"
msgid "Crossbow"
msgstr "十字弓"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1650
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:50
msgctxt "items"
msgid "Crossbows are the deadliest ranged weapons made since the Time of Wonders.  This crossbow is made of stout Yew wood and metal fixtures, but is otherwise rather ordinary."
msgstr "十字弓是从奇迹时代以来最致命的远距离杀伤性武器。它由坚硬的水杉木和金属混合制成，是件普通的兵器。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1651
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:51
msgctxt "items"
msgid "Accurate Crossbow"
msgstr "精准十字弓"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:851
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:50
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:51
msgctxt "items"
msgid "These crossbows were stockpiled by Archibald just prior to the Succession War for use against his brother.  As with most decisions involving death, Archibald chose wisely.  These crossbows are amongst the best in the land."
msgstr "阿基巴德为发动与其兄弟罗兰德争夺王位的战争，大量囤积此类十字弓。阿基巴德没有选错，它们是天下质量最好，杀伤力最强大的弓箭。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1652
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:52
msgctxt "items"
msgid "True Crossbow"
msgstr "地道十字弓"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1652
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:51
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:52
msgctxt "items"
msgid "Equipped with a hand crank and shaft sights, these exceptional crossbows are superior to all that have come before.  Just where they are coming from is a mystery at this time…"
msgstr "这些十字弓有曲柄和雕花图案，是威力最强大的弓箭。它们出自哪位大师之手至今仍是个迷。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:67
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:69
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:70
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:71
