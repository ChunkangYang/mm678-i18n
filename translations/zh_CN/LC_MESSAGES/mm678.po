#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:666
msgctxt "autonote or awards"
msgid "Won Arcomage at the Emerald Inn in The Tularian Forest."
msgstr "在图拉利昂森林的翡翠旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:667
msgctxt "autonote or awards"
msgid "Won Arcomage at the The Snobbish Goblin in Deyja."
msgstr "在迪雅的怪物旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:668
msgctxt "autonote or awards"
msgid "Won Arcomage at the Familiar Place in The Bracada Desert."
msgstr "在布拉卡达沙漠的宾至如归旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:669
msgctxt "autonote or awards"
msgid "Won Arcomage at The Blessed Brew in Celeste."
msgstr "在塞莱斯特的美酒佳肴旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:670
msgctxt "autonote or awards"
msgid "Won Arcomage at The Vampyre Lounge in The Pit."
msgstr "在地狱城的吸血鬼会馆赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:671
msgctxt "autonote or awards"
msgid "Won Arcomage at The Laughing Monk in Evenmorn Island."
msgstr "在埃弗蒙岛的法师旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:672
msgctxt "autonote or awards"
msgid "Won Arcomage at Fortune's Folly in Mount Nighon."
msgstr "在尼根山脉的幸运旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:673
msgctxt "autonote or awards"
msgid "Won Arcomage at Miner's Only in The Barrow Downs."
msgstr "在拜尔德斯的矿工旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:674
msgctxt "autonote or awards"
msgid "Won Arcomage at The Loyal Mercenary in Tatalia."
msgstr "在泰塔利亚的忠诚佣兵旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:675
msgctxt "autonote or awards"
msgid "Won Arcomage at The Potted Pixie in Avlee."
msgstr "在埃里的勇士旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:676
msgctxt "autonote or awards"
msgid "Won Arcomage at Grogg's Grog in Stone City."
msgstr "在石头城的克劳格旅店赢得了魔幻牌比赛。"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:677
msgctxt "autonote or awards"
msgid "Essence of Might = Remove Fear + Heroism"
msgstr "力量精髓药剂 = 驱逐恐惧药剂 + 天赐神力药剂"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:679
msgctxt "autonote or awards"
msgid "Essence of Personality = Remove Fear + Haste"
msgstr "个性精髓药剂 = 驱逐恐惧药剂 + 攻击加速药剂"

#: mmmerge/Data/Text localization/LANG_AutonoteTxt.txt.py:680
msgctxt "autonote or awards"
msgid "Essence of Endurance = Remove Curse + Recharge Item"
