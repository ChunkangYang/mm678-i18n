#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1609
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:9
msgctxt "items"
msgid "A basic two-handed sword.  Thousands of these low quality weapons can be found throughout Enroth."
msgstr "可双手使用的一般铁剑，在恩洛斯随处可见。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:810
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:9
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:10
msgctxt "items"
msgid "Great Sword"
msgstr "霸王剑"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1610
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:10
msgctxt "items"
msgid "Yet another simple two-handed sword, this barbarian's weapon sports a wavy blade and an extra cross piece.  Its construction is sturdy and the blade is sharp."
msgstr "也是双手使用的铁剑，但锋刃较宽，呈十字形，这样杀伤力较大。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:811
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:10
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:11
