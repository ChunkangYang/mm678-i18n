msgid "This spell is as good as it will ever get!"
msgstr "强得不能再强了！"

#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:15
msgctxt "spells"
msgid "Shows 'points of interest'"
msgstr "显示“值得一去”的地点"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:15
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:15
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:15
msgctxt "spells"
msgid "Casting cost is free"
msgstr "不消耗魔法值"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:17
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:17
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:17
msgctxt "spells"
msgid "Air Resist"
msgstr "御风奇术"

#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:17
msgctxt "spells"
msgid "Increases all your characters’ resistance to air magic by an amount equal to your skill in Air and lasts one hour per point of skill."
msgstr "增加所有角色的风系抗性。增加的抗性等于空气魔法技能等级。魔法持续时间等于空气魔法技能等级乘以1小时。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
msgctxt "spells"
msgid "Faster recovery rate, 7 sparks"
msgstr "快速恢复，发射7个光球"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
msgctxt "spells"
msgid "Fastest recovery rate, 9 sparks"
msgstr "恢复最快，发射9个光球"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:43
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:52
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:57
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:20
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:43
