#: mm6/data/10LocLANG.icons/Spells.txt.py:69
msgctxt "spells"
msgid "Calms a single targeted creature and removes any hostile feelings it has towards your characters.  If this creature takes any damage, it will immediately become hostile again."
msgstr "可以使单一目标平息怒气，消除对你的敌意。但如果它遭到攻击，将立刻重新还击。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:104
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:104
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:104
#: mm6/data/10LocLANG.icons/Spells.txt.py:69
#: mm6/data/10LocLANG.icons/Spells.txt.py:102
msgctxt "spells"
msgid "Duration 3 minutes per point of skill"
msgstr "持续时间为3分钟乘以魔法等级"

#: mm6/data/10LocLANG.icons/Spells.txt.py:69
msgctxt "spells"
msgid "Duration 6 minutes per point of skill"
msgstr "持续时间为6分钟乘以魔法等级"

#: mm6/data/10LocLANG.icons/Spells.txt.py:69
msgctxt "spells"
msgid "Duration 12 minutes per point of skill"
msgstr "持续时间为12分钟乘以魔法等级"

#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:70
#: mm6/data/10LocLANG.icons/Spells.txt.py:70
msgctxt "spells"
msgid "All creatures in the caster’s sight fear the caster and flee.  If a creature takes damage while under the influence of this spell, the spell will be broken.  Mass Fear will not work on Undead creatures.  The duration of Mass Fear is 3 minutes per point of skill in Mind Magic."
msgstr "可以使你视野范围内的怪物全部望风而逃。但如果怪兽遭到攻击，此咒会立刻失效。该魔法对亡灵怪兽无能为力。它的有效时间为3分钟乘以魔法等级。"

#: mm6/data/10LocLANG.icons/Spells.txt.py:71
msgctxt "spells"
msgid "Feeblemind removes the ability of a target to cast spells until this spell wears out.  The duration of this spell is 5 minutes per point of skill in Mind Magic"
msgstr "该魔法可以使目标丧失施展魔法的能力。有效时间为5分钟乘以魔法等级。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:71
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:71
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:71
#: mm6/data/10LocLANG.icons/Spells.txt.py:72
msgctxt "spells"
msgid "Cure Insane"
msgstr "治愈痴狂"

