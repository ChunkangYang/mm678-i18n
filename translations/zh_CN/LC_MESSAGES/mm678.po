msgid "Ability to use a spear in one hand."
msgstr "可以单手挥舞长矛"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:8
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:8
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:8
msgctxt "skilldes"
msgid "Chance to paralyze equal to skill."
msgstr "可以将敌人麻痹，其概率百分比等于技能等级"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:9
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:9
msgctxt "skilldes"
msgid "Skill added to Attack Bonus (quintuple effect)"
msgstr "技能等级可增加攻击点数（效果乘以4）"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:10
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:10
msgctxt "skilldes"
msgid "Protection as per Shield spell."
msgstr "相当于施展“护体神盾”魔法"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:11
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:11
msgctxt "skilldes"
msgid "Skill added to Elemental (Fire/Earth/Air/Water) Resistances."
msgstr "技能等级可增加元素（火系/水系/风系/土系）抗性"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:12
#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:12
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:13
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:12
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:13
msgctxt "skilldes"
msgid "Recovery penalty halved"
msgstr "恢复时间减半"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:12
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:12
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:12
msgctxt "skilldes"
msgid "Receive 2/3 damage from physical attacks."
msgstr "使经受的物理攻击伤害减少三分之一"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:13
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:13
msgctxt "skilldes"
msgid "Receive 1/2 damage from physical attacks."
msgstr "使经受的物理攻击伤害减少二分之一"

#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:21
msgctxt "skilldes"
msgid "Light magic spells represent some of the strongest spells in Erathia.  Usable only by Clerics and Sorcerers, light magic cannot be chosen before creating your characters; rather, light magic must be learned and mastered during your travels."
msgstr "光明魔法是游戏中威力最强的魔法技能之一，只有牧师和巫师方能使用。你的队员在游戏开始时不能学习这类魔法，只能在探险途中掌握。"

#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:22
msgctxt "skilldes"
msgid "Dark magic spells are the strongest spells in Erathia.  While casting spells of darkness can have spectacular results, dark spells sometimes come with unwanted side effects…  Dark magic cannot be chosen before creating your characters, and is restricted to Clerics and Sorcerers."
msgstr "暗黑魔法是游戏中最强大的魔法技能，只限于牧师和巫师使用。虽然暗黑魔法能产生惊人的效果，但有时会带来意想不到的负面效应。你的队员在游戏开始时不能学习这类魔法。"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:26
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:26
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:23
msgctxt "skilldes"
msgid "Ability to identify items"
msgstr "可以鉴定物品"

