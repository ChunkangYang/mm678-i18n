msgctxt "location"
msgid "Tree"
msgstr "Strom"

#: mmmerge/Data/10LocLANG.T/CD1.STR.py:10
#: mm6/data/10LocLANG.icons/CD1.STR.py:10
msgctxt "location"
msgid ""
"Etched into the tree a message reads:"
"                                                                                                                                                                                                                              "
"The first is half the forth plus one, better hurry or you'll be done!"
msgstr ""
"Do stromu vyrytá zpráva:"
"                                                                                                                                                                                                                             "
"První je půlka čtvrtého plus jedna, radši mákni, sic si v kelu!"

#: mmmerge/Data/10LocLANG.T/CD1.STR.py:11
#: mm6/data/10LocLANG.icons/CD1.STR.py:11
msgctxt "location"
msgid ""
"Etched into the tree a message reads:"
"                                                                                                                                                                                                                              "
"The second is next to the third, oh so pretty like a bird!"
msgstr ""
"Do stromu vyrytá zpráva:"
"                                                                                                                                                                                                                             "
"Druhý je vedle třetího, je tak krásný - jako ptáček!"

#: mmmerge/Data/10LocLANG.T/CD1.STR.py:12
#: mm6/data/10LocLANG.icons/CD1.STR.py:12
msgctxt "location"
msgid ""
"Etched into the tree a message reads:"
"                                                                                                                                                                                                                              "
"The third is the first of twenty six, A through Z you'll have to mix!"
msgstr ""
"Do stromu vyrytá zpráva:"
"                                                                                                                                                                                                                             "
"Třetí je první z šestadvaceti, od A do Zet, musíš to promíchat!"

#: mmmerge/Data/10LocLANG.T/CD1.STR.py:13
#: mm6/data/10LocLANG.icons/CD1.STR.py:13
msgctxt "location"
msgid ""
"Etched into the tree a message reads:"
"                                                                                                                                                                                                                              "
"The fifth is twice the second, five letters in all I reckon!"
msgstr ""
"Do stromu vyrytá zpráva:"
"                                                                                                                                                                                                                             "
"Pátý je dvakrát druhý, pět písmen, jak jsem spočítal!"

#: mmmerge/Data/10LocLANG.T/CD1.STR.py:14
#: mm6/data/10LocLANG.icons/CD1.STR.py:14
msgctxt "location"
msgid ""
"Etched into the tree a message reads:"
"                                                                                                                                                                                                                              "
"The forth is eight from the end, Archibald really is your friend!"
msgstr ""
"Do stromu vyrytá zpráva:"
"                                                                                                                                                                                                                             "
"Čtvrtý je osmý od konce, Archibald je vážně tvůj přítel!"

