#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid ""
"Causes a weapon that has no special abilities to burn with a magical fire, "
"giving the weapon the \"of Fire\" ability.  This spell lasts for one hour "
"per point of skill in Fire Magic."
msgstr ""
"Způsobí, že zbraň, která nemá žádnou speciální vlastnost, začne hořet "
"magickým ohněm. Zbrani přidá vlastnost '...Ohně'. Kouzlo trvá jednu hodinu "
"za bod dovednosti magie ohně."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid "Grants \"of Fire\""
msgstr "Dává vlastnost \"...Ohně\""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid "Grants \"of Flame\""
msgstr "Dává vlastnost \"...Plamene\""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
msgid "Grants \"of Infernos\""
msgstr "Dává vlastnost \"...Pekla\""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:6
msgctxt "spells"
