msgid "Triple effect of skill"
msgstr "Efekt se ztrojnásobuje"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:26
#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:28
