msgid "Detect Life"
msgstr "Odhalení života"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
msgctxt "spells"
msgid ""
"Allows the party to see an opponent's current health as an exact hit point "
"number when you right-click on a creature."
msgstr ""
"Umožňuje družině vidět protivníkovo aktuální zdraví jako určité číslo."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:51
msgctxt "spells"
msgid "Duration 10 minutes per point of skill."
msgstr "Doba trvání 10 minut za bod dovednosti."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:112
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
