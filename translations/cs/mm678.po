msgctxt "items"
msgid "Amber"
msgstr "Jantar"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:181
msgctxt "items"
msgid ""
"A Jadamean amber, stilled and neatly cut. As a gem quality stone it has no "
