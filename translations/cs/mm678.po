#: mmmerge/Data/10LocLANG.T/Spells.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:10
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:10
msgctxt "spells"
msgid ""
"Surrounds your characters with a very hot fire that is only harmful to "
"others.  The spell will deliver 1-6 points of damage per point of skill to "
"all nearby monsters for as long as they remain in the area of effect. "
msgstr ""
"Obklopí tvé postavy velmi horkým ohněm, které je zraňující pouze pro "
"ostatní. Kouzlo způsobuje 1-6 bodů zranění za bod dovednosti všem blízkým "
"nestvůrám tak dlouho, dokud zůstanou v blízkosti. "

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:10
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:10
