#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:446
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:447
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:448
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:449
msgctxt "items"
msgid "Gem"
msgstr "Krystal"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:624
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:626
msgctxt "items"
msgid ""
"Quest Item: This large ruby is of perfect quality, clear throughout with an "
"even pigeon blood red. It contains a powerful enchantment and pulses with a "
"slumbering heartbeat rhythm."
msgstr ""
"Úkolový předmět: Tento velký rubín je dokonalé kvality, jasně červené barvy "
"holubí krve. Obsahuje mocné okouzlení a pulzuje v rytmu dřímajícího srdce."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:625
msgctxt "items"
msgid "Charged connector stone"
msgstr "Nabitý spojovací kámen"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:625
msgctxt "items"
msgid "Smooth half-transparent connector stone charged by time traveling."
msgstr "Hladký poloprůhledný spojovací kámen nabitý cestováním časem."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:626
msgctxt "items"
msgid "Connector stone"
msgstr "Spojovací kámen"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:626
msgctxt "items"
msgid "Smooth stone without specific color."
msgstr "Hladký kámen bez určité barvy."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:627
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:629
msgctxt "items"
msgid "Prophecies of the Sun"
msgstr "Proroctví slunce"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:627
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:629
msgctxt "items"
msgid ""
"Quest Item: The writing inside this book reads like the ranting of a madman."
" Still, someone must have thought highly of it. The text is entirely hand "
"scribed in a florid style. Inset illuminations bring to life scenes from the"
" story which are, in turn, disturbing, outlandish or seemingly drawn from "
"nightmare."
msgstr ""
"Úkolový předmět: Text této knihy vypadá, jako by ji napsal nějaký "
"vychloubačný šílenec. Přesto se však našel někdo, kdo si tohoto proroctví "
"váží. Text knihy je psán rukou v květnatém stylu. Vložené ilustrace "
"zobrazují scény popisovaných povídek. Některé působí rušivě, jiné vypadají "
"exoticky a další jsou jako vystřižené z nočních můr."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:628
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:630
msgctxt "items"
msgid "Remains of Korbu"
msgstr "Korbuovy ostatky"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:628
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:630
msgctxt "items"
msgid "Remains"
msgstr "Pozůstatky"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:628
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:630
msgctxt "items"
msgid ""
"Quest Item: The remains of Korbu who some claim was the most powerful "
"vampire of all times. He's not much to look at now, however. His skeleton "
"has been almost completely dismantled--either by design or the ravages of "
"time, and a wooden stake is nestled entirely within the ribcage."
msgstr ""
"Úkolový předmět: Pozůstatky Korbu, o kterém někteří tvrdí, že byl "
"nejmocnějším upírem všech dob. Nicméně teď na to nevypadá. Jeho kostra je "
"skoro rozpadlá - buď působením času nebo cizím zaviněním. Mezi jeho žebry "
"totiž nápadně vyčnívá dřevěný kůl."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:629 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1404 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1418
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:603
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:617
msgctxt "items"
msgid "Lich Jar"
msgstr "Lichova nádoba"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:629 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1404 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1418 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1431
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:631
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:603
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:617
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:630
msgctxt "items"
msgid "Jar"
msgstr "Džbán"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:629
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:631
msgctxt "items"
msgid "Quest Item: A well made jar."
msgstr "Úkolový předmět: Řemeslně zpracovaný džbán."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:630
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:632
msgctxt "items"
msgid "Ring of Keys"
msgstr "Svazek klíčů"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:630
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:632
msgctxt "items"
msgid ""
"Quest Item: Both the keys and ring are made of a metal you've never "
"encountered before. The gemstones inset in the key heads are familiar to "
"you. They are elemental heartstones like those incorporated in the conflux "
"key Xanthor made for you."
msgstr ""
"Úkolový předmět: Klíče i kroužek jsou vyrobeny z neznámého kovu, jaký jsi "
"ještě nikdy neviděl. Drahokamy zdobící hlavy klíčů ti připadají povědomě. "
"Jsou to totiž kamenná srdce elementů, stejná jaké Xanthor zasadil do Klíče "
"splynutí, který pro tebe vyrobil."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:631
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:633
msgctxt "items"
msgid "Idol of the Snake"
msgstr "Hadí idol"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:631
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:633
msgctxt "items"
msgid "Idol"
msgstr "Soška"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:631
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:633
msgctxt "items"
msgid ""
"Quest Item: An Idol of the ancient snake god who was worshipped by the "
"Serpentmen who used to dwell on the Dagger Wound Islands."
msgstr ""
"Úkolový předmět: Modla pradávného hadího bůžka uctívaného hadími muži, kteří"
" obývali souostroví Dýky."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:632
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:634
msgctxt "items"
msgid "Big Brass Ring"
msgstr "Velký mosazný prsten"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:632
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:634
msgctxt "items"
msgid ""
"Quest Item: A large ring of polished brass. It seems to be part of a door "
"knocker."
msgstr ""
"Úkolový předmět: Velký kruh z leštěné mosaze. Vypadá jako součást dveřního "
"klepadla."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:633
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:635
msgctxt "items"
msgid "Naga Hide"
msgstr "Kůže nágy"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:633
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:635
msgctxt "items"
msgid "Hide"
msgstr "Kůže"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:633
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:635
msgctxt "items"
msgid "The skinned and scraped hide of a naga."
msgstr "Stažená a vyčiněná kůže nagy."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:634
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:636
msgctxt "items"
msgid "Dire Wolf Pelt"
msgstr "Kožešina lítého vlka"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:634
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:636
msgctxt "items"
msgid "Pelt"
msgstr "Kožešina"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:634
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:636
msgctxt "items"
msgid "The skinned and scraped hide of a dire wolf."
msgstr "Stažená a vyčiněná kožešina strašného vlka."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:635 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2099
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:637
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:481
msgctxt "items"
msgid "Flute"
msgstr "Flétna"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:635
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:637
msgctxt "items"
msgid "Quest Item: A well crafted instrument."
msgstr "Úkolový předmět: : Mistrovsky zdobený nástroj."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:636
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:638
msgctxt "items"
msgid "Royal Wasp Jelly"
msgstr "Vosí mateří kašička"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:636
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:638
msgctxt "items"
msgid "Jelly"
msgstr "Želé"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:636
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:638
msgctxt "items"
msgid "A jar of royal wasp jelly."
msgstr "Džbán vosího želé."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:637
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:639
msgctxt "items"
msgid "Dragonbane Flower"
msgstr "Květ dračí zhouby"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:637
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:639
msgctxt "items"
msgid "Quest Item: A fresh dragonbane flower. The petals are thick and waxy."
msgstr ""
"Úkolový předmět: Čerstvá květina Dračí zhouby. Okvětní lístky jsou silné a "
"voskové."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:638
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:640
msgctxt "items"
msgid "Bone of Doom"
msgstr "Kost zhouby"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:638 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1430 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2086
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:640
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:629
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:468
msgctxt "items"
msgid "Bone"
msgstr "Kost"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:638
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:640
msgctxt "items"
msgid ""
"Quest Item: The arm bone of the legendary necromancer, Zacharia. It is "
"infused with the death magician's evil energy."
msgstr ""
"Úkolový předmět: Pažní kost legendárního nekromanta Zacharia. Je prosáklá "
"zlou energii mrtvého kouzelníka."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:639
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:641
msgctxt "items"
msgid "Druid Circlet of Power"
msgstr "Druidská čelenka moci"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:639
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:641
msgctxt "items"
msgid "Circlet"
msgstr "Čelenka"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:639
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:641
msgctxt "items"
msgid ""
"A legendary item rumored to be from the time of the Ancients.  Only someone "
"with the power of a Grand Druid can wear this item."
msgstr ""
"Legendární artefakt, o kterém se povídá, že pochází z dob Pradávných. Může "
"ho nosit pouze někdo s titulem Veledruida."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:640
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:642
msgctxt "items"
msgid "Arcane Key"
msgstr "Arkánní klíč"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:640 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:642
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:642
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:644
msgctxt "items"
msgid "Quest Item: A gem containing an unfocused magical energy."
msgstr ""
"Úkolový předmět: Drahokam obsahující nedefinovatelnou magickou energii."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:641
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:643
msgctxt "items"
msgid "Wyvern Horn"
msgstr "Roh wyverny"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:641 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2056
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:643
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:438
msgctxt "items"
msgid "Horn"
msgstr "Roh"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:641
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:643
msgctxt "items"
msgid "A horn taken from a wyvern."
msgstr "Roh získaný z ještěra."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:642
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:644
msgctxt "items"
msgid "Ogre Key"
msgstr "Zlobří klíč"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:643
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:645
msgctxt "items"
msgid "Pirate Hat"
msgstr "Pirátský klobouk"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:643
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:645
msgctxt "items"
msgid ""
"Quest Item: A sea raider captain's hat. Inside the band are stitched the "
"words \"D. P. Stanley.\""
msgstr ""
"Úkolový předmět: Klobouk pirátského kapitána. Na vnitřní straně stuhy je "
"vyšité jméno \"S. P. Stanley.\""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:644
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:646
msgctxt "items"
msgid "Tobersk Fruit"
msgstr "Toberský plod"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:644
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:646
msgctxt "items"
msgid "Fruit"
msgstr "Plod"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:644
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:646
msgctxt "items"
msgid ""
"The fruit of the tobersk bush which only grows on the Dagger Wound Islands. "
"It is the main export item of the islands' Lizardmen."
msgstr ""
"Plody toberkovníku, který roste pouze na souostroví Dýky. Tvoří hlavní "
"vývozní artikl ještěrčích ostrovů."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:645
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:647
msgctxt "items"
msgid "Tobersk Pulp"
msgstr "Toberská dužina"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:645
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:647
msgctxt "items"
msgid "Pulp"
msgstr "Dužina"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:645
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:647
msgctxt "items"
msgid "Pulp made from Dagger Wound Islands grown tobersk fruit."
msgstr "Dužina získána ze zralých plodů toberkovníků na souostroví Dýky."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:646
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:648
msgctxt "items"
msgid "Tobersk Brandy"
msgstr "Toberská brandy"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:646
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:648
msgctxt "items"
msgid "Brandy"
msgstr "Pálenka"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:646
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:648
msgctxt "items"
msgid ""
"Brandy made from the processed pulp of Dagger Wound Islands grown tobersk "
"fruit."
msgstr ""
"Pálenka vyrobená ze zpracované dužiny zralých plodů toberkovníků na "
"souostroví Dýky."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:647
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:649
msgctxt "items"
msgid "Heartwood of Jadame"
msgstr "Jádrové dřevo z Jadame"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:647
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:649
msgctxt "items"
msgid "Wood"
msgstr "Dřevo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:647
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:649
msgctxt "items"
msgid ""
"The cooler climate of the Murmurwood forest causes the trees there to grow "
"with a tight grain. These lumbered planks are of the clear grained "
"heartwood."
msgstr ""
"Chladné podnebí Šeptajících lesů je důvodem, že zdejší stromy mají letokruhy"
" těsně u sebe. Tato nařezaná prkna jsou bez suků a jakýchkoliv kazů."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:648
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:650
msgctxt "items"
msgid "Flawed Amulets"
msgstr "Vadné amulety"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:648 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:649 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:650 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1495 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1496 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1497 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1498 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1499 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1500
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:650
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:651
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:652
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:694
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:695
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:696
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:697
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:698
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:699
msgctxt "items"
msgid "Crate"
msgstr "Bedna"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:648
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:650
msgctxt "items"
msgid ""
"A crate of from the Shadowspire artificers. Small flaws in workmanship have "
"made them incapable of holding enchantments."
msgstr ""
"Bedna obchodníků ze Země stínů. Malá chyba při řemeslnickém zpracování "
"učinila amulety neschopnými přijmout očarování."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:649
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:651
msgctxt "items"
msgid "Dried Sunfish"
msgstr "Sušená sluneční ryba"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:649
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:651
msgctxt "items"
msgid ""
"A crate of dried sunfish harvested from the Ifarine Sea. Some find the "
"chewy, salty fish a delicacy."
msgstr ""
"Bedna sušených okounů nachytaných v Ifarinském moři. Někteří je vyhledávají "
"jako oblíbenou slanou lahůdku."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:650
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:652
msgctxt "items"
msgid "Silver Dust of the Sea"
msgstr "Stříbrný prach moře"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:650
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:652
msgctxt "items"
msgid ""
"A crate full of bagged Silver Dust. Made by the Necromancers' Guild, it is "
"said to have value to some sea travelers."
msgstr ""
"Bedna plná stříbrného prachu vyrobená cechem nekromantů. Říká se, že má cenu"
" hlavně pro cestovatele po moři."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:651
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:653
msgctxt "items"
msgid "Forged Vouchers"
msgstr "Padělané poukázky"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:651
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:653
msgctxt "items"
msgid "Vouchers"
msgstr "Stvrzenky"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:651
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:653
msgctxt "items"
msgid ""
"Forged credit documents used by the ogre mage Zog to embezzle gold from "
"Alvarian merchant customers."
msgstr ""
"Falešné stvrzenky používané zlobřím mágem Zogem k zpronevěře zlata zákazníků"
" Alvarských obchodníků."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:652
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:654
msgctxt "items"
msgid "Ground Wyvern Horn"
msgstr "Rozemletý roh wyverny"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:652
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:654
msgctxt "items"
msgid "A powerful potion reagent used by the Necromancers of Shadowspire."
msgstr "Mocná přísada používaná nekromanty ze Země stínů k výrobě lektvarů."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:653
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:655
msgctxt "items"
msgid "Prophecies of the Snake"
msgstr "Proroctví hada"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:653
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:655
msgctxt "items"
msgid ""
"Quest Item: One of many books of prophecy circulating recently, the "
"Prophecies of the Snake may indeed tell the future of Jadame."
msgstr ""
"Úkolový předmět: Jedna z mnoha nedávno vyšlých knih proroctví. Proroctví "
"Hada možná doopravdy vypravuje o budoucnosti Jadame."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:654
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:656
msgctxt "items"
msgid "Ogre Ear"
msgstr "Zlobří ucho"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:654
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:656
msgctxt "items"
msgid "Ear"
msgstr "Ucho"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:654
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:656
msgctxt "items"
msgid ""
"Used to keep track of kills, some bounty hunters collect these gruesome "
"reminders of battles past."
msgstr ""
"Slouží jako důkaz o zabití zlobra. Někteří lovci sbírají tyto uši jako "
"ohavné suvenýry z bitev."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:655
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:657
msgctxt "items"
msgid "Wasp Stingers"
msgstr "Vosí žihadla"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:655
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:657
msgctxt "items"
msgid "Stinger"
msgstr "Žihadlo"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:655
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:657
msgctxt "items"
msgid "The stinger of a giant wasp."
msgstr "Žihadlo obří vosy."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:656
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:658
msgctxt "items"
msgid "Green Apple"
msgstr "Zelené jablko"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:656 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1433 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2105
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:658
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:632
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:487
msgctxt "items"
msgid "Apple"
msgstr "Jablko"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:656
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:658
msgctxt "items"
msgid ""
"Jadamean green apples are crunchy, slightly tart and a good source of "
"nutrition.  (To use the apple, pick it up and left-click over a character's "
"portrait in the inventory screen.)"
msgstr ""
"Jadamská zelená jablka jsou křupavá, jemně natrpklá a jsou dobrým zdrojem "
"výživy. (Použiješ ho levým kliknutím nad postavou na obrazovce inventáře.)"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:657 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1449 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2084
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:659
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:648
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:466
msgctxt "items"
msgid "Horseshoe"
msgstr "Podkova"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:657 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1449 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2084
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:648
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:466
msgctxt "items"
msgid ""
"This flawless horseshoe is made of silver. To use, pick the horseshoe up and"
" right-click over a character's portrait."
msgstr ""
"Dokonalá stříbrná podkova. Použiješ ji pravým kliknutím nad portrétem "
"postavy."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:658
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:660
msgctxt "items"
msgid "Enchanted Amulet"
msgstr "Očarovaný amulet"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:658
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:660
msgctxt "items"
msgid ""
"A pretty bauble favored by the Pirates of Regna for it appearance, not for "
"any magical enchantment it may have."
msgstr ""
"Pěkná tretka oblíbená Regnanskými piráty pro její vzhled, ne kvůli nějakému "
"okouzlení."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:659 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:801
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:803
msgctxt "items"
msgid "Wheel of Frelandeau"
msgstr "Bochník sýra Frelandeau"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:659 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:660 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
msgctxt "items"
msgid "Cheese"
msgstr "Sýr"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:659
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:661
msgctxt "items"
msgid ""
"Quest Item: A wheel of prized unicorn's-milk frelandeau cheese. Sliced onto "
"crackers, it is the perfect compliment to a snifter of fine tobersk brandy."
msgstr ""
"Úkolový předmět: Kolo velmi ceněného Frelandeauského sýra vyrobeného z mléka"
" jednorožců. Nakrájený na plátky je tento sýr dokonalou pochoutkou hlavně ke"
" skleničce toberské pálenky."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:660 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:802
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:804
msgctxt "items"
msgid "Log of Eldenbrie"
msgstr "Špalek sýra Eldenbrie"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:660
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:662
msgctxt "items"
msgid ""
"Quest Item: A log of Vori eldenbrie cheese. Though many have tried to "
"duplicate its subtle, smoky flavor, only the master Frost Giant cheese "
"masters of the frozen Vori wastes know the secrets of its formulation."
msgstr ""
"Úkolový předmět: Špalek Eldenbrieského sýra z Vori. I když hodně mistrů se "
"pokoušelo napodobit jeho jemné uzené aroma, tajemství jeho výroby znají "
"pouze mistři ze zamrzlých pustin Vori."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:661 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:803
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:805
msgctxt "items"
msgid "Ball of Dunduck"
msgstr "Bochník sýra Dunduck"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:661
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:663
msgctxt "items"
msgid ""
"Quest Item: A ball of dunduck cheese. Made in small batches by the goblins "
"of Erathia, most consider it an acquired taste."
msgstr ""
"Úkolový předmět: Bochník Dunduckého sýra. Vyrábějí ho v malém množství "
"erathijští goblini. Je ceněný hlavně pro svou neopakovatelnou chuť."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:664
msgctxt "items"
msgid "Emperor Thorn's Key"
msgstr "Klíč císaře Thorna"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:662
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:664
msgctxt "items"
msgid "Quest Item: The key you took from the Unicorn King's body."
msgstr "Úkolový předmět: Klíč nalezený u krále jednorožců."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:665
msgctxt "items"
msgid "Cannonball of Dominion"
msgstr "Dělová koule nadvlády"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:665
msgctxt "items"
msgid "Cannonball"
msgstr "Dělová koule"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:663
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:665
msgctxt "items"
msgid ""
"Quest Item: The strange cannonball you took from the Regnan fortress. It is "
"unlike any ammunition you've seen before."
msgstr ""
"Úkolový předmět: Podivná dělová koule získána v Regnanské pevnosti. Ještě "
"nikdy dosud jsi podobný náboj neviděl."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:664
msgctxt "items"
msgid "Infused Metal Rod"
msgstr "Prosycená kovová tyč"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:664
msgctxt "items"
msgid "Metal Rod"
msgstr "Kovová tyč"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:664
msgctxt "items"
msgid "Metal stick."
msgstr "Kovová hůlka."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:665
msgctxt "items"
msgid "Large Round Crystal"
msgstr "Velký kulatý krystal"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:665
msgctxt "items"
msgid "Round crystal"
msgstr "Kulatý krystal"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:665
msgctxt "items"
msgid "Large smooth and perfectly round crystal."
msgstr "Velký, hladký a dokonale kulatý krystal."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:666
msgctxt "items"
msgid "Whisp wrappings"
msgstr "Přízračné oviny"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:666
msgctxt "items"
msgid "Pieces of rotten cloth."
msgstr "Kusy zetlelé látky."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:667
msgctxt "items"
msgid "Telelocator"
msgstr "Telelokátor"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:667
msgctxt "items"
msgid "Metal stick with smooth gem on top of it."
msgstr "Kovová tyč s hladkým drahokamem na vrcholu."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:687 mmmerge/Data/Text
