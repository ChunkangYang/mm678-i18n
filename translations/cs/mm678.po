msgctxt "items"
msgid "Hat"
msgstr "Klobouk"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:115
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:117
msgctxt "items"
msgid "A loose fitting hat made of sturdy cloth."
msgstr "Obyčejný klobouk vyrobený ze silné tkaniny."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:116
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:118
msgctxt "items"
msgid "Festival Hat"
msgstr "Slavnostní klobouk"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:116
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:118
msgctxt "items"
msgid ""
"Hats decorated with cheap glass gems are worn by Regnans on festival "
"occassions--of which they have many."
msgstr ""
"Tyto klobouky zdobené lacinými skleněnými drahokamy se nosí na Regně při "
"různých slavnostních příležitostech, kterých je tam požehnaně."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:117
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:119
msgctxt "items"
msgid "Merchantman's Hat"
msgstr "Obchodníkův klobouk"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:117
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:119
msgctxt "items"
msgid ""
"This pleated cap of velvet, lined and edged with black rabbit fur is "
"decorated with a small enameled medallion. "
msgstr ""
"Sametový plisovaný klobouk olemovaný černou králičí kůži je ozdobený malým "
"smaltovaným medailonem. "

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:118
msgctxt "items"
msgid "Studded Leather Belt"
msgstr "Vycpávaný kožený opasek"

