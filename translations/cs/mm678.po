#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:340
#: mm6/data/10LocLANG.icons/Spells.txt.py:44
msgctxt "spells"
msgid "Stone Skin"
msgstr "Kamenná kůže"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:43
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:43
msgctxt "spells"
msgid ""
"Increases all of your characters' armor class by 5 + 1 point per point of "
"skill in Earth Magic."
msgstr ""
"Zvyšuje obranné číslo všech tvých postav o 5 + 1 bod za bod magie země."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:44
