msgid "Earth Resist"
msgstr "Odolnost proti zemi"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:41
msgctxt "spells"
msgid ""
"Increases all of your characters’ resistance to Earth Magic damage by an "
"amount equal to your skill in Earth. The effect lasts one hour per point of "
"skill."
msgstr ""
"Zvyšuje odolnost všech tvých postav proti kouzlům magie země o množství "
"úměrné tvým bodům dovednosti magie země. Efekt trvá hodinu za každý bod "
"dovednosti."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:339
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:439
