#: mm7/DATA/10LocLANG.events/SPCITEMS.TXT.py:6
#: mm6/data/10LocLANG.icons/SPCITEMS.TXT.py:6
msgctxt "spcitems"
msgid "of The Gods"
msgstr "bohů"

#: mmmerge/Data/Text localization/LANG_SpcItemsTxtNames.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/SPCITEMS.TXT.py:7
#: mm7/DATA/10LocLANG.events/SPCITEMS.TXT.py:7
#: mm6/data/10LocLANG.icons/SPCITEMS.TXT.py:7
msgctxt "spcitems"
msgid "of Carnage"
msgstr "masakru"

#: mmmerge/Data/Text localization/LANG_SpcItemsTxtNames.txt.py:5
#: mm8/Data/10LocLANG.EnglishT/SPCITEMS.TXT.py:8
