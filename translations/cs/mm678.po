#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:5
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:7
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:3
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:5
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:7
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:3
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:5
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:7
msgctxt "skilldes"
msgid "Skill reduces recovery time"
msgstr "Kratší čas na zotavení"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:3
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:3
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:3
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:3
msgctxt "skilldes"
msgid "Permits use of sword in left hand"
msgstr "Možnost bojovat mečem v levé ruce"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:4
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:4
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:4
msgctxt "skilldes"
msgid ""
"While daggers don’t do the kind of damage that a sword or an axe can "
"deliver, they are very quick—sometimes letting you get two attacks for every"
" one of your slower opponents'.  Expert dagger fighters can wield a dagger "
"in their left hand while using another weapon in their right.  Master dagger"
" fighters have a chance of doing a triple damage attack."
msgstr ""
"Ačkoli nemůže dýka způsobit taková zranění jako meč nebo sekyra, je velmi "
"rychlá a získáš možnost útočit dvakrát, pokud je protivník pomalejší. Expert"
" s dýkou může bojovat dýkou v levé ruce a používat jinou zbraň v druhé. "
"Mistři s dýkou mají šanci způsobit trojnásobná zranění během útoku."

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:4
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:4
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:4
msgctxt "skilldes"
msgid "Permits use of dagger in left hand"
msgstr "Možnost bojovat dýkou v levé ruce"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:4
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:4
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:4
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:4
msgctxt "skilldes"
msgid "Chance to cause triple damage equal to skill"
msgstr "Šance na způsobení trojnásobných zranění"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:4
#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:5
#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:8
