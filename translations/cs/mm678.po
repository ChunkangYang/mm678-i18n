#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1474 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2119
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:673
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:501
msgctxt "items"
msgid ""
"Quest Item:  The finest Dwarven axe ever created in Enroth, Snergle's name "
"is traced in flowing dwarven runes across the blade."
msgstr ""
"Úkolový předmět: Nejlepší trpasličí sekyra, jaká kdy byla vyrobena v "
"Enrothu. Napříč čepelí je trpasličími runami vyryté Snerglovo jméno."

