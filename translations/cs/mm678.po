#: mmmerge/Data/10LocLANG.T/6D08.STR.py:24
#: mm6/data/10LocLANG.icons/D08.STR.py:24
msgctxt "location"
msgid ""
"I go through an apple, or point out your way, I fit in a bow, then a target,"
" to stay. What am I?"
msgstr ""
"Projdu jablkem, ukazuji ti cestu, pasuji do luku i do terče. Copak asi jsem?"

#: mmmerge/Data/10LocLANG.T/6D08.STR.py:25
