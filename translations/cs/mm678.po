#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:490
msgctxt "items"
msgid ""
"A spell book.  (To learn this spell, pick the book up and right-click over a"
" character's portrait in the inventory screen.  Your character must know the"
" Light magic skill to learn this spell.)"
msgstr ""
"Kniha kouzel. (Kouzlo se naučíš tak, že knihou klikneš levým tlačítkem na "
"postavu na obrazovce inventáře. Aby se postava kouzlo naučila, musí mít "
"dovednost magie světla.)"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:489 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:490 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:491 mmmerge/Data/Text
