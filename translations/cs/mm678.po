msgid "Blades"
msgstr "Čepele"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:44
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:44
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:44
msgctxt "spells"
msgid ""
"Fires a rotating, razor-thin metal blade at a single monster.  The blade "
"does 1-9 points of damage per point of skill in Earth Magic."
msgstr ""
"Vystřelí ostrou rotující čepel na samostatný cíl. Čepel způsobí 1-9 bodů "
"zranění za bod dovednosti v magii země."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:342
