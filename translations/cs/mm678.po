#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:95
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:92
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:94
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:95
#: mm6/data/10LocLANG.icons/Spells.txt.py:93
#: mm6/data/10LocLANG.icons/Spells.txt.py:95
#: mm6/data/10LocLANG.icons/Spells.txt.py:105
msgctxt "spells"
msgid "All spells cast at four times skill"
msgstr "Všechna kouzla jsou seslána se čtyřnásobnou dovednosti"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:92
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:94
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:95
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:92
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:94
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:95
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:92
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:94
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:95
msgctxt "spells"
msgid "All spells cast at five times skill"
msgstr "Všechna kouzla jsou seslána s pětinásobnou dovednosti"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:93
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:386
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:486
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:93
