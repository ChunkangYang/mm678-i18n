#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:391
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:491
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:100
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:292
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:392
#: mm6/data/10LocLANG.icons/Spells.txt.py:101
msgctxt "spells"
msgid "Toxic Cloud"
msgstr "Jedovatý mrak"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:100
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:100
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:100
#: mm6/data/10LocLANG.icons/Spells.txt.py:101
msgctxt "spells"
msgid ""
"A poisonous cloud of noxious gases is formed in front of the caster and "
"moves slowly away from your characters.  The cloud does 25 points of damage "
"plus 1-10 per point of skill in Dark Magic and lasts until something runs "
"into it."
msgstr ""
"Před sesílatelem kouzla se vytvoří jedovatý mrak zhoubných plynu a pomalu se"
" pohybuje směrem od tvých postav. Mrak způsobí 25 bodů zranění + 1-10 bodů "
"za bod dovednosti magie temnoty."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:393
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:493
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:392
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:492
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:101
msgctxt "spells"
msgid "Vampiric Weapon"
msgstr "Upíří zbraň"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:101
msgctxt "spells"
msgid "Vamp Weap"
msgstr "Upíří zbraň"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
msgctxt "spells"
msgid ""
"Enchants a weapon with the Vampiric ability.  Damage inflicted on monsters "
"struck by this weapon will be given to the weapon's wielder as extra hit "
"points, up to his or her normal hit point maximum."
msgstr ""
"Očaruje zbraň a přidá jí upíří vlastnost. Zdraví odebrané nestvůře touto "
"zbraní je přidáno tomu, kdo zbraň používá jako extra zdraví, až do maximální"
" hodnoty zdraví postavy."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:101
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:101
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:6
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:101
msgctxt "spells"
msgid "Permanent"
msgstr "Trvalé očarování"

