#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:264
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:266
msgctxt "items"
msgid ""
"Adds \"of Dragon Slaying\" to a non-magic weapon.  (To use, pick the potion "
"up and right-click over a non-magic weapon.  To mix, pick the potion up and "
"right-click over another potion.)"
msgstr ""
"Nemagické zbrani dodá vlastnost 'Zhouba draků'. (Použití - pravý klik nad "
"nemagickou zbraní. Míchání s dalším lektvarem - pravý klik nad jiným "
"lektvarem.)"

