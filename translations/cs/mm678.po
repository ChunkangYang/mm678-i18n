msgctxt "items"
msgid "Wand"
msgstr "Hůlka"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:153 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:154 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:155 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:156 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:155
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159
msgctxt "items"
msgid ""
"The primitive materials of this wand is infused with dark spiritual energy. "
"To use this wand, you must equip it as though you were equipping a weapon."
msgstr ""
"Primitivní materiály, z kterých je tato hůlka vyrobena, jsou nasáklé temnou "
"duchovní energií. Abys ji použil, musíš s ní ozbrojit svou postavu."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:154
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156
msgctxt "items"
msgid "Witch's Wand of Sparks"
msgstr "Čarodějčina hůlka jisker"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:155
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157
msgctxt "items"
msgid "Witch's Wand of Poison"
msgstr "Čarodějčina hůlka jedu"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158
msgctxt "items"
msgid "Witch's Wand of Stunning"
msgstr "Čarodějčina hůlka omráčení"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159
msgctxt "items"
msgid "Witch's Wand of Harming"
msgstr "Čarodějčina hůlka zranění"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:158
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:160
msgctxt "items"
msgid "Shaman's Wand of Light"
msgstr "Šamanova hůlka světla"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:158 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:159 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:160 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:161 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:162
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:160
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:161
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:162
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:163
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:164
msgctxt "items"
msgid ""
"Something rattles ominously within the gog skull topping this wand - product"
" of Ogre mage magic. To use it, you must equip it like a weapon."
msgstr ""
"Z lebky goga usazené na konci hůlky je slyšet zlověstný chřestot - tak "
"vypadá tento výrobek magie zlobřích mágů. Abys ji použil, musíš s ní "
"ozbrojit svou postavu."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:159
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:161
msgctxt "items"
msgid "Shaman's Wand of Ice"
msgstr "Šamanova hůlka ledu"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:160
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:162
msgctxt "items"
msgid "Shaman's Wand of Lashing"
msgstr "Šamanova hůlka bičování"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:161
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:163
msgctxt "items"
msgid "Shaman's Wand of Mind"
msgstr "Šamanova hůlka mysli"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:162
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:164
msgctxt "items"
msgid "Shaman's Wand of Swarms"
msgstr "Šamanova hůlka rojů"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:163
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:165
msgctxt "items"
msgid "Wizard Wand of Fireballs"
msgstr "Čarodějova hůlka ohnivých koulí"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:163 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:164 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:165 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:166 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:167
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:165
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:166
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:167
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:168
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:169
msgctxt "items"
msgid ""
"A wand of highly polished thornbark wrapped with platinum wire. To use it, "
"you must equip it like a weapon."
msgstr ""
"Velmi lesklá hůl z trnovníkového dřeva ovinutá platinovým drátem. Abys ji "
"použil, musíš s ní ozbrojit svou postavu."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:164
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:166
msgctxt "items"
msgid "Wizard Wand of Acid"
msgstr "Čarodějova hůlka kyseliny"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:165
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:167
msgctxt "items"
msgid "Wizard Wand of Lightning"
msgstr "Čarodějova hůlka blesku"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:166
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:168
msgctxt "items"
msgid "Wizard Wand of Blades"
msgstr "Čarodějova hůlka čepelí"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:167
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:169
msgctxt "items"
msgid "Wizard Wand of Berzerking"
msgstr "Čarodějova hůlka běsnění"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:168
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:170
msgctxt "items"
msgid "Serpent Wand of Blasting"
msgstr "Hadí hůlka výbuchu"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:168 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:169 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:170 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:171 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:172
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:170
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:171
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:172
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:173
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:174
msgctxt "items"
msgid ""
"Made from the braided bodies of three snakes, this wand pulses like a slow "
"heartbeat. To use it you must equip it like a weapon."
msgstr ""
"Vyrobena ze tří propletených hadích těl, tato hůlka pulsuje jako tep "
"pomalého srdce. Abys ji použil, musíš s ní ozbrojit svou postavu."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:169
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:171
msgctxt "items"
msgid "Serpent Wand of the Fist"
msgstr "Hadí hůlka pěsti"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:170
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:172
msgctxt "items"
msgid "Serpent Wand of Rocks"
msgstr "Hadí hůlka kamenů"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:171
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:173
msgctxt "items"
msgid "Serpent Wand of Paralysis"
msgstr "Hadí hůlka ochromení"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:172
msgctxt "items"
msgid "Serpent Wand of Clouds"
msgstr "Hadí hůlka oblaků"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:173
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:175
msgctxt "items"
msgid "Necrotic Wand of Implosion"
msgstr "Nekrotická hůlka imploze"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:173 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:174 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:175 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:176 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:177
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:175
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:176
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:177
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:178
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:179
msgctxt "items"
msgid ""
"A unicorn horn capped with a gold set ruby and crowned with a sculpted "
"skull, this wand could only be the creation of the Necromancers' Guild. To "
"use it you must equip it like a weapon."
msgstr ""
"Roh jednorožce posázený nádhernými rubíny završený vyřezávanou lebkou. Toto "
"může být jedině práce cechu nekromantů ze Země stínů. Abys ji použil, musíš "
"s ní ozbrojit svou postavu."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:174
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:176
msgctxt "items"
msgid "Necrotic Wand of Distortion"
msgstr "Nekrotická hůlka pokřivení"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:175
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:177
msgctxt "items"
msgid "Necrotic Wand of Shrapnel"
msgstr "Nekrotická hůlka střepin"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:176
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:178
msgctxt "items"
msgid "Necrotic Wand of Shrinking"
msgstr "Nekrotická hůlka zmenšení"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:177
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:179
msgctxt "items"
msgid "Necrotic Wand of Incineration"
msgstr "Nekrotická hůlka zpopelnění"

