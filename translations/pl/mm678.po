#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:342
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Stone to Flesh"
msgstr "Zamiana Kamienia w Ciało"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Stone - Flesh"
msgstr "Kam. w ciało"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
msgctxt "spells"
msgid "Removes the stoned condition from a character if you cast this spell in time.  The greater the skill and rank in Earth Magic the longer the condition can have been present before the “point of no return” is reached.  After that, the only way to remove the condition short of Divine Intervention is to visit a temple."
msgstr "Jeżeli jakaś postać została zamieniona w kamień, to zaklęcie przywróci ją do normalnej postaci pod warunkiem, że zostanie rzucone na czas. Im większa biegłość i poziom znajomości magii ziemi, tym dłużej dana postać może być zamieniona w kamień, zanim zostanie odczarowana. Jeżeli postać była zamieniona w kamień zbyt długo, to oprócz zaklęcia Boska Interwencja, pozostaje jedynie wizyta w świątyni."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Works if stoned less than 1 hour per point of skill"
msgstr "Czar zadziała, jeżeli zamiana w kamień nie trwała dłużej niż 1 godzinę na każdy punkt biegłości."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:45
#: mm6/data/10LocLANG.icons/Spells.txt.py:46
msgctxt "spells"
msgid "Works if stoned less than 1 day per point of skill"
msgstr "Czar zadziała, jeżeli zamiana w kamień nie trwała dłużej niż 1dzień na każdy punkt biegłości."

