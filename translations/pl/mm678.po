#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:42
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:239
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:339
#: mm6/data/10LocLANG.icons/Spells.txt.py:43
msgctxt "spells"
msgid "Deadly Swarm"
msgstr "Zabójczy Rój"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:42
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:42
#: mm6/data/10LocLANG.icons/Spells.txt.py:43
msgctxt "spells"
msgid "Swarm"
msgstr "Zabójczy rój"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:42
msgctxt "spells"
msgid "Summons a swarm of biting, stinging insects to bedevil a single target.  The swarm does 5 points of damage plus 1-3 per point of skill in Earth Magic."
msgstr "Przyzywa rój owadów, które gryzą i kłują postać, na którą zostało rzucone zaklęcie. Owady zawsze trafiają do celu. Czar zadaje 5 punktów obrażeń plus 1-3 punktów na każdy punkt biegłości w magii ziemi."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:43
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:340
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:440
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:43
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:339
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:439
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:43
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:240
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:340
#: mm6/data/10LocLANG.icons/Spells.txt.py:44
msgctxt "spells"
msgid "Stone Skin"
msgstr "Kamienna Skóra"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:43
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:43
msgctxt "spells"
msgid "Increases all of your characters' armor class by 5 + 1 point per point of skill in Earth Magic."
msgstr "Klasa pancerza postaci, na którą zostało rzucone zaklęcie, zostaje zwiększona o 5 punktów plus 1 punkt na każdy punkt biegłości w magii ziemi, który posiada rzucający."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:44
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:341
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:441
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:44
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:340
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:440
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:44
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:241
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:341
#: mm6/data/10LocLANG.icons/Spells.txt.py:45
msgctxt "spells"
msgid "Blades"
msgstr "Wirujące Ostrze"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:44
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:44
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:44
msgctxt "spells"
msgid "Fires a rotating, razor-thin metal blade at a single monster.  The blade does 1-9 points of damage per point of skill in Earth Magic."
msgstr "W kierunku celu wystrzeliwane jest wirujące ostrze, które zadaje 1-9 punktów obrażeń na każdy punkt biegłości. "

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:342
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:442
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:45
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:341
