msgstr "Naładowanie Różdżki"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:234
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:236
msgctxt "items"
msgid "Grants Recharge Item (as the spell).  The item permanently loses 70%-point of potion strength of its charges.   (To use, pick the potion up and right-click over an item with charges.  To mix, pick the potion up and right-click over another potion.)"
msgstr "Zapewnia efekt zaklęcia Naładowanie Różdżki, odnawiając ładunki wybranej magicznej różdżki. Po użyciu go na różdżce, traci ona 50% swojego ładunku minus jeden procent za każdy punkt mocy eliksiru."

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:235
