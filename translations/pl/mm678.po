msgid "Duration 1 hour + 1 hour per point of skill"
msgstr "Czas trwania wynosi 1 godzinę + 1 godzinę na każdy punkt biegłości."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:21
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:320
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:420
