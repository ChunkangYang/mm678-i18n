#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:40
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:40
msgctxt "spells"
msgid "Monster slows to 1/8 speed"
msgstr "Potwór spowolniony do 1/8 swojej szybkości."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:338
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:438
