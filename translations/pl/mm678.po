#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:446
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:51
msgctxt "spells"
msgid "Detect Life"
msgstr "Wykrycie Życia"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
msgctxt "spells"
msgid "Allows the party to see an opponent's current health as an exact hit point number when you right-click on a creature."
msgstr "Pozwala członkom twojej drużyny widzieć aktualną, liczbową wartość punktów życia przeciwnika, gdy klikniesz na niego prawym przyciskiem myszy. "

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:51
msgctxt "spells"
msgid "Duration 10 minutes per point of skill."
msgstr "Czas trwania wynosi 10 minut na punkt biegłości."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:112
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:112
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:51
msgctxt "spells"
msgid "Duration 30 minutes per point of skill"
msgstr "Czas trwania wynosi 30 minut na punkt biegłości."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:51
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:51
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:51
msgctxt "spells"
msgid "Shows spells"
msgstr "Pokazuje także zaklęcia."

