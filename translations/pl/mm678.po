#: mm6/data/10LocLANG.icons/Spells.txt.py:25
#: mm6/data/10LocLANG.icons/Spells.txt.py:32
#: mm6/data/10LocLANG.icons/Spells.txt.py:48
msgctxt "spells"
msgid "Duration 5 minutes per point of skill"
msgstr "Czas trwania wynosi 5 minut na punkt biegłości."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:17
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:316
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:416
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:17
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:315
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:415
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:17
msgctxt "spells"
msgid "Air Resistance"
msgstr "Odporność na Magię Powietrza"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:17
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:17
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:17
msgctxt "spells"
msgid "Air Resist"
msgstr "Odp. pow."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:17
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:17
msgctxt "spells"
msgid "Increases all your characters’ resistance to air damage by an amount equal to your skill in Air. The protection lasts one hour per point of skill."
msgstr "Zwiększa odporność na magię powietrza u wszystkich członków drużyny o liczbę punktów równą twojej biegłości w magii powietrza. Czas trwania wynosi jedną godzinę na każdy punkt biegłości."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:317
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:417
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:316
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:416
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:217
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:317
#: mm6/data/10LocLANG.icons/Spells.txt.py:19
msgctxt "spells"
msgid "Sparks"
msgstr "Iskry"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
#: mm6/data/10LocLANG.icons/Spells.txt.py:19
msgctxt "spells"
msgid "Sparks fires small balls of lightning into the world that bounce around until they hit something or dissipate. It is hard to tell where they will go, so this spell is best used in a room crowded with small monsters. Each spark does 2 points plus 1 per point of skill in Air Magic."
msgstr "Zaklęcie to powoduje wystrzelenie małych kul błyskawic, które odbijają się od powierzchni do momentu gdy w coś nie trafią, lub same znikną. Trudno powiedzieć, w którym kierunku skierują się kule, więc najlepiej użyć tego zaklęcia w małym pomieszczeniu pełnym potworów. Każda kula zadaje 2 punkty obrażeń plus 1 punkt za każdy punkt biegłości w magii powietrza."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
#: mm6/data/10LocLANG.icons/Spells.txt.py:19
msgctxt "spells"
msgid "Moderate recovery rate, 3 sparks"
msgstr "Potrzebny średnio długi czas osiągnięcia gotowości do podjęcia kolejnej akcji, 3 iskry."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
#: mm6/data/10LocLANG.icons/Spells.txt.py:19
msgctxt "spells"
msgid "Faster recovery rate, 5 sparks"
msgstr "Skraca się czas osiągnięcia gotowości do podjęcia kolejnej akcji, 5 iskier."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
msgctxt "spells"
msgid "Faster recovery rate, 7 sparks"
msgstr "Skraca się czas osiągnięcia gotowości do podjęcia kolejnej akcji, 7 iskier."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:18
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:18
msgctxt "spells"
msgid "Fastest recovery rate, 9 sparks"
msgstr "Najkrótszy czas osiągnięcia gotowości do podjęcia kolejnej akcji, 9 iskier."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:19
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:318
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:418
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:19
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:317
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:417
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:19
#: mm6/data/10LocLANG.icons/GLOBAL.TXT.py:127
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:221
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:321
#: mm6/data/10LocLANG.icons/Spells.txt.py:23
msgctxt "spells"
msgid "Jump"
msgstr "Skok"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:19
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:19
msgctxt "spells"
msgid "Jump launches your party 60 feet into the air, allowing you to reach high ledges and jump large crevasses.  Your party takes no falling damage from the jump."
msgstr "Twoja drużyna wyskakuje na około 20 metrów w górę, nie odnosząc żadnych obrażeń przy spadaniu."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:319
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:419
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:20
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:318
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:418
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:20
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:219
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:319
#: mm6/data/10LocLANG.icons/Spells.txt.py:21
msgctxt "spells"
msgid "Shield"
msgstr "Tarcza"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:20
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:20
#: mm6/data/10LocLANG.icons/Spells.txt.py:21
msgctxt "spells"
msgid "Halves damage from incoming ranged attacks (such as rocks and arrows) by slowing the missiles down just before they hit."
msgstr "Spowalnia nadlatujące pociski (takie jak kamienie lub strzały) sprawiając, że przy uderzeniu zadają tylko połowę obrażeń."

