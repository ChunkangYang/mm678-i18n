#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1684
msgctxt "npc conversation"
msgid "What wretch would want to deal with scum like yourself? Repent for your sins and do not show your face here until you do."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1685
msgctxt "npc conversation"
msgid "Dragon ate enough! Let him grow."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCText.txt.py:1686
