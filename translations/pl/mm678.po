msgctxt "spells"
msgid "Fire Spike"
msgstr "Mina Ogniowa"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Drops a Fire Spike on the ground that waits for a creature to get near it before exploding.  Fire Spikes last until you leave the map or they are triggered."
msgstr "Powoduje postawienie na ziemi miny ogniowej, która eksploduje, jeżeli ktoś będzie przechodził obok niej. Miny pozostają na swoim miejscu dopóki ktoś ich nie zdetonuje, lub dopóki twoja drużyna nie opuści danej mapy."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Causes 1-6 points of damage per point of skill, 5 spikes maximum"
msgstr "Powoduje 1-6 punktów obrażeń na każdy punkt biegłości; maksymalnie można ustawić 5 min."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Causes 1-8 points of damage per point of skill, 7 spikes maximum"
msgstr "Zadaje 1-8 punktów obrażeń na każdy punkt biegłości; maksymalnie można ustawić 7 min."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:9
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:9
msgctxt "spells"
msgid "Causes 1-10 points of damage per point of skill, 9 spikes maximum"
msgstr "Zadaje 1-10 punktów obrażeń na każdy punkt biegłości; maksymalnie można ustawić 9 min."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:10
