#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:5
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:4
msgctxt "quests"
msgid "Deliver Dadeross' Letter to Elgar Fellmoon at the Merchant House in Ravenshore."
msgstr "Dostarcz list od Daderossa Elgarowi Fellmoonowi, który urzęduje w domu kupieckim w Ravenshore."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:7
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:6
msgctxt "quests"
msgid "Kill the leader of the Regnan Pirate outpost at Dagger Wound."
msgstr "Zabij dowódcę posterunku regnańskich piratów na Wyspach Krwawego Sztyletu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:8
msgctxt "quests"
msgid "Bring Brekish Onefang's portal crystal to Fredrick Talimere."
msgstr "Przynieś Frederickowi Talimere kryształ uruchamiający portal, dany ci przez Brekisha Jednego Kła."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:11
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:10
msgctxt "quests"
msgid "Deliver Fellmoon's blackmail letter to Arion Hunter, leader of the wererat smugglers. Report back to Fellmoon."
msgstr "Dostarcz list napisany przez Fellmoona Arionowi Łowcy, przywódcy szczurołaków przemytników. Następnie wróć do Fellmoona."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:13
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:12
msgctxt "quests"
msgid "Report to Bastian Loudrin, the merchant guildmaster in Alvar."
msgstr "Porozmawiaj z Bastianem Loudrinem, mistrzem Gildii Kupców z Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:15
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:14
msgctxt "quests"
msgid "Form an alliance among the major factions of Jadame."
msgstr "Zaaranżuj zawarcie przymierza między głównymi frakcjami w Jadame."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:16
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:15
msgctxt "quests"
msgid "Form an alliance with the Necromancers' Guild in Shadowspire."
msgstr "Zawrzyj przymierze z Gildią Nekromantów z Shadowspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:17
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:16
msgctxt "quests"
msgid "Form an alliance with the Temple of the Sun in Murmurwoods."
msgstr "Zawrzyj przymierze ze Świątynią Słońca w Murmurwoods."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:18
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:17
msgctxt "quests"
msgid "Form an alliance with the Dragon hunters of Garrote Gorge."
msgstr "Zawrzyj przymierze z łowcami smoków z Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:19
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:18
msgctxt "quests"
msgid "Form an alliance with the Dragons of Garrote Gorge."
msgstr "Zawrzyj przymierze ze smokami z Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:20
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:19
msgctxt "quests"
msgid "Form an alliance with the Minotaurs of Ravage Roaming."
msgstr "Zawrzyj przymierze z minotaurami ze Splądrowanych Pustkowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:26
msgctxt "quests"
msgid "Find a witness to the lake of fire's formation. Bring him back to the merchant guild in Alvar."
msgstr "Znajdź świadka powstania jeziora ognia. Sprowadź go do Gildii Kupców z Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:27
msgctxt "quests"
msgid "Find the skeleton transformer in the Shadowspire Necromancers' Guild. Destroy it and return to Oskar Tyre."
msgstr "Znajdź transformator szkieletów w Gildii Nekromantów z Shadowspire. Zniszcz go i wróć do Oskara Tyre."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:30
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:29
msgctxt "quests"
msgid "Bring the Nightshade Brazier to the Necromancers' Guild leader, Sandro. The Brazier is in the Temple of the Sun."
msgstr "Przynieś kociołek Nocnego Cienia przywódcy Gildii Nekromantów, Sandro. Kociołek znajduje się w Świątyni Słońca."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:31
msgctxt "quests"
msgid "Rescue the Minotaurs trapped in their lair in Ravage Roaming."
msgstr "Uratuj minotaury uwięzione w ich leżu na Splądrowanych Pustkowiach."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:33
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:32
msgctxt "quests"
msgid "Recover the Dragon Egg from Zog's fortress in Ravage Roaming and return it to Charles Quixote in Garrote Gorge."
msgstr "Wykradnij smocze jajo z fortecy Zoga na Splądrowanych Pustkowiach i przynieś je Charlesowi Quixote'owi z Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:35
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:34
msgctxt "quests"
msgid "Find the Dragon Egg and return it to the dragon leader, Deftclaw Redreaver."
msgstr "Znajdź smocze jajo i zwróć je wodzowi smoków, Deftclawowi Redreaverowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:38
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:37
msgctxt "quests"
msgid "Sink the Regnan Fleet. Return to the Ravenshore council chamber."
msgstr "Zatop Flotę Regnańską. Wróć do komnaty rady w Ravenshore."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:40
msgctxt "quests"
msgid "Find Cauri Blackthorne then return to Dantillion in Murmurwoods with information of her location."
msgstr "Znajdź Cauri Blackthorne, a następnie wróć do Dantilliona z Murmurwoods z informacją o jej miejscu pobytu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:43
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:42
msgctxt "quests"
msgid "Bring the Heart of Water from the Plane of Water to Xanthor."
msgstr "Zdobądź Serce Wody z jego wymiaru i dostarcz je Xanthorowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:44
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:43
msgctxt "quests"
msgid "Bring the Heart of Air from the Plane of Air to Xanthor."
msgstr "Zdobądź Serce Powietrza z jego wymiaru i dostarcz je Xanthorowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:44
msgctxt "quests"
msgid "Bring the Heart of Earth from the Plane of Earth to Xanthor."
msgstr "Zdobądź Serce Ziemi z jego wymiaru i dostarcz je Xanthorowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:46
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:45
msgctxt "quests"
msgid "Bring the Heart of Fire from the Plane of Fire to Xanthor."
msgstr "Zdobądź Serce Ognia z jego wymiaru i dostarcz je Xanthorowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:48
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:47
msgctxt "quests"
msgid "Find the cause of the cataclysm through the Crystal Gateway."
msgstr "Znajdź przyczynę kataklizmu za Kryształowym Portalem."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:50
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:49
msgctxt "quests"
msgid "Rescue Pyrannaste, Lord of Fire."
msgstr "Uwolnij Pyrannaste, Pana Ognia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:52
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:51
msgctxt "quests"
msgid "Rescue Gralkor the Cruel, Lord of Earth."
msgstr "Uwolnij Gralkora Okrutnego, Pana Ziemi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:54
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:53
msgctxt "quests"
msgid "Rescue Acwalander, Lord of Water."
msgstr "Uwolnij Acwalandera, Pana Wody."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:56
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:55
msgctxt "quests"
msgid "Rescue Shalwend, Lord of Air."
msgstr "Uwolnij Shalwenda, Pana Powietrza."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:63
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:62
msgctxt "quests"
msgid "Put Vilebite's ashes in the Dust village tomb then return to Overdune."
msgstr "Złóż prochy Vilebite'a w grobowcu w wiosce Rust i powróć do Overdune'a."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:70
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:69
msgctxt "quests"
msgid "Find the Ancient Troll Homeland and return to Volog Sandwind in the Ironsand Desert."
msgstr "Znajdź starożytną ojczyznę trolli i wróć do Vologa Sandwinda na pustyni Ironsand."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:72
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:71
msgctxt "quests"
msgid "Find Blazen Stormlance and recover the spear Ebonest. Return to Leane Stormlance in Garrote Gorge and deliver Ebonest to Charles Quixote."
msgstr "Znajdź Blazena Stormlance i odzyskaj włócznię Ebonest. Wróć do Leane Stormlance w Wąwozie Garoty i oddaj Ebonesta Charlesowi Quixote'owi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:74
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:73
msgctxt "quests"
msgid "Inquire about a cure for Blazen Stormlance from Dervish Chevron in Ravenshore."
msgstr "Dowiedz się o lek dla Blazena Stormlance u Derwisza Chevrona w Ravenshore."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:76
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:75
msgctxt "quests"
msgid "Kill all Dragon Slayers and return the Sword of Whistlebone the Slayer to Deftclaw Redreaver in Garrote Gorge."
msgstr "Zabij wszystkich łowców smoków i zwróć miecz Whistlebone'a Deftclawowi Redreaverowi z Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:78
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:77
msgctxt "quests"
msgid "Find the Axe of Balthazar, in the Dark Dwarf Mines.  Have the Axe authenticated by Dadeross.  Return the axe to Tessalar, heir to the leadership of the Minotaur Herd."
msgstr "Odszukaj Topór Balthazara w kopalniach mrocznych krasnoludów. Potwierdź jego autentyczność u Daderossa. Zwróć Topór Tessalarowi, dziedzicowi przywództwa nad Stadem Minotaurów."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:80
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:79
msgctxt "quests"
msgid "Find the Prophecies of the Sun in the Abandoned Temple  and take them to Stephen."
msgstr "Znajdź Proroctwa Słońca w Opuszczonej Świątyni i przynieś je Stephenowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:82
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:81
msgctxt "quests"
msgid "Find the Sarcophagus of Korbu and Korbu's Remains and return them to Lathean in Shadowspire."
msgstr "Znajdź sarkofag Korbu i szczątki Korbu, po czym zwróć je Latheanowi z Shadowspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:84
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:83
msgctxt "quests"
msgid "Find the Lost Book of Khel and return it to Vertrinus in Shadowspire."
msgstr "Znajdź zaginioną księgę Khela i zwróć ją Vetrinusowi z Shadowspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:87
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:86
msgctxt "quests"
msgid "Find Dadeross, the Minotaur in charge of your merchant caravan. When you saw him last, he was going to talk to the village clan leader."
msgstr "Znajdź Daderossa, minotaura odpowiedzialnego za twoją karawanę kupiecką. Podczas waszego ostatniego spotkania Dadeross zamierzał porozmawiać z przywódcą klanu z wioski."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:93
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:92
msgctxt "quests"
msgid "Consult the Ironfists' court sage, Xanthor about the Ravenshore crystal."
msgstr "Porozmawiaj z nadwornym wieszczem zamku Ironfist, Xanthorem, na temat kryształu z Ravenshore."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:103
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:102
msgctxt "quests"
msgid "Deliver Cure Disease Scrolls to the six huts on the outer Dagger Wound Islands.  Return to Aislen on Dagger Wound Island."
msgstr "Dostarcz zwoje z zaklęciem Ulecz Chorobę do pięciu chatek na zewnętrznych wyspach archipelagu Krwawego Sztyletu. Wróć do Aislena z Wysp Krwawego Sztyletu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:111
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:110
msgctxt "quests"
msgid "Find and return an Anointed Potion to Languid in the Dagger Wound Islands."
msgstr "Znajdź błogosławiony olejek i przynieś go Languidowi z Wysp Krwawego Sztyletu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:113
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:112
msgctxt "quests"
msgid "Bring Hiss on the Dagger Wound Islands the Idol of the Snake from the Abandoned Temple."
msgstr "Przynieś Hissowi z Wysp Krwawego Sztyletu posążek węża z opuszczonej świątyni."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:115
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:114
msgctxt "quests"
msgid "Bring Thistle on the Dagger Wound Islands the basic ingredients for a potion of Pure Speed."
msgstr "Przynieś Thistle'owi z Wysp Krwawego Sztyletu podstawowe odczynniki potrzebne do stworzenia eliksiru czystej Szybkości (1 żółty, 2 niebieskie i 4 czerwone)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:117
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:116
msgctxt "quests"
msgid "Bring Rihansi in Alvar the basic ingredients for a potion of Pure Luck."
msgstr "Przynieś Rihansi z Alvar podstawowe odczynniki potrzebne do stworzenia eliksiru czystego Szczęścia (3 żółte, 3 niebieskie i 2 czerwone)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:119
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:118
msgctxt "quests"
msgid "Deliver fake report to the Dread Pirate Stanley in the Pirate's Rest Tavern on the Island of Regna."
msgstr "Dostarcz fałszywy raport Strasznemu Piratowi Stanleyowi, który czeka w tawernie Odpoczynek Pirata na Wyspie Regna."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:121
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:120
msgctxt "quests"
msgid "Rescue Arion Hunter's daughter from Ogre Fortress in Alvar."
msgstr "Uwolnij córkę Ariona Łowcy z fortecy ogrów w Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:123
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:122
msgctxt "quests"
msgid "Bring Talion in the Ironsand Desert the basic ingredients for a potion of Pure Endurance."
msgstr "Przynieś Talionowi z pustyni Ironsand podstawowe odczynniki potrzebne do stworzenia eliksiru czystej Wytrzymałości (1 żółty, 4 niebieskie i 2 czerwone)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:125
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:124
msgctxt "quests"
msgid "Bring Kelvin in Shadowspire the basic ingredients for a potion of Pure Intellect."
msgstr "Przynieś Kelvinowi z Shadowspire podstawowe odczynniki potrzebne do stworzenia eliksiru czystego Intelektu (4 żółte, 2 niebieskie i 1 czerwony)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:127
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:126
msgctxt "quests"
msgid "Bring Castigeir in Murmurwoods the basic ingredients for a potion of Pure Personality."
msgstr "Przynieś Castigeirowi z Murmurwoods podstawowe odczynniki potrzebne do stworzenia eliksiru czystej Osobowości (2 żółte, 4 niebieskie i 1 czerwony)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:129
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:128
msgctxt "quests"
msgid "Recover the shield, Eclipse, for Lathius in Ravenshore."
msgstr "Odzyskaj tarczę Zaćmienia dla Lathiusa z Ravenshore."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:131
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:130
msgctxt "quests"
msgid "Kill all Ogres in the Alvar canyon area and in Ogre Fortress and return to Keldon in Alvar."
msgstr "Zabij wszystkie ogry w okolicach Alvar, po czym wróć do Keldona z Alvar. Ogry znajdują się na drogach, wzgórzach i w ich fortecy."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:134
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:133
msgctxt "quests"
msgid "Bring Galvinus in Ravage Roaming the basic ingredients for a potion of Pure Accuracy."
msgstr "Przynieś Galvinusowi ze Splądrowanych Pustkowi podstawowe odczynniki potrzebne do stworzenia eliksiru czystej Celności (4 żółte, 1 niebieski i 2 czerwone)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:137
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:136
msgctxt "quests"
msgid "Find the Prophecies of the Snake for Pascella Tisk."
msgstr "Znajdź proroctwa węża dla Pascelli Tisk."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:139
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:138
msgctxt "quests"
msgid "Find Isthric the Tongue, brother of Rohtnax.  Return to Rohtnax in the village of Blood Drop on Dagger Wound Island."
msgstr "Znajdź Isthrica Języka, brata Rohtnaxa. Wróć do Rohtnaxa z wioski Kropla Krwi na Wyspie Krwawego Sztyletu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:141
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:140
msgctxt "quests"
msgid "Kill all Dire Wolves in Ravenshore. Return to Maddigan in Ravenshore."
msgstr "Zabij wszystkie dzikie wilki w Ravenshore. Wróć do Maddigan z Ravenshore."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:144
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:143
msgctxt "quests"
msgid "Deliver Fire Resistance Potions to the six southernmost houses of Rust.  Return to Hobert in Rust."
msgstr "Dostarcz eliksiry odporności na magię ognia do sześciu południowych domów w Rust. Wróć do Pole'a z Rust."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:152
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:151
msgctxt "quests"
msgid "Find a Dragonbane Flower for Calindril in Garrote Gorge."
msgstr "Znajdź smocze kwiecie dla Calindrila z Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:154
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:153
msgctxt "quests"
msgid "Find a Dragonbane Flower for the Balion Tearwing in the Garrote Gorge Dragon Caves."
msgstr "Znajdź smocze kwiecie dla Baliona Tearwinga ze Smoczych Jam Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:155
msgctxt "quests"
msgid "Kill all the Dragons in the Garrote Gorge wilderness area. Return to Avalon in Garrote Gorge."
msgstr "Zabij wszystkie smoki z pustkowi Wąwozu Garoty. Wróć do Avalona z Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:159
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:158
msgctxt "quests"
msgid "Kill all the Dragon Hunter's in the Garrote Gorge wilderness area. Return to Jerin Flame-eye in the Garrote Gorge Dragon Caves."
msgstr "Zabij wszystkich łowców smoków z pustkowi Wąwozu Garoty. Wróć do Jerina Płomienne Oko ze Smoczych Jam Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:162
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:161
msgctxt "quests"
msgid "Find the Legendary Drum of Victory. Return it to Zelim in Garrote Gorge."
msgstr "Znajdź legendarny Bęben Zwycięstwa. Zwróć go Zelimowi z Wąwozu Garoty."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:164
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:163
msgctxt "quests"
msgid "Find Iseldir's Puzzle Box for Benefice of Shadowspire."
msgstr "Znajdź Zagadkowe Pudełko Iseldira dla Benefice'a z Shadowspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:166
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:165
msgctxt "quests"
msgid "Find a Vial of Grave Dirt. Return it to Halien in Shadowspire."
msgstr "Znajdź fiolkę ziemi cmentarnej. Zwróć ją Hallienowi z Shadowspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:168
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:167
msgctxt "quests"
msgid "Find the Bone of Doom for Tantilion of Shadowspire."
msgstr "Znajdź Kość Zagłady dla Tantiliona z Shadowspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:174
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:173
msgctxt "quests"
msgid "Challenge the Arcomage Champion in each tavern of Jadame."
msgstr "Wyzwij na pojedynek czempiona Arcomage z każdej tawerny w Jadame."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:175
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:174
msgctxt "quests"
msgid "Win a game of Arcomage in all eleven taverns, then return to Tonk Blueswan in Ravenshore."
msgstr "Wygraj rozgrywki Arcomage we wszystkich jedenastu tawernach, po czym wróć do Tonki Blueswan z Ravenshore."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:178
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:177
msgctxt "quests"
msgid "Find a wheel of Frelandeau Cheese. Bring it to Asael Fromago in Alvar."
msgstr "Znajdź krąg sera Frelandeau. Przynieś go Asaelowi Fromago z Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:179
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:178
msgctxt "quests"
msgid "Find a log of Eldenbrie Cheese. Bring it to Asael Fromago in Alvar."
msgstr "Znajdź bryłę sera Eldenbrie. Przynieś ją Asaelowi Fromago z Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:180
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:179
msgctxt "quests"
msgid "Find a ball of Dunduck Cheese. Bring it to Asael Fromago in Alvar."
msgstr "Znajdź kulę sera Dunduck. Przynieś ją Asaelowi Fromago z Alvar."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:238
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:237
msgctxt "quests"
msgid "Find the treasure of the Dread Pirate Stanley."
msgstr "Znajdź skarb Strasznego Pirata Stanleya."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:286
#: mm8/Data/10LocLANG.EnglishT/quests.txt.py:285
msgctxt "quests"
msgid "Return to Fellmoon in Ravenshore and report your success in blackmailing the wererat smuggler, Arion Hunter."
msgstr "Wróć do Fellmoona z Alvar i powiadom go o udanym szantażu szczurołaka przemytnika, Ariona Łowcy."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:515
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:2
msgctxt "quests"
msgid "Return a red potion to the Judge on Emerald Island."
msgstr "Przynieście czerwony eliksir sędziemu na Szmaragdowej Wyspie"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:516
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:3
msgctxt "quests"
msgid "Return a seashell to the Judge on Emerald Island."
msgstr "Przynieście muszlę sędziemu na Szmaragdowej Wyspie"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:517
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:4
msgctxt "quests"
msgid "Return a longbow to the Judge on Emerald Island."
msgstr "Przynieście długi łuk sędziemu na Szmaragdowej Wyspie"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:518
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:5
msgctxt "quests"
msgid "Return a floor tile to the Judge on Emerald Island."
msgstr "Przynieście płytkę podłogową sędziemu na Szmaragdowej Wyspie"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:519
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:6
msgctxt "quests"
msgid "Return a musical instrument to the Judge on Emerald Island."
msgstr "Przynieście instrument muzyczny sędziemu na Szmaragdowej Wyspie"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:520
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:7
msgctxt "quests"
msgid "Return a wealthy hat to the Judge on Emerald Island."
msgstr "Przynieście strojny kapelusz sędziemu na Szmaragdowej Wyspie"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:530
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:17
msgctxt "quests"
msgid "Find the missing contestants on Emerald Island and bring back proof to Lord Markham."
msgstr "Znajdźcie zaginionych zawodników na Szmaragdowej Wyspie i przynieście tego dowód Lordowi Markhamowi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:532
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:19
msgctxt "quests"
msgid "Go to Lord Markham's estate in Tatalia, steal the vase there, and return it to William Lasker in the Erathian Sewers."
msgstr "Udajcie się do majątku Lorda Markhama w Tatalii, skradnijcie stamtąd wazę i wróćcie z nim do Williama Laskera w kanałach Erathii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:533
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:20
msgctxt "quests"
msgid "Go to Watchtower 6 in the Deyja Moors, and move the weight from the top of the tower to the bottom of the tower.  Then return to William Lasker in the Erathian Sewers."
msgstr "Udajcie się do szóstej wieży strażniczej na wrzosowiskach Deyi i przenieście odważnik z góry wieży na dół. Potem wróćcie do Williama Laskera w kanałach Erathii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:535
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:22
msgctxt "quests"
msgid "Go to the Celestial Court in Celeste and kill Lady Eleanor Carmine.  Return with proof to Seknit Undershadow in the Deyja Moors."
msgstr "Udajcie się na Niebiański Dwór w Celeste i zabijcie lady Eleanor Carmine. Wróćcie z dowodem do Seknita Undershadowa na wrzosowiskach Deyi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:536
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:23
msgctxt "quests"
msgid "Kill Wromthrax the Heartless in his cave in Tatalia, then talk to Sir Charles Quixote."
msgstr "Zabijcie Wromthraxa Bez Serca w jego jaskini w Tatalii, a potem porozmawiajcie z Sir Charlesem Quixotem."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:538
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:25
msgctxt "quests"
msgid "Rescue Alice Hargreaves from William's Tower in the Deyja Moors then talk to Sir Charles Quixote."
msgstr "Uratujcie Alicję Hargreaves z wieży Williama na wrzosowiskach Deyi, a potem porozmawiajcie z Sir Charlesem Quixotem."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:540
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:27
msgctxt "quests"
msgid "Capture Alice Hargreaves from her residence in Castle Gryphonheart and return her to William's Tower in the Deyja Moors."
msgstr "Porwijcie Alicję Hargreaves z jej rezydencji w Zamku Gryphonheart i przyprowadźcie ją do wieży Wiliama na wrzosowiskach Deyi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:541
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:28
msgctxt "quests"
msgid "Find the lost meditation spot in the Dwarven Barrows."
msgstr "Znajdźcie zaginione miejsce medytacji w Krasnoludzkich Kurhanach."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:542
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:29
msgctxt "quests"
msgid "Go to the Temple of Baa in Avlee and kill the High Priest of Baa, then return to Bartholomew Hume in Harmondale."
msgstr "Udajcie się do świątyni Baa w Avlee i zabijcie Najwyższego Kapłana Baa. Następnie wróćcie do Bartłomieja Hume'a w Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:543
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:30
msgctxt "quests"
msgid "Crack the code in the School of Sorcery in the Bracada Desert to reveal the location of the Tomb of Ashwar Nog'Nogoth.  Discover the tomb's location, enter it, and then return it to Stephan Sand in the Pit."
msgstr "Złamcie szyfr w Szkole Czarów na pustyni Bracada, aby odkryć położenie grobowca Ashwara Nog'Nogotha. Gdy tego dokonacie, udajcie się na miejsce, wejdźcie do środka, a następnie wróćcie do Stephana Sand w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:544
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:31
msgctxt "quests"
msgid "Retrieve the Perfect Bow from the Titans' Stronghold in Avlee and return it to Lawrence Mark in Harmondale."
msgstr "Odzyskajcie doskonały łuk z Twierdzy Tytanów w Avlee i przynieście go do Lawrence'a Marka w Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:545
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:32
msgctxt "quests"
msgid "Sabotage the lift in the Red Dwarf Mines in the Bracada Desert then return to Steagal Snick in Avlee."
msgstr "Zepsujcie windę w Kopalni Czerwonych Krasnoludów na pustyni Bracada, a następnie udajcie się do Steagala Snicka w Avlee."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:546
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:33
msgctxt "quests"
msgid "Retrieve the Perfect Bow from the Titans' Stronghold in Avlee and return it to Steagal Snick in Avlee."
msgstr "Odzyskajcie doskonały łuk z Twierdzy Tytanów w Avlee i przynieście go do Steagala Snicka w Avlee."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:547
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:34
msgctxt "quests"
msgid "Win five arena challenges then return to Leda Rowan in the Bracada Desert."
msgstr "Wygrajcie pięć walk na arenie na poziomie rycerza i powróćcie do Ledy Rowan na pustyni Bracada."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:548
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:35
msgctxt "quests"
msgid "Destroy all the undead in the Haunted House in the Barrow Downs and return to Frederick Org in Erathia."
msgstr "Zabijcie wszystkich nieumarłych w nawiedzonym dworku w Dolinie Kurhanów i powróćcie do Fredericka Orga w Erathii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:549
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:36
msgctxt "quests"
msgid "Raid the Elven Treasury at Castle Navan in the Tularean Forest and return to Frederick Org in Erathia."
msgstr "Wkradnijcie się do skarbca elfów w Zamku Navan w Lesie Tulareańskim, a następnie powróćcie do Fredericka Orga w Erathii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:550
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:37
msgctxt "quests"
msgid "Calm the trees in the Tularean Forest by speaking to the Oldest Tree then return to Lysander Sweet in the Bracada Desert."
msgstr "Uspokójcie drzewa z Lasu Tulareańskiego rozmawiając z Najstarszym Drzewem, a następnie powróćcie do Lysandera Sweeta na pustyni Bracada."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:551
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:38
msgctxt "quests"
msgid "Solve the secret to the entrance of the Faerie Mound in Avlee and speak to the Faerie King."
msgstr "Odkryjcie sekret wejścia do wzgórza skrzatów w Avlee i porozmawiajcie z królem skrzatów."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:552
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:39
msgctxt "quests"
msgid "Collect 10,000 gold worth of bounties from the Bounty Hunts in the town halls, then return to Ebednezer Sower in the Tularean Forest."
msgstr "Zbierzcie nagrody o wartości 10 000 sztuk złota ze zleceń od Rad Miasta, a następnie wróćcie do Ebednezera Sowera w Lesie Tulareańskim."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:553
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:40
msgctxt "quests"
msgid "Find the Heart of the Forest in the Mercenary Guild in Tatalia and return it to the Oldest Tree in the Tularean Forest."
msgstr "Odnajdźcie Serce Kniei w gildii najemników w Tatalii i zwróćcie je Najstarszemu Drzewu w Lesie Tulareańskim."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:556
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:43
msgctxt "quests"
msgid "Purify the Altar of Evil in the Temple of the Moon on Evenmorn Isle then return to Rebecca Devine in Celeste."
msgstr "Dokonajcie obrzędu oczyszczenia ołtarza zła w świątyni Księżyca na Wyspie Evenmorn, po czym wróćcie do Rebekki Devine w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:557
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:44
msgctxt "quests"
msgid "Find the lost pirate map in the Tidewater Caverns in Tatalia and return to Daedalus Falk in the Deyja Moors."
msgstr "Odnajdźcie zaginioną mapę piratów w jaskiniach Tidewater w Tatalii i powróćcie do Daedalusa Falka na wrzosowiska Deyi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:558
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:45
msgctxt "quests"
msgid "Deface the Altar of Good in the Temple of the Sun on Evenmorn Isle then return to Daedalus Falk in the Deyja Moors."
msgstr "Zbezcześćcie ołtarz dobra w świątyni Słońca na Wyspie Evenmorn, po czym wróćcie do Daedalusa Falka na wrzosowiska Deyi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:559
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:46
msgctxt "quests"
msgid "Collect the six golem pieces and construct a complete golem, then return to Thomas Grey in the School of Sorcery."
msgstr "Zbierzcie sześć części golema i złączcie je w całość, a następnie wróćcie do Thomasa Greya do Szkoły Czarów."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:561
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:48
msgctxt "quests"
msgid "Find the Book of Divine Intervention in the Breeding Zone in the Pit and return it to Thomas Grey in the School of Sorcery."
msgstr "Odnajdźcie Księgę Boskiej Interwencji w Strefie Wylęgu w Czeluści, a potem wróćcie do Thomasa Greya do Szkoły Czarów."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:562
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:49
msgctxt "quests"
msgid "Retrieve the lich jars from the Proving Grounds in Celeste and bring them back to Halfgild Wynac in the Pit."
msgstr "Odzyskajcie naczynia liszów z Toru Przeszkód w Celeste i przynieście je Halfgildowi Wynacowi w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:563
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:50
msgctxt "quests"
msgid "Visit the three stonehenge monoliths in Tatalia, the Evenmorn Islands, and Avlee, then return to Anthony Green in the Tularean Forest."
msgstr "Udajcie się do kamiennych kręgów w Tatalii, na Wyspach Evenmorn i Avlee, potem wróćcie do Anthony'ego Greena w Lesie Tulareańskim."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:568
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:55
msgctxt "quests"
msgid "Retrieve the bones of the Dwarf King from the tunnels between Stone City and Nighon and place them in their proper resting place in the Barrow Downs, then return to Anthony Green in the Tularean Forest."
msgstr "Wydobądźcie kości krasnoludzkiego króla z tuneli pomiędzy Kamiennym Miastem a Nighon i umieśćcie je w miejscu spoczynku w Dolinie Kurhanów. Następnie wróćcie do Anthony'ego Greena w Lesie Tulareańskim."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:569
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:56
msgctxt "quests"
msgid "Retrieve the dragon egg from the Dragon Cave in the Land of the Giants and return it to Tor Anwyn in Mount Nighon."
msgstr "Zabierzcie smocze jajo ze smoczej jaskini w krainie olbrzymów i przynieście je Torowi Anwynowi na Górze Nighon."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:589
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:76
msgctxt "quests"
msgid "Clean out Castle Harmondale and return to the Butler in the tavern, On the House, in Harmondale."
msgstr "Oczyśćcie Zamek Harmondale i powróćcie do Lokaja w Gospodzie Domowej w Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:590
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:77
msgctxt "quests"
msgid "Rescue the dwarves from the Red Dwarf Mines and return to the Dwarf King in Stone City in the Barrow Downs."
msgstr "Uratujcie krasnoludy z Kopalń Czerwonych Krasnoludów i powróćcie do ich króla w Kamiennym Mieście w Dolinie Kurhanów."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:591
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:78
msgctxt "quests"
msgid "Retrieve plans from Fort Riverstride and return them to Eldrich Parson in Castle Navan in the Tularean Forest."
msgstr "Odzyskajcie plany z Fortu Riverstride i przynieście je Eldrichowi Parsonowi do Zamku Navan w Lesie Tulareańskim."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:592
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:79
msgctxt "quests"
msgid "Rescue Loren Steel from the Tularean Caves in the Tularean Forest and return him to Queen Catherine."
msgstr "Uratujcie Lorena Steela z jaskiń Tulareańskich w Lesie Tulareańskim i przyprowadźcie go do Królowej Katarzyny."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:593
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:80
msgctxt "quests"
msgid "Retrieve Gryphonheart's Trumpet from the battle in the Tularean Forest and return it to whichever side you choose."
msgstr "Podczas bitwy w Lesie Tulareańskim zdobądźcie trąbkę Gryphonhearta i zwróćcie ją wybranej przez was stronie."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:608
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:95
msgctxt "quests"
msgid "Give false Riverstride plans to Eldrich Parson in Castle Navan in the Tularean Forest."
msgstr "Przekażcie fałszywe plany fortu Riverstride Eldrichowi Parsonowi z Zamku Navan w Lesie Tulareańskim."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:609
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:96
msgctxt "quests"
msgid "Return the Loren imposter to Queen Catherine in Castle Gryphonheart in Erathia."
msgstr "Przyprowadźcie fałszywego Lorena do Królowej Katarzyny w Zamku Gryphonheart."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:615
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:102
msgctxt "quests"
msgid "Complete the Walls of Mist without killing a single opponent and return to Gavin Magnus in Castle Lambent in Celeste."
msgstr "Przejdźcie przez Ściany Mgły nikogo nie zabijając i wróćcie do Gavina Magnusa w Zamku Jasności w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:617
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:104
msgctxt "quests"
msgid "Retrieve the altar piece from the Temple of Light in Celeste and the Temple of Dark in the Pit and return them to Resurectra in Castle Lambent in Celeste."
msgstr "Zdobądźcie części ołtarzy ze Świątyni Światła w Celeste i Świątyni Ciemności w Czeluści i wróćcie z nimi do Wskrzesicielki w Zamku Jasności w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:618
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:105
msgctxt "quests"
msgid "Go to Colony Zod in the Land of the Giants and slay Xenofex then return to Resurectra in Castle Lambent in Celeste."
msgstr "Udajcie się do Kolonii Zod w krainie olbrzymów i zabijcie Xenofexa, po czym wróćcie do Wskrzesicielki w Zamku Jasności w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:620
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:107
msgctxt "quests"
msgid "Investigate the Wine Cellar in Tatalia and return to Crag Hack in Castle Lambent in Celeste."
msgstr "Przeszukajcie piwnicę z winem w Tatalii i powróćcie do Craga Hacka w Zamku Jasności w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:622
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:109
msgctxt "quests"
msgid "Retrieve the Case of Soul Jars from Castle Gloaming in the Pit and return to Sir Caneghem in Celeste."
msgstr "Wydostańcie skrzynkę z naczyniami dusz z Zamku Półmroku w Czeluści i powróćcie z nią do Sir Caneghema w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:623
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:110
msgctxt "quests"
msgid "Assassinate Tolberti in his house in the Pit and return his control cube to Robert the Wise in Celeste."
msgstr "Napadnijcie na Tolbertiego w jego domu w Czeluści i przynieście jego kostkę kontrolną Mędrcowi Robertowi w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:636
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:123
msgctxt "quests"
msgid "Retrieve the altar piece from the Temple of Light in Celeste and the Temple of Dark in the Pit and return them to Kastore in the Pit."
msgstr "Zdobądźcie części ołtarzy ze Świątyni Światła w Celeste i Świątyni Ciemności w Czeluści i wróćcie z nimi do Kastora w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:637
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:124
msgctxt "quests"
msgid "Go to Colony Zod in the Land of the Giants and slay Xenofex then return to Kastore in the Pit."
msgstr "Udajcie się do Kolonii Zod w krainie olbrzymów i zabijcie Xenofexa, po czym wróćcie do Kastora w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:638
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:125
msgctxt "quests"
msgid "Retrieve the Case of Soul Jars from the Warlocks in Thunderfist Mountain and bring them to Maximus in the Pit."
msgstr "Zdobądźcie skrzynkę z naczyniami dusz od czarnoksiężników Górze Grzmiącej Pięści i wróćcie z nią do Maximusa w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:639
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:126
msgctxt "quests"
msgid "Destroy the magical defenses inside Clanker's Laboratory and return to Dark Shade in the Pit."
msgstr "Zniszczcie magiczne systemy obrony w laboratorium Clankera i wróćcie do Mrocznego Cienia w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:641
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:128
msgctxt "quests"
msgid "Assassinate Robert the Wise in his house in Celeste and return to Tolberti in the Pit."
msgstr "Dokonajcie zamachu na Mędrca Roberta w jego domu w Celeste, a potem wróćcie do Tolbertiego w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:642
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:129
msgctxt "quests"
msgid "Complete the Breeding Zone and return to Archibald in the Pit."
msgstr "Przejdźcie przez Strefę Wylęgu i powróćcie do Archibalda w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:644
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:131
msgctxt "quests"
msgid "Go to the Lincoln in the sea west of Avlee and retrieve the Oscillation Overthruster and return it to Resurectra in Celeste."
msgstr "Udajcie się do Lincolna, który znajduje się pod powierzchnią morza, na zachód od Avlee, wydostańcie z niego przetwornik oscylacyjny, a następnie zwróćcie go Wskrzesicielce w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:645
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:132
msgctxt "quests"
msgid "Go to the Lincoln in the sea west of Avlee and retrieve the Oscillation Overthruster and return it to Kastore in the Pit."
msgstr "Udajcie się do Lincolna, który znajduje się pod powierzchnią morza, na zachód od Avlee, wydostańcie z niego przetwornik oscylacyjny, a następnie zwróćcie go Kastorowi w Czeluści."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:660
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:147
msgctxt "quests"
msgid "Talk to the Dwarves in Stone City in the Barrow Downs to find a way to repair Castle Harmondale."
msgstr "Porozmawiajcie z krasnoludami z Kamiennego Miasta w Dolinie Kurhanów, aby znaleźć sposób na wyremontowanie zamku Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:665
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:152
msgctxt "quests"
msgid "Enter the Pit from the Hall of the Pit in the Deyja Moors, then talk to Archibald in Castle Gloaming in the Pit."
msgstr "Będąc w Przedsionku Czeluści na wrzosowiskach Deyi wejdźcie do Czeluści, a następnie potem porozmawiajcie z Archibaldem w Zamku Półmroku."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:666
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:153
msgctxt "quests"
msgid "Enter Celeste from the grand teleporter in the Bracada Desert, then talk to Gavin Magnus in Castle Lambent in Celeste."
msgstr "Dostań się do Celeste używając wielkiego teleportu na pustyni Bracada, a następnie porozmawiaj z Gavinem Magnusem w Zamku Jasności w Celeste."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:667
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:154
msgctxt "quests"
msgid "Choose a judge to succeed Judge Grey as Arbiter in Harmondale."
msgstr "Dokonaj wyboru sędziego, który zastąpi sędziego Greya na stanowisku arbitra w sporze o Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:669
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:156
msgctxt "quests"
msgid "Retrieve the Lantern of Light from the Barrow Downs and return it to Tarin Withern in Harmondale."
msgstr "Zabierzcie Latarnię Światła z Doliny Kurhanów i zwróćcie ją Tarinowi Withernowi w Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:670
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:157
msgctxt "quests"
msgid "Retrieve Haldar's Remains from the Maze in Nighon and return them to Mazim Dusk in Nighon."
msgstr "Wydostańcie szczątki Haldara z labiryntu w Nighon i zwróćcie je Mazimowi Duskowi w Nighon."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:671
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:158
msgctxt "quests"
msgid "Retrieve Davrik's Signet ring from the Bandit Caves in the northeast of Erathia and return it to Davrik Peladium in Harmondale."
msgstr "Wydostańcie sygnet Davrika z jaskiń bandytów w północno-zachodniej Erathii i zwróćcie go Davrikowi Peladium z Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:672
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:159
msgctxt "quests"
msgid "Take Sealed Letter to Lord Markham in Lord Markham's Manor in Tatalia for collector Norbert Thrush."
msgstr "Dostarczcie Lordowi Markhamowi w jego posiadłości w Tatalii zapieczętowany list od kolekcjonera Norberta Thrusha."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:673
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:160
msgctxt "quests"
msgid "Return Parson's Quill to Norbert Thrush in Erathia."
msgstr "Przynieście pióro Parsona Norbertowi Thrushowi w Erathii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:693
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:180
msgctxt "quests"
msgid "Take the sealed letter to the Faerie King in the Hall under the Hill in Avlee."
msgstr "Dostarczcie zapieczętowany list królowi skrzatów w Pałacu pod Wzgórzem w Avlee."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:694
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:181
msgctxt "quests"
msgid "Take the Faerie Pipes to Johann Kerrid in the Tularean Forest."
msgstr "Przynieście piszczałki skrzatów Johannowi Kerridowi w Lesie Tulareańskim."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:695
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:182
msgctxt "quests"
msgid "Go to the Mercenary Guild in Tatalia and talk to Niles Stantley within two weeks."
msgstr "Przed upływem dwóch tygodni udajcie się do gildii najemników w Tatalii i porozmawiajcie z Nilesem Stantleyem."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:696
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:183
msgctxt "quests"
msgid "Steal the Tapestry from your associate's Castle and return it to Niles Stantley in the Mercenary Guild in Tatalia."
msgstr "Ukradnijcie gobelin z zamku waszego sojusznika i przynieście go Nilesowi Stantleyowi do gildii najemników w Tatalii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:700
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:187
msgctxt "quests"
msgid "Kill all the Troglodytes underneath Stone City and return to Spark Burnkindle in Stone City."
msgstr "Zabijcie wszystkich troglodytów pod Kamiennym Miastem i wróćcie do Sparka Burnkindle."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:701
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:188
msgctxt "quests"
msgid "Kill all the Griffins in Erathia and the Bracada Desert and return to Seth Drakkson in the Deyja Moors."
msgstr "Zabijcie wszystkie gryfy w Erathii i na pustyni Bracada i wróćcie do Setha Drakksona na wrzosowiska Deyi."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:708
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:195
msgctxt "quests"
msgid "Find the fate of Darron's brother in the White Cliff Caves, then return to Darron Temper in Harmondale."
msgstr "Dowiedzcie się, co się stało z bratem Darrona w jaskiniach Białych Klifów, a następnie wróćcie do Darrona w Harmondale."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:709
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:196
msgctxt "quests"
msgid "Retrieve the Seasons' Stole from the Hall of the Pit and return it to Gary Zimm in the Bracada Desert."
msgstr "Odzyskajcie Stułę Pór Roku z Przedsionka Czeluści i wróćcie z nią do Gary Zimma na pustynię Bracada."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:714
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:201
msgctxt "quests"
msgid "Retrieve the three statuettes and place them on the shrines in the Bracada Desert, Tatalia, and Avlee, then return to Thom Lumbra in the Tularean Forest."
msgstr "Zdobądźcie trzy statuetki i umieśćcie je w sanktuariach na pustyni Bracada, w Tatalii oraz Avlee, po czym wróćcie do Thorna Lumbra z Lasu Tulareańskiego."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:718
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:205
msgctxt "quests"
msgid "Retrieve the three paintings and return them to Ferdinand Visconti in Tatalia."
msgstr "Zdobądźcie trzy obrazy i wróćcie z nimi do Ferdinanda Viscontiego w Tatalii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:719
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:206
msgctxt "quests"
msgid "Win a game of Arcomage in all thirteen taverns, then return to Gina Barnes in Erathia."
msgstr "Wygrajcie pojedynki w Arcomage we wszystkich trzynastu gospodach, a potem wróćcie do Giny Barnes w Erathii."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:759
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:246
msgctxt "quests"
msgid "Congratulations"
msgstr "Gratulacje"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1107
#: mm6/data/10LocLANG.icons/Quests.txt.py:82
msgctxt "quests"
msgid "Show Sulman's letter to Andover Potbello in New Sorpigal."
msgstr "Pokażcie list Sulmana Andoverowi Potbello w Nowym Sorpigalu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1108
#: mm6/data/10LocLANG.icons/Quests.txt.py:83
msgctxt "quests"
msgid "Bring Sulman's letter to Regent Wilbur Humphrey at Castle Ironfist."
msgstr "Przyieście list Sulmana do regenta Wilbura Humphreya na Zamku Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1109
#: mm6/data/10LocLANG.icons/Quests.txt.py:84
msgctxt "quests"
msgid "Find the Combination to the vault door in Goblinwatch and return to the Town Hall in New Sorpigal."
msgstr "Znajdźcie kombinacje do drzwi skarbca w Goblińskiej Wachcie i powróćcie do Ratusza w Nowym Sorpigalu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1110
#: mm6/data/10LocLANG.icons/Quests.txt.py:85
msgctxt "quests"
msgid "Get the Chime of Harmony from the Temple of Baa and return to the New Sorpigal Town Hall."
msgstr "Przynieście Dzwonki Harmonii ze Świątyni Baa i powróćcie do Ratusza w Nowym Sorpigalu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1112
#: mm6/data/10LocLANG.icons/Quests.txt.py:87
msgctxt "quests"
msgid "Find Lord Kilburn's Shield and return to Wilbur Humphrey in Castle Ironfist to report."
msgstr "Znajdźcie Tarczę Lorda Kilburna i powróćcie do Wilbura Humphreya na Zamku Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1114
#: mm6/data/10LocLANG.icons/Quests.txt.py:89
msgctxt "quests"
msgid "Rescue a Damsel in Distress and return with her to Wilbur Humphrey in Castle Ironfist."
msgstr "Uratujcie Pannę w Opałach i powróćcie z nią do Wilbura Humphreya na Zamku Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1115
#: mm6/data/10LocLANG.icons/Quests.txt.py:90
msgctxt "quests"
msgid "Slay Longfang Witherhide in his cave near Castle Darkmoor and return to Wilbur Humphrey in Castle Ironfist."
msgstr "Zabijcie Longfanga Witherhide'a w jego jaskini niedaleko Zamku Darkmoor i powróćcie do Wilbura Humphreya na Zamku Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1116
#: mm6/data/10LocLANG.icons/Quests.txt.py:91
msgctxt "quests"
msgid "Entertain Nicolai."
msgstr "Rozbawcie Nicolaia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1121
#: mm6/data/10LocLANG.icons/Quests.txt.py:96
msgctxt "quests"
msgid "Find and return Prince Nicolai to Castle Ironfist."
msgstr "Znajdźcie i przyprowadźcie z powrotem Księcia Nicolaia na Zamek Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1122
#: mm6/data/10LocLANG.icons/Quests.txt.py:97
msgctxt "quests"
msgid "Find the Third Eye and bring it to Prince Nicolai in Castle Ironfist."
msgstr "Odnajdźcie Trzecie Oko i przynieście je do Księcia Nicolaia na Zamku Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1124
#: mm6/data/10LocLANG.icons/Quests.txt.py:99
msgctxt "quests"
msgid "Capture the Prince of Thieves and bring him to Lord Anthony Stone at Castle Stone."
msgstr "Schwytajcie Księcia Złodziei i przynieście go do Lorda Anthony'ego Stone'a na Zamku Stone."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1131
#: mm6/data/10LocLANG.icons/Quests.txt.py:106
msgctxt "quests"
msgid "Hire a Stonecutter and a Carpenter, bring them to Temple Stone in Free Haven to repair the Temple, and then return to Lord Anthony Stone at Castle Stone."
msgstr "Najmijcie murarza i cieślę, przyprowadźcie ich do Świątyni Stone w Wolnej Przystani aby ją naprawić, a następnie powróćcie do lorda Anthony'ego Stone'a na Zamku Stone."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1133
#: mm6/data/10LocLANG.icons/Quests.txt.py:108
msgctxt "quests"
msgid "Take the Sacred Chalice from the monks in their island temple east of Free Haven, return it to Temple Stone in Free Haven, and then return to Lord Stone at Castle Stone."
msgstr "Zabierzcie Święty Kielich od mnichów na ich wyspiarskiej świątyni na wschód od Wolnej Przystani, przynieście go do Świątyni Stone, a następnie powróćcie do lorda Stone'a na Zamku Stone."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1136
#: mm6/data/10LocLANG.icons/Quests.txt.py:111
msgctxt "quests"
msgid "Find and return the Hourglass of Time to Lord Albert Newton in Mist."
msgstr "Zajdźcie i oddajcie Klepsydrę Czasu lordowi Albertowi Netwonowi we Mgle."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1137
#: mm6/data/10LocLANG.icons/Quests.txt.py:112
msgctxt "quests"
msgid "Drink from the Fountain of Magic and return to Lord Albert Newton in Mist."
msgstr "Napijcie się wody z Fontanny Magii i powróćcie do lorda Alberta Netwona we Mgle."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1138
#: mm6/data/10LocLANG.icons/Quests.txt.py:113
msgctxt "quests"
msgid "Retrieve the Crystal of Terrax and return to Lord Albert Newton in Mist."
msgstr "Odzyskajcie Kryształ Terraxa i powróćcie do lorda Alberta Netwona we Mgle."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1139
#: mm6/data/10LocLANG.icons/Quests.txt.py:114
msgctxt "quests"
msgid "Destroy the Devil's Outpost and return to Lord Osric Temper at Castle Temper."
msgstr "Zniszczcie Posterunek Diabłów i powróćcie do lorda Osrica Tempera na Zamku Temper."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1140
#: mm6/data/10LocLANG.icons/Quests.txt.py:115
msgctxt "quests"
msgid "Get Knight's nomination from Chadwick and return to Lord Osric Temper at Castle Temper."
msgstr "Zdobąćcie nominację rycerzy od Chadwicka i powróćcie do lorda Osrica Tempera na Zamku Temper."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1141
#: mm6/data/10LocLANG.icons/Quests.txt.py:116
msgctxt "quests"
msgid "Defeat the Warlord and bring proof to Osric Temper"
msgstr "Pokonajcie Wodza i przynieście dowód zwycięstwa Osricowi Temperowi"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1142
#: mm6/data/10LocLANG.icons/Quests.txt.py:117
msgctxt "quests"
msgid "Fix the prices of all 9 stables in the Kingdom and return to Lady Fleise in Silver Cove."
msgstr "Ustalcie ceny we wszystkich 9 stajniach w Królestwie i powróćcie do Pani Fleise w Srebrzystej Zatoczce."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1144
#: mm6/data/10LocLANG.icons/Quests.txt.py:119
msgctxt "quests"
msgid "Visit the Altar of the Sun in the circle of stones north of Silver Cove on an equinox or solstice (HINT:  March 20th is an equinox)."
msgstr "Odwiedźcie Ołtarz Słońca w kamiennym kręgu na północ od Srebrzystej Zatoczki podczas równonocy lub przesilenia (WSKAZÓWKA:  20 marca nastąpi równonoc)."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1145
#: mm6/data/10LocLANG.icons/Quests.txt.py:120
msgctxt "quests"
msgid "Visit the Altar of the Moon in the Temple of the Moon at midnight of a full moon."
msgstr "Odwiedźcie Ołtarz Księżyca w Świątyni Księżyca o północy podczas pełni księżyca."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1146
#: mm6/data/10LocLANG.icons/Quests.txt.py:121
msgctxt "quests"
msgid "End winter for Lord Stromgard at Castle Stromgard, and return to him with the good news."
msgstr "Zakończcie zimę dla lorda Stormgarda na Zamku Stormgard i powróćcie do niego z dobrymi wieściami."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1147
#: mm6/data/10LocLANG.icons/Quests.txt.py:122
msgctxt "quests"
msgid "Retrieve the key to the Dragon Towers from Icewind Keep south of Whitecap, and bring it to Lord Stromgard at Castle Stromgard."
msgstr "Odzyskajcie klucz do Smoczych Wież z Twierdzy Lodowego Wichru na południe od Białego Wzgórza i przynieście go do lorda Stromgarda na Zamku Stromgard."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1148
#: mm6/data/10LocLANG.icons/Quests.txt.py:123
msgctxt "quests"
msgid "Reset all of the Dragon Towers at each town and return to Lord Stromgard in Castle Stromgard."
msgstr "Zresetujcie wszystkie Smocze Wieże w każdym mieście i powróćcie do lorda Stromgarda  na Zamku Stromgard."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1150
#: mm6/data/10LocLANG.icons/Quests.txt.py:125
msgctxt "quests"
msgid "Kill Snergle in Snergle's Caverns and return with his axe to Avinril Smythers at The Haunt tavern in the Mire of the Damned."
msgstr "Zabijcie Snergle'a w Jaskiniach Snergle'a i powróćcie z jego toporem do Avinril Smythers w tawernie Speluna na Bagnach Potępionych."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1151
#: mm6/data/10LocLANG.icons/Quests.txt.py:126
msgctxt "quests"
msgid "Storm the Silver Helm Outpost near Mist and return with evidence of their corruption to the Constable of Mist."
msgstr "Wedrzyjcie się do Posterunku Srebrnych Hełmów niedaleko Mgły i powróćcie z dowodem ich korupcji do konstabla Mgły."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1152
#: mm6/data/10LocLANG.icons/Quests.txt.py:127
msgctxt "quests"
msgid "Retrieve the candelabra from the Abandoned Temple for Andover Potbello in New Sorpigal."
msgstr "Odzyskajcie kandelabr z Opuszczonej Świątyni i dajcie go Andoverowi Potbello w Nowym Sorpigalu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1154
#: mm6/data/10LocLANG.icons/Quests.txt.py:129
msgctxt "quests"
msgid "Retrieve the harp from the Dragoon's Caverns south of Castle Ironfist and return it to Andrew Besper in Castle Ironfist."
msgstr "Odzyskajcie harfę z Jaskiń Dragonów na południe od Zamku Ironfist i przynieście ją Andrewowi Besperowi na Zamku Ironfist."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1155
#: mm6/data/10LocLANG.icons/Quests.txt.py:130
msgctxt "quests"
msgid "Retrieve Ethric's skull from his tomb west of Free Haven for Gabriel Cartman in Free Haven."
msgstr "Odzyskajcie czaszkę Ethrica z jego grobowca na zachód od Wolnej Przystani dla Gabriela Cartmana w Wolnej Przystani."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1156
#: mm6/data/10LocLANG.icons/Quests.txt.py:131
msgctxt "quests"
msgid "Kill the Queen of the Spiders in the Abandoned Temple in New Sorpigal and return with her heart to Buford T. Allman in New Sorpigal."
msgstr "Zabijcie Królową Pająków w Opuszczonej Świątyni w Nowym Sorpigalu i powróćcie z jej sercem do Buforda T. Allmana w Nowym Sorpigalu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1157
#: mm6/data/10LocLANG.icons/Quests.txt.py:132
msgctxt "quests"
msgid "Deface the altar in the Monolith west of Silver Cove and return to Eleanor Vanderbilt in Silver Cove."
msgstr "Zbezcześćcie ołtarz w Monolicie na zachód od Srebrzystej Zatoczki i powróćcie do Eleanor Vanderbilt w Srebrzystej Zatoczce."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1160
#: mm6/data/10LocLANG.icons/Quests.txt.py:135
msgctxt "quests"
msgid "Destroy the crystal in the Temple of the Fist and return to Winston Schezar in Bootleg Bay."
msgstr "Zniszczcie kryształ w Świątyni Pięści i powróćcie do Winstona Schezara."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1162
#: mm6/data/10LocLANG.icons/Quests.txt.py:137
msgctxt "quests"
msgid "Rescue Emmanuel from the Temple of the Snake near Blackshire and return him to Joanne Cravitz in Blackshire."
msgstr "Uratujcie Emmanuela ze Świątyni Węża niedaleko Czarnego Hrabstwa i powróćcie z nim do Joanne Cravitz w Czarnym Hrabstwie."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1163
#: mm6/data/10LocLANG.icons/Quests.txt.py:138
msgctxt "quests"
msgid "Find the lost artifact in the Dragoons' Keep near Castle Temper and return it to Zoltan Phelps in Free Haven."
msgstr "Znajdźcie zaginiony artefakt w Twierdzy Dragonów niedaleko Zamku Temper i powróćcie z nim do Zoltana Phelpsa w Bezpiecznej Przystani."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1164
#: mm6/data/10LocLANG.icons/Quests.txt.py:139
msgctxt "quests"
msgid "Rescue Sharry from the Shadow Guild Hideout and return with her to Frank Fairchild in New Sorpigal."
msgstr "Ocalcie Sharry z Kryjówki Gildii Cienia i powróćcie z nią do Granka Fairchilda w Nowym Sorpigalu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1165
#: mm6/data/10LocLANG.icons/Quests.txt.py:140
msgctxt "quests"
msgid "Rescue Angela from the Abandoned Temple and return her to Violet Dawson in New Sorpigal."
msgstr "Ocalcie Angelę Z Opuszczonej Świątyni i powróćcie z nią do Violet Dawson w Nowym Sorpigalu."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1166
#: mm6/data/10LocLANG.icons/Quests.txt.py:141
msgctxt "quests"
msgid "Rescue Sherell from the cannibals on the islands east of Free Haven and return with her to Carlo Tormini in Free Haven."
msgstr "Ocalcie Sherell od kanibali na wyspach na wschód od Bezpiecznej Przystani i powróćcie z nią do Carla Torminiego w Bezpiecznej Przystani."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1167
#: mm6/data/10LocLANG.icons/Quests.txt.py:142
msgctxt "quests"
msgid "Destroy the Werewolf's altar in the Lair of the Wolf and return to Maria Trepan in Blackshire."
msgstr "Zniszczcie ołtarz Wilkołaka w Wilczym legowisku i powróćcie do Marii Trepan w Czarnym Hrabstwie."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1169
#: mm6/data/10LocLANG.icons/Quests.txt.py:144
msgctxt "quests"
msgid "Find the Pearl of Putrescence in the Lair of the Wolf and bring it to the Ghost of Balthasar, also in the Lair of the Wolf."
msgstr "Znajdźcie Perłę Zepsucia w Wilczym legowisku i przynieście ją Duchowi Baltazara, także w Wilczym legowisku."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1170
#: mm6/data/10LocLANG.icons/Quests.txt.py:145
msgctxt "quests"
msgid "Retrieve the jewelled egg from Castle Kriegspire and return it to Emil Lime in Kriegspire village."
msgstr "Odzyskajcie jajo wysadzane klejnotami z Zamku Kriegspire i powróćcie do Emil Lime w wiosce Kriegspire."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1171
#: mm6/data/10LocLANG.icons/Quests.txt.py:146
msgctxt "quests"
msgid "Unward the doors in the Hall of the Fire Lord and return to the Lord of Fire, also in the Hall of the Fire Lord."
msgstr "Odbezpieczcie drzwi w Komnatach Władcy Ognia i powróćcie do Władcy Ognia."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1188
#: mm6/data/10LocLANG.icons/Quests.txt.py:163
msgctxt "quests"
msgid "Find Memory Crystal Alpha in the Supreme Temple of Baa and restore it to a module altar at the Oracle beneath the High Council.."
msgstr "Znajdźcie Kryształ Pamięci Alfa w Najwyższej Świątyni Baa i przywróćcie go do modułu w ołtarzu w Wyroczni pod Wysoką Radą."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1189
#: mm6/data/10LocLANG.icons/Quests.txt.py:164
msgctxt "quests"
msgid "Find Memory Crystal Beta in Castle Alamos and restore it to a module altar at the Oracle beneath the High Council."
msgstr "Znajdźcie Kryształ Pamięci Beta na Zamku Kriegspire i przywróćcie go do modułu w ołtarzu w Wyroczni pod Wysoką Radą."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1190
#: mm6/data/10LocLANG.icons/Quests.txt.py:165
msgctxt "quests"
msgid "Find Memory Crystal Delta in Castle Darkmoor and restore it to a module altar at the Oracle beneath the High Council."
msgstr "Znajdźcie Kryształ Pamięci Delta na Zamku Darkmoor i przywróćcie go do modułu w ołtarzu w Wyroczni pod Wysoką Radą."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1191
#: mm6/data/10LocLANG.icons/Quests.txt.py:166
msgctxt "quests"
msgid "Find Memory Crystal Epsilon in Castle Kriegspire and restore it to a module altar at the Oracle beneath the High Council."
msgstr "Znajdźcie Kryształ Pamięci Epsilon na Zamku Alamos i przywróćcie go do modułu w ołtarzu w Wyroczni pod Wysoką Radą."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1192
#: mm6/data/10LocLANG.icons/Quests.txt.py:167
msgctxt "quests"
msgid "Retrieve the Control Cube from the Tomb of Varn in Dragonsand and return to the Oracle beneath the High Council."
msgstr "Odzyskajcie Kostkę kontrolną z Grobowca VARN na Smoczej Pustyni i powróćcie do Wyroczni pod Wysoką Radą."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1226
#: mm6/data/10LocLANG.icons/Quests.txt.py:201
msgctxt "quests"
msgid "Find a cure for Slicker Silvertongue in the Superior Temple of Baa east of Castle Kriegspire and return to Wilbur Humphrey with the good news."
msgstr "Znajdźcie lekarstwo dla Slikera Srebrnego Języka w Wielkiej Świątyni Baa na wschód od Zamku Kriegspire i powróćcie do Wilbura Humphreya z dobrymi wieściami."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1227
#: mm6/data/10LocLANG.icons/Quests.txt.py:202
msgctxt "quests"
msgid "Bring the the letter detailing Silvertongue's treason to the High Council in Free Haven."
msgstr "Przynieście list opisujący zdradę Srebrnego Języka Wysokiej Radzie w Bezpieczniej Przystani."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1230
#: mm6/data/10LocLANG.icons/Quests.txt.py:205
msgctxt "quests"
msgid "Find and destroy the Book of Liches in Castle Darkmoor and return to Terry Ros in Darkmoor village."
msgstr "Znajdźcie i zniszczcie Księgę Liszów w zamku Darkmoor i powróćcie do Terry'ego Rosa w wiosce Darkmoor."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1245
#: mm6/data/10LocLANG.icons/Quests.txt.py:220
msgctxt "quests"
msgid "Place the statuettes in Sweet Water, Kriegspire, Dragonsand, Mire of the Damned, and Bootleg Bay and return to Twillen in Blackshire."
msgstr "Umieśćcie statuetki w Słodkim Zdroju, Kriegspire, Smoczej Pustyni, Bagnach Potępionych i Zatoce Przemytników i powróćcie do Twillen w Czarnym Hrabstwie."

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1261
#: mm6/data/10LocLANG.icons/Quests.txt.py:236
msgctxt "quests"
msgid "Obtain Arcane Magic from Archibald in the Royal Library in Castle Ironfist"
msgstr "Opanujcie Tajemną Magię od Archibalda w Królewskiej Bibliotece na Zamku Ironfist"

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:1714
msgctxt "quests"
msgid "Mysterious woman asked you to travel in time and fulfill destinies of other heroes. Well..."
msgstr ""

