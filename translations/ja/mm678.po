#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:694
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:688
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:689
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:690
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:691
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:692
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:693
msgctxt "items"
msgid "Lump of Ore"
msgstr "鉱物の塊"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:687
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1489
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:689
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:688
msgctxt "items"
msgid "A small chunk of iron-laced ore.  In the hands of a skilled craftsman, this could make a weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "鉄を含む鉱石の小さな塊。武器、護符、指輪、防具など、様々なアイテムの材料になる。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:688
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1490
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:690
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:689
msgctxt "items"
msgid "Siertal-laced ore"
msgstr "シエルタルを含んだ鉱石"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:688
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1490
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:690
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:689
msgctxt "items"
msgid "A small chunk of siertal-laced ore.  Stronger and lighter than steel, in the hands of a skilled craftsman siertal could make an exceptional weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "シエルタルを含む鉱石の小さな塊。鋼鉄よりも硬くて軽いシエルタルは、熟練した職人の手にかかると最高のアイテム（武器、護符、指輪、防具など）に変貌する。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:689
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1491
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:691
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:690
msgctxt "items"
msgid "Phylt-laced ore"
msgstr "フィルトを含んだ鉱石"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:689
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1491
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:691
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:690
msgctxt "items"
msgid "A small chunk of phylt-laced ore.  Phylt is often used in steel alloys to increase the durability and enchantability of steel.  In the hands of a skilled craftsman phylt could make a weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "フィルトを含む鉱石の小さな塊で、耐久性と魔力の込めやすさを向上させるため、しばしば鋼鉄に混ぜられる。熟練した職人の手にかかれば、フィルトは武器、護符、指輪、防具といった様々なアイテムに変貌する。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:690
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1492
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:692
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:691
msgctxt "items"
msgid "Kergar-laced ore"
msgstr "ケルガーを含んだ鉱石"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:690
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1492
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:692
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:691
msgctxt "items"
msgid "A small chunk of kergar-laced ore.  Kergar shares many properties of steel, but is much easier to enchant.  In the hands of a skilled craftsman kergar could easily make a magical weapon, an amulet, a ring, armor, or almost any other item."
msgstr "ケルガーを含んだ鉱石の小さな塊。ケルガーは鋼鉄と多くの点で似ているが、魔力の込めやすさにおいて、はるかに優れている。熟練した職人なら、ケルガーを使って魔力を秘めたアイテム（武器、護符、指輪、防具など）を作ることができる。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:691
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1493
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:693
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:692
msgctxt "items"
msgid "Erudine-laced ore"
msgstr "エルダインを含んだ鉱石"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:691
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1493
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:693
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:692
msgctxt "items"
msgid "A small chunk of erudine-laced ore.  A rare magical ore found in few regions of Erathia, in the hands of a skilled craftsman erudine could make a powerful weapon, an amulet, a ring, armor, or almost any other item."
msgstr "エルダインを含んだ鉱石の小さな塊。エルダインはエラシアのごく一部の地域でのみ産出される希少な魔法金属で、熟練した職人の手にかかると強力なアイテム（武器、護符、指輪、防具など）に変貌する。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:692
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1494
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:694
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:693
msgctxt "items"
msgid "Stalt-laced ore"
msgstr "スタルトを含んだ鉱石"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:692
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1494
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:694
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:693
msgctxt "items"
msgid "A small chunk of stalt-laced ore.  Easy to enchant and as hard as obsidian, in the hands of a skilled craftsman stalt could make an incredibly powerful weapon, an amulet, a ring, armor, or almost any other item."
msgstr "スタルトを含んだ鉱石の小さな塊。魔力を込めやすく、なおかつ黒曜石と同等の硬さを備えているので、熟練した職人の手にかかると信じられないほど強力なアイテム（武器、護符、指輪、防具など）に変貌する。"

