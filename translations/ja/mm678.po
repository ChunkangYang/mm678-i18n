#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:481
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:89
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:282
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:382
#: mm6/data/10LocLANG.icons/Spells.txt.py:90
msgctxt "spells"
msgid "Dispel Magic"
msgstr "ディスペルマジック"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:89
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:89
msgctxt "spells"
msgid "Removes all spells on all creatures in the caster’s sight, both helpful and harmful.  Recovery is reduced by an amount equal to skill in Light Magic."
msgstr "視界内の生物にかかっている呪文を、有益か有害かに関係なく、全て消し去る。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:90
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:383
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:483
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:90
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:382
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:482
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:90
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:288
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:388
#: mm6/data/10LocLANG.icons/Spells.txt.py:96
msgctxt "spells"
msgid "Paralyze"
msgstr "パラライズ"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:90
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:90
msgctxt "spells"
msgid "Paralyze temporarily prevents a monster from moving or attacking for the duration of this spell, which is 3 minutes per point of skill in Light Magic.  You are free to attack your helpless target to your heart's content--paralyzed monsters cannot retaliate."
msgstr "敵の動きや攻撃を短時間だけ封じる呪文。この呪文を使えば、反撃されることなく、無抵抗な敵をこころゆくまで攻撃することができる。\n\n持続時間＝「光の魔法」技能レベル×3分"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:91
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:384
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:484
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:91
msgctxt "spells"
msgid "Summon Wisp"
msgstr "サモンエレメンタル"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:91
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:91
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:91
msgctxt "spells"
msgid "Summon"
msgstr "サモンエレメンタル"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:91
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:91
msgctxt "spells"
msgid "Summons a Dancing Light to fight for the party.  It will stay until the spell duration runs out or it is destroyed.  You can have no more than 1 elemental summoned at once."
msgstr "エレメンタルを召喚して、敵と戦わせる呪文。呼び出されたエレメンタルは、呪文の持続時間が切れるか倒されるまで、この世界にとどまる。召喚できるエレメンタルの数と種類は「光の魔法」技能ランクによる。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:91
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:91
msgctxt "spells"
msgid "Duration 5 minutes per point of skill.  1 Dancing Light maximum."
msgstr "持続時間＝技能レベル×5分\nダンシングライトを1体のみ召喚できる"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:91
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:91
msgctxt "spells"
msgid "Summons a Wisp.  Duration 15 minutes per point of skill. 3 Wisps maximum."
msgstr "持続時間＝技能レベル×15分\n最大で3体のウィスプを召喚"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:91
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:91
msgctxt "spells"
msgid "Summons a Will O' Wisp.  5 Will O' Wisps maximum."
msgstr "最大で5体のウィルオーウィスプを召喚"

