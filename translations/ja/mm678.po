msgid "Day -o- Gods"
msgstr "デイ オブ ザ ゴッド"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:92
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:92
msgctxt "spells"
msgid "Temporarily increases all seven stats on all your characters by three times your skill in Light Magic.  This spell lasts until you rest."
msgstr "パーティー全員の7種類の能力値を、一時的に向上させる呪文。この呪文の効果は休息を取るまで持続する。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:92
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:92
