#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:319
#: mm6/data/10LocLANG.icons/Spells.txt.py:21
msgctxt "spells"
msgid "Shield"
msgstr "シールド"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:20
