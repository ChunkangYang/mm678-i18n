msgstr "骨"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:638
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:640
msgctxt "items"
msgid "Quest Item: The arm bone of the legendary necromancer, Zacharia. It is infused with the death magician's evil energy."
msgstr "クエストアイテム：伝説のネクロマンサー、ゼカリアの腕の骨。彼の邪悪なエネルギーが宿っている。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:639
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:641
msgctxt "items"
msgid "Druid Circlet of Power"
msgstr "ドルイドのサークレット"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:639
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:641
msgctxt "items"
msgid "Circlet"
msgstr "サークレット"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:639
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:641
msgctxt "items"
msgid "A legendary item rumored to be from the time of the Ancients.  Only someone with the power of a Grand Druid can wear this item."
msgstr "古代種族の時代から存在すると言われている伝説的なアイテム。大 ドルイドの魔力を持つ者だけが身に着けることができる。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:640
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:642
msgctxt "items"
msgid "Arcane Key"
msgstr "不思議な鍵"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:640
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:642
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:642
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:644
msgctxt "items"
msgid "Quest Item: A gem containing an unfocused magical energy."
msgstr "クエストアイテム：指向性を持たない魔力を秘めている。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:641
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:643
msgctxt "items"
msgid "Wyvern Horn"
msgstr "ワイヴァーンの角"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:641
