#: mm6/data/10LocLANG.icons/Spells.txt.py:66
msgctxt "spells"
msgid "Mind Blast"
msgstr "マインドブラスト"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:66
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:66
msgctxt "spells"
msgid "Fires a bolt of mental force which damages a single target's nervous system.  Mind Blast does 3 points of damage plus 1-3 per point of skill in Mind Magic."
msgstr "精神力を矢のようにして放ち、1体の敵の神経系にダメージを与える呪文。\n\nダメージ＝3＋「精神魔法」技能レベル×1〜3"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:67
