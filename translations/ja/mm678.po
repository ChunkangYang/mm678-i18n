#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:459
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:65
msgctxt "spells"
msgid "Mind Resistance"
msgstr "マインドレジスタンス"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:65
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:65
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:65
msgctxt "spells"
msgid "Mind Resist"
msgstr "マインドレジスタンス"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:65
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:65
msgctxt "spells"
msgid "Increases all your characters’ resistance to Mind Magic damage by an amount equal to your skill in Mind Magic. The protection lasts one hour per point of skill."
msgstr "パーティー全員の「精神」によるダメージに対する抵抗力が、「精神魔法」技能に応じて向上する。\n\n持続時間＝技能レベル×1時間"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:66
