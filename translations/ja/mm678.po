#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:230
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:330
#: mm6/data/10LocLANG.icons/Spells.txt.py:33
msgctxt "spells"
msgid "Ice Bolt"
msgstr "アイスボルト"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:30
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:30
msgctxt "spells"
msgid "Fires a bolt of ice at a single target.  The missile does 1-4 points of damage per point of skill in Water Magic."
msgstr "1体の敵に向けて氷の矢を放つ呪文。\n\nダメージ＝「水の魔法」技能レベル×1〜4"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:31
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:31
msgctxt "spells"
msgid "Only useful outdoors, Water Walk lets your characters walk along the surface of water without sinking.  In addition to its casting cost, one spell point is expended every 20 minutes while your party is in contact with water."
msgstr "この呪文を使うと、沈まずに水の上を歩くことができる。ただし、水上を歩行中は、唱えるのに必要なマジックポイントとは別途に、20分につき1マジックポイントを消費する。\n\n※野外でのみ使用可能"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:32
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:330
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:430
