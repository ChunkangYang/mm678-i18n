msgctxt "items"
msgid "Gauntlets"
msgstr "籠手"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:128
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:130
msgctxt "items"
msgid "These gloves of poorly cured leather are worn by workmen everywhere."
msgstr "ろくに防腐処理もされていない革の手袋で、あらゆる場所で職人たちによって使われている。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:129
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:131
msgctxt "items"
msgid "Troll Gauntlets"
msgstr "トロールガントレット"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:129
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:131
msgctxt "items"
msgid "These leather gloves of Trollish make are studded with iron spikes at the knuckles."
msgstr "トロールによって作られた革の手袋。拳の部分に鉄の鋲が打たれている。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:130
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:914
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:132
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:113
msgctxt "items"
msgid "Steel Gauntlets"
msgstr "スティールガントレット"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:130
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:132
msgctxt "items"
msgid "Made of hinged plates of steel, these gauntlets offer good protection, but have a tendency to pinch."
msgstr "鉄板に関節をつけた手袋。防御力は高いが、手を動かしづらくなる傾向がある。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:131
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:133
msgctxt "items"
msgid "Minotaur Gauntlets"
msgstr "ミノタウロスガントレット"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:131
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:133
msgctxt "items"
msgid "Siertal-alloy makes these gauntlets light and tough. Superior workmanship make them comfortable and flexible."
msgstr "シエルタル合金製の手袋で、軽くて頑丈。優れた職人の技がこめられているので、はめ心地が良く、柔軟性も高い。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:132
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:134
msgctxt "items"
msgid "Crusader's Gauntlets"
msgstr "クルセイダーズガントレット"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:132
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:134
msgctxt "items"
msgid "These gauntlets are master crafted from pure erudine marking them as the product of Derrick Goreth's White Light Forgeworks."
msgstr "純エルダインで作られた手袋。デリック ゴレスのホワイトライト鍛造法による逸品である。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:133
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:135
msgctxt "items"
msgid "Walking Boots"
msgstr "ウォーキングブーツ"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:133
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:134
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:135
