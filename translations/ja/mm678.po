#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:66
msgctxt "spells"
msgid "Telepathy"
msgstr "テレパシー"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:63
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:63
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:66
msgctxt "spells"
msgid "Caster reads the target's mind, finding out exactly how much gold and what items the target has."
msgstr "効果対象の心を読み、所持金の額と持っているアイテムを正確に知ることができる。"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:63
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:66
#: mmmerge/Data/10LocLANG.T/Spells.txt.py:96
