#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:4
msgctxt "quests"
msgid "Return a longbow to the Judge on Emerald Island."
msgstr ""

#: mmmerge/Data/Text localization/LANG_QuestsTxt.txt.py:518
#: mm7/DATA/10LocLANG.events/QUESTS.TXT.py:5
msgctxt "quests"
msgid "Return a floor tile to the Judge on Emerald Island."
msgstr ""

