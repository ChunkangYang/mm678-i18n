msgid "Skill added to damage."
msgstr "Skill added to damage."

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:6
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:6
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:6
msgctxt "skilldes"
msgid "Ability to use a spear in one hand."
msgstr "Ability to use a spear in one hand."

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:7
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:7
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:7
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:7
msgctxt "skilldes"
msgid "Bow skill covers both bow and crossbow usage.  Expert archers gain a speed increase with their weapon, while master archers can fire two arrows with every attack."
msgstr "Bow skill covers both bow and crossbow usage.  Expert archers gain a speed increase with their weapon, while master archers can fire two arrows with every attack."

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:7
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:7
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:7
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:7
msgctxt "skilldes"
msgid "Bow fires two arrows on every attack"
msgstr "Bow fires two arrows on every attack"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:8
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:8
msgctxt "skilldes"
msgid "Mace skill covers all kinds of blunt trauma weapons ranging from large clubs to flails.  Expert mace swingers do extra damage with their weapons. Masters and grandmasters can stun or paralyze their opponents."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:8
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:8
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:8
msgctxt "skilldes"
msgid "Chance to paralyze equal to skill."
msgstr "Chance to paralyze equal to skill."

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:9
msgctxt "skilldes"
msgid "A weapon from before the Silence, their making has long since been lost.  Expert and master blasters gain double and triple accuracy with these awesome weapons."
msgstr "A weapon from before the Silence, their making has long since been lost.  Expert and Master Blasters gain double and triple accuracy with these awesome weapons."

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:9
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:9
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:9
msgctxt "skilldes"
msgid "Skill added to Attack Bonus (double effect)"
msgstr "Skill added to Attack Bonus (double effect)"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:9
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:9
#: mm6/data/10LocLANG.icons/SKILLDES.TXT.py:9
msgctxt "skilldes"
msgid "Skill added to Attack Bonus (triple effect)"
msgstr "Skill added to Attack Bonus (triple effect)"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:9
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:9
#: mm7/DATA/10LocLANG.events/SKILLDES.TXT.py:9
msgctxt "skilldes"
msgid "Skill added to Attack Bonus (quintuple effect)"
msgstr "Skill added to Attack Bonus (quintuple effect)"

#: mmmerge/Data/10LocLANG.T/Skilldes.txt.py:10
#: mm8/Data/10LocLANG.EnglishT/Skilldes.txt.py:10
msgctxt "skilldes"
msgid "Shield skill directly improves a character’s armor class while a shield is employed.  Expert and master rankings in the shield increase this defensive bonus."
msgstr "Shield skill directly improves a character痴 armor class while a shield is employed.  Expert and master ranking in the shield increase this defensive bonus."

