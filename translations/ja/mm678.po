msgctxt "items"
msgid "Wand"
msgstr "ワンド"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:153
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:154
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:155
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:156
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:155
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159
msgctxt "items"
msgid "The primitive materials of this wand is infused with dark spiritual energy. To use this wand, you must equip it as though you were equipping a weapon."
msgstr "素材は原始的だが、この杖には邪悪な霊的エネルギーが注ぎ込まれている。この杖を使う際は、武器と同じ要領で装備しなければならない。"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:154
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156
msgctxt "items"
msgid "Witch's Wand of Sparks"
msgstr "ウィッチズスパークワンド"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:155
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157
msgctxt "items"
msgid "Witch's Wand of Poison"
msgstr "ウィッチズポイズンワンド"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158
msgctxt "items"
msgid "Witch's Wand of Stunning"
msgstr "ウィッチズスタンワンド"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159
msgctxt "items"
msgid "Witch's Wand of Harming"
msgstr "ウィッチズハームワンド"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:158
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:160
msgctxt "items"
msgid "Shaman's Wand of Light"
msgstr "シャーマンズライトワンド"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:158
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:159
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:160
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:161
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:162
