msgctxt "items"
msgid "Leather Armor"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:69 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1669
msgctxt "items"
msgid "Lightest and most easily made among the armors, leather armor offers the least protection.  This particular suit is of average quality."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:70
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:69 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:870 localization/LANG_ItemsTxt.txt.py:1670
msgctxt "items"
msgid "Studded Leather"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:70 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1670
msgctxt "items"
msgid "Studded leather offers more protection than regular leather armor at the expense of being stiffer and weighing more.  This particular suit is well made."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:71 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1671
msgctxt "items"
msgid "Enchanted Leather"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:71
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:70 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:871 localization/LANG_ItemsTxt.txt.py:1671
msgctxt "items"
msgid "An otherwise ordinary suit of leather armor, this suit is imbued with a subtle enchantment that strengthens the material against blows without increasing weight."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:72 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1672
msgctxt "items"
msgid "Dragon Leather"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:72
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:71 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:872 localization/LANG_ItemsTxt.txt.py:1672
msgctxt "items"
msgid "Standard issue leather armor for officers in the Regnan Navy.  All such leather armor receives enchantments to strengthen and lighten it during its creation in the Regnan Armories."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:73 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1673
msgctxt "items"
msgid "Imperial Leather"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:73 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1673
msgctxt "items"
msgid "An extremely rare suit of leather armor created during the conflicts between the Church of the Moon and the Church of the Sun roughly 80 years ago.  These suits provide the finest protection available with leather armor."
msgstr ""

