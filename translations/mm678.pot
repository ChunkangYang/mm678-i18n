#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:283
msgctxt "npc conversation"
msgid "You can find expert disarm training from Ivan right near the Smugglers' Guild."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:183
