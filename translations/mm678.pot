msgctxt "items"
msgid "Chain Mail"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:74 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1674
msgctxt "items"
msgid "Chain mail is an armor formed of small, interlocking loops of metal.  This suit is low quality:  the metal used is plain iron, there are only two layers of rings, and it is heavy and stiff for its size."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:75
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:74 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1675
msgctxt "items"
msgid "Steel Chain Mail"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:75 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1675
msgctxt "items"
msgid "A superior suit of chain mail, the metal used in this suit is steel, and the former owner was careful to keep the suit well oiled and free of rust."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:76 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1676
msgctxt "items"
msgid "Noble Chain Mail"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:76 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1676
msgctxt "items"
msgid "Cavalry officer's chain mail from the reign of Taledon V of Karigor, Divine High Priest and High Holy Conduit of the Church of the Sun, circa 870 A.S.  The armor is high quality chain, enchanted to lighten and strengthen the metal."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:77 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1677
msgctxt "items"
msgid "Royal Chain Mail"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:77 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1677
msgctxt "items"
msgid "Highly enchanted armor worn by elvish nobility and royalty during the Timber Wars of the seventh and eighth centuries."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:78 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1678
msgctxt "items"
msgid "Majestic Chain Mail"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:78 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1678
msgctxt "items"
msgid "A very rare suit of armor turned out by the Heavenly Forges of Governor Padish before the Silence.  The armor was originally worn strictly by the Governor and his highest military officers as a badge of office.  It is not just for show; this chain mail is lighter, stronger, and more supple than any other chain in the world."
msgstr ""

