#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:190
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:305
msgctxt "npc conversation"
msgid "Erathia is sure a better place now that Catherine is ruling from Castle Gryphonheart.  Don’t you think?"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:191
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:306
