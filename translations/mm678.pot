#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2502
msgctxt "npc conversation"
msgid "No.  I won't let you waste any more of my time.  Perhaps tomorrow."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2527
msgctxt "npc conversation"
msgid "My generosity ends here.  I've already helped you today and I am sick of seeing you.  Leave me."
msgstr ""

