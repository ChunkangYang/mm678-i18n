#: localization/LANG_ItemsTxt.txt.py:2120
msgctxt "items"
msgid "Large Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:82 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1682
msgctxt "items"
msgid "Formed of stretched hides over a wooden frame, this simple shield provides basic protection against physical attacks."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:83 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1683
msgctxt "items"
msgid "Tower Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:83 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1683
msgctxt "items"
msgid "The simplicity of the heraldic design on this shield leads one to believe it was created either by barbarians or goblins.  It is made of sturdy materials and should stand up reasonably well in combat."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:84 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1684
msgctxt "items"
msgid "Castle Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:84 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1684
msgctxt "items"
msgid "This shield is made of wood framed by iron.  It is somewhat heavy for its size, but it should see you through a battle safely--as long as  you're not backstabbed."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:85 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1685
msgctxt "items"
msgid "Celestial Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:85
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:84 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:885 localization/LANG_ItemsTxt.txt.py:1685
msgctxt "items"
msgid "Made of a lightweight metal, this shield has a foundry stamp from the Kelebrim armory.  Though light, the material is very strong, and the metal is welded almost seamlessly.  "
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:86 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1686
msgctxt "items"
msgid "Olympian Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:86
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:85 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:886 localization/LANG_ItemsTxt.txt.py:1686
msgctxt "items"
msgid "These shields were forged by the Phynaxian empire during its brief rise to power on the steppes of southern Erathia (790-864).  They are made of stalt, a metal that takes well to enchantment, and contributed heavily to Phynaxian military might.  Unfortunately, very little of the metal could be mined, and Phynaxia fell in 864 A.S. to an Elvish offensive."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:87
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:82 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:883 localization/LANG_ItemsTxt.txt.py:1687
msgctxt "items"
msgid "Wooden Shield"
msgstr ""

