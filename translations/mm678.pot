msgctxt "items"
msgid "Boots"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:118 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1718
msgctxt "items"
msgid "Common traveler's boots made with leather and hobnailed."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:119 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1719
msgctxt "items"
msgid "Steel Boots"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:119 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1719
msgctxt "items"
msgid "Heavy steel boots made for solid foot protection in battle.  They are uncomfortable to walk in and have a tendency to rust on the inside."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:120 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1720
msgctxt "items"
msgid "Armored Boots"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:120 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1720
msgctxt "items"
msgid "The interior of these steel plated boots is made of leather and cloth to soften the sharp edges on the metal plates.  They are a bit heavy and exhausting to wear for extended periods."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:121 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1721
msgctxt "items"
msgid "Sterling Boots"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:121
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:120 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:921 localization/LANG_ItemsTxt.txt.py:1721
msgctxt "items"
msgid "Polished silver boots with velvet interiors, these boots are lighter than steel boots and far more comfortable.  They look pretty snappy, too."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:122 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1722
msgctxt "items"
msgid "Ultimate Boots"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:122 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1722
msgctxt "items"
msgid "Dragonhide boots reinforced with molded horn strips and stalt metal rivets.  Soft and light, they provide unparalleled foot protection."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:123 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1723
msgctxt "items"
msgid "Fine Ring"
msgstr ""

