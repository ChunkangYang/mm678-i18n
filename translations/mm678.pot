#: localization/LANG_ItemsTxt.txt.py:1667
#: localization/LANG_ItemsTxt.txt.py:1668
msgctxt "items"
msgid "Ancient Weapon"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:67 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1667
msgctxt "items"
msgid "A weapon of awesome power, clearly created during the Time of Wonders.  "
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:68
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:67 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:868 localization/LANG_ItemsTxt.txt.py:1668
msgctxt "items"
msgid "Blaster Rifle"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:68 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1668
msgctxt "items"
msgid "The finest of personal weapons made during the Time of Wonders, this Blaster Rifle can deal death faster than any weapon you have ever seen."
msgstr ""

