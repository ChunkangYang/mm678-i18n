msgid "A wooden wand painted green and banded with brass.  The wand is capped with a large, flawed emerald.  To use this wand, you must equip it as though you were equipping a weapon."
msgstr ""

#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:143 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:944 localization/LANG_ItemsTxt.txt.py:1744
msgctxt "items"
msgid "Fairy Wand of Ice"
msgstr ""

#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:144 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:945 localization/LANG_ItemsTxt.txt.py:1745
msgctxt "items"
msgid "Fairy Wand of Lashing"
