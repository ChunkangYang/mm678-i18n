msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:98
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:199
msgctxt "npc conversation"
msgid "Walter Hargreaves"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:98
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:199
msgctxt "npc conversation"
msgid "Walter teaches expert diplomacy in one of the towers of Castle Ironfist."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:99
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:200
msgctxt "npc conversation"
msgid "Terrance Smith"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:99
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:200
msgctxt "npc conversation"
msgid "Behind the King's Crown you can find Terrance Smith.  He'll teach skilled dagger users a few new tricks."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:100
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:4
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:22
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:50
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:201
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:402
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:615
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:815
msgctxt "npc conversation"
msgid "Merchants"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:100
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:201
msgctxt "npc conversation"
msgid "I hear there's a reward out for the ones who can put down the Dragoon highwaymen plying the road near the south shore.  Some merchant's offering a LOT of money for the return of his stolen merchandise!"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:101
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:202
msgctxt "npc conversation"
msgid "Order of the Fist"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:101
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:202
msgctxt "npc conversation"
msgid "A small order of monks has grown just south of Bootleg Bay, called the Order of the Fist."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:102
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:63
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:203
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:520
msgctxt "npc conversation"
msgid "Pirate Treasure"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:102
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:203
msgctxt "npc conversation"
msgid "The islands of Bootleg Bay hide a pile of pirate treasure.  That is, if you can get past the cannibals and actually find it…"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:103
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:204
msgctxt "npc conversation"
msgid "The location of the Fountain of Magic is still a mystery.  For some reason, the people that find it never reveal its location."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:104
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:73
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:205
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:838
msgctxt "npc conversation"
msgid "Temple"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:104
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:205
msgctxt "npc conversation"
msgid "The Church of the Sun used to have a temple on an island in Bootleg Bay."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:105
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:206
msgctxt "npc conversation"
msgid "Arthur"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:105
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:206
msgctxt "npc conversation"
msgid "A powerful crown, Arthur not only boosts all its wearer's physical characteristics, but also their spell points."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:106
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:207
msgctxt "npc conversation"
msgid "Heroes"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:106
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:207
msgctxt "npc conversation"
msgid "I've heard that you need to slay an elder dragon to be promoted from Crusader to Hero.  No wonder there are so few Heroes around!"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:107
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:208
msgctxt "npc conversation"
msgid "Temple of Tsantsa"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:107
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:208
msgctxt "npc conversation"
msgid "The temple of Tsantsa can be found on one of the large islands south of Silver Cove.  The people that live on that island like to sacrifice captives to their beastly god Tsantsa, and then shrink their heads in the pools of disgusting chemicals they keep in their temple.  The islanders are quite hostile, so be sure to kiss your loved ones goodbye if you have plans to visit the island."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:108
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:209
msgctxt "npc conversation"
msgid "Temple of the Sun"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:108
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:209
msgctxt "npc conversation"
msgid "Long abandoned by the Church of the Sun, their temple still stands on a large island east of Free Haven.  A small order of confused monks, misapprehending the true nature of the temple, have somehow made peace with the islanders and moved into the temple– bringing a stolen holy artifact with them.  Now the old temple's insidious magic has affected their minds, making them believe they must defend the temple to the death.  The monks are very unfriendly these days, and attack all who trespass."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:109
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:210
msgctxt "npc conversation"
msgid "Preston Harper"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:109
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:210
msgctxt "npc conversation"
msgid "Preston teaches expert chain skill just east of the Goblin's Tooth."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:110
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:211
msgctxt "npc conversation"
msgid "Shoshi Pertoniki"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:110
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:211
msgctxt "npc conversation"
msgid "Shoshi can teach you new perception tricks from his house just east of the Goblin's Tooth."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:111
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:212
msgctxt "npc conversation"
msgid "Winston Schezar"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:111
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:212
msgctxt "npc conversation"
msgid "Winston used to be a member of that new clerical order down here, but he quit.  Apparently he left something behind because he's looking for someone to go back to the Temple of the Fist for him.  He's lives in one of the antechambers of the House of Healing now."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:112
#: mm6/data/10LocLANG.icons/NPCNews.txt.py:153
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:213
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:254
msgctxt "npc conversation"
msgid "Celestial Order"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:112
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:213
msgctxt "npc conversation"
msgid "Cedric Druthers' splinter group of druids perform ceremonies in a cave west of Silver Cove."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:113
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:214
msgctxt "npc conversation"
msgid "The stronghold of the Fraternal Order of Silver is located near Silver Cove.  The Silver Helms seem more violent lately, I wonder why that is?"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:114
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:215
msgctxt "npc conversation"
msgid "The Warlord"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:114
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:215
msgctxt "npc conversation"
msgid "The Warlord's Fortress is to the northwest of Silver Cove.  Only the strongest warriors are enlisted into his army."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:115
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:216
msgctxt "npc conversation"
msgid "The Shadow Guild supposedly has a large guild right near Castle Stone.  I'm surprised Anthony Stone hasn’t discovered its location yet."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:116
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:217
msgctxt "npc conversation"
msgid "Not many ships travel to Castle Alamos.  Most captains are afraid of the strange creatures that prowl around the northern seas."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:117
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:218
msgctxt "npc conversation"
msgid "Light and Dark"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:117
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:218
msgctxt "npc conversation"
msgid "Guilds of Light can be found in Silver Cove and Blackshire and Guilds of Dark can be found in Winter Cap and Blackshire."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:118
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:219
msgctxt "npc conversation"
msgid "Diamond Gargoyle"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:118
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:219
msgctxt "npc conversation"
msgid "Diamond Gargoyles are the toughest gargoyles around.  They're impossible to kill with physical attacks, so you should use magic to kill them."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:119
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:220
msgctxt "npc conversation"
msgid "Druids"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:119
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:220
msgctxt "npc conversation"
msgid "Druids can cast a variety of elemental spells when angered, and are often slightly shielded from magical attacks."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:120
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:221
msgctxt "npc conversation"
msgid "Lucius"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:120
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:221
msgctxt "npc conversation"
msgid "These legendary boots enable their wearer to move faster and react quicker."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:121
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:222
msgctxt "npc conversation"
msgid "Arch Druids"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:121
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:222
msgctxt "npc conversation"
msgid "To be promoted to Arch Druid, a Greater Druid needs to perform the Ceremony of the Moon in the Temple of the Moon near Free Haven."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:122
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:223
msgctxt "npc conversation"
msgid "Warlord's Fortress"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:122
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:223
msgctxt "npc conversation"
msgid "The fortress of the Warlord watches over the source of the Calimar river as it winds its way past Silver Cove and empties into Bootleg Bay.  Originally established to protect a town planned for that region, the fortress became a magnet for mercenaries and criminals after the town failed and all the settlers moved south to greener pastures."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:123
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:224
msgctxt "npc conversation"
msgid "The Monolith"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:123
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:224
msgctxt "npc conversation"
msgid "The Monolith overlooks the Silver road that leads from Silver Cove to Free Haven.  It's been an object of fascination and occasional worship for ages.  A long time ago, some group of druids carved a home out of the giant rock, and it has been inhabited by various groups since then.  The druids who currently live there were experimenting with some kind of new magic, and I think something may have gone wrong.  They've been avoiding contact with the outside world for some time now, and refuse to allow visitors to enter the Monolith."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:124
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:69
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:225
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:680
msgctxt "npc conversation"
msgid "Silver Cove"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:124
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:225
msgctxt "npc conversation"
msgid "The town of Silver Cove got its start as a fishing and trading village a few hundred years ago.  With time, our little village grew up to be a full-fledged town.  We have ample room to expand the town, and the land around us is fertile and easy to farm.  We are just a little distant from the rest of the Kingdom, though."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:125
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:10
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:16
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:30
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:31
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:34
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:40
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:226
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:467
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:497
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:550
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:641
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:873
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:876
msgctxt "npc conversation"
msgid "Loretta Fleise"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:125
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:226
msgctxt "npc conversation"
msgid "The Lady of Silver Cove often seems more interested in amassing her fortune than governing well, but I don't think it's so simple.  She often spends a lot of wealth on town improvements and security, so I guess she can't be all bad."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:126
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:227
msgctxt "npc conversation"
msgid "The Silver Helm vigilantes have occupied a fortress just north of Silver Cove.  Accusing Lady Fleise of the sin of greed, the Silver Helms have begun to attack her caravans travelling between Silver Cove and Free Haven.  I'm sure she's none too happy about it..."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:127
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:228
msgctxt "npc conversation"
msgid "Eel Infested Waters"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:127
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:228
msgctxt "npc conversation"
msgid "Be careful of travelling the waters north and east of Silver Cove– they're inhabited by giant, man-eating sea serpents!"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:128
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:229
msgctxt "npc conversation"
msgid "Equinoxes"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:128
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:229
msgctxt "npc conversation"
msgid "The Spring Equinox is on March 20th, and the Autumn Equinox is on September 23rd.  It's said that these dates are important magical events."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:129
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:230
msgctxt "npc conversation"
msgid "The White Rock Islands north of Silver Cove have long been abandoned by civilized humans, and are now home to the monsters and madmen.  Druids occasionally risk their lives and journey to those islands looking for the fabled Circle of Stones so they can perform the Ceremony of the Sun."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:130
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:231
msgctxt "npc conversation"
msgid "Sir John Silver"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:130
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:231
msgctxt "npc conversation"
msgid "The Silver Helms have been attacking everyone they see as less than 100% behind their fight against evil.  I don't know about you, but I think such an extreme position can't be a good thing– what's Sir John Silver thinking?"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:131
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:232
msgctxt "npc conversation"
msgid "Netherworld Ties"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:131
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:232
msgctxt "npc conversation"
msgid "The druids of the Monolith have made a pact with the Netherworld– I know, because I met a druid who escaped from there one night.  He says unspeakable things are happening inside the Monolith, and if something isn't done soon, the outside world may soon learn more than it ever wanted to know about the secrets of the ancient place."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:132
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:233
msgctxt "npc conversation"
msgid "Tina Sheltan"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:132
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:233
msgctxt "npc conversation"
msgid "Tina lives with her daughter just east of Town Hall.  She teaches light expertise to skilled apprentices."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:133
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:234
msgctxt "npc conversation"
msgid "Cyrus Montebleu"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:133
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:234
msgctxt "npc conversation"
msgid "You can learn expert repair just west of the Mercenary Guild from Cyrus Montebleu."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:134
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:235
msgctxt "npc conversation"
msgid "Clyde Dagget"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:134
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:235
msgctxt "npc conversation"
msgid "Clyde teaches expert meditation skill right across the street from the Self Guild."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:135
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:236
msgctxt "npc conversation"
msgid "Sigriv"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:135
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:236
msgctxt "npc conversation"
msgid "Sigriv can teach you expert techniques with the spear just south of the training grounds."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:136
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:237
msgctxt "npc conversation"
msgid "Eleanor Vanderbilt"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:136
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:237
msgctxt "npc conversation"
msgid "I heard that Eleanor wants the evil druids kicked out of the Monolith to the west, and she's willing to offer a reward to the people that do it.  She's on the east side of town if you want to know more."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:137
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:46
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:61
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:238
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:580
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:826
msgctxt "npc conversation"
msgid "Darkmoor"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:137
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:238
msgctxt "npc conversation"
msgid "The home of the Necromancers; no one travels to Castle Darkmoor anymore unless they're looking for undead.  I can't imagine the village of Darkmoor surviving much longer without any trade from the rest of Enroth."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:138
#: mm6/data/10LocLANG.icons/NPCNews.txt.py:251
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:239
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:352
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:697
msgctxt "npc conversation"
msgid "Dragonsand"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:138
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:239
msgctxt "npc conversation"
msgid "The mountains to the west keep all the horrible creatures of Dragonsand from rampaging across the rest of Enroth."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:139
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:240
msgctxt "npc conversation"
msgid "Snergle"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:139
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:240
msgctxt "npc conversation"
msgid "Snergle isn't a good leader, but none of the dwarves dare to stand up to him."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:140
#: mm6/data/10LocLANG.icons/PROFTEXT.txt.py:41
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:241
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:575
msgctxt "npc conversation"
msgid "Terrax"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:140
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:241
msgctxt "npc conversation"
msgid "Terrax never left Darkmoor after he became a lich.  He could very well still be inside researching new magical spells."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:141
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:242
msgctxt "npc conversation"
msgid "Ghost"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:141
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:242
msgctxt "npc conversation"
msgid "The ghosts that haunt the Mire of the Damned can age you past your years with a single touch."
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:142
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:243
msgctxt "npc conversation"
msgid "Harpy"
msgstr ""

#: mm6/data/10LocLANG.icons/NPCNews.txt.py:142
#: mmmerge/Data/10LocLANG.EnglishT/NPCNews.txt.py:243
