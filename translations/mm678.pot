msgctxt "items"
msgid "Small Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:87 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1687
msgctxt "items"
msgid "A small wooden shield designed to protect mostly against arrows."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:88
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:87 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:888 localization/LANG_ItemsTxt.txt.py:1688
msgctxt "items"
msgid "Bronze Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:88
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:87 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:888 localization/LANG_ItemsTxt.txt.py:1688
msgctxt "items"
msgid "Bronze shields are lighter than iron shields of the same size, but aren't nearly as strong."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:89 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1689
msgctxt "items"
msgid "Steel Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:89 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1689
msgctxt "items"
msgid "Since this shield is made of tempered steel, it should resist all but the most unusual of enchanted weapons."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:90 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1690
msgctxt "items"
msgid "Spirit Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:90 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1690
msgctxt "items"
msgid "Spirit shields are ordinary steel shields enchanted through a ritualistic process that can have powerful, albeit unpredictable results.  The process is time consuming and requires the undivided attention of at least three masters of Spirit magic."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:91 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1691
msgctxt "items"
msgid "Astral Shield"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:91 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1691
msgctxt "items"
msgid "These rare shields were turned out by the hundreds with the aid of the Heavenly Forges to combat rebel forces in the endless string of skirmishes and supply raids that tested (and finally overcame) the Governor's forces in the first century A.S.  As with all such equipment, it is light, tough, and is capable of holding the most powerful enchantments."
msgstr ""

