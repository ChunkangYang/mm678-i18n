#: localization/LANG_ItemsTxt.txt.py:1651
#: localization/LANG_ItemsTxt.txt.py:1652
msgctxt "items"
msgid "Crossbow"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:50 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1650
msgctxt "items"
msgid "Crossbows are the deadliest ranged weapons made since the Time of Wonders.  This crossbow is made of stout Yew wood and metal fixtures, but is otherwise rather ordinary."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:51 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1651
msgctxt "items"
msgid "Accurate Crossbow"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:51
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:50 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:851 localization/LANG_ItemsTxt.txt.py:1651
msgctxt "items"
msgid "These crossbows were stockpiled by Archibald just prior to the Succession War for use against his brother.  As with most decisions involving death, Archibald chose wisely.  These crossbows are amongst the best in the land."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:52 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1652
msgctxt "items"
msgid "True Crossbow"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:52
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:51 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:852 localization/LANG_ItemsTxt.txt.py:1652
msgctxt "items"
msgid "Equipped with a hand crank and shaft sights, these exceptional crossbows are superior to all that have come before.  Just where they are coming from is a mystery at this time…"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:53
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:54
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:55
