msgid "Always glad to be of service, %06.  Do you have %04 for me?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2403
msgctxt "npc conversation"
msgid "More!  More gold!  Yes!  Give me %04 more!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2428
msgctxt "npc conversation"
msgid "Price is the same every time, %06.  %04 gold!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2453
msgctxt "npc conversation"
msgid "Ahh, yes.  < %01 rubs %03 hands together> More important business and discussion, I suppose.  The price, as always, is %04."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2528
msgctxt "npc conversation"
msgid "<looking both ways> %04, then, and lets make this quick!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2553
msgctxt "npc conversation"
msgid "Have you returned for more spiritual advice? The donation is still %04."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2578
msgctxt "npc conversation"
msgid "I'm afraid I will require a second payment, %06.  %04 now, or the conversation ends here."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2603
msgctxt "npc conversation"
msgid "%04 is still the price."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2379
msgctxt "npc conversation"
msgid "Please don't kill me!  I've told you everything you asked for!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2404
msgctxt "npc conversation"
msgid "Ooooh, %06, no need to threaten me again, I'll talk."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2429
msgctxt "npc conversation"
msgid "Hey, uh, we're still friends, right?  What do you need?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2454
msgctxt "npc conversation"
msgid "Oh, dear!  What more do you want?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2479
msgctxt "npc conversation"
msgid "Grrrr…someday…All right, what is it?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2504
msgctxt "npc conversation"
msgid "Now what?  Have you returned to slay me?  I will surely call out your name before you strike me down!  Someone will come to save me!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2629
msgctxt "npc conversation"
msgid "No need to threaten me a second time--I'll cooperate.  After all, Baa will rule the Kingdom in the end.  Nothing you or I can say or do will change that."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2380
msgctxt "npc conversation"
msgid "I only talk to real people, not unknowns like yourselves.  I'm busy now, so go away."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2405
msgctxt "npc conversation"
msgid "I will not talk to nobodies.  Leave me."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2430
msgctxt "npc conversation"
msgid "Go away kid, ya bother me.  Come back when you're not as wet behind the ears."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2455
msgctxt "npc conversation"
msgid "My merchandise is both rare and high quality.  So are my customers.  Since you are low quality customers, it would seem we are unable to conduct business."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2480
msgctxt "npc conversation"
msgid "You may have heard of me.  Some call me…%02.  Being famous, I only associate with other famous and important people.  You are neither.  Begone."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2505
msgctxt "npc conversation"
msgid "I haven't time for simple folk such as yourselves!  Perhaps when you have become more sophisticated…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2530
msgctxt "npc conversation"
msgid "<yawns>  Not interested.  Go away--I'm waiting for someone important to speak to."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2555
msgctxt "npc conversation"
msgid "I have important matters to attend to, child.  Someday you'll be important too, but you aren't yet, so go now, in peace."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2580
msgctxt "npc conversation"
msgid "Sorry, I'm looking for famous Heroes, not unknown peasants.  Be off with you now."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2605
msgctxt "npc conversation"
msgid "%02?  Never heard of you.  Now go away and stop wasting my time."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2630
msgctxt "npc conversation"
msgid "Hmmm?  What? Here, go away, I don't have time for the little people--that means you!  You aren't famous enough."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2655
msgctxt "npc conversation"
msgid "Don't bother me, simpleton!  I reserve my time solely for known, capable Heroes--not for unknown, incompetent, peasants."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2680
msgctxt "npc conversation"
msgid "I am looking to speak with Heroes, not children.  If you want my time, go do something heroic."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2381
msgctxt "npc conversation"
msgid "Oh No!  Please don't hurt me, %06 %02! I'll tell you anything!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2406
msgctxt "npc conversation"
msgid "Monsters!  I have heard of your crimes.  I would slay you if I could."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2431
msgctxt "npc conversation"
msgid "It's <gulp>…%06 %02 and %09 band of merry pranksters!  You are so well known around here!  A real…honor, my %10."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2456
msgctxt "npc conversation"
msgid "Oh, my, %02!  Please don't rob me!  I have nothing of value!  All I own is debt!  Have mercy, my %10!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2481
msgctxt "npc conversation"
msgid "I never thought that I might one day come face to face with one as evil as you, %02.  This is not a happy day.  What are your demands?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2506
msgctxt "npc conversation"
msgid "Oh dear, the infamous %06 %02 and accomplices…I suppose begging for my life isn't enough.  What do you want of me?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2531
msgctxt "npc conversation"
msgid "%02!  Villain! How dare you speak to me?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2556
msgctxt "npc conversation"
msgid "It is the Devil himself before me!  I do not fear you, nor will I help you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2581
msgctxt "npc conversation"
msgid "Oh, the notorious %02.  Yes, I've heard of you, and I'm not impressed.  I hope you are brought to justice soon!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2606
msgctxt "npc conversation"
msgid "<drawing %03 sword> %02! Prepare to die!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2631
msgctxt "npc conversation"
msgid "%02!  <shrieking> Please don't kill me! I'll tell you anything!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2656
msgctxt "npc conversation"
msgid "<eyes widening> %02? Villain!  The world would be a better place without you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2681
msgctxt "npc conversation"
msgid "Hmmm.  The infamous and wicked %02. I am surprised that one of the Heroes of the land has not yet slain you.  I shall be sure to help raise the bounty on your heads."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2382
msgctxt "npc conversation"
msgid "The infamous %06 %02!  I heard you've been murdering people right and left.  That's great!  What can I do for you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2407
msgctxt "npc conversation"
msgid "Your infamy precedes you, %02.  Anything to serve one so wicked as you, %06."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2432
msgctxt "npc conversation"
msgid "Ah, the notorious %06 %02.  Anything for you, %02!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2457
msgctxt "npc conversation"
msgid "%07 %02!  That was really something when you slaughtered everyone in that small village!  Had it coming, if you ask me.  That was you…wasn't it?  Well, anyway, what can I do for you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2482
msgctxt "npc conversation"
msgid "A delight to finally meet the mighty %06 %02 in the flesh.  The denizens of the netherworld can't stop praising your exploits, and they eagerly await your inevitable arrival…Until then, how may I serve you, my %10?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2507
msgctxt "npc conversation"
msgid "My %10, everyone with an open mind in the Kingdom follows your deliciously outrageous behavior.  Such a wonderful history your deeds will make.  How may I serve you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2532
msgctxt "npc conversation"
msgid "Infamous %06, It is an honor to know you and a pleasure to serve you.  What do you desire?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2557
msgctxt "npc conversation"
msgid "My Master…your work in the name of darkness is unparalleled.  Your evil is superior to mine.  To serve you is my one and only desire."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2582
msgctxt "npc conversation"
msgid "By the Word, your deeds are an inspiration to us all!  Keep up the good work--with your help, the Kingdom will surely fall soon!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2607
msgctxt "npc conversation"
msgid "%10 %02.<pulling a flask from inside %03 jerkin> A toast to those who do what they want when they want!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2632
msgctxt "npc conversation"
msgid "<smiling>  The end of the world nears--with a little help from you and me, %10 %02.  Is there anything I can do for you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2657
msgctxt "npc conversation"
msgid "<bowing deeply> %10 %02! Your evil is known throughout the land!  Consider me your most ardent supporter."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2682
msgctxt "npc conversation"
msgid "A pleasure to know the intriguing and adventurous %10 %02.  When I first heard about your wickedness, I was very impressed!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2383
msgctxt "npc conversation"
msgid "%07 %02!  What an honor!  Everyone is talking about how you %08!  What can I do for you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2408
msgctxt "npc conversation"
msgid "%07 %02.  I am gratified to know you.  What is mine is yours."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2433
msgctxt "npc conversation"
msgid "Your exploits are known far and wide, %06 %02.  %01 at your service, my %10."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2458
msgctxt "npc conversation"
msgid "I heard about how you %08.  It is an honor and a pleasure.  Anything for you, my %10."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2483
msgctxt "npc conversation"
msgid "To know you is to love you, honorable %06 %02!  You are the ones who %08.  You have but to ask and from me you will receive!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2508
msgctxt "npc conversation"
msgid "Your deeds are known far and wide, my %10.  I will gladly serve you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2533
msgctxt "npc conversation"
msgid "Ah, the famous and honorable %06 %02!  <bowing> Whatsoever you desire that is in my power to give, I freely grant."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2558
msgctxt "npc conversation"
msgid "Praise the Light!  A gift from Heaven to be in the presence of the sweet and honorable %10 %06! "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2583
msgctxt "npc conversation"
msgid "An honor, great %10.  How may I serve you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2608
msgctxt "npc conversation"
msgid "%10 %02.  An honor."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2633
msgctxt "npc conversation"
msgid "Wonderful %10 %02!  You have come to save the world!  Praise be!  I only hope you aren't too late."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2658
msgctxt "npc conversation"
msgid "An honor to know you, %02.  I am at your service."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2683
msgctxt "npc conversation"
msgid "Ah! An honor and a privilege to see you, %02.  My considerable resources are at your disposal."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2384
msgctxt "npc conversation"
msgid "Oh No!  %06 %02!  I didn't do it!  It was the other guy!  I wasn't there!  I'll tell you anything--anything, just don't hurt me!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2409
msgctxt "npc conversation"
msgid "Hissssss….Please, don't slay me.  I am a worm, not worth your trouble.  I grovel at your feet, mighty %10."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2434
msgctxt "npc conversation"
msgid "%07 %02!  So good to see you in person!  Which is surprising, since you are so famous and powerful and good, while I am so weak and pitiful.  Not worth your time, no, not at all. Aheh-heh…Heh."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2459
msgctxt "npc conversation"
msgid "Please, please, don't kill me, your worship! <sob>  I am a wretch, not worth tiring your sword arm.  If you leave me alone, I will die on my own soon anyway!  Have mercy, mighty %10!  Have mercy!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2484
msgctxt "npc conversation"
msgid "Wait!  Please don't attack me!  I'll stop the experiments,  I swear!  No more evil sorcery for me..I'm done with that, you can count on me, %10 %02.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2509
msgctxt "npc conversation"
msgid "I know you're thinking you should strike me down like the dog I am, %10, but surely a saint like yourself can find it in your heart to overlook past indiscretions… Can't you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2534
msgctxt "npc conversation"
msgid "%02.  <spits on the ground>"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2559
msgctxt "npc conversation"
msgid "The higher you climb, the farther you will fall…And you have climbed oh so high!  Rest assured, sainted one, that I will not be there to catch you when you fall!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2584
msgctxt "npc conversation"
msgid "Oh, saints preserve us, it's the %10 of Heaven, come to do justice! <smirks> Let me worship you, your Highness…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2609
msgctxt "npc conversation"
msgid "<drawing %03 sword> %02!  In the name of Zenofex, prepare to die!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2634
msgctxt "npc conversation"
msgid "Too bad you're on the losing side, %02!  But listen, I'll tell you anything you want--the Temple of Baa will reign soon no matter what you do!  Just please don't kill me. "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2659
msgctxt "npc conversation"
msgid "%02.  Your shining goodness is giving me a headache. <rubbing %03 temples>  I think I'm going to have to slay you to cure it."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2684
msgctxt "npc conversation"
msgid "Clearly, you are the enemy, O Champion of righteousness! Your speedy death would please me."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2385
msgctxt "npc conversation"
msgid "Oh…you people.  I can't even bear to think of things people are saying about you!  Go away and leave me alone!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2410
msgctxt "npc conversation"
msgid "I don't speak with evil humans.  Go away before I become…violent."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2435
msgctxt "npc conversation"
msgid "You've a %11 reputation, %06.  I don't want anything to do with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2460
msgctxt "npc conversation"
msgid "%02...  I've heard things about you, none of them good.  Please remove yourself from my presence.  Immediately."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2485
msgctxt "npc conversation"
msgid "Bah!  I haven't time enough for the likes of you!  I will only speak to people of good repute--people who's reputation is %12…or better."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2510
msgctxt "npc conversation"
msgid "People have been talking about how you like to commit crimes, %02.  I don't like how that sounds, so I don't want to talk to you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2535
msgctxt "npc conversation"
msgid "O Ho!  %13! Er, %13.  I think.  Whatever.  There's gossip about you--all of it bad.  Get thee hence, lest I spit thee on the point of my sword!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2560
msgctxt "npc conversation"
msgid "I have heard that you stopped walking in the Light.  Return to me when you have found your way."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2585
msgctxt "npc conversation"
msgid "My sources tell me that you may have committed a number of crimes.  You must clear those problems up before I can speak with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2610
msgctxt "npc conversation"
msgid "I heard you may have been less than lawful, recently.  If it could be proven, I would arrest you right now. "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2635
msgctxt "npc conversation"
msgid "Oh, my!  Everyone is saying terrible things about you and your friends, %02.  I'm afraid I can't speak with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2660
msgctxt "npc conversation"
msgid "There is a rumor going 'round saying that you are a criminal.  I'm afraid I don't associate with criminals."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2685
msgctxt "npc conversation"
msgid "My sources tell me that you have committed a number of crimes.  They say you may even have KILLED.  I am afraid that with that record, I cannot help you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2386
msgctxt "npc conversation"
msgid "Oooh…I'm talking to %06 never do wrong!  Such an honor.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2411
msgctxt "npc conversation"
msgid "Oh, hooray.  It's the good guys.  You're lucky I'm in a good mood right now.  Leave me before it changes."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2436
msgctxt "npc conversation"
msgid "<sneer> Stinkin' goody two-shoes.  They say you %08.  Well isn't that just wonderful?  You people make me sick.  Go your way before I do something you'll regret!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2461
msgctxt "npc conversation"
msgid "Psssst!  Hey, you wanna buy a <squints> wait a minute…never mind."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2486
msgctxt "npc conversation"
msgid "May the dark gods save us from the righteous!  Is there no end to you people?  Get away from me before I put a hex on you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2511
msgctxt "npc conversation"
msgid "I doubt you would approve of my researches into the darker magics, just as I would not approve of your intolerant ways.  I have nothing further to say to you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2536
msgctxt "npc conversation"
msgid "%13, eh? <loosening %03 sword> Better take to your heels…I don't much care for you law-abiding types."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2561
msgctxt "npc conversation"
msgid "Begone, fool!  I will not speak to cowards unwilling to travel the shadowed path."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2586
msgctxt "npc conversation"
msgid "Sorry, %06 but it doesn't matter to me if you %08.  As a matter of fact, I consider your holier-than-thou attitude quite insulting…%06."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2611
msgctxt "npc conversation"
msgid "Word is you %08.  That makes me sick!  If you aren't away from me soon, I'll do a lot more than just arrest you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2636
msgctxt "npc conversation"
msgid "Baaaa! <grinning nastily> Baaa! The herd calls, friend.  Why not go and do some good deeds or something?  G'won!  Git!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2661
msgctxt "npc conversation"
msgid "Everyone says your reputation is %11.  I hate that.  But, because you amuse me, I'll let you live awhile longer--as long as you go pester someone else."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2686
msgctxt "npc conversation"
msgid "Not everyone appreciates how you %08.  I am one of those people.  I doubt we have much to say to one another."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2387
msgctxt "npc conversation"
msgid "Although I have not heard many bad things about you, %02, I haven't heard many good stories either.  I just don't trust you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2412
msgctxt "npc conversation"
msgid "Most humans are evil…and a simple lack of criminal reputation isn't enough to make me trust you.  Leave me."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2437
msgctxt "npc conversation"
msgid "Nothing I've heard about you makes me want to speak with you, %02.  I'm not saying you are bad people;  I'm just saying that you might not be good.  Perhaps if you improved your reputation…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2462
msgctxt "npc conversation"
msgid "I only deal with people I know and trust.  Since I haven't heard anything good about you, I have  no reason to trust you.  Good day."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2487
msgctxt "npc conversation"
msgid "I am afraid I cannot associate with people whose charm and reputation do not approach my own.  It would taint my aura.  Sorry."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2512
msgctxt "npc conversation"
msgid "The court of public opinion about you is divided, %02.  Some say you are good people, others are not so sure. I, for one, will wait for more good rumors about you before I will speak with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2537
msgctxt "npc conversation"
msgid "Hello!  I'm %01!  I've heard of you, %13, and while you haven't done anything too terribly wrong, or at least that I've heard, you haven't done much good, either.  So get out there and do some good deeds!  Maybe then I'll talk to you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2562
msgctxt "npc conversation"
msgid "You haven't an aura of evil or good strong enough for my spells to detect.  Until I know one way or the other, I must decline to speak with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2587
msgctxt "npc conversation"
msgid "A smart official only associates with people of quality reputation.  Your reputation is only %11.  Not good enough for me.  Sorry."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2612
msgctxt "npc conversation"
msgid "I have been instructed to talk only with persons of sound reputation.  Yours is %11, while I must demand %12.  Be on your way."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2637
msgctxt "npc conversation"
msgid "I absolutely, categorically refuse to speak with persons whose reputation is less than %12."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2662
msgctxt "npc conversation"
msgid "My name is %01.  It would be a violation of my sacred oaths to speak with people whose reputation is less than %12.  Therefore, I must bid you good day."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2687
msgctxt "npc conversation"
msgid "I will not sully my excellent reputation by conversing with one whose reputation is merely %11."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2388
msgctxt "npc conversation"
msgid "%02, eh?  I hear you might be a sheriff in disguise.  I don't talk to sheriffs. Or guards…. or King's men.  Maybe if you did a few crimes I could trust you. "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2413
msgctxt "npc conversation"
msgid "%02. I smell traces of an awful goodness seeping from your pores.  I can't stand it!  Go and commit some acts of unspeakable evil.  Maybe then I'll talk to  you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2438
msgctxt "npc conversation"
msgid "<squinting>  Hmm.  I've heard that you have a bad reputation.  That's a good start, but not quite enough.  Your reputation is going to have to get a lot worse before I trust you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2463
msgctxt "npc conversation"
msgid "%10 %02.  I've heard of you.  They say your reputation is %11.  That says a lot, but I need to hear more before I feel I can safely deal with you.  Come back to me after you have proven yourself some more."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2488
msgctxt "npc conversation"
msgid "%02, I am %01.  I am constrained by pacts and promises I have made from dealing over much with the innocent.  I only tell you this because I heard that your reputation is %11.  That's bad, but not bad enough.  Return after performing a few more despicable acts.  Then we will talk."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2513
msgctxt "npc conversation"
msgid "Look--I'm bad company.  Evil, pure and simple, through and through.  How would it look to all my friends to be caught associating with people who lack the kind of %12 reputation we have?  That's right--simply dreadful."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2538
msgctxt "npc conversation"
msgid "%13, it is good to meet you at last.  Your reputation is %11.  Could be worse.  Matter of fact, it makes me think you are some kind of wimp!  Yeah, until I hear worse, I don't want to be seen with you.  Get out of my sight!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2563
msgctxt "npc conversation"
msgid "%02, your reputation is %11, indicating to me that there is hope you will join the darkness yet!  Still, there are traces of goodness in your soul that are troublesome.  Eliminate them and return.  Then we can talk."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2588
msgctxt "npc conversation"
msgid "%02.  I understand you may be something less than a good citizen, and perhaps something more than a common criminal…There are always uses for such as you--if not for me than for my…associates.  But I need more proof!  Commit some more crimes--then we can talk.  And don't tell anyone we spoke about this--I'll deny our little conversation if accused."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2613
msgctxt "npc conversation"
msgid "I have been ordered to speak only with persons of, ah, the right kind of reputation.  Yours is merely %11.  Be on your way."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2638
msgctxt "npc conversation"
msgid "Baaa, friend %02!  I've heard that you might be just the kind of people we are looking for.  But I'm not sure.  You need to get a reputation for doing those things our cult requires…I'm sure you get the idea!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2663
msgctxt "npc conversation"
msgid "%02.  As a Champion of evil, it pleases me to hear that your reputation is %11, but you just aren't evil enough for me!  Get worse!  I'm talking atrocities!  Cause a calamity or do something dastardly, then we can talk."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2688
msgctxt "npc conversation"
msgid "I can see you might be the type of person I commonly associate with, %02, but the rumors of your behavior vary.  I must hear more before I will tolerate your presence.  Perhaps you could dominate and bully some peasants…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2389
msgctxt "npc conversation"
msgid "I've heard so many bad things about you.  Why won't you leave me alone?  I want no trouble from you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2414
msgctxt "npc conversation"
msgid "Back again, %02?  I thought you were smarter than that.  I can smell the evil on you.  It makes me hungry!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2439
msgctxt "npc conversation"
msgid "There's a lot of talk about you people and none of it is good.  I can't be seen with you.  Let's go our separate ways, shall we?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2464
msgctxt "npc conversation"
msgid "I do not speak to ruffians!  Your reputation is %11, well below my standards."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2489
msgctxt "npc conversation"
msgid "I grow wrathful thinking about all the negative things the wind whispers about you.  Your reputation is %11!  Not very nice.  Now begone, before my wrath turns to action!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2514
msgctxt "npc conversation"
msgid "The talk about you and your friends is that you are not decent folk, %02.  I, for one, will have nothing to do with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2539
msgctxt "npc conversation"
msgid "Back again, %13?  Is this some sort of challenge?  Have you come to insult me?  Friend %13, I warn you--you're walking a narrow bridge with me, and the chasm is very deep…very deep indeed!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2564
msgctxt "npc conversation"
msgid "Still dealing in shadows?  I know you can do better, %02.  Go in peace, and return once you have renounced your evil ways."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2589
msgctxt "npc conversation"
msgid "%02? The record is still quite clear:  Your reputation is %11.  Our conversation must end here."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2614
msgctxt "npc conversation"
msgid "I still think I should arrest you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2639
msgctxt "npc conversation"
msgid "<whispering> I'm still not allowed to speak with you, %02!  Now please go, before I'm seen with you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2664
msgctxt "npc conversation"
msgid "%02, your reputation is %11.  My instincts tell me to slay you on the spot, but in the interests of charity, I'll give you a chance to redeem yourself by letting you live.  For now."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2689
msgctxt "npc conversation"
msgid "It is unseemly for me to be seen talking to criminals like yourselves.  Now get out of my sight!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2390
msgctxt "npc conversation"
msgid "Maybe I didn't tell you before:  I don't like you.  I don't see why the high and mighty would want to talk to a lowlife like me anyway, so go away!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2415
msgctxt "npc conversation"
msgid "My mood grows sour as I contemplate your lack of evil.  I have nothing to say to you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2440
msgctxt "npc conversation"
msgid "Oh, back again, huh?  Have you been deputized yet?  Favored by the King?  Well, I'll tell you--Mayors and Kings may welcome your type, but I sure don't.  Watch your back."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2465
msgctxt "npc conversation"
msgid "Are you talking to me?  Go bother someone else.  I have nothing for you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2490
msgctxt "npc conversation"
msgid "Wasn't I rude enough the last time we spoke?  I detest you!  Your angelic faces turn my stomach!  Your innocence nauseates me! Leave!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2515
msgctxt "npc conversation"
msgid "It is a pleasure withholding information from righteous do-gooders like you!  Beg me to reconsider and I might condescend to speak with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2540
msgctxt "npc conversation"
msgid "I am this far--this far from hacking your saintly head from your shoulders!  Leave me while you still can."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2565
msgctxt "npc conversation"
msgid "You try my patience, craven one.  I am tempted to experiment with the powers the netherworld has granted me…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2590
msgctxt "npc conversation"
msgid "<sigh> Back again?!?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2615
msgctxt "npc conversation"
msgid "I can't believe you're back.  My sword hand is starting to itch…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2640
msgctxt "npc conversation"
msgid "Are you soft in the head?  I said go away!  I don't need any good deeds done today."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2665
msgctxt "npc conversation"
msgid "You've returned to try my patience, I see."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2690
msgctxt "npc conversation"
msgid "I still do not quite care for you %02.  Your reputation amongst the common folk is %11, which is a bad business in my book.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2391
msgctxt "npc conversation"
msgid "I'm simply not impressed.  Your reputation is but %11.  I won't talk to you unless it improves."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2416
msgctxt "npc conversation"
msgid "The stories I hear about you are %11, but that isn't good enough.  Be on your way."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2441
msgctxt "npc conversation"
msgid "Ah, %02.  Until the rumors and gossip about you grow more positive, I don't want to talk to you. "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2466
msgctxt "npc conversation"
msgid "Persons of quality are not telling me that you are a person of quality.  Since I only deal with people whose reputations are %12 or better, we have nothing further to talk about."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2491
msgctxt "npc conversation"
msgid "%02.  Your reputation suffers.  Prolonged association with the likes of you imperils the purity of my aura.  I don't want to speak with you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2516
msgctxt "npc conversation"
msgid "<sigh>  Though your reputation is at least %11, I promised my mother that I wouldn't talk to people whose reputation wasn't at least %12.  Sorry."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2541
msgctxt "npc conversation"
msgid "%13!  Maybe someday I will have something to say to you!  Maybe.  But not until your reputation improves."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2566
msgctxt "npc conversation"
msgid "My dear %02.  You must tend to your soul before I can attend to your needs.  Go, and return only when your feet are more firmly on the righteous path."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2591
msgctxt "npc conversation"
msgid "I will only associate with people who won't embarrass me!  You will.  Maybe if people start telling me your reputation is %12.  Until then…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2616
msgctxt "npc conversation"
msgid "I can't talk to you.  I know your reputation is only %11. It must be better.  Orders.  Sorry."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2641
msgctxt "npc conversation"
msgid "Everyone in my secret cult tells me that you aren't nice enough to be with.  So go get nicer and I'll start talking to you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2666
msgctxt "npc conversation"
msgid "Hmm.  %02.  I have sworn an oath to avoid those of ill repute.  Your reputation is %11, which is beneath me.  Perhaps if it improves..."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2691
msgctxt "npc conversation"
msgid "My friends all tell me your reputation is %11, %02.  That's not good enough!  Perhaps a good deed or two would make your presence more acceptable to civilized society."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2392
msgctxt "npc conversation"
msgid "Your reputation is just too pure for me.  I don't like it.  It's not right.  Maybe if I heard some more bad gossip about you we could talk.  Until then…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2417
msgctxt "npc conversation"
msgid "I can sense goodness upon you, %02.  Bring yourself down to %11, and then return to me."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2442
msgctxt "npc conversation"
msgid "Look, all my friends are uncertain about trusting you.  Until you do something to earn our faith, something illegal, I just can't be seen with you.  It makes me look bad."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2467
msgctxt "npc conversation"
msgid "I just can't trust you.  Maybe if your reputation were to fall to %11, or worse we could talk.  <bowing> Until then %10."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2492
msgctxt "npc conversation"
msgid "Your aura lacks the mottled purple and yellow spots I must see before I am allowed to speak with you.  You must do more evil, %02, before we can safely talk."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2517
msgctxt "npc conversation"
msgid "Your reputation is only %12!  I can't be seen with you.  Everyone I know would laugh at me!  I only associate with people whose reputation is %11 or worse."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2542
msgctxt "npc conversation"
msgid "%13!  You've returned!  Returned with a reputation of %11…Hmmm.  Looks wimpy to me.  Do something to impress me, 'cause I don't associate with the weak, or the helpless.  Until then, take off, eh?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2567
msgctxt "npc conversation"
msgid "%02, your personal darkness is shot through with streaks of light.  I won't have it!  I refuse to deal with the uncommitted, the uncertain, and the weak!  Return to me after you have proven your evil and stained your soul!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2592
msgctxt "npc conversation"
msgid "I retain doubts about your commitment to a life on the shady side.  I must hear that your reputation is %12 or less!  Otherwise I can have nothing to do with you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2617
msgctxt "npc conversation"
msgid "I can't talk to you.  I know your reputation is only %11. It must be worse.  Orders.  Sorry."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2642
msgctxt "npc conversation"
msgid "Your reputation isn't appropriate for my organization, %02, therefore I can't be seen talking to you.  Come back when your reputation has…improved."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2667
msgctxt "npc conversation"
msgid "%02, your evil wavers.  More.  More I say!  You need to be at least %12 for me to want to talk to you, so get to work!  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2692
msgctxt "npc conversation"
msgid "I cannot believe you would enter my presence with a reputation of merely %11!  The insult is dire indeed, %10.  Leave, and return when your reputation is %12!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2393
msgctxt "npc conversation"
msgid "Oh, all right.  But I really don't want to be seen with you.  Let's not make this a habit."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2418
msgctxt "npc conversation"
msgid "Your groveling has touched my heart.  I will talk to you for a moment."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2493
msgctxt "npc conversation"
msgid "<sigh> Very well.  But this is it for today!  I don't have time for you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2518
msgctxt "npc conversation"
msgid "Fine, but make it quick."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2543
msgctxt "npc conversation"
msgid "I suppose I could speak to you for a few minutes.  Hurry up."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2568
msgctxt "npc conversation"
msgid "How could I not respond to such a piteous cry for help?  What do you require, %15?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2668
msgctxt "npc conversation"
msgid "Hmmm.  All right.  But only because my mood is good."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2693
msgctxt "npc conversation"
msgid "Today I will grant your wish. I will speak with you.  Briefly."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2444
msgctxt "npc conversation"
msgid "I gave at the Guild.  I'm not interested. I'm broke.  It's not my problem.  Get a job.  I don't care…Don't you get it?  Go away, I don't want to talk to you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2469
msgctxt "npc conversation"
msgid "What about me makes you think I care about you or your problems?  Begone, or I shall set the town guard on you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2594
msgctxt "npc conversation"
msgid "Beg all you like.  I still won't help you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2619
msgctxt "npc conversation"
msgid "<kicking at you> Get away from me!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2644
msgctxt "npc conversation"
msgid "I already told you I don't really care for you.  Bother someone else."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2395
msgctxt "npc conversation"
msgid "Thank you, %06.  Now, what did you want?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2420
msgctxt "npc conversation"
msgid "Yes, good.  What do you want?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2445
msgctxt "npc conversation"
msgid "A pleasure doing business with you, %06.  What can I do for you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2470
msgctxt "npc conversation"
msgid "Thank you!  Please, tell me what it is you are seeking."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2545
msgctxt "npc conversation"
msgid "Yes, now what is it you need, %13?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2570
msgctxt "npc conversation"
msgid "I see now that you are not a malicious defiler of all I hold dear, but rather a misguided soul that has lost %09 way.  How may I help you, child?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2595
msgctxt "npc conversation"
msgid "Thank you.  How may I be of service?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2620
msgctxt "npc conversation"
msgid "Thanks.  What is it you wanted?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2496
msgctxt "npc conversation"
msgid "Money alone will not sway me, scoundrel!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2521
msgctxt "npc conversation"
msgid "Money means little.  Knowledge is power to me.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2646
msgctxt "npc conversation"
msgid "My devotion to Baa is greater than any amount of money.  I will never accept your bribe, never!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2671
msgctxt "npc conversation"
msgid "I think not.  No amount of money could change my opinion of you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2696
msgctxt "npc conversation"
msgid "Your paltry wealth isn't enough to even tempt me.  I will not be bribed."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2397
msgctxt "npc conversation"
msgid "<gulp> I get it. Yes, %06.  What do you want of me?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2422
msgctxt "npc conversation"
msgid "Please, don't slay me!  I will tell you what you want to know!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2447
msgctxt "npc conversation"
msgid "Ok, ok!  Whatever you say, boss."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2472
msgctxt "npc conversation"
msgid "I see.  No need for violence.  What is it you need?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2497
msgctxt "npc conversation"
msgid "Hmmm.  You have a point.  What do you want?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2522
msgctxt "npc conversation"
msgid "Understood %06.  I want to live.  What do you need?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2647
msgctxt "npc conversation"
msgid "Ok, Ok!  Please, don't kill me.  I'm not supposed to die yet."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2548
msgctxt "npc conversation"
msgid "<drawing %03 sword> I don't take kindly to threats…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2573
msgctxt "npc conversation"
msgid "I will not bow to threats."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2598
msgctxt "npc conversation"
msgid "A threat?  You had best be gone before I set the watch on you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2623
msgctxt "npc conversation"
msgid "HA!  <drawing %03 sword> Threaten me, will you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2673
msgctxt "npc conversation"
msgid "You would challenge me?  I am ready for the likes of you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2698
msgctxt "npc conversation"
msgid "I will not bow to your threats!"
msgstr ""

