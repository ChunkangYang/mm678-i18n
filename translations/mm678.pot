msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:3
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:20
msgctxt "trans"
msgid "The faint smell of brimstone and the sound of creatures talking in a strange language drift from the entrance of this cave."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:154
#: mm7/DATA/10LocLANG.events/TRANS.TXT.py:154
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:26
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:42
msgctxt "trans"
msgid "Regent Wilbur Humphrey, Foremost Paladin, and Prince Nicolai Ironfist, heir to the throne of Enroth, both reside in Castle Ironfist."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:156
#: mm7/DATA/10LocLANG.events/TRANS.TXT.py:156
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:43
msgctxt "trans"
msgid "Lord Albert Newton, High Sorcerer of Enroth, resides in Castle Newton."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:158
#: mm7/DATA/10LocLANG.events/TRANS.TXT.py:158
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:44
msgctxt "trans"
msgid "Lord Osric Temper, Foremost Knight, resides in Castle Temper."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:160
#: mm7/DATA/10LocLANG.events/TRANS.TXT.py:160
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:29
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:45
msgctxt "trans"
msgid "Lord Anthony Stone, High Priest of Free Haven, resides in Castle Stone."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:162
#: mm7/DATA/10LocLANG.events/TRANS.TXT.py:162
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:30
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:46
msgctxt "trans"
msgid "Lady Loretta Fleise, Chancellor of the Treasury, resides in Castle Fleise."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:164
#: mm7/DATA/10LocLANG.events/TRANS.TXT.py:164
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:31
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:47
msgctxt "trans"
msgid "Lord Eric von Stromgard, Marquis of the Northern Marches, resides in Castle Stromgard."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:166
#: mm7/DATA/10LocLANG.events/TRANS.TXT.py:166
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:32
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:36
msgctxt "trans"
msgid "The Oracle has provided the rulers of Enroth with wisdom for as long as anyone can remember."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:171
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:154
msgctxt "trans"
msgid "The Control Center has been closed since the Silence, nearly twelve centuries ago."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:172
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:121
msgctxt "trans"
msgid "The weathered stones of this old keep shelter empty buildings in an unused courtyard.  Faint sounds echo from a worn stairway that leads down below the keep."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:173
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:126
msgctxt "trans"
msgid "Strange squeaking echoes from behind the front doors.  At one time a temple of Baa, a foul curse caused the old inhabitants to move away."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:174
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:129
msgctxt "trans"
msgid "This area appears to be abandoned.  However, fresh footprints lead in and out from a recently repaired door.  Perhaps it isn’t so abandoned after all."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:175
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:132
msgctxt "trans"
msgid "Ancient runes above the entrance attempt to scare away the casual visitor.  Fresh goblin tracks lead into and out of the doorway."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:176
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:134
msgctxt "trans"
msgid "These caverns once belonged to the exiled King Rocklin, but now they are home to the new Dwarven King, Snergle."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:177
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:136
msgctxt "trans"
msgid "The original name of these caverns has been lost in time.  Now, it is named for the group of bandits that base their operations from it."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:178
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:138
msgctxt "trans"
msgid "This small post acts as an advance base for the Fraternal Order of Silver.  From here, they are able to patrol Mist in their conquest of evil."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:179
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:140
msgctxt "trans"
msgid "Home to the so-called Prince of Thieves, the Shadow Guild operates outside of Anthony Stone's jurisdiction.  This Guildhall is not open to the public."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:180
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:142
msgctxt "trans"
msgid "The largest dwarven mine in Enroth, Snergle has claimed it in his succession to the dwarven throne."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:181
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:143
msgctxt "trans"
msgid "The Dragoons rebuilt and refurbished this keep to serve as their headquarters.  From here, they prey on traffic to and from Free Haven."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:182
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:144
msgctxt "trans"
msgid "Once the residence of Archmage Terrax, Corlagon received the Estate from Archibald for his services during the Succession Wars."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:183
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:145
msgctxt "trans"
msgid "The headquarters of the Fraternal Order of Silver and Sir John Silver's home.  Silver Helms from this Stronghold patrol Silver Cove in search of evil."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:184
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:146
msgctxt "trans"
msgid "This forboding structure radiates magical power.  Druids from all over Enroth make periodic pilgrimages to visit this sacred place."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:185
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:147
msgctxt "trans"
msgid "Ethric, the first Sorcerer seeking life after death, still walks about his tomb, the leader of a host of undead servants.  At least, that’s how the rumor goes..."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:186
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:148
msgctxt "trans"
msgid "Originally used to keep creatures from escaping the Frozen Wastelands, now the keep prevents traffic to and from Castle Stromgard and town of White Cap."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:187
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:149
msgctxt "trans"
msgid "Muted sounds of clashing metal and loud voices emanate from this imposing fortress.  No one would dare assault the Warlord’s home."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:188
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:150
msgctxt "trans"
msgid "A foul smell wafts from the entrance to these caves.  The howl of a wolf can be heard from the distance."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:189
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:151
msgctxt "trans"
msgid "Fire Elementals assisted Gharik in his attempts to create powerful items here.  A handful of his students continue his experiments."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:190
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:152
msgctxt "trans"
msgid "This laboratory is the birthplace for countless horrid experiments.  Its remote location was chosen for both safety and secrecy."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:191
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:153
msgctxt "trans"
msgid "These caves house a strange alliance between human warriors and dragons.  The Dragon Towers were built in the towns to ward off these raiders."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:192
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:122
msgctxt "trans"
msgid "Faint chanting can be heard from beyond the doors of this Temple.  Visitors do not appear to be welcome here."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:193
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:127
msgctxt "trans"
msgid "This large but simple structure has become the center of worship for a small religious group called the Order of the Fist."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:194
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:130
msgctxt "trans"
msgid "The smells of death and decay seem to fill the air near this structure.  The temple's original purpose has long since been forgotten by the new worshippers."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:195
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:133
msgctxt "trans"
msgid "This forgotten shrine of the Church of the Sun still stands.  For all of its time in the humid jungle, the temple remains in surprisingly good condition."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:196
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:135
msgctxt "trans"
msgid "Originally a place of worship for the Church of the Moon, this old sanctuary is now home to Cedric Drother’s group of Druids."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:197
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:137
msgctxt "trans"
msgid "The temperature rises steadily as you approach the doors, the smell of sulfur and ash strong.  This place resembles a hideout more than a temple."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:198
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:139
msgctxt "trans"
msgid "The focal point of all Baa worship in Enroth, the Superior Temple only allows followers of Baa inside."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:199
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:141
msgctxt "trans"
msgid "The forest of statues scattered about seems to magnify the silence on Star Island.  Certainly, the rumors of medusas living in this temple are true."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:200
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:123
msgctxt "trans"
msgid "The first fortress dedicated to magical research, its remote location provided secrecy for the mages and protection for the populace in the event of an accident."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:201
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:128
msgctxt "trans"
msgid "The temperature drops as you approach the gates to this castle.  Legend holds that this castle contains the knowledge of how to transcend death as undead."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:202
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:131
msgctxt "trans"
msgid "Kriegspire no longer rests between its lakes, the earth around the castle was raised to prevent the creatures inside from escaping."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:203
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:124
msgctxt "trans"
msgid "This pyramid seems to be made of a strange, weathered metal.  It appears to be partially buried in the sand."
msgstr ""

#: mm6/data/10LocLANG.icons/Trans.txt.py:204
#: mmmerge/Data/10LocLANG.EnglishT/Trans.txt.py:125
msgctxt "trans"
msgid "This strange structure commands a spectacular view of Paradise Valley.  The outer walls are constructed from an unknown material."
msgstr ""

