msgid "Axe"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:26 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1626
msgctxt "items"
msgid "More of a tool than a weapon, this simple axe will work in a pinch.  But don't expect much."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:27
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:26 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:827 localization/LANG_ItemsTxt.txt.py:1627
msgctxt "items"
msgid "Battle Axe"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:27 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1627
msgctxt "items"
msgid "Made as a weapon of war instead of a tool, the battle axe is usually employed by barbarians and undisciplined armies."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:28 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1628
msgctxt "items"
msgid "War Axe"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:28 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1628
msgctxt "items"
msgid "This War Axe appears to be one of a large shipment of such axes seized by Roland during the Succession War.  It was manufactured in Karigor by order of Archibald Ironfist to be used against his brother in their struggle for the throne of Enroth."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:29
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:27 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:828 localization/LANG_ItemsTxt.txt.py:1629
msgctxt "items"
msgid "Dwarven Axe"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:29 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1629
msgctxt "items"
msgid "An example of the high quality work done by the dwarves of the Red Mountains, the blade is sharp and the balance perfect."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:30 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1630
msgctxt "items"
msgid "Supreme Axe"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:30 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1630
msgctxt "items"
msgid "This weapon surely has a dark history.  An axe of this quality is only forged as the personal weapon of a noble Dwarf, and it is never sold or traded away…"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:31
msgctxt "items"
msgid "Poleax"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:31
