msgctxt "items"
msgid "Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:123 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1723
msgctxt "items"
msgid "A small golden ring with a quarter carat diamond.  The style is simple and elegant."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:124 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1724
msgctxt "items"
msgid "Sparkling Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:124 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1724
msgctxt "items"
msgid "Two amethysts adorn this plain platinum ring."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:125 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1725
msgctxt "items"
msgid "Lunar Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:125 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1725
msgctxt "items"
msgid "A gold ring with a large moonstone set in the center.  These rings typically carry an enchantment."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:126 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1726
msgctxt "items"
msgid "Witch Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:126 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1726
msgctxt "items"
msgid "Rings such as this one were worn by the Witch's guild to signify membership during their heyday between 550-800 A.S."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:127 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1727
msgctxt "items"
msgid "Blessed Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:127 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1727
msgctxt "items"
msgid "The three pearls mounted on a gold base glimmer a faint blue when held out in the sun, offering insight as to the source of their magic."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:128 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1728
msgctxt "items"
msgid "Valuable Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:128 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1728
msgctxt "items"
msgid "A large star sapphire flanked by two smaller rubies decorate an otherwise plain gold band."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:129 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1729
msgctxt "items"
msgid "Precious Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:129 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1729
msgctxt "items"
msgid "Three gems, symmetrically equal in size and quality adorn a hammered gold band.  The center gem is a ruby, and the two flanking gems are purple topazes."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:130 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1730
msgctxt "items"
msgid "Ethereal Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:130 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1730
msgctxt "items"
msgid "A hammered white gold ring with a large central diamond and two small pearls, light doesn't fall upon it normally.  The ring glitters and fades unpredictably, as though it were lit by an invisible sun shining in an unseen, yet parallel world.  "
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:131 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1731
msgctxt "items"
msgid "Exquisite Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:131 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1731
msgctxt "items"
msgid "Three opals rimmed with a strange red metal are set in a perfect ring of stalt--a very rare metal found only in southern Erathia."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:132 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1732
msgctxt "items"
msgid "Scarab Ring"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:132 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1732
msgctxt "items"
msgid "A gold band adorned with the shell of a rare beetle found only in the deserts of Enroth.  Treated properly by an alchemist, these shells can be made to hold the mightiest of enchantments."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:133 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1733
msgctxt "items"
msgid "Turquoise Amulet"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:133
