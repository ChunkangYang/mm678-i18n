#: mm6/data/10LocLANG.icons/npcprof.txt.py:5
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2322
msgctxt "npcprof"
msgid "Unlimited weapon repair.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:5
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2269
msgctxt "npcprof"
msgid "I'll happily join you for 200 gold and %17 percent of all the gold we find.  I'll fix any weapon you ask me to while I work for you."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:6
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2323
msgctxt "npcprof"
msgid "Unlimited armor repair.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:6
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2270
msgctxt "npcprof"
msgid "I'm looking for work fixing armor.  All I charge is 200 gold to start and %17 percent of all the gold we find.  You won't regret hiring me!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:7
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:7
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2324
msgctxt "npcprof"
msgid "Unlimited magic item repair.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:7
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:7
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2271
msgctxt "npcprof"
msgid "I can mend any broken magic item you have, unless it's a piece of armor or a weapon.  My rate is 400 gold to start plus %17 percent of all the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:8
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2325
msgctxt "npcprof"
msgid "Unlimited item Identification and a 5 percent bonus on all experience gained.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2272
msgctxt "npcprof"
msgid "I studied under Lord Newton in Mist for eight years to learn to tell one magic item from another.  I'll work for you for 500 gold to start, plus a %17 percent share of all the gold we find. "
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:9
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2326
msgctxt "npcprof"
msgid "All map crossings one day faster (minimum one day).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2273
msgctxt "npcprof"
msgid "I know shortcuts and back roads throughout Enroth.  I'll be your guide for a mere 100 gold to start and a %17 percent share of all the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:10
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2327
msgctxt "npcprof"
msgid "All map crossings two days faster (minimum one day).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2274
msgctxt "npcprof"
msgid "I know shortcuts and back roads throughout Enroth.  I'll be your guide for 200 gold to start, plus a %17 percent share of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:11
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2328
msgctxt "npcprof"
msgid "All map crossings three days faster (minimum one day).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2275
msgctxt "npcprof"
msgid "I know shortcuts and back roads throughout Enroth.  I'll be your guide for a mere 300 gold to start, plus a %17 percent share of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:12
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2329
msgctxt "npcprof"
msgid "All boat travel 2 days faster (minimum one day).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:12
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2276
msgctxt "npcprof"
msgid "Uh, Ya.  I can uh, you know, work.  On a boat.  I'll help get you places quicker.  With me, I can get you across the sea two days faster than normal.  Uh, I uh, want oh, let's see, 100 gold to start, and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:13
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2330
msgctxt "npcprof"
msgid "All boat travel 3 days faster (minimum one day).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:13
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2277
msgctxt "npcprof"
msgid "I've spent quite some time putting together accurate charts of the waters surrounding our continent.  With my charts and my skill, I can get you across water three days faster than normal.  I charge 200 gold to start, plus %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:14
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2331
msgctxt "npcprof"
msgid "Cures all party hit points once a day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:14
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2278
msgctxt "npcprof"
msgid "I can travel with you, my children, for an initial donation of 500 gold to start and %17 percent of the gold we find to my church.  Once per day I'll be able to heal you of all your wounds, short of death."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:15
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2332
msgctxt "npcprof"
msgid "Cures all party hit points and conditions (excepting dead, stoned, or eradicated) once per day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:15
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2279
msgctxt "npcprof"
msgid "As an expert healer, I can heal your wounds and many other conditions (but not death or turned to stone) once per day.  All I require is a donation of 2000 to my church and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:16
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2333
msgctxt "npcprof"
msgid "Completely heals party of all hit points and conditions once per day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:16
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2280
msgctxt "npcprof"
msgid "As a master healer, my services are in demand by many, but my power to magically heal only works but once per day.  I can heal everything but eradication, and require a modest initial donation of 5000 gold to my temple and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:17
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2334
msgctxt "npcprof"
msgid "Ten percent bonus on all experience learned.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:17
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2281
msgctxt "npcprof"
msgid "I can help you to interpret and understand what you see as you travel. I think my advice will increase your overall experience.  I must charge 300 gold to start and %17 percent of the gold we find for my services, however."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:18
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2335
msgctxt "npcprof"
msgid "Fifteen percent bonus on all experience learned.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:18
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2282
msgctxt "npcprof"
msgid "I can help you to interpret and understand what you see as you travel. I think my advice will increase your overall experience.  I must charge 700 gold to start and %17 percent of the gold we find for my  services, however."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2336
msgctxt "npcprof"
msgid "Two point bonus to all weapon skills for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:19
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2283
msgctxt "npcprof"
msgid "Everyone benefits from good advice, and my advice on weapons and combat is amongst the best.  During battle, my direction will improve your skill at arms.  I charge but 300 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2337
msgctxt "npcprof"
msgid "Three point bonus to all weapon skills for all characters..  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:20
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2284
msgctxt "npcprof"
msgid "Everyone benefits from good advice, and my advice on weapons and combat is the best.  During battle, my direction will significantly improve your skill at arms.  I charge but 400 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2338
msgctxt "npcprof"
msgid "Two point bonus to all spell skills for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2285
msgctxt "npcprof"
msgid "I can lend a little magic to boost your spell skills and ease your magical burden for 500 gold to start and %17 percent of the gold we find.."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2339
msgctxt "npcprof"
msgid "Three point bonus to all spell skills for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2286
msgctxt "npcprof"
msgid "I can lend a good deal of magic to magnify your spell skills for 1000 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2340
msgctxt "npcprof"
msgid "Four point bonus to all spell skills for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2287
msgctxt "npcprof"
msgid "I can lend my considerable magic reserves to sharply increase your spell skills and effects for the low, low price of 2000 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:24
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2341
msgctxt "npcprof"
msgid "Four point bonus to Merchant skill for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:24
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2288
msgctxt "npcprof"
msgid "Sometimes, people have trouble bargaining in their own behalf.  I'll be happy to give you advice to better the prices you receive while bargaining with Merchants.  All I ask is 100 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:25
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2342
msgctxt "npcprof"
msgid "Six point bonus to Merchant skill for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2289
msgctxt "npcprof"
msgid "As a long time member of the Merchant's Guild, and a former rug Merchant myself, I know all the tricks of the trade like the back of my hand.  I can give you advice while bargaining with other Merchants to improve the prices you get.  My fee is but 200 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:26
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2343
msgctxt "npcprof"
msgid "Six point bonus to perception skill for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:26
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2290
msgctxt "npcprof"
msgid "My eyes are sharp, and my voice is loud.  I can alert you to danger before it strikes.  May save your life…And all I need is 300 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2344
msgctxt "npcprof"
msgid "Four point bonus to Diplomacy skill for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2291
msgctxt "npcprof"
msgid "I've spent my life in and around courts and bureaucracies, and I know how to make people more…sympathetic to a cause.  Hire me, and I'll do the same for you.  200 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2345
msgctxt "npcprof"
msgid "Eight point bonus to Diplomacy skill for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2292
msgctxt "npcprof"
msgid "I've spent my life in and around courts and bureaucracies, and I know how to make people more…sympathetic to a cause.  Hire me, and I'll do the same for you.  300 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:29
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:29
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2346
msgctxt "npcprof"
msgid "Four point bonus to Disarm Traps skill for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:29
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:29
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2293
msgctxt "npcprof"
msgid "I know a thing or two about fixing tools and whatnot.  I also know about locks.  I can help you pick them if you hire me for 200 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:30
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:30
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2347
msgctxt "npcprof"
msgid "Six point bonus to Disarm Traps skill for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:30
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:30
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2294
msgctxt "npcprof"
msgid "Locksmithing is a difficult thing to learn, and you need a professional with you to help you handle the toughest locks.  I can work for you for 300 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:31
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:31
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2348
msgctxt "npcprof"
msgid "Five point bonus to Luck statistic for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:31
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:31
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2295
msgctxt "npcprof"
msgid "The gods favor drunks, children and fools.  Well, I'm a fool!  Take me with you and maybe the gods will favor you too.  All I want is 100 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:32
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:32
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2349
msgctxt "npcprof"
msgid "Twenty point bonus to Luck statistic for all characters.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:32
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:32
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2296
msgctxt "npcprof"
msgid "People say Chimney Sweeps are lucky.  I don't know about that– sweeping chimneys is hard work!  But if you want, you could hire me for 200 gold to start and %17 percent of the gold we find..  Maybe I'll bring you good luck."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:33
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:33
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2350
msgctxt "npcprof"
msgid "One less day of food use when camping, (minimum of one used).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:33
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:33
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2297
msgctxt "npcprof"
msgid "If you need someone to carry some traveller's comforts, like tents and cooking gear, I'm your man!  All I want is 100 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:34
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:34
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2351
msgctxt "npcprof"
msgid "Two less days of food use when camping, (minimum of one used).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:34
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:34
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2298
msgctxt "npcprof"
msgid "For 200 gold to start and %17 percent of the gold we find, I'll organize all your camping needs and carry your gear.  I think you'll find me well worth the price!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:35
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:35
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2352
msgctxt "npcprof"
msgid "Ten percent bonus on all gold found.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:35
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:35
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2299
msgctxt "npcprof"
msgid "For 500 gold to start and %17 percent of the gold we find I'll organize your finances and check all the coins you find for rarity.  I can usually increase a client's wealth by 5 percent."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:36
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:36
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2353
msgctxt "npcprof"
msgid "Twenty percent bonus on all gold found.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:36
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:36
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2300
msgctxt "npcprof"
msgid "For 1000 gold to start and %17 percent of the gold we find I'll organize your finances and check all the coins you find for rarity.  I can usually increase a client's wealth by 10 percent."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:37
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:37
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2354
msgctxt "npcprof"
msgid "Makes one day of food per day (maximum of 14 days).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:37
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:37
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2301
msgctxt "npcprof"
msgid "Ever want your own personal cook?  For 300 gold to start and %17 percent of the gold we find, I'll carry extra food and prepare your meals for myself and the four of you.  You won't be sorry– everyone loves my cooking!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:38
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:38
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2355
msgctxt "npcprof"
msgid "Makes two days of food per day (maximum of 14 days).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:38
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2302
msgctxt "npcprof"
msgid "I have studied in the finest cooking schools in Enroth, and I am willing to prepare your meals for a paltry 400 gold to start and %17 percent of the gold we find.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:39
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:39
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2356
msgctxt "npcprof"
msgid "Trips using the stables take two days fewer to complete (minimum one day).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:39
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:39
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2303
msgctxt "npcprof"
msgid "I can see you know little about handling horses and getting the most out of them.  I'll be happy to take care of any horses you use when you rent horses at the stables.  You'll get to your destination faster with my help.  All I want is 100 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:40
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:40
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2357
msgctxt "npcprof"
msgid "Grants a constant, single category bonus to your reputation.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:40
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:40
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2304
msgctxt "npcprof"
msgid "My reputation as a famous musician follows me wherever I go.  If I'm with you, I'm sure some of my reputation will rub off on you.  I only need 1000 gold to start and %17 percent of the gold we find for living expenses."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:41
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2358
msgctxt "npcprof"
msgid "Increases protection from the four elements by 20 constantly.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:41
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2305
msgctxt "npcprof"
msgid "Dangerous Sorcerers abound throughout the land of Enroth.  Most use spells that do some sort of elemental damage, like fire or lightning.  I know a spell that will protect you from these elements, and I can keep it going all the time.  I'll cast it for you if you take me along.  All I want is 1000 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:42
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:42
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2359
msgctxt "npcprof"
msgid "Keeps the Wizard Eye spell at expert ranking going at all times.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:42
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:42
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2306
msgctxt "npcprof"
msgid "For 200 gold to start and %17 percent of the gold we find, I can cast the Wizard Eye spell at expert level constantly."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:43
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:43
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2360
msgctxt "npcprof"
msgid "Casts the Fly spell (duration 2 hours) once per day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:43
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:43
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2307
msgctxt "npcprof"
msgid "Ever want to fly?  Take me with you and I can cast the Fly spell on you once a day.  All I ask is 2000 gold to start and %17 percent of the gold we find.  Cheap, huh?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:44
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:44
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2361
msgctxt "npcprof"
msgid "Casts the Water Walk spell (duration 3 hours) once per day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:44
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:44
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2308
msgctxt "npcprof"
msgid "Ancient prophets claimed the power to walk on water, and I've rediscovered their secret.  Once per day I can cast the Water Walk spell on you and everyone with you.  My rate is 1000 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:45
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:45
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2362
msgctxt "npcprof"
msgid "Casts the Town Portal spell at master ranking once per day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:45
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2309
msgctxt "npcprof"
msgid "There are spells that duplicate some of the natural magical features of Enroth.  One of those, Town Portal, I've learned to cast at master level.  I'll  cast it for you up to once per day if you hire me.  My price is 2000 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:46
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:46
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2363
msgctxt "npcprof"
msgid "Casts the Bless spell (duration 2 hours) at master ranking once per day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:46
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:46
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2310
msgctxt "npcprof"
msgid "For a donation of 200 gold to start and %17 percent of the gold we find to my temple, I'll travel with you and cast the Bless spell once per day."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:47
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:47
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2364
msgctxt "npcprof"
msgid "Casts the Heroism spell (duration 2 hours) at master ranking once per day.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:47
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:47
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2311
msgctxt "npcprof"
msgid "All armies travelling in style bring a piper along to inspire them to heroic deeds during combat.  Even small groups like your own can benefit.  I'll travel with you for 300 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:48
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:48
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2365
msgctxt "npcprof"
msgid "All travel times reduced by one day (minimum of one day).  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:48
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:48
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2312
msgctxt "npcprof"
msgid "My experience in travelling the world can speed your journeys by a day whether you travel by land or by sea.  All I require is 100 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:49
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:49
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2366
msgctxt "npcprof"
msgid "All boat travel reduced by two days, gold is increased by ten percent when found, and Reputation is decreased by one full category.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:49
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:49
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2313
msgctxt "npcprof"
msgid "Arrr.  My life as a freedom-loving sailor has taught me to travel quickly on the seas and count my gold well.  But I'm down on my luck these days, so I'll sign on with you for only 500 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:50
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:50
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2367
msgctxt "npcprof"
msgid "Armor and weapon skills are increased by two points for each character.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:50
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:50
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2314
msgctxt "npcprof"
msgid "All warriors need a squire to take care of their weapons and armor and back them up in battle.  I'll be your squire for 600 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:51
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:51
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2368
msgctxt "npcprof"
msgid "Perception skill is increased by five points and Luck statistics are increased by ten points for each character.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:51
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:51
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2315
msgctxt "npcprof"
msgid "Fortune is my business, and I can improve your fortunes for 400 gold to start and %17 percent of the gold we find.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:52
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:52
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2369
msgctxt "npcprof"
msgid "Food use is reduced by one day's worth of food when resting (minimum one day), Merchant skill is increased by three points for each character, and Reputation is decreased by one full category.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:52
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:52
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2316
msgctxt "npcprof"
msgid "My entire life has been spent on the road, and believe me when I say you gotta know how to travel and you gotta know how to deal.  I can help you with both for 100 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:53
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2370
msgctxt "npcprof"
msgid "Both Merchant and Diplomacy skills are increased by four points for each character.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:53
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:53
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2317
msgctxt "npcprof"
msgid "Not everyone knows how to talk strangers into giving them what they want.  I make it my specialty.  Bring me along and I'll use my skills to ease your way through society.  My rate is 500 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:54
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:54
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2371
msgctxt "npcprof"
msgid "Merchant skill is increased by eight points for each character and Reputation is decreased by one full category.  %01 takes %17 percent of all gold you find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:54
#: mm7/DATA/10LocLANG.events/NPCPROF.TXT.py:54
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2318
msgctxt "npcprof"
msgid "Lots of people can be talked out of stuff they would never give up if they thought about it.  The trick is to talk fast and don't let them pause to consider what you're really saying.  I'll stay with you and coach you on this valuable skill for only 200 gold to start and %17 percent of the gold we find."
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:55
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2372
msgctxt "npcprof"
msgid "Disarm Traps skill is increased by eight points for each character and Reputation is decreased by one full category.  %01 costs you nothing!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:55
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2319
msgctxt "npcprof"
msgid "Need traps disarmed?  I've been doing it ever since I was released from jail three years ago.  If you need help, I'll come with you for free!  I need the practice.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:56
#: mm6/data/10LocLANG.icons/npcprof.txt.py:57
#: mm6/data/10LocLANG.icons/npcprof.txt.py:58
#: mm6/data/10LocLANG.icons/npcprof.txt.py:59
#: mm6/data/10LocLANG.icons/npcprof.txt.py:60
#: mm6/data/10LocLANG.icons/npcprof.txt.py:61
#: mm6/data/10LocLANG.icons/npcprof.txt.py:62
#: mm6/data/10LocLANG.icons/npcprof.txt.py:63
#: mm6/data/10LocLANG.icons/npcprof.txt.py:64
#: mm6/data/10LocLANG.icons/npcprof.txt.py:65
#: mm6/data/10LocLANG.icons/npcprof.txt.py:66
#: mm6/data/10LocLANG.icons/npcprof.txt.py:67
#: mm6/data/10LocLANG.icons/npcprof.txt.py:68
#: mm6/data/10LocLANG.icons/npcprof.txt.py:69
#: mm6/data/10LocLANG.icons/npcprof.txt.py:70
#: mm6/data/10LocLANG.icons/npcprof.txt.py:71
#: mm6/data/10LocLANG.icons/npcprof.txt.py:72
#: mm6/data/10LocLANG.icons/npcprof.txt.py:73
#: mm6/data/10LocLANG.icons/npcprof.txt.py:74
#: mm6/data/10LocLANG.icons/npcprof.txt.py:75
#: mm6/data/10LocLANG.icons/npcprof.txt.py:76
#: mm6/data/10LocLANG.icons/npcprof.txt.py:77
#: mm6/data/10LocLANG.icons/npcprof.txt.py:78
#: mm6/data/10LocLANG.icons/npcprof.txt.py:79
#: mm6/data/10LocLANG.icons/npcprof.txt.py:80
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2268
msgctxt "npcprof"
msgid "Well, I have no skills to offer, but I'm good company!  Just feed me and throw me a few gold pieces and I'll be happy to accompany you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcprof.txt.py:81
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2320
msgctxt "npcprof"
msgid "I don't have any skills to offer you, but if this will get me out of school and away from my chores, I'd love to follow you around!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:3
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1694
msgctxt "npc conversation"
msgid "Oh!  The Seal.  Here, I'm supposed to give you this money.  Now, go away before we're seen together!  Someone will get suspicious."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:4
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1695
msgctxt "npc conversation"
msgid "Don't try to say I didn't pay you!  You got your gold!  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1696
msgctxt "npc conversation"
msgid "My instructions are quite clear.  I am to pay the person carrying the letter that bears the Seal.  Since you don't have a letter with a Seal, you get no money!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1697
msgctxt "npc conversation"
msgid "Just south of town is an old keep called Goblinwatch.  It was originally built to help keep the town safe from goblin raids, but times have been so peaceful recently that we haven't been taking care of it.  You can imagine our embarrassment when we realized that the very monsters we were guarding against have moved into the keep!  They also changed the lock on a very important door leading to the caves below the dungeon level.  We have a standing reward of 2000 gold pieces to the ones who can figure out the combination and tell us what it is."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:7
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1698
msgctxt "npc conversation"
msgid "How can you find the combination to that lock by standing around here?  Get going!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:8
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1699
msgctxt "npc conversation"
msgid "Ah, thank you for taking care of that little detail for us.  Here's your gold!  Feel free to return to Goblinwatch any time to finish clearing out the rest of the monsters.  We can't pay you, but you can have anything you find there.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:9
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1700
msgctxt "npc conversation"
msgid "You did such a fine job with the Goblinwatch assignment that we would like to employ you again.  A cult has moved into an old abandoned temple a few day's journey west of here.  To pay for their blasphemous activities, they've been robbing travelers using the road that leads to Castle Ironfist.  We've appealed to the regent to do something about these horrible cultists, but he says all his forces are occupied in the west, or some such nonsense.  We want it gone now, so we're willing to pay you 5000 gold pieces to get rid of them and bring us back the Chime of Harmony as proof you've done the deed."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:10
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1701
msgctxt "npc conversation"
msgid "Without the Chime of Harmony, I'm not authorized to pay the reward money.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:11
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1702
msgctxt "npc conversation"
msgid "Good work!  Here's your gold!  I can't thank you enough for ruining that temple.  Now the road to Ironfist will be safe for travel again."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:12
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1703
msgctxt "npc conversation"
msgid "The road to Ironfist is much safer thanks to you.  You have our gratitude."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:13
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1704
msgctxt "npc conversation"
msgid "The proprietor of the Howling Moon is George Caniss.  It's a wonderful place.  Tell him I said hi!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:14
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1705
msgctxt "npc conversation"
msgid "Thank you so much for bringing me these letters! <Wilbur begins reading the letters> I’ve been so worried…I see… This is not good news…Oh, no.  Traitors!  Traitors and conspirators everywhere!  I must organize an expedition at once! <Wilbur lowers his voice> I trust you will not speak to the prince about these letters– he is already too depressed and unhappy to hear more bad news.  And now I must see to the organization of the expedition.  Here is a bag of gold as a reward– you’ve earned it and my gratitude.  Now, if only I could find someone to finish looking for Lord Kilburn…"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:15
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1706
msgctxt "npc conversation"
msgid "<Wilbur snaps his fingers> Say, you wouldn’t happen to be interested in taking care of a little detail for me, would you?  Lord Kilburn disappeared near Blackshire.  Find out what you can and return to me with the information.  If it is true that he has been slain by devils, return his shield to me if at all possible.  I will grant you my favor with the High Council, should you require it, and you can rest assured your compensation will be generous."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:16
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1707
msgctxt "npc conversation"
msgid "Hmm.  No luck finding the shield yet, eh?  Well, do keep looking, will you?  It really is important that someone accounts for his whereabouts."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:17
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1708
msgctxt "npc conversation"
msgid "If his shield was in my Castle, I think I’d be aware of it.  Perhaps if you were to leave, you may have better luck finding it…"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:18
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1709
msgctxt "npc conversation"
msgid "Ah.  ‘Tis a sad day when so noble a Knight should fall to such foul monsters!  You have done a good thing, bringing his shield to me.  I shall ensure that he and his men receive all the honors due them.  I am in your debt, and you have my favor with the council.  Here is your reward."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:19
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1710
msgctxt "npc conversation"
msgid "Well, you have my vote on the High Council.  I trust you implicitly.  I've sent a messenger instructing Slicker Silvertongue to vote for you on my behalf.  Now I'm quite busy, and must attend to other duties.  I'm sure you can take care of any problems and miscommunications that may arise in this matter.  Yes.  Quite right."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:20
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1711
msgctxt "npc conversation"
msgid "I cannot thank you enough for uncovering that horrible traitor and his crimes against the throne.  I understand you are on a mission of some importance, so for Services Rendered to the Crown, it behooves me to offer you free use of the royal yacht for your travels.  It will take you as far as Hermit's Isle, if you need it to.  Once again, thank you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:21
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1712
msgctxt "npc conversation"
msgid "I am the Foremost Paladin, and as such, I am the one charged with the promotion and keeping of the titles and responsibilities of paladinhood.  Those paladins who wish to perform a quest for the official promotion to crusader must rescue a damsel in distress.  Those of you who are not paladins will be awarded the title of honorary crusader, and all will be given a sizeable gold reward.  Return to me with said damsel and I will promote any paladins aiding in her rescue to the status of crusader."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:22
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1713
msgctxt "npc conversation"
msgid "I know there is a shortage of damsels in distress, but this quest is the traditional test.  I really can’t bend the rules here.  Keep looking– I’m sure you’ll find someone.  If it helps, I hear Melody Silver, daughter of the noble John Silver, is being held captive by ruffians on the Island of Mist."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:23
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1714
msgctxt "npc conversation"
msgid "I have heard stories of the daring rescue, and I am delighted that you have returned with Miss Silver.  I shall arrange to have her returned to her family at once.  Exemplary work!  I hereby officially promote all paladins to the status of crusader, and all non-paladins to honorary crusaders!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:24
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1715
msgctxt "npc conversation"
msgid "Well, then!  It is a fine thing to be promoted to crusader, but even finer a thing to be promoted to hero.  As you may have guessed by now, the condition for hero status is to slay a dragon.  I know this seems difficult, but tradition has its demands.  What’s worse, you can’t slay just any dragon, but must slay a named dragon.  Your task is to slay Longfang Witherhide and return with a claw or tooth as proof.  Fortunately, we know that Longfang lives in a cave in the mountains behind Castle Darkmoor.  He has slain at least twelve would-be heroes, so be careful!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:25
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1716
msgctxt "npc conversation"
msgid "There is no use returning to me to talk about your quest.  I cannot change the rules or your quest.  Longfang awaits your avenging sword.  Now get to it!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:26
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1717
msgctxt "npc conversation"
msgid "Well done!  One less horrible monster in the world is a good thing.  I hereby officially promote all crusaders to heroes, and all honorary crusaders to the status of honorary hero! May you long continue to live up to the title!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:27
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1718
msgctxt "npc conversation"
msgid "It is always good to speak with heroes of the realm!  Come back in some less troubled time and we'll swap tales of honor and courage by the fire!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:28
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1719
msgctxt "npc conversation"
msgid "The palace is deadly dull, and everyone tells me what to do.  Being royalty isn’t really worth much and no one will let me go outside the walls while my father is gone.  I haven’t left the castle for months!  Anyway, you people look pretty important.  What if you helped me sneak out and stay with you for a couple of days?  I can’t give you much in return yet, but I’ll owe you a favor.  Someday I’ll be able to repay you.  I am the prince, after all!  I’ll go out the secret door and meet you outside."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:29
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1720
msgctxt "npc conversation"
msgid "Let’s go see the circus!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:30
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1721
msgctxt "npc conversation"
msgid "It seems that Prince Nicolai disappeared while you were resting."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:31
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1722
msgctxt "npc conversation"
msgid "Um.  Hi. <smiling weakly> Would you believe I got lost and these nice people were taking me home?  No?  I guess I wouldn’t either.  I suppose it’s time we got back to the castle, then."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:32
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1723
msgctxt "npc conversation"
msgid "We should go back to Castle Ironfist."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:33
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1724
msgctxt "npc conversation"
msgid "<Nicolai speaks to you> Well, thanks for sneaking me out of the castle.  Sorry about the circus thing– I hope I wasn’t too much trouble to find.  I’ll go in myself so no one will see that it was you who kidnapped me.  Thanks again, and goodbye.  I’ll remember this, and I owe you a favor! "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:34
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1725
msgctxt "npc conversation"
msgid "Thanks for bringing me home.  I owe you a favor!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:35
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1726
msgctxt "npc conversation"
msgid "Everyone says that my Uncle Archibald wasn’t a very nice person, and that he almost usurped the throne from my father, but we defeated him.  Father had Tanir turn him to stone and then locked him in the library.  Nobody’s been in there for years. "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:36
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1727
msgctxt "npc conversation"
msgid "You want to free Archibald?!  If the Oracle told you to do it, I guess we should, but he’ll be trouble once he’s loose, that’s for sure.  I know where the bell is that turned him to stone, but I can’t open the family vault that it’s in without the Third Eye.  It’s one of three gems you need to put into the door of the vault in order to open it.  I’ve got two of them– one in my father’s crown and one in his scepter, but my father hid the third one, and he didn’t tell me where it is.  If you could find it, I could open the vault and get the bell."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:37
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1728
msgctxt "npc conversation"
msgid "Without the Third Eye, I can’t get into the vault to get you the bell that will release Archibald.  He must have hidden it near the castle, because he used to just go right outside and fetch it whenever he needed to open the vault."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:38
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1729
msgctxt "npc conversation"
msgid "You found the Third Eye!  All right, wait here– the bell should be in the vault.  <Nicolai runs out of the throne room, returning a short while later> Ok, here it is! "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:39
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1730
msgctxt "npc conversation"
msgid "I hope you know what you're doing.  Everyone says my uncle is quite treacherous."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:41
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1732
msgctxt "npc conversation"
msgid "Now wait just a minute Tanir, and I’ll make it worth your while to let me…Oh. <Archibald is silent for a long while> I guess I have you people to thank for releasing me from my prison of stone.  Thank you!  You say you need a spell that I've created?  <reaching to the shelves and removing a library scroll> Well, as a reward, I’ll give you the Ritual of the Void.  Use it in good health.  Now, I’m sure you’re very busy, as am I…<Archibald waves his arms and fades away>"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:42
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1733
msgctxt "npc conversation"
msgid "Thank you for rescuing me from the clutches of those ruffians!  Oh, I wish there was some way for me to reward you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:43
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1734
msgctxt "npc conversation"
msgid "Mine is the traditional duty to oversee the, um, less than upright business in the Kingdom.  My House has done this for centuries under the philosophy that such business will always exist and is better watched and regulated than not.  Recently, a man styling himself the 'Prince of Thieves' has begun to usurp my authority in Free Haven.  Not only does he challenge my authority, he cooperates with that loathsome new cult that’s sprung up recently…what’s it called?  Moo, or Yak, or Bark…no…whatever.  Some sort of animal sound.  Anyway, my sources tell me that this cult plots to overthrow the King and assume power in Enroth.  This is a bad business, and needs to be stopped.  You can start by arresting the Prince of Thieves and returning him to me in chains.  I will, of course, reward you richly.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:45
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1736
msgctxt "npc conversation"
msgid "I have no information on his whereabouts, so it will do you no good to talk to me about it.  Try going to Free Haven and asking around.  He must have a hideout somewhere in or near that town.  <Smiling> if you find where he’s living, be sure to check under the bed and in the closet– you’ll probably find him hiding under a pile of clothes."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:46
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1737
msgctxt "npc conversation"
msgid "Ah!  My friends, you have returned with the package!  Well done!  Here is your reward money.  You have my full support at the council. <looking at the Prince> Welcome to my humble home, mighty Prince.  I have a room prepared just for you.  Guards!  Take him away."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:47
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1738
msgctxt "npc conversation"
msgid "Your work in capturing the Prince of Thieves has been quite beneficial to me.  You have my full support on the High Council."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:48
msgctxt "npc conversation"
msgid "In addition to my duties as overseer of unlicensed business, I am the High Priest of Enroth.  It is my job to promote clerics to priests, and if warranted, priests to high priests.  Right now, the rolls are full of priests, and I am unable to promote new ones without creating new positions.  To do so would be highly irregular, but if someone were to perform an extraordinary service for the kingdom, the promotion would be acceptable.  <Rubbing his temples> Come to think of it, there is a service I need.  A temple in Free Haven was destroyed by fire a few months ago.  If you could get it rebuilt, I would have a reason to promote any clerics among you to priest status.  Since I really want this job done, I am even willing to promote non-priests to an honorary priest status, and I will pay you well for your service.  You’ll need to hire a stonecutter and a carpenter and show them the temple you want them to work on."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:49
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1740
msgctxt "npc conversation"
msgid "The temple I asked you to rebuild still stands in ruins.  The people are deprived of their rightful religious solace, and you return to me empty-handed.  Leave here and complete your mission!  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:50
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1741
msgctxt "npc conversation"
msgid "Excellent work!  The temple has been rebuilt and the affront to the gods eased.  For this service, I am happy to promote all clerics to priests, and I grant honorary priest status to all non-clerics.  Congratulations! "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:51
msgctxt "npc conversation"
msgid "It seems a bit quick to promote anyone to high priest, given that the promotion to priest has been so recent.  Why, many wait their entire lives to receive such a promotion, only to be granted it posthumously.  However, an extraordinary service could possibly accelerate that promotion to, well, right now for instance… and I do have such a service in mind.  The heretical monks that live on the islands east of Free Haven have stolen our sacred chalice.  Retrieve it from the monks and put it in the temple you rebuilt.  Then return to me."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:52
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1743
msgctxt "npc conversation"
msgid "The monks still have the chalice, and our temple is still without it.  Why do you delay?"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:53
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1744
msgctxt "npc conversation"
msgid "I see that you have recovered the chalice!  Good work, but you still need to ensconce it in the temple.  Take it there at once and return to me for your promotion!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:54
msgctxt "npc conversation"
msgid "You are successful!  It looks like I will have to keep my promise and make more irregular, early promotions.  I do so with pleasure.  I hereby promote all priests to high priests, and all honorary priests to honorary high priests"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:55
msgctxt "npc conversation"
msgid "Though your rise to high priest status was almost unseemly quick, I have never seen finer high priests in all my years.  I am grateful for all you've done for myself and for Enroth."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:56
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1747
#, python-format
msgctxt "npc conversation"
msgid "This is %s, the month of %s.  Journey to the Shrine of %s and pray there to be rewarded."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:57
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1748
msgctxt "npc conversation"
msgid "You must wait until the new month to undergo a pilgrimage."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:58
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1749
msgctxt "npc conversation"
msgid "performed daring deeds"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:59
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1750
msgctxt "npc conversation"
msgid "What have you lost?"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:63
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1754
msgctxt "npc conversation"
msgid "I sometimes have the worst trouble trying to remember things I’ve learned.  I’m not sure why this is, but I’ve discovered a way around the problem.  I am going to create a mirror that will allow me to look back in time, so that I can remember what it is I’ve forgotten.  To do this, I need the Hourglass of Time, but my duties and research prevent me from searching for the hourglass on my own.  The hourglass is said to be in a dark cavern up near area… <pauses a moment>  No, that was the Spear of Darkness…  where is the hourglass?  <pauses again>  I should be able to remember this.  <snaps his fingers>  Of course!  It’s buried in an old fort to the south of here.  I can offer you my support in the council if you will help me in creating my mirror."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:64
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1755
msgctxt "npc conversation"
msgid "Did you forget where the way out is?  I sometimes do.  I think it’s the large doors behind you.  Or is that the kitchen?  In any case, I’m sure the hourglass isn’t here, I would have found it by now if it was."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:65
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1756
msgctxt "npc conversation"
msgid "I’m still looking for the mirror. <pauses> I mean Hourglass… I keep getting those mixed up.  Did you try the dark cavern– no wait, it was the old fort south of here.  I always seem to mix those up."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:66
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1757
msgctxt "npc conversation"
msgid "Now all I have to do is remember how to create the mirror.  I wrote down all the important parts so I wouldn’t forget how to do it.  <stops> Where did I put those notes?  <ponders for a minute> I must have left them somewhere obvious, maybe in the laboratory.  Anyway, your part in this is done, and again I thank you.  You will have my complete support in the council for this.  What were your names again? "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:67
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1758
msgctxt "npc conversation"
msgid "The hourglass wasn’t there?  Oh, that’s right!  I knew I forgot something!  The key is in there!  You use the key to open the Forge of… <pauses>  Well, I can’t remember whose forge it is, but that is the resting place of the Hourglass of Time...I think.  It can’t hurt to look there, especially now that you’ve found the key.  <pauses>  At least I THINK that’s what the key opens.  Anyway, that forge or laboratory or whatever it is can be found on the islands north of New Sorpigal.  Good Luck!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:68
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1759
msgctxt "npc conversation"
msgid "Thanks again for getting the hourglass for me!  If only I could remember where I put it.  <sighs>  You have my support in the council for as long as you need it."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:69
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1760
msgctxt "npc conversation"
msgid "I am the magus in charge of training and promoting sorcerers.  Though powerful, sorcerer is not the pinnacle of the elemental magician.  Wizards take the knowledge and ability of a sorcerer, and hone those abilities to a sharper level.  They have greater magical potential than the sorcerer, and demand greater respect.  The way to earn this training, however, is not easy.  Find the Fountain of Magic, drink from its waters, and return here.  If you are able to do this, I will train you in the ways of the wizard."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:70
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1761
msgctxt "npc conversation"
msgid "I am the magus responsible for  the promotion of sorcerers.  Though none of you are sorcerers, I’m a fair man.  If you are able to locate the Fountain of Magic, I’ll grant you honorary wizard status.  You won’t receive any benefits of the wizards’ training, but you will gain more respect in the eyes of sorcerers and wizards.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:71
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1762
msgctxt "npc conversation"
msgid "Don’t ask me for hints, I’ve already forgotten where the Fountain is.  I know this isn’t an easy task, but if it were not difficult, every sorcerer would already BE a wizard."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:72
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1763
msgctxt "npc conversation"
msgid "You have done well in finding the Fountain.  It’s location and powers are a secret, do not spread its location around.  Now, let me show you the secrets of the wizard."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:73
msgctxt "npc conversation"
msgid "Your training does not end with what you have learned as a wizard, one final step remains.  Arch mage status completes your mastery of elemental magic.  Building on your wizard training, arch mages have vast magical ability– the most efficient and skilled use of magic anywhere.  Earning this training requires a powerful artifact, owned by the powerful Arch Mage Drael-.. no, it was Frundir-… no, that’s not right either.  Actually, I can’t seem to remember what the artifact was or who owned it.  I'd remember it if I saw it, though.  I know it can be found in Corlagon’s Estate near the Mire of the Damned.  Search for it there and return it; I must have it to train you to become an arch mage."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:74
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1765
msgctxt "npc conversation"
msgid "I’m sorry, but I still haven’t remembered exactly what it is you need.  I know you need to search Corlagon’s Estate.   "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:75
msgctxt "npc conversation"
msgid "Great news!  I remember what you need to find!  The Crystal of Terrax!  Oh, you seem to have found it already.  Well, perfect!  I can train you to arch mage, then.  The first arch mage, Terrax, used this Crystal to master the elements.  Fire, earth, water, and air all formed together to make it, and from analyzing it he learned a great deal about elemental magic.  In addition, its effect on light led him to his discoveries of light and dark magic.  Since that time, the study of this crystal has guided every new arch mage.  Let me show you the secrets of the crystal, arch magi. "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:76
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1767
msgctxt "npc conversation"
msgid "I don’t have much time to talk right now– I have a lot to do.  I’m in the process of organizing a few campaigns to attack the devils along the western coast.  You must realize, as I do, that nothing in all of Enroth poses as much of a threat to our safety as they do.  I only wish the other Lords would assist me by contributing supplies and troops, or just helping in the planning of these attacks.  They spend more time bickering amongst themselves over borders and laws and trade than in helping me deal with the REAL threat.  The devils have an advance post in Kriegspire near the Sentinels.  From here, they are able to base small raids and gather intelligence on our forces.  I need you to sneak in and attack it, find what information you can on the location of any devil strongholds and patrol patterns, and destroy the place.  Do not let any of the devils escape!  Surprise and secrecy are our greatest weapons."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:77
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1768
msgctxt "npc conversation"
msgid "Still here?  The demons are to the west, near the coast, not in my throne room!  Or are you THAT lost?  You have the information you need to complete this mission, all you need now is to go out and do it."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:78
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1769
msgctxt "npc conversation"
msgid "Did you fail in your mission?  You didn’t allow the demons to escape, did you?  That post MUST be destroyed for any large attack against them to be successful.  As long as that post exists, your mission still stands. "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:79
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1770
msgctxt "npc conversation"
msgid "Good job!  With the information you’ve brought back, we now have the intelligence we need to stage an attack on the devils, and with that post out of the way, we can hit them when they won’t expect it. I give you my full support in the council– hopefully the council will actually DO something for once."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:80
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1771
msgctxt "npc conversation"
msgid "Excellent work in dispatching those devils!  Again, you have my thanks.  My support in the council is yours, at least until the threat of the devils is past.  Hopefully you can spur the council into action.  By the way, the information that you brought back has confirmed our suspicion about the enemy base.  It is definitely near the town of Sweet Water in Paradise Valley."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:81
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1772
msgctxt "npc conversation"
msgid "I am the Armsmaster in charge of the promotion of all knights in Enroth.  Worthy knights can be promoted to cavaliers.  Cavaliers embody the spirit of action and the power of purpose.  Behind their courageous example, armies charge into battle and enemies flee in terror. However, to become a cavalier, you need to be nominated by a person of authority.  If you could get the nomination of a cavalier, that would be good enough for me.   "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:82
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1773
msgctxt "npc conversation"
msgid "I am the Armsmaster in charge of the promotion of knights.  Unfortunately, none of you are knights, and therefore the skills I would teach you would be worthless.  However, if you so desire, you can attempt the task of a would-be cavalier.  Seek the nomination of a person of authority, a cavalier, for example, and return to me."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:83
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1774
msgctxt "npc conversation"
msgid "Well there, you’re looking for a nomination to become cavaliers?  I was once a valiant knight in my day.  I fought with Roland in the Succession wars, though now I’m too old to do much good on the battlefield.  It’s good to see Osric keeping the traditions of the knights alive.  Tell him that I proudly nominate you to become cavaliers, and if he gives you any trouble tell him to come see me himself."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:84
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1775
msgctxt "npc conversation"
msgid "Congratulations!  I know you’ll make fine cavaliers.  I only wish I had my youth again to serve with Osric in a campaign against the devils."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:85
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1776
msgctxt "npc conversation"
msgid "Come now!  A person of your fame and stature should have no problem being nominated.  Don’t tell me your fame is contrived– are you sure you deserve to be as famous as you are?  <laughs>  I’m jesting, calm down.  Seriously, I'd suggest looking in Free Haven or the village of Rockham.  I've heard a few cavaliers frequent the taverns there."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:86
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1777
msgctxt "npc conversation"
msgid "Congratulations!  The nomination may not seem important, but we have a tradition that must be followed for this promotion.  As a cavalier, you need to understand that the traditions and values of the people need to be defended.  I gladly promote you to the rank of cavalier!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:87
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1778
msgctxt "npc conversation"
msgid "Ah, worthy cavaliers, the final step in your training is to become a champion.  A cavalier is a brave and noble warrior, but a champion is a power to behold.  No force can stand between the champion and victory.  Entire campaigns are decided on the bravery, decisiveness, and powerful example of the champion.  The task to complete this promotion, however, is difficult.  You must defeat a powerful enemy to prove your ability and determination.  The only enemy worthy of this task is a man known only as the Warlord, a dangerous and powerful warrior.  He commands a legion of evil knights, normally based to the northeast of  Icewind Pass.  Defeat him, bring back proof of your victory, and your promotion to champion is assured."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:88
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1779
msgctxt "npc conversation"
msgid "You’re not scared of the Warlord, are you?  His terror needs to be put to an end.  You can’t become champion hiding underneath your bed or standing around looking at the walls– you need to go out and DO it!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:89
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1780
msgctxt "npc conversation"
msgid "Good job!  Excellent!  I wasn’t sure you’d make it back alive.  Kergmond had more potential than I realized, but you’re certainly more than a match for an army of Kergmonds.  You’ve proven yourselves worthy of the rank of champion. You must not be afraid to take up arms to defend what is right.  May your enemies fear your approach and your allies rally behind your courage. And now, I promote you to the rank of champion! "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:90
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1781
msgctxt "npc conversation"
msgid ""
"Memory Crystal Alpha – Hermit’s Isle.\n"
"Memory Crystal Beta – Alamos.\n"
"Memory Crystal Delta – Darkmoor.\n"
"Memory Crystal Epsilon – Kriegspire."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:91
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1782
msgctxt "npc conversation"
msgid "Place the memory Crystals into the modules above.  All four Crystals are necessary to activate the Oracle."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:92
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1783
msgctxt "npc conversation"
msgid ""
"I am Melian, Guardian of Enroth.  Thank you for replacing my memory modules.  Archibald took them from here when I refused to give him any help in his battle for succession.  Your timing is impeccable.  The Kreegan have invaded our world, and you must try and stop them.  Unfortunately, Archibald’s attempts at extracting information from me have damaged me enough that I cannot help you directly now.  Instead, I can only give you advice.\n"
"\n"
"While most of the Kreegan can be slain with ordinary weapons and spells, the elite guards and upper echelon breeders have tougher skin and natural defenses that protect them from anything but very powerful weapons.  In the planetary control center beneath me are the weapons and armor you will need to survive battle with the enemy.  My orders, however, will only permit passage to someone with a Control Cube.  My instruments tell me that the only Control Cube left in Enroth can be found somewhere underground in Dragonsand.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:93
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1784
msgctxt "npc conversation"
msgid "You now have access to the Control Center.  Simply ask to be transported and I will oblige.  One warning however– the guardians of the Control Center are no longer under my control, so please exercise caution while visiting the Center."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:94
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1785
msgctxt "npc conversation"
msgid "As I said, the Kreegan are resistant to most of the weapons available in Enroth, but not all.  To rid the world of them, you will need to find where their vessel crashed and destroy the main reactor.  The only problem is that the resulting explosions from the reactor will destroy this planet.  You will need a powerful spell to prevent the explosion from damaging the planet, but no spell like that exists in the world today.  The only person I can think of that would know of such a spell is Archibald, but he is in no condition to teach you.  To make matters worse, the reactor cannot be harmed by normal weapons or spells– you will need the ancient weapons in the Control Center to destroy the reactor."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:95
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1786
msgctxt "npc conversation"
msgid "Though my memory has been damaged by Archibald, I can still remember the danger that our ancient enemy, the Kreegan, pose to our world.  The Kreegan first appeared roughly 1500 years ago, attacking outlying colonies and stealing their resources.  It was thought at the time they simply needed certain minerals, and could be reasoned with, but this was not the case.  Their life cycle forces them to breed until the world cannot support their numbers, then they send ships off to other worlds to renew the cycle.  Their attacks against the empire of the Ancients disrupted the network of shipping and communications that held us all together, causing the Silence that marks the first year of our modern calendar.  Without support from the homeworlds, our fledgling technology failed, bringing us to this sorry state.  I would help rebuild our technology, but I seem to have become a religious figure in the minds of many people, and very few visit me or understand what I have to offer.  Perhaps this Kreegan crisis we face will bring people to their senses--as long as we survive it."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:96
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1787
msgctxt "npc conversation"
msgid "I happen to know that you are amongst a short list of adventurers looking to receive favor from the High Council.  What you want it for I don’t know, nor do I care.  I’ll be blunt:  I love money, and I want more.  Much more.  I have a plan to fix the price of shipping in my favor for a time and I need competent agents to carry it out.  Perform this task well and I will give you my support, not to mention a lot of money.  Here is the plan:  Each of the nine shipping companies in the Kingdom must be convinced to charge at least 48 gold per pound per mile of material they transport.  They are all in competition and they know it, so none will want to make a move before the others.  I don’t care how you convince them– just get the job done and report back to me."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:97
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1788
msgctxt "npc conversation"
msgid "Not all of the companies have agreed to raise their prices!  Why do you return only to report incompetence?  There are large profits I could be reaping if you had done your job and convinced these idiots to raise their prices!  MUST I DO THIS MYSELF?  Should I send someone else?  Why do I surround myself with MORONS?!  So far I have lost a lot of gold because you haven’t finished your job!  I’ll deduct these losses from your final payment, you can be sure of that!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:98
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1789
msgctxt "npc conversation"
msgid "At last!  Thought you would never finish.  Maybe you’re good for something after all.  You have won my support in the council, and of course, your payment. "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:99
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1790
msgctxt "npc conversation"
msgid "If you're concerned about the suffering of the peasants over my price increase, don't be.  I did it all for a good cause.  I needed to raise money for granaries to store the excess grain we are harvesting this year.  The shipping prices are back down, and the availability of cheap, high quality grain more than makes up for it.  There!  I'm not so horrible, am I?"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:100
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1791
msgctxt "npc conversation"
msgid "Although it may be hard to believe, I happen to be one of the top druids in the land.  As such I am empowered to promote druids to great and arch druid status, provided they prove themselves worthy.  To be promoted to great druid status, you must perform the Ceremony of the Sun.  Pray at the center of the Circle of Stone during any equinox or solstice– March 20th, June 21st, September 23rd, or December 21st.  If you are there at that time, I will contact you magically and lead you through the Ceremony, thus promoting you to great druid.  Those among you who are not druids will be granted honorary great druid status, and I am sure the experience will be worthwhile."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:101
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1792
msgctxt "npc conversation"
msgid "You must pray at the center of the Circle of Stone during an equinox or solstice to complete the Ceremony of the Sun and be promoted to great druid.  There is nothing I can do for you to be promoted until then."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:102
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1793
msgctxt "npc conversation"
msgid "<Loretta Fleise contacts you via a telepathy spell> Welcome to the Ceremony of the Sun.  Stand ye in the circle of life and face the north while no shadows stretch before thee.  Meditate upon this truth:  “Money is everything.  I have no truer a friend than money…” <grinning> Just kidding.  Now, close your eyes, and meditate as you stand at the center of the world and time for just this one, sublime moment… <long, silent pause>  Open your eyes.  I hereby promote all druids to great druids and all non-druids to honorary druids. <Loretta fades away> "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:103
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1794
msgctxt "npc conversation"
msgid "So, you believe you are deserving of the title of arch druid.  You must complete the Ceremony of the Moon to achieve arch druid status.  This used to be rather easy before the factional split amongst the last generation of druids, but now you must fight your way to the sacred altar.  It is in the Temple of the Moon, currently controlled by the evil heretic Cedric Druthers.  There is no way they will just let you complete the ceremony peacefully, so you will probably have to fight your way in.  Like the Ceremony of the Sun, the Ceremony of the Moon must be performed at a certain place and time.  Pray at the Altar of the Moon in the Temple of the Moon at midnight during any full moon.  If you are there at that time, I will contact you magically and lead you through the Ceremony."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:104
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1795
msgctxt "npc conversation"
msgid "<Loretta Fleise contacts you via a telepathy spell> Welcome to the Ceremony of the Moon.  Stand ye before the altar of the Moon facing south.  Close your eyes and meditate upon the Circle of Seasons and the Wheel of Life.  <long, silent pause>  Open your eyes, my friends.  I hereby promote all great druids to arch druids, and all honorary great druids to honorary arch druids.  <Loretta fades away> "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:105
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1796
msgctxt "npc conversation"
msgid "You must be standing before the altar of the Moon at midnight on any full moon to complete the Ceremony of the Moon and be promoted to arch druid.  There is nothing I can do for you to be promoted until then."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:106
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1797
msgctxt "npc conversation"
msgid "The earth is wounded in the west.  I can feel it, my fellow druids, and if you put your hand to the ground and listen with your heart, you'll feel it, too.  I am bound here with my responsibilities, but I urge you to investigate the source of this pain.  I am sure the wound and the Night of Shooting Stars are related.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:107
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1798
msgctxt "npc conversation"
msgid "I grow tired of winter.  In my lands, winter seems to last year round.  As a matter of fact, for the last few years, summer didn’t arrive at all.  I have come to believe that something is wrong with the weather, and I want something done about it.  I know your reputation, and I hear you can do anything.  I have a deal for you.  End the winter in my land and I will give you my support in the High Council when it comes time for you to ask for it.  If it's any help at all, I hear there is hermit on a mountaintop somewhere west of here who has studied the weather in detail."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:108
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1799
msgctxt "npc conversation"
msgid "Do you think you could hurry this miracle thing along?  The snow on the ground is building up, and we are going to have to start putting buildings on stilts!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:109
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1800
msgctxt "npc conversation"
msgid "I was looking out my window when the weather broke and the snow vanished!  A miracle!  A genuine miracle!  You have done my people and me a great service.  <Slapping his chest> Count Erik Von Stromgard as your friend forever!  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:110
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1801
msgctxt "npc conversation"
msgid "For your services, I grant you my favor in the High Council!  Long may you live, O enemies of Winter!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:111
msgctxt "npc conversation"
msgid "20 years ago, I won the annual archery competition held at Castle Ironfist, and I have held the championship ever since.  This gives me the right to promote archers to the title of battle mage and warrior mage as I see fit.  I’ll grant the title of battle mage to all the archers amongst you if you do me a little favor. I need the key to the old Dragon Towers set up near every major settlement in Enroth to shoot down flying creatures.  I think that they can be set to shoot down only monsters, instead of shooting anything flying through the air. Since this is something of a pet project, I will reward honorary battle mage status to the rest of you.  The key is in my old keep near the southern entrance to my lands.  I had to leave it there when the ogres and their companions took it from me a few years ago.  Return with that key and be rewarded.  And I won’t be crying in my beer if you kill a lot of those monsters while you’re at it.  They took my keep!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:112
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1803
msgctxt "npc conversation"
msgid "No key—No reward.  Our deal is simple and straightforward.  Fetch the key from my old keep and return once you have it.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:113
msgctxt "npc conversation"
msgid "Very good!  You got the key, and hopefully slew a large number of those loathsome beasts.  I hereby promote all archers to the status of battle mage, and all non-archers to honorary battle mage."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:114
msgctxt "npc conversation"
msgid "The reason I wanted the key was to open the Dragon Towers and make the adjustments to prevent them from shooting flyers indiscriminately.  There is a way to adjust the towers to shoot at only large objects, and I want all of them adjusted for the good of the Kingdom.  Magic is becoming more common, as are stories of young Sorcerers getting shot from the sky because they didn’t know the function of the towers.  You have the key.  If you adjust all of the towers to shoot at only large objects, I will promote all battle mages amongst you to warrior mages and promote any honorary battle Mages to honorary warrior mages."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:115
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1806
msgctxt "npc conversation"
msgid "Hmm.  Not all of the towers have been reset.  They are easy to find, if a bit long in getting to.  The easiest is in Whitecap to the west of us."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:116
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1807
msgctxt "npc conversation"
msgid "You’ve had a measure of success in resetting the towers, I see, but the job isn’t done yet.  There are still towers unadjusted.  Finish what you’ve started and return to me to receive your reward."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:117
msgctxt "npc conversation"
msgid "I knew my faith in you was well placed!  You have fixed a major problem in our kingdom, not to mention doing yourself a favor—It’s now safe to fly above towns.  It is my pleasure to promote all battle mages to warrior mages, and all honorary battle mages to honorary warrior mages.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:118
msgctxt "npc conversation"
msgid "Welcome, warrior mages!  You may warm yourself by my hearth any time!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:119
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1810
msgctxt "npc conversation"
msgid "I like it up here.  It’s as though I can watch the world turn from up high and all alone.  Serene.  Untouchable.  Almost…Prophetic.  I can see the clouds churn and travel, break apart and mix together.  I can predict the weather almost perfectly.  <Smiling> Right now, I predict more snow."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:120
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1811
msgctxt "npc conversation"
msgid "So, Stromgard needs a miracle with the weather, eh?  All this time I thought he was the one responsible for making it snow continually.  I can break the enchantment on the weather easily, and if you hurry back to him, I’m sure you can claim responsibility."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:121
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1812
msgctxt "npc conversation"
msgid "As grateful as I am for your company, I am, in fact, a hermit.  I'm sure you have plenty of important things to do and don't need to be cluttering up my house any longer."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:122
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1813
msgctxt "npc conversation"
msgid "Well met, champions!  Please, don’t waste your valuable time or mine in times like this.  Use your skills for the good of Enroth and leave me to my planning!  When this battle is over, THEN we can share tales of valor and skill."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:123
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1814
msgctxt "npc conversation"
msgid "Hello there!  Are you here to tile the floors?  Oh!  Sorry, for a moment I forgot who you were!  Welcome again, arch mages!  Perhaps you can assist me in an experiment or two when you’re less busy?"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:124
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1815
msgctxt "npc conversation"
msgid "I am only allowed to vote on the issues that Lord Temper specifically instructs me on.  Garner his approval, and on his recommendation, I will vote in your favor."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:125
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1816
msgctxt "npc conversation"
msgid "Osric has instructed me to vote for your cause.  I give you my full support in his name."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:126
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1817
msgctxt "npc conversation"
msgid "Lady Fleise could not possibly care less about your problems and I will therefore not even consider your request."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:127
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1818
msgctxt "npc conversation"
msgid "You have my vote, in Loretta’s name, to visit the Oracle."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:128
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1819
msgctxt "npc conversation"
msgid "Lord Stone has not authorized me to vote in your behalf.  You will need to take this matter up with him."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:129
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1820
msgctxt "npc conversation"
msgid "Anthony backs your request to visit the Oracle, and I give you my vote on his behalf."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:130
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1821
msgctxt "npc conversation"
msgid "I cannot vote on matters that do not concern Lord Stromgard.  Until you have his backing, I cannot vote for you."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:131
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1822
msgctxt "npc conversation"
msgid "I vote for you to visit the Oracle, as instructed by Eric von Stromgard himself."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:132
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1823
msgctxt "npc conversation"
msgid "Until I receive favorable word from Lord Newton on your request, I cannot give you my backing."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:133
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1824
msgctxt "npc conversation"
msgid "Albert has given me permission to back your request to visit the Oracle. "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:134
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1825
msgctxt "npc conversation"
msgid "You have not adequately demonstrated your loyalty to my liege, Lord Humphrey, and I cannot give you my vote."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:135
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1826
msgctxt "npc conversation"
msgid "As long as I am a member of this council, you will not be permitted to visit the Oracle.  I am not convinced of your sincerity and will not grant your request."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:136
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1827
msgctxt "npc conversation"
msgid "Do not believe you have won!  Soon the Iron Fist will lose its grip, and I will be your king!  And you can be sure I won't forget you…"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:137
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1828
msgctxt "npc conversation"
msgid "Curses!  Foiled again!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:138
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1829
msgctxt "npc conversation"
msgid "Well, If Loretta's got a new scheme, count me in!  But you better get all the other companies to sign up!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:139
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:125
#: mm8/Data/10LocLANG.EnglishT/npctext.txt.py:125
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:125
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1063
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1830
msgctxt "npc conversation"
msgid "You're already a member of this guild."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:140
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:101
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1039
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1831
msgctxt "npc conversation"
msgid "I am the one you need to speak with in order to join the Guild of the Elements.  The cost to join is 100 gold pieces.  Only members may purchase spells from our fine library.  The guild has spells from all four of the elemental disciplines, and like all guilds in the kingdom, we have two guild halls.  Membership in one automatically enrolls you in the other."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:141
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:102
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1040
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1832
msgctxt "npc conversation"
msgid "It is my sacred duty to accept donations for the Guild of the Self.  If you contribute 100 gold pieces, we will grant you guild member status.  Members are permitted to buy spells from any Guild of the Self in the land."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:142
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1833
msgctxt "npc conversation"
msgid "Pssst…Wanna buy membership in the Buccaneers' Lair?  We have two chapter houses in the kingdom, and we support our members by teaching them certain valuable skills.  I'm sure you know what I mean.  All we want is 25 gold pieces, and our services are at your disposal."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:143
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1834
msgctxt "npc conversation"
msgid "Hi.  I'm the guild recruiter for Protection Services, a 'special' guild sanctioned by Lord Anthony Stone to sell protection to merchants, whether they want it or not.  But we aren't all thugs– we offer legitimate services and classes, too.  Membership in the Protection Services Guild costs 50 gold, and entitles you to buy classes in any skill we teach."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:144
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1835
msgctxt "npc conversation"
msgid "The Smugglers' Guild doesn't just run contraband goods past customs inspectors– it offers schooling in all the skills a smuggler needs to excel in his chosen profession.  All our members get access to the finest teachers in the business.  All we ask is a one time guild membership fee of 50 gold pieces."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:145
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1836
msgctxt "npc conversation"
msgid "HEY!  The Blades' End mercenary's guild wants YOU– provided you're willing to pay a small fee to join.  For 25 gold pieces, we'll give you access to teachers for many of the skills a good sword for hire needs to succeed.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:146
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1837
msgctxt "npc conversation"
msgid "The Duelists' Edge mercenary guild offers valuable teachings in all the skills that a warrior on the go needs to know.  For a one time fee of 50 gold, we'll give you access to not just one of our fine guild halls, but BOTH of them.  Remember, ours is the only guild that teaches the valuable repair skill."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:147
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1838
msgctxt "npc conversation"
msgid "The only way to get someone to teach you how to properly wear plate armor, short of a four year stint in the Iron Army, is to join the Berserkers' Fury mercenary guild.  We teach many other skills as well, so our modest fee of 50 gold pieces to join for life is really cheap."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:148
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1839
msgctxt "npc conversation"
msgid "If you already have membership in the Guild of the Elements, I'm sure you've found that their 'fine library' doesn't measure up to your exacting standards.  That's why I urge you to pay your dues at the Guild of Air.  Since we concentrate on air magic, you're more likely to find what you're looking for.  And the price is low, too!  Just 50 gold for a lifetime membership."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:149
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1840
msgctxt "npc conversation"
msgid "Membership in the Guild of Earth will give you access to our excellent library of earth spells.  Like all the spell guilds, we have two guild houses, and membership in the one automatically enrolls you in the other.  The cost to join is but 50 gold pieces."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:150
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1841
msgctxt "npc conversation"
msgid "You may have noticed all the monsters and hostile people running around the kingdom lately.  Defending yourself can be tough with the simple spells the Guild of the Elements teaches to its members.  What you need is fire power!  The Guild of Fire has the most destructive spells short of dark magic known to man.  50 gold pieces gives you access to our excellent library."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:151
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1842
msgctxt "npc conversation"
msgid "Membership in the Guild of Water gives you the right to buy our spells of change and movement.  It's my job to recruit new members and collect membership dues from them.  The price is 50 gold, and that includes membership in both our initiate and adept guild halls."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:152
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1843
msgctxt "npc conversation"
msgid "I am the guild recruiter for the Guild of Body.  We are aware that many people think the simple healing spells available at the Guild of the Self are adequate, but we assure you they're not.  If you join our guild, you'll have the opportunity to purchase much more effect Body magic spells.  The cost is 50 gold pieces."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:153
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1844
msgctxt "npc conversation"
msgid "The greatest mind magic spells cannot be found in the Guild of the Self– they can only be found at the Guild of the Mind.  I am empowered to sell membership to the Guild of the Mind for 50 gold pieces.  We have two guild halls, and membership in either is one and the same."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:154
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1845
msgctxt "npc conversation"
msgid "When death strikes, often the measures an individual takes to prevent financial loss to the grieving family are inadequate, resulting in devastating burial costs.  The best way to prevent these costs is to invest in a Raise Dead or Resurrection spell purchased by the friendly folks at the Guild of Spirit Magic.  Yes, members enjoy full access to our luxurious and well stocked libraries for a small one time charge of 50 gold.  Act now and set your mind at ease!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:155
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1846
msgctxt "npc conversation"
msgid "Light magic represents the most powerful magic a person can wield without cost to his soul.  Unavailable anywhere else in the kingdom, we feel confident our price of 1000 gold pieces for guild membership is fair."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:156
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1847
msgctxt "npc conversation"
msgid "I know what you want– power.  You're tired of half-hearted spells that nick and cut your enemies but do no real damage.  Let me introduce you to the Guild of Dark.  Our spells are the strongest in the land, plain and simple.  Membership in our guild costs but 1000 gold."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:157
#: mm7/DATA/10LocLANG.events/NPCTEXT.TXT.py:112
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1050
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:1848
msgctxt "npc conversation"
msgid "Join the Elemental Guild for 100 gold"
msgstr ""

