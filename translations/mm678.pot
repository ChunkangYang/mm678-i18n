#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:4 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:2
msgctxt "items"
msgid "Produced in great numbers, these slightly overbalanced swords are the arms of militiamen across the land."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:5 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:3
msgctxt "items"
msgid "Trollish War Sword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:5 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:3
msgctxt "items"
msgid "Though of primitive craftsmanship, the great weight of this weapon's blade gives it excellent striking power."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:6 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:4
msgctxt "items"
msgid "Dark Elven Longsword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:6 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:4
msgctxt "items"
msgid "The weapon of a merchantman from the Dark Elven city of Alvar. It's wavy edged blade holds a good edge."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:7 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:5
msgctxt "items"
msgid "Templar's Sword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:7 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:5
msgctxt "items"
msgid "A sword for a true swordsman. Its lack of ornamentation bespeaks of the singular purpose of its design."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:8 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:6
msgctxt "items"
msgid "Champion's Sword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:8 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:6
msgctxt "items"
msgid "These are made exclusively for members of the Erathian Order of the Blade. Since by tradition they are buried with their fallen wielders on hallowed and guarded grounds, they are rare articles indeed."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:9 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:7
msgctxt "items"
msgid "This blade's great weight and length give its blows greater reach and damage. Otherwise, it is unexceptional in quality."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:10 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:8
msgctxt "items"
msgid "Dark Elven Bastard Sword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:10 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:8
msgctxt "items"
msgid "Often carried by Elven caravan guards, these slightly under-proportioned blades are nearly, but not quite, light enough to brandish single-handedly."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:11 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:9
msgctxt "items"
msgid "Minotaur Battlesword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:11 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:9
msgctxt "items"
msgid "Only those possessed of great strength and balance can gracefully swing these mighty blades let alone control them in the heat of combat."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:12 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:10
msgctxt "items"
msgid "Dragonning Blade"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:12 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:10
msgctxt "items"
msgid "A deep biting, perfectly balanced weapon designed for one purpose - the slaying of dragons."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:13 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:11
msgctxt "items"
msgid "Headsman's Reaver"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:13 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:11
msgctxt "items"
msgid "Crafted from purified erudine alloy and then tempered in a pool of roiling lava, this sword's practically undullable and perfectly balanced blade backs up its intimidating appearance."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:14 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:12
msgctxt "items"
msgid "Iron Broadsword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:14 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:12
msgctxt "items"
msgid "Some swordsmen swear that the soft metal of an iron sword gives them certain combat advantages. Those swordsmen never seem to be very old."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:15 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:13
msgctxt "items"
msgid "Trollish Claymore"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:15 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:13
msgctxt "items"
msgid "Though of primitive design and craftsmanship, these Troll forged weapons are effective in strong hands."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:16 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:14
msgctxt "items"
msgid "Lizardman Broadsword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:16 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:14
msgctxt "items"
msgid "The Lizardmen produce a weapon capable of giving sturdy service."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:17 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:15
msgctxt "items"
msgid "Knightly Broadsword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:17 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:15
msgctxt "items"
msgid "The weight of this sword's untapered blade would make it unwieldy if not for its exacting counterbalance."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:18 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:16
msgctxt "items"
msgid "Archangel Broadsword"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:18 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:16
msgctxt "items"
msgid "This blade of pure erudine steel can cut armor like butter and gleams with a starlight glow. There are finer swords available, but their numbers can be counted on a single hand."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:19 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:17
msgctxt "items"
msgid "Rusty Cutlass"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:19 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:17
msgctxt "items"
msgid "This weapon may once have been of some quality, though it would be hard to tell through the apparent years of corrosion."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:20 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:18
msgctxt "items"
msgid "Goblin Scimitar"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:20 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:18
msgctxt "items"
msgid "After the Gowdar Deep Goblins were wiped off the face of Jadame in the Goblin-Ogre Wars, thousands of these weapons appeared on the common market."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:21 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:19
msgctxt "items"
msgid "Issued to Regnan seamen as a basic side arm, these blades have gained a sturdy reputation."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:22 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:20
msgctxt "items"
msgid "Regnan Falchion"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:22 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:20
msgctxt "items"
msgid "The extremely forward balance of this weapon's blade gives it extra striking power, but requires great strength and skill from its wielder."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:23 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:21
msgctxt "items"
msgid "Captain's Cutlass"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:23 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:21
msgctxt "items"
msgid "Given to Regnan captains upon gaining their first command, these superior weapons help them to dominate their foes and subordinate."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:24 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:22
msgctxt "items"
msgid "Crude Dagger"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:24 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:22
msgctxt "items"
msgid "As much a cutting tool and eating implement as a weapon, this dagger of soft steel will take an edge, but will lose it through very little use."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:25 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:23
msgctxt "items"
msgid "Crystal Dagger"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:25 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:23
msgctxt "items"
msgid "These daggers are often carried by members of the Necromancers' Guild. The crystals used for the blades are found in the Shadowspire mountains. They are incredibly sharp, but have a tendency to shatter."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:26 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:24
msgctxt "items"
msgid "Merchantman's Dagger"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:26 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:24
msgctxt "items"
msgid "This dagger is a typical example of those produced by the weaponsmiths of Alvar. It is made of hardened steel and has excellent balance."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:27 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:25
msgctxt "items"
msgid "Master's Dagger"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:27 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:25
msgctxt "items"
msgid "Daggers of this quality are rare indeed. Made of erudine and rare woods, finished in gold, and set with a sizable ruby, this would be a rich man's extravagance if it were not also so effective a weapon."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:28 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:26
msgctxt "items"
msgid "Fanged Blade"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:28 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:26
msgctxt "items"
msgid "The grip on this blade has clearly been rewrapped many times. It is said that such blades were used by the first Vampires who appeared millennia before the Silence. Could this possibly be one of those ancient weapons?"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:29 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:27
msgctxt "items"
msgid "With a blade in length between sword and dagger, these weapons are meant for the knife fighter who desires a bit of extra reach. This particular weapon is of mediocre workmanship in soft steel."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:30 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:28
msgctxt "items"
msgid "Alvarian Poignard"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:30 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:28
msgctxt "items"
msgid "At many social functions in Alvar, it is deemed inappropriate to carry a sword. It is common for Elven warriors to carry a smaller blade in case things become uncivil."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:31 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:29
msgctxt "items"
msgid "Regnan Fighting Knife"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:31 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:29
msgctxt "items"
msgid "Not wishing to be encumbered by a shield, many Regnan pirate raiders fight with a cutlass in one hand and one of these shorter blades in the other."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:32 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:30
msgctxt "items"
msgid "Twilight Kris"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:32 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:30
msgctxt "items"
msgid "This wavy bladed long dagger of the best quality steel is the product of the Twilight weaponsmiths. The bat wing guard set with a blood red ruby marks it as the weapon of a Vampire."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:33 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:31
msgctxt "items"
msgid "Dueling Long Dagger"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:33 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:31
msgctxt "items"
msgid "While they present a united front to the rest of the world, there is much internal strife among the Vampires of Shadowspire. By custom, very serious differences are settled in battle using these deadly blades of exquisite craftwork."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:34 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:32
msgctxt "items"
msgid "Stone Axe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:34 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:32
msgctxt "items"
msgid "Not much more than fire-hardened sticks lashed to sharp stones, these crude implements make for poor tools and weapons."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:35 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:33
msgctxt "items"
msgid "Battle Hatchet"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:35 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:33
msgctxt "items"
msgid "Often carried by mounted knights as a secondary arm, battle hatchets are preferred by some who carry them to the exclusion to any sword."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:36 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:34
msgctxt "items"
msgid "Battleaxe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:36 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:34
msgctxt "items"
msgid "These heavy axes are meant to be carried one-handed for use against both armored and unarmored foes."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:37 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:35
msgctxt "items"
msgid "Dwarven Battleaxe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:37 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:35
msgctxt "items"
msgid "While the blacksmiths of the Jadamean Dark Dwarves are not as skilled as their Erathian counterparts, they still produce a product superior to most of what is otherwise available."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:38 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:36
msgctxt "items"
msgid "Minotaur Battleaxe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:38 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:36
msgctxt "items"
msgid "Forged by the Minotaurs for their wars with the Ogres, these axes are forged of a secret alloy formula. Their edges are difficult to dull and even harder to sharpen."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:39 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:37
msgctxt "items"
msgid "As much an implement for working wood as a weapon, this crude axe can still deliver a telling blow."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:40 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:38
msgctxt "items"
msgid "Footman's Axe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:40 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:38
msgctxt "items"
msgid "Capable of splitting armor, these two-handed axes are a favorite among soldiers facing mounted knights."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:41 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:39
msgctxt "items"
msgid "Minotaur War Axe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:41 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:39
msgctxt "items"
msgid "These two-handed axes are commonly used by Minotaurs who have the strength necessary to handle their great weight."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:42 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:40
msgctxt "items"
msgid "Elite Minotaur Axe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:42 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:40
msgctxt "items"
msgid "These axes of superior workmanship are issued only to members of The Blackened Horn, the elite warriors who guard Minotaur holy sites."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:43 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:41
msgctxt "items"
msgid "Minotaur Herdsman Axe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:43 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:41
msgctxt "items"
msgid "Minotaur herdsmen lead their troops into battle wielding these devastating war axes of superlative balance and workmanship."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:44 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:42
msgctxt "items"
msgid "Ogre Fighting Stick"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:44 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:42
msgctxt "items"
msgid "A fire-hardened and sharpened sapling studded with thorns, spears like these are used by Ogre troops for drill and basic combat training. "
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:45 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:43
msgctxt "items"
msgid "Steel Spear"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:45 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:43
msgctxt "items"
msgid "Basic spears are found stockpiled in the armories of many races, and for good reason - they are effective and deadly weapons. This particular one is of Minotaur origin."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:46 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:44
msgctxt "items"
msgid "Elven Long Spear"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:46 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:44
msgctxt "items"
msgid "The fine craftsmanship and balance of this alloy steel headed spear mark it as the work of the weaponsmiths of Alvar."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:47 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:45
msgctxt "items"
msgid "War Spear"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:47 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:45
msgctxt "items"
msgid "This spear is built for battle. Far to heavy to be wielded by the part-time militiaman, it is built for the professional warrior who prefers the spear to other weapons."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:48 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:46
msgctxt "items"
msgid "Dragon Harpoon"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:48 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:46
msgctxt "items"
msgid "The back-barbed stalt steel head of this weapon is designed to deal grievous damage to even the most ancient of dragons. Naturally, it is the spearfighter's choice for dispatching all foes."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:49 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:47
msgctxt "items"
msgid "Improvised Voulge"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:49 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:47
msgctxt "items"
msgid "This simple poleaxe appears to have been made by attaching the blade of a farm implement to a poorly crafted spear."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:50 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:48
msgctxt "items"
msgid "A versatile weapon combining the qualities of an axe and a spear, the halberd is designed to perform in formation and individual close quarter fighting."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:51 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:49
msgctxt "items"
msgid "Beaked Halberd"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:51 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:49
msgctxt "items"
msgid "This improved halberd has a spiked blade opposite its axe face to provide both balance and a means of penetrating plate armor."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:52 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:50
msgctxt "items"
msgid "Minotaur Campaign Pole-axe"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:52 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:50
msgctxt "items"
msgid "When the Minotaurs went to war with the Frost Giants of faraway Vori, their king Balthazar commissioned this polearm to arm his troops. He reportedly said, \"Since they will be gone so long, arm them with something versatile.\""
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:53 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:51
msgctxt "items"
msgid "Labyrinth Grapple"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:53 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:51
msgctxt "items"
msgid "Minotaurs have very little tolerance for intruders in their hallowed mazes. This fact is well evidenced in the attention paid to weapons constructed for the labyrinth guards."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:54 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:52
msgctxt "items"
msgid "Hayfork"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:54 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:52
msgctxt "items"
msgid "Though a common farming implement, this hayfork is of sturdy construction and could be an excellent, if improvised, weapon."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:55 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:53
msgctxt "items"
msgid "Infantry Fork"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:55 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:53
msgctxt "items"
msgid "A highly specialized piece of equipment intended to equalize contests between foot soldiers and mounted, armored opponents, these modified spears are effective if slightly clumsy weapons."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:56 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:54
msgctxt "items"
msgid "Lizardman Trident"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:56 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:54
msgctxt "items"
msgid "The blacksmiths on the Dagger Wound Islands craft a wide variety of spearheads. This trident is one of their most unusual designs. The barbed tines cause extra damage during straight thrusting attacks."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:57 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:55
msgctxt "items"
msgid "Regnan Trident"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:57 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:55
msgctxt "items"
msgid "No Regnan ship leaves port without a cache of tridents. Boarding attacks against their galleys seldom succeed against massed walls of their erudine tines."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:58 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:56
msgctxt "items"
msgid "Triton Trident"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:58 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:56
msgctxt "items"
msgid "The first thing one notices when first handling this trident is that it is unusually cool to the touch. The second is a sense that the dragon turtle bone tines seem to seek vulnerabilities in their targets' defenses as if guided by an unseen hand."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:59 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:57
msgctxt "items"
msgid "Hunting Bow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:59 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:57
msgctxt "items"
msgid "These lightweight bows of simple construction are meant for bringing down small game animals - not for direct combat. "
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:60 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:58
msgctxt "items"
msgid "Recurve Bow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:60 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:58
msgctxt "items"
msgid "Recurved bowstaves allows an archer to pull a heavier bow than they might otherwise be able to. Greater pull weight means greater arrow speed for increase range and damage."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:61 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:59
msgctxt "items"
msgid "Snakewood Bow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:61 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:59
msgctxt "items"
msgid "The human soldiers of Enroth carry bows made from the native snakewood tree. The strong, flexible wood makes a sturdy bow."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:62 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:60
msgctxt "items"
msgid "Elven Warbow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:62 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:60
msgctxt "items"
msgid "By laminating together layers of wood, steel, and bone the bowsmiths of Alvar have created a bow of perfect balance, strength and accuracy. The process consumes a lot of time, craft and expensive materials which explains the steep price these bows command."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:63 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:61
msgctxt "items"
msgid "Devilbone Bow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:63 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:61
msgctxt "items"
msgid "Dark Elven bowsmiths have discovered that unusual characteristics of the Kreegan spinal column make it the best material for heavy bowstaves. A clever arrangement of composite pulleys make it possible for those of less than superhuman strength to pull these mighty weapons."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:64 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:62
msgctxt "items"
msgid "Light Crossbow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:64 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:62
msgctxt "items"
msgid "Because of their ease of use, crossbows like these are stockpiled in militia armories everywhere. Their low pull strength and mediocre workmanship however, make them only moderately effective."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:65 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:63
msgctxt "items"
msgid "Blood Drop Crossbow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:65 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:63
msgctxt "items"
msgid "A light crossbow of good quality, these weapons feature a grooved table, basic sights and a smooth releasing nut."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:66 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:64
msgctxt "items"
msgid "Hunting Crossbow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:66 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:64
msgctxt "items"
msgid "Built for use in the field, this medium crossbow is designed for hunting, but is equally effective as a battle weapon."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:67 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:65
msgctxt "items"
msgid "Caravaner's Crossbow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:67 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:65
msgctxt "items"
msgid "The Merchants of Alvar like to see their caravan guards well armed. This well-crafted heavy crossbow has a cranked drawing mechanism."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:68 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:66
msgctxt "items"
msgid "Regnan Crossbow"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:68 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:66
msgctxt "items"
msgid "The pirates of Regna Island have spent centuries perfecting their crossbow design. The resulting weapon has a crystal lensed sight and bowstaves of pure stalt - which would make the bow impossible to cock if not for the crank draw of erudine alloy."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:69 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:67
msgctxt "items"
msgid "A slight improvement over the common club, maces are better balanced, more durable, and deliver greater damage."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:70 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:68
msgctxt "items"
msgid "Flail"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:70 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:68
msgctxt "items"
msgid "Though evolved from the farm implement which shares its name, the flail's great reach and striking power make it a fearsome weapon."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:71 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:69
msgctxt "items"
msgid "Temple Mace"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:71 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:69
msgctxt "items"
msgid "The sunray corona circling the head of this well made mace serves as a devotional declaration for Temple of the Sun clerics; it also greatly increases the damage of its blows. "
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:72 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:70
msgctxt "items"
msgid "Reverend Sceptre"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:72 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:70
msgctxt "items"
msgid "As much a symbol of office as weapon, these finely crafted maces are carried by inner circle Sun Temple priests. Its highly decorated shaft belies the effectiveness of the gilded erudine-steel head."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:73 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:71
msgctxt "items"
msgid "Trollish War Mace"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:73 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:71
msgctxt "items"
msgid "While most races have concentrated on developing bladed weapons, the Trolls have always been content to refine the simple bludgeon. This brutal weapon forged as a single piece of stalt alloy is the finest example of their craft."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:74 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:72
msgctxt "items"
msgid "Sledgehammer"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:74 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:72
msgctxt "items"
msgid "This hammer is more a construction tool than a weapon. Still, it could deliver a telling, if clumsy, blow."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:75 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:73
msgctxt "items"
msgid "Field Hammer"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:75 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:73
msgctxt "items"
msgid "This hammer was designed as secondary infantry arm designed to finish off armored opponents who have fallen to the ground."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:76 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:74
msgctxt "items"
msgid "Warhammer"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:76 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:74
msgctxt "items"
msgid "An improved version of the field hammer, this weapon is heavier, better balanced and more durable. While it requires strength to wield, it is a terrible sight to armored and unarmored foes alike."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:77 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:75
msgctxt "items"
msgid "Sun Hammer"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:77 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:75
msgctxt "items"
msgid "Clerics of the Sun are prohibited from using bladed weapons. That they carry such fine warhammers is the natural result of this restriction. As an added measure of devotion, a reverse image of their sun symbol is embossed on the striking face."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:78 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:76
msgctxt "items"
msgid "Trollish Maul"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:78 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:76
msgctxt "items"
msgid "It is necessary to handle this weapon to appreciate its perfect grip and balance. The hammer's head is carved from a single mineral crystal. Trollish weaponsmiths spend a lifetime mastering the shaping technique to produce a head that retains incredible hardness without being shatter prone."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:79 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:77
msgctxt "items"
msgid "A wooden head and handle studded with short iron spikes, the simple club's best attribute is that it can be constructed from found materials."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:80 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:78
msgctxt "items"
msgid "Thornbark Club"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:80 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:78
msgctxt "items"
msgid "The Trolls of the Ironsand Desert make these clubs by fire-hardening the fantastically tough root wood of the thornbark tree."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:81 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:79
msgctxt "items"
msgid "Overlord's Club"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:81 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:79
msgctxt "items"
msgid "Troll tribal chieftains must win their position through trial by combat. The winner keeps his club as a symbol of office. The losers' clubs often find their way into the weapon marketplace."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:82 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:80
msgctxt "items"
msgid "Journey Staff"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:82 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:80
msgctxt "items"
msgid "Many dangers face the Jadamean traveler. Even the least battle-minded carry some sort of weapon. These iron ended walking sticks are a common choice."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:83 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:81
msgctxt "items"
msgid "Orb Staff"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:83 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:81
msgctxt "items"
msgid "This staff is topped with a head of polished turquoise to give it greater striking force."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:84 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:82
msgctxt "items"
msgid "Priestly Staff"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:84 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:82
msgctxt "items"
msgid "This finely decorated staff is the product of Lizardman craft. Wrapped with exotic leathers, and ended with a bronze footcap and striker, these staves are carried by Lizardman priests as a symbol of station."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:85 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:83
msgctxt "items"
msgid "Serpent Staff"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:85 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:83
msgctxt "items"
msgid "These rare staffs may appear unwieldy, but they are the product of sorcery. In combat they flex with animal intelligence to work in blows through their targets' defenses."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:86 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:84
msgctxt "items"
msgid "Bone Staff"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:86 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:84
msgctxt "items"
msgid "Fashioned from the spinal bones of wyverns and crowned by a dragon's lower spikeplate, these staves are the product of necromantic weaponcraft. It is unusual to find one of these deadly weapons that is not also carrying a powerful enchantment."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:87 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:85 localization/LANG_ItemsTxt.txt.py:1669
msgctxt "items"
msgid "Leather Jerkin"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:87 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:85
msgctxt "items"
msgid "This armor of thick, supple leather studded with brass offers minimal protection against blows."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:88 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:86
msgctxt "items"
msgid "Hardened Leather Vest"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:88 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:86
msgctxt "items"
msgid "This item of leather armor has been hardened to offer increased protection. It is comfortable and light though offers little coverage."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:89 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:87
msgctxt "items"
msgid "Caravaner's Leather"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:89 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:87
msgctxt "items"
msgid "This is the type of armor worn most often by those guarding Alverian merchant caravans. A hardened and internally braced breastplate covers an undersuit of tough but supple hide, offering the wearer full body protection with a minimal hampering of movement."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:90 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:88
msgctxt "items"
msgid "Though seemingly too thin to offer solid protection, this armor of Regnan design holds a subtle enchantment which makes the leather nearly steel tough. Additionally, a secret process makes the suit resistant to salt water corrosion."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:91 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:89
msgctxt "items"
msgid "Alvarian Leather"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:91 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:89
msgctxt "items"
msgid "Leather armor sets of this quality are of the finest produced by the Alvarian Armorers' Guild. The stalt-alloy edged panels are virtually inpenetrable; their clever interlockings give the wearer excellent freedom of movement."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:92 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:90
msgctxt "items"
msgid "Rusty Mail Vest"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:92
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:93
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:94
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:95
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:96
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:517 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:90 localization/LANG_ItemsTxt.txt.py:91
#: localization/LANG_ItemsTxt.txt.py:92 localization/LANG_ItemsTxt.txt.py:93
#: localization/LANG_ItemsTxt.txt.py:94 localization/LANG_ItemsTxt.txt.py:515
msgctxt "items"
msgid "Chainmail"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:92 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:90
msgctxt "items"
msgid "This corroded ring mail vest has seen better days. It has been field repaired in many places and even has a large patch of thinner mail salvaged from a piece of chain cowl."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:93 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:91
msgctxt "items"
msgid "Steel Chainmail"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:93 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:91
msgctxt "items"
msgid "Constructed of strong steel this is the type of armor worn by the rank and file foot soldiers of many armies."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:94 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:92
msgctxt "items"
msgid "Minotaur Chainmail"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:94 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:92
msgctxt "items"
msgid "Of a design originally created by the Minotaurs for their Vori campaigns, this type of chainmail, with its good coverage and fine construction, has proven popular among other races. Now the armorsmiths of Bathazar Lair construct it in sizes for any with ready gold to spend."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:95 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:93
msgctxt "items"
msgid "Siertal Chainmail"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:95 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:93
msgctxt "items"
msgid "The Alvarian Dark Elves guard their siertal-alloy formula carefully. Chainmail made from this metal is both light and capable of turning the hardest blades."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:96 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:94
msgctxt "items"
msgid "Erudine Chainmail"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:96 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:94
msgctxt "items"
msgid "Another master product of the Alvarian Armorers' Guild, this hybrid suit of plate and mail is made of siertal-alloy finished erudine with an attention to craftsmanship worthy of the precious materials."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:97 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:95
msgctxt "items"
msgid "Rusty Breastplate"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:97 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:95
msgctxt "items"
msgid "This piece of plate armor salvaged from a larger suit is so corroded it is a question whether it is equipment for a warrior or junk for the scrap man."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:98 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:96
msgctxt "items"
msgid "Banded Plate"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:98 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:96
msgctxt "items"
msgid "Bands of steel cover the mid-torso of this chain and plate chest armor. While lighter and simpler to construct than continuously formed plate, this armor offers less protection than heavier plate."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:99 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:97
msgctxt "items"
msgid "Minotaur Plate"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:99 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:97
msgctxt "items"
msgid "An example of the work produced by the Minotaur armorers of Balthazar Lair, this plate armor provides excellent mid-section protection. The arms are left free in the Minotaur-style."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:100 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:98
msgctxt "items"
msgid "Dark Knight Plate"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:100 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:98
msgctxt "items"
msgid "Though lined with felt and red velvet, and decorated with enamel and gilding, this armor is no showpiece. The siertal-alloy plates are light, but tough enough that they must have been worked with tools with erudine working faces."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:101 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:99
msgctxt "items"
msgid "Dragoning Plate"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:101 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:99
msgctxt "items"
msgid "The technique for making plate armor of erudine sheets is not known on Jadame. In fact, it is only produced by the master armorer, Derrick Goreth of Erathia who spent a lifetime constructing his famed White Light Forgeworks."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:102 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:100
msgctxt "items"
msgid "Trollish Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:102 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:100
msgctxt "items"
msgid "A simple wooden shield of Trollish make, the design is often copied by apprentice armorsmiths just learning their craft."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:103 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:101
msgctxt "items"
msgid "Thornbark Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:103 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:101
msgctxt "items"
msgid "Made from thornbark tree heartwood and rimmed with iron, this shield is sturdy, if a bit heavy."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:104 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:102
msgctxt "items"
msgid "Regnan Tournament Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:104 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:102
msgctxt "items"
msgid "Every ten moons, the Regnans hold a great festival which includes a tournament of arms. The noble class contestants spare no expense in the commissioning of shields that are light, but tough enough to shelter them from harm."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:105 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:103
msgctxt "items"
msgid "Veteran Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:105 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:103
msgctxt "items"
msgid "In the Demon Wars of Erathia, the Humans found that only erudine armor was proof against the fiery attacks of their foes. Bit by bit, pieces of this armor - like this shield - have made their way to Jadame."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:106 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:104
msgctxt "items"
msgid "Dragon Hunter's Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:106 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:104
msgctxt "items"
msgid "The town of Kriegspire in Enroth had a problem with Dragons. These shields were their answer. Magically bound layers of erudine, stalt-steel and hydra leather, make a nearly unbreakable material resistant to most Dragon breath weapons."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:107 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:105
msgctxt "items"
msgid "This small shield is gripped in the off-weapon hand. The wielder is much dependent on agility to make use of its scant defensive coverage."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:108 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:106
msgctxt "items"
msgid "Caravaner's Small Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:108 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:106
msgctxt "items"
msgid "Caravan guards traveling Merchant of Alvar trade routes must often cover long distances on foot. This shield, like the rest of their equipment is well made and lightweight."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:109 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:107
msgctxt "items"
msgid "Calvary Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:109 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:107
msgctxt "items"
msgid "A favorite among mounted knights, these steel shields are strong enough to turn aside the points of pikemen."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:110 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:108
msgctxt "items"
msgid "Death Head Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:110 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:108
msgctxt "items"
msgid "The Necromancers' Guild likes to arm its undead armies well. Their elite infantry carry these erudine alloy shield of great strength."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:111 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:109
msgctxt "items"
msgid "Eldritch Shield"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:111 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:109
msgctxt "items"
msgid "There are only twelve of these shields in known existence. Their bodies are made of an alloy that appears to seethe with the color of coal fire. Their rims are made of another unknown metal that is soft enough to catch blades, but doesn't gouge or scratch."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:112 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:110
msgctxt "items"
msgid "This cap of soft iron and unhardened leather provides a small measure of protection from blows to the head."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:113 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:111
msgctxt "items"
msgid "Lizardman Helm"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:113 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:111
msgctxt "items"
msgid "Iron and leather helms of this sort are produced by blacksmiths everywhere. This one is of Lizardman manufacture and sports genuine ram horns."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:114 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:112
msgctxt "items"
msgid "Steel helms of this design are commissioned in large numbers by the Merchants of Alvar who issue them to mounted caravan guards."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:115 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:113
msgctxt "items"
msgid "Battle Helm"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:115 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:113
msgctxt "items"
msgid "This full helmet is of superior materials and workmanship. The structurally weaker areas around the eye and nose slits are reinforced with siertal."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:116 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:114
msgctxt "items"
msgid "Dragon Helm"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:116 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:114
msgctxt "items"
msgid "The faceplate of this superior helmet hinges on nearly invisible seams so that when closed it provides a snug fit and full face coverage. Only the most well-aimed blows have a chance of penetrating through."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:117 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:115
msgctxt "items"
msgid "A loose fitting hat made of sturdy cloth."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:118 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:116
msgctxt "items"
msgid "Festival Hat"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:118 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:116
msgctxt "items"
msgid "Hats decorated with cheap glass gems are worn by Regnans on festival occassions--of which they have many."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:119 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:117
msgctxt "items"
msgid "Merchantman's Hat"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:119 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:117
msgctxt "items"
msgid "This pleated cap of velvet, lined and edged with black rabbit fur is decorated with a small enameled medallion. "
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:120 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:118
msgctxt "items"
msgid "A simple belt of cured leather. It is decorated with iron studs and closes with a pinned hasp."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:121 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:119
msgctxt "items"
msgid "Sturdy Belt"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:121 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:119
msgctxt "items"
msgid "A thick leather belt. The studs and buckle are made of brass."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:122 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:120
msgctxt "items"
msgid "Wyvern Leather Belt"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:122 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:120
msgctxt "items"
msgid "Wyvern leather is very tough and difficult to obtain. It is prized by Shadowspire leathercrafters because it becomes black when tanned--a color favored by their vampire and necromancer clientele."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:123 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:121
msgctxt "items"
msgid "Steel Belt"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:123 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:121
msgctxt "items"
msgid "This well crafted belt is made of enameled steel. It has two cleverly concealed side hinges and has a latching clasp in back."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:124 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:122
msgctxt "items"
msgid "Artificer's Belt"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:124 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:122
msgctxt "items"
msgid "Finely crafted belts of dragon leather are made to hold enchantments. This one is worked in gold and circled by thin bands of siertal."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:125 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:123
msgctxt "items"
msgid "Traveler's Cloak"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:125 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:123
msgctxt "items"
msgid "This warm cloak of dyed wool also offers a small amount of protection from weapon attacks."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:126 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:124
msgctxt "items"
msgid "Moon Temple Cloak"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:126 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:124
msgctxt "items"
msgid "The blue dye used to color the glove leather cloaks worn by Moon Temple clerics is derived from the frond petal flowers which grow only in the Mount Nighon region of Erathia."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:127 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:125
msgctxt "items"
msgid "Alvar Cloak"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:127 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:125
msgctxt "items"
msgid "Made in Alvar, cloaks of this quality are often seen on the shoulders of the more wealthy members of the Alvarian Merchant Guild."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:128 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:126
msgctxt "items"
msgid "Necromancer Cloak"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:128 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:126
msgctxt "items"
msgid "Clearly a cloak made for a practitioner of the dark arts. This fine cloak is worked with arcane designs embroidered in darkened silver thread."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:129 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:127
msgctxt "items"
msgid "Vampire Cloak"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:129 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:127
msgctxt "items"
msgid "This high collared, jet black cloak of wyvern leather is lined in red velvet--a style much favored by the elder vampires of Shadowspire."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:130 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:128
msgctxt "items"
msgid "Leather Gloves"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:130 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:128
msgctxt "items"
msgid "These gloves of poorly cured leather are worn by workmen everywhere."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:131 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:129
msgctxt "items"
msgid "Troll Gauntlets"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:131 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:129
msgctxt "items"
msgid "These leather gloves of Trollish make are studded with iron spikes at the knuckles."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:132 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:130
msgctxt "items"
msgid "Made of hinged plates of steel, these gauntlets offer good protection, but have a tendency to pinch."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:133 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:131
msgctxt "items"
msgid "Minotaur Gauntlets"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:133 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:131
msgctxt "items"
msgid "Siertal-alloy makes these gauntlets light and tough. Superior workmanship make them comfortable and flexible."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:134 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:132
msgctxt "items"
msgid "Crusader's Gauntlets"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:134 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:132
msgctxt "items"
msgid "These gauntlets are master crafted from pure erudine marking them as the product of Derrick Goreth's White Light Forgeworks."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:135 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:133
msgctxt "items"
msgid "Walking Boots"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:135 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:133
msgctxt "items"
msgid "Built more for comfort than combat, these boots of soft leather offer good protection from mud and sharp stones, but are not meant to turn weapon blows."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:136 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:134
msgctxt "items"
msgid "Hardened Leather Boots"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:136 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:134
msgctxt "items"
msgid "The leather of these boots has been stiffened for greater protection. They are thick soled and lined with a thin layer of softer leather."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:137 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:135
msgctxt "items"
msgid "Regnan Boots"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:137 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:135
msgctxt "items"
msgid "These steel capped boots are commonly worn by Regnan warriors. The leather parts are treated to make them waterproof."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:138 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:136
msgctxt "items"
msgid "Alvarian Boots"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:138 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:136
msgctxt "items"
msgid "Made by the Alvarian Elves, these boots are internally reinforced by bands of siertal-alloy. Their soles are softer than most boots making them quieter stepping."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:139 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:137
msgctxt "items"
msgid "Dragonning Boots"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:139 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:137
msgctxt "items"
msgid "Dragon hunters require unusually hardy protective gear, their boots not excepting. These boots are constructed with erudine-alloy shells lined with wyvern leather."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:140 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:138
msgctxt "items"
msgid "Bronze Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:140 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:138
msgctxt "items"
msgid "A simple bauble of very little value."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:141 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:139
msgctxt "items"
msgid "Gold Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:141 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:139
msgctxt "items"
msgid "A ring of soft gold rendered with half-hearted craftsmanship as a means of conveniently carrying a small amount of wealth."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:142 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:140
msgctxt "items"
msgid "A silver ring set with a good quality pearl."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:143 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:141
msgctxt "items"
msgid "Gemstone Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:143 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:141
msgctxt "items"
msgid "This gold ring is decorated with a variety of tiny gems giving it a multicolored sparkle."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:144 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:142
msgctxt "items"
msgid "Amethyst Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:144 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:142
msgctxt "items"
msgid "A ring set with three amethysts. The largest is an excellent stone - richly and evenly purple with a perfect cut."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:145 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:143
msgctxt "items"
msgid "Necromatic Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:145 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:143
msgctxt "items"
msgid "Though made of semi-precious silver, this ring is highly valuable because it is well suited to holding enchantments of medium power."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:146 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:144
msgctxt "items"
msgid "Ruby Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:146 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:144
msgctxt "items"
msgid "This simply elegant ring is set with a single, oval ruby of high quality - pigeon blood red, perfectly cut and clear of imperfections."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:147 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:145
msgctxt "items"
msgid "Vampire's Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:147 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:145
msgctxt "items"
msgid "Worn only by elder Vampires of great power, it is said that a part of their life force is invested in the ring's creation. This would certainly explain their ability to hold powerful enchantments."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:148 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:146
msgctxt "items"
msgid "Sun Opal Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:148 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:146
msgctxt "items"
msgid "Sun opals shine with a mild inner light. They are extremely rare and coveted by elemental magicians."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:149 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:147
msgctxt "items"
msgid "Focal Ring"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:149 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:147
msgctxt "items"
msgid "The \"stone\" of this platinum ring is actually a tiny interplanar portal which draws power from realms beyond. The strength limit of the enchantments such rings can hold is the skill and knowledge of the enchanter."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:150 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:148
msgctxt "items"
msgid "Brass Charm"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:150 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:148
msgctxt "items"
msgid "These stamp formed and lacquered baubles are cheap trinkets sold to pilgrims as keepsake mementos."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:151 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:149
msgctxt "items"
msgid "Jade Amulet"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:151 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:149
msgctxt "items"
msgid "A large polished jade stone decorates and adds value to this simple amulet."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:152 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:150
msgctxt "items"
msgid "Blood Talisman"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:152 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:150
msgctxt "items"
msgid "Made by necromancers to hold dark magics, other sorcerers have recognized their worth for other uses."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:153 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:151
msgctxt "items"
msgid "Shadow Sect Medallion"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:153 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:151
msgctxt "items"
msgid "Formed in white and yellow gold, inlaid with jade, and studded with peridots, these amulets are worn by members of the secret Shadow Sect hidden beneath their clothing."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:154 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:152
msgctxt "items"
msgid "Locus Amulet"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:154 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:152
msgctxt "items"
msgid "The pinnacle of artificer tradecraft, these amulets wrought in platinum and set with a perfect sapphire can contain enchantments of nearly unimaginable potency."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:155 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:153
msgctxt "items"
msgid "Witch's Wand of Fire"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:155
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:153 localization/LANG_ItemsTxt.txt.py:154
#: localization/LANG_ItemsTxt.txt.py:155 localization/LANG_ItemsTxt.txt.py:156
#: localization/LANG_ItemsTxt.txt.py:157
msgctxt "items"
msgid "The primitive materials of this wand is infused with dark spiritual energy. To use this wand, you must equip it as though you were equipping a weapon."
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:156 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:154
msgctxt "items"
msgid "Witch's Wand of Sparks"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:157 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:155
msgctxt "items"
msgid "Witch's Wand of Poison"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:158 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:156
msgctxt "items"
msgid "Witch's Wand of Stunning"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:159 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:157
msgctxt "items"
msgid "Witch's Wand of Harming"
msgstr ""

#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:160 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:158
msgctxt "items"
msgid "Shaman's Wand of Light"
