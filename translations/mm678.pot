#: mm6/data/10LocLANG.icons/intro.STR.py:2
msgctxt "intro.str"
msgid "Having cheated death during the Night of Shooting Stars, you find yourself as far from your village of Sweet Water as old Falagar’s magic could take you."
msgstr ""

#: mm6/data/10LocLANG.icons/intro.STR.py:4
msgctxt "intro.str"
msgid "Three years have passed while Falagar imparted what knowledge he could to train you in your chosen professions."
msgstr ""

#: mm6/data/10LocLANG.icons/intro.STR.py:6
msgctxt "intro.str"
msgid "But the time came at last when he could teach you no more, and you have ventured into the world to seek your fame and fortune."
msgstr ""

#: mm6/data/10LocLANG.icons/intro.STR.py:8
msgctxt "intro.str"
msgid "Now, a world away from your lost home, you have stumbled across evidence of a terrible conspiracy involving a new religious cult."
msgstr ""

#: mm6/data/10LocLANG.icons/intro.STR.py:10
msgctxt "intro.str"
msgid "Five letters from King Roland to his wife Catherine, and a letter from the King of the Devils to a wicked traitor named Sulman, have turned up in an abandoned Goblin camp."
msgstr ""

#: mm6/data/10LocLANG.icons/intro.STR.py:12
msgctxt "intro.str"
msgid "Your fate seems inextricably bound to these letters and that awful Night, and your role in the events to come may be larger than anyone could imagine."
msgstr ""

#: mm6/data/10LocLANG.icons/intro.STR.py:14
msgctxt "intro.str"
msgid "The tools you have are but a small sum of gold, your wits, and a lot of potential. The roads ahead are infinite--the choices are all yours to make."
msgstr ""

#: mm6/data/10LocLANG.icons/intro.STR.py:18
msgctxt "intro.str"
msgid "Good Luck"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2375
msgctxt "npc conversation"
msgid "Good %05!  I'm %01.  Pleased to meet you!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2400
msgctxt "npc conversation"
msgid "%02, eh?  I'll remember that."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2425
msgctxt "npc conversation"
msgid "Hi.  Name's %01.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2450
msgctxt "npc conversation"
msgid "<bowing> %01, at your service."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2475
msgctxt "npc conversation"
msgid "I am %01.  What do you want?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2500
msgctxt "npc conversation"
msgid "%02.  Charmed, I'm sure."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2525
msgctxt "npc conversation"
msgid "Hello there!  A mighty fine %05, if you ask me!  I'm %01."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2550
msgctxt "npc conversation"
msgid "Peace, %06.  My name is %14 %01.  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2575
msgctxt "npc conversation"
msgid "<sigh> Yes?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2600
msgctxt "npc conversation"
msgid "What is it?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2625
msgctxt "npc conversation"
msgid "Hello friend! <making a curious gesture with thumb and nose> Baaaa! The end of the world draws nigh!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2650
msgctxt "npc conversation"
msgid "Hello! My name is %01, and I am pleased to meet you, %02."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:5
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2675
msgctxt "npc conversation"
msgid "%02.  I am pleased to make your acquaintance."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2376
msgctxt "npc conversation"
msgid "Oh, Hullo %02.  Nice %05, isn't it?  "
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2401
msgctxt "npc conversation"
msgid "%02 again.  What do you want?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2426
msgctxt "npc conversation"
msgid "How're you doin', %02?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2451
msgctxt "npc conversation"
msgid "Always a pleasure, %06 %02."
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2476
msgctxt "npc conversation"
msgid "<sigh> Back so soon?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2501
msgctxt "npc conversation"
msgid "What is it, %02?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2526
msgctxt "npc conversation"
msgid "Good to see you again!  Hahahaha!  Uhm…What did you say your name was?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2551
msgctxt "npc conversation"
msgid "A glorious %05, %02.  How may I help you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2576
msgctxt "npc conversation"
msgid "Ah, yes, %02.  Can I help you?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2601
msgctxt "npc conversation"
msgid "Back again, %02?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2626
msgctxt "npc conversation"
msgid "Ah, %16. The Signs are dark indeed, aren't they?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2651
msgctxt "npc conversation"
msgid "A fine %05, %02, is it not?"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:6
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2676
msgctxt "npc conversation"
msgid "%02.  I hope you aren't going to waste my time…"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2377
msgctxt "npc conversation"
msgid "Hey, I already said I didn't want to be seen with you.  Get lost!"
msgstr ""

#: mm6/data/10LocLANG.icons/npcbtb.txt.py:7
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2402
msgctxt "npc conversation"
msgid "My patience is at its end.  Go away and stop bothering me."
msgstr ""

