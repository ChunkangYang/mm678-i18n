msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:452
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2143
msgctxt "npc conversation"
msgid "Great to do business with you, here's your weapon!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:453
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2144
msgctxt "npc conversation"
msgid "Great to do business with you, here's your accessory!"
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:454
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2145
msgctxt "npc conversation"
msgid "I'm collecting used magic lamps, but I don't have any money.  I'll trade you some of these pretty stones for the lamps, though."
msgstr ""

#: mm6/data/10LocLANG.icons/npctext.txt.py:455
#: mmmerge/Data/10LocLANG.EnglishT/NPCText.txt.py:2146
msgctxt "npc conversation"
msgid "Thanks for the lamp!  Here are your stones."
msgstr ""

