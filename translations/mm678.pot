#: localization/LANG_ItemsTxt.txt.py:1660
msgctxt "items"
msgid "Hammer"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:58 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1658
msgctxt "items"
msgid "A graceless and unimaginative weapon, hammers are slow, but hit very hard.  This one is of common construction and materials."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:59 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1659
msgctxt "items"
msgid "Dark Hammer"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:59
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:58 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:859 localization/LANG_ItemsTxt.txt.py:1659
msgctxt "items"
msgid "A step up in construction quality, these hammers are commonly wielded by humanoid monsters.  Since everyone knows most monsters don't make weapons, the question 'from where are they getting them?' arises…"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:60 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1660
msgctxt "items"
msgid "Holy Hammer"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:60 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1660
msgctxt "items"
msgid "Magically constructed, these hammers are the property of the Church of the Moon in Karigor."
msgstr ""

