msgctxt "items"
msgid "Helm"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:92 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1692
msgctxt "items"
msgid "An ordinary helm.  This one is made of hides stretched over wood.  There's no fur or padding on the inside, so your head will probably ring like a bell when struck a solid blow."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:93 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1693
msgctxt "items"
msgid "Steel Helm"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:93 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1693
msgctxt "items"
msgid "This is a common steel helm.  The design is a good one and has been used for centuries by warriors all around the world.  Best guess is this helm is 50-75 years old."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:94 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1694
msgctxt "items"
msgid "Guardian Helm"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:94
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:93 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:894 localization/LANG_ItemsTxt.txt.py:1694
msgctxt "items"
msgid "This helm design has been used by the Elves of Erathia since before the Silence.  It is composed of silver and steel and is very strong."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:95 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1695
msgctxt "items"
msgid "Defender Helm"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:95 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1695
msgctxt "items"
msgid "Half made from the skull of the ferocious Mogred beast in Karigor, these helms grow more uncommon every year as the Mogreds approach extinction.  The red stripes around the horns of the helm are highly receptive to enchantment."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:96 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1696
msgctxt "items"
msgid "Angelic Helm"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:96 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1696
msgctxt "items"
msgid "These helms are extremely rare and no one knows where they originate, but they almost certainly come from the Time of Wonders.  An extremely fine inscription inside the helm says  'Property of Ship's Store, VARN MCMIV'."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:97
