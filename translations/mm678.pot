msgid "Greetings!  Are you here to study the arts of Sorcerey?"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:181
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:296
msgctxt "npc conversation"
msgid "Welcome to Celeste!  There are many great sites to see here!"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:182
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:297
msgctxt "npc conversation"
msgid "Yer in the Pit now!  Wish you were dead yet?"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:183
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:298
msgctxt "npc conversation"
msgid "Nighon is the place to learn the ways of magic.  Have you visited all who could teach you?"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:184
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:299
msgctxt "npc conversation"
msgid "The Barrow Downs is not a place to linger!  I may return to Stone City if it gets much worse here!"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:185
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:300
msgctxt "npc conversation"
msgid "Tatalia has the most drastic climes in Erathia.  From the snow topped mountains to the swamps to the south."
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:186
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:301
msgctxt "npc conversation"
msgid "Greetings!  Hope the day finds you well!"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:187
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:302
msgctxt "npc conversation"
msgid "Visitors to Stone City.  Its been a while since we had travelers such as yourselves!  Welcome!"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:188
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:303
msgctxt "npc conversation"
msgid "You won Lord Markham's contest?  Good luck…last people who tried to clean this place up went into Castle Harmondale and never came out."
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:189
#: mmmerge/Data/10LocLANG.EnglishT/NPCGreet.txt.py:304
msgctxt "npc conversation"
msgid "Welcome to Pierpont.  Be sure not to travel into the forest to the northeast.  Several people have disappeared in that region!"
msgstr ""

#: mm7/DATA/10LocLANG.events/npcgreet.txt.py:189
