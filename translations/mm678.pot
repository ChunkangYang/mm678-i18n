msgctxt "items"
msgid "Two-Handed Axe"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:31 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1631
msgctxt "items"
msgid "This style of long hafted axe is typically used to deadly effect by Eastern tribes and the elite guard of some members of the nobility."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:32
msgctxt "items"
msgid "Heavy Poleax"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:32 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1632
msgctxt "items"
msgid "A stronger version of the basic Poleax, this weapon is frequently used by city guards and other fighters who don't expect to do battle in large, coordinated groups (like armies)."
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:33
msgctxt "items"
msgid "Grand Poleax"
msgstr ""

#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:33 mmmerge/Data/Text
#: localization/LANG_ItemsTxt.txt.py:1633
msgctxt "items"
msgid "The blade head of this weapon was obviously created with the aid of magic.  It is both unusually sharp and light at the same time."
msgstr ""

