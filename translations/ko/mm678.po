#: mm6/data/10LocLANG.icons/Spells.txt.py:56
msgctxt "spells"
msgid "Remove Curse"
msgstr "저주 제거"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:55
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:55
#: mm6/data/10LocLANG.icons/Spells.txt.py:56
msgctxt "spells"
msgid "Rmv. Curse"
msgstr "저주 제거"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:55
msgctxt "spells"
msgid "Removes the cursed condition from a character if you cast this spell in time.  The greater the skill and rank in Spirit Magic the longer the condition can have been present before the “point of no return” is reached.  After that, the only way to remove the condition short of Divine Intervention is to visit a temple."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:55
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:55
#: mm6/data/10LocLANG.icons/Spells.txt.py:56
msgctxt "spells"
msgid "Works if cursed less than 1 hour per point of skill"
msgstr "유효시간은 저주에 거린 후 (기술 레벨) x 1 시간까지입니다. "

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:55
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:55
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:55
#: mm6/data/10LocLANG.icons/Spells.txt.py:56
msgctxt "spells"
msgid "Works if cursed less than 1 day per point of skill"
msgstr "유효시간은 저주에 걸린 후 (기술 레벨) x 1 일까지입니다. "

