msgctxt "spells"
msgid "Cure Poison"
msgstr "해독"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:80
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:80
msgctxt "spells"
msgid "Cures poison in a character if you cast this spell in time.  The greater the skill and rank in Body Magic the longer the character can have been poisoned before the “point of no return” is reached.  After that, the only way to remove the condition short of Divine Intervention is to visit a temple."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:80
