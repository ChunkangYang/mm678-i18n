#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:359
#: mm6/data/10LocLANG.icons/Spells.txt.py:65
msgctxt "spells"
msgid "Remove Fear"
msgstr "공포 제거"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:64
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:64
msgctxt "spells"
msgid "Removes the afraid condition from a character if you cast this spell in time.  The greater the skill and rank in Mind Magic the longer the condition can have been present before the spell no longer is effective.  After that, the condition may only be removed by resting or at a temple."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:64
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:64
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:63
#: mm6/data/10LocLANG.icons/Spells.txt.py:65
msgctxt "spells"
msgid "Works if afraid less than 3 minutes per point of skill"
msgstr "유효시간은 겁먹은 이후부터 (기술 레벨) x 3 분까지입니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:64
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:64
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:63
#: mm6/data/10LocLANG.icons/Spells.txt.py:65
msgctxt "spells"
msgid "Works if afraid less than 1 hour per point of skill"
msgstr "유효시간은 겁먹은 이후부터 (기술 레벨) x 1 시간까지입니다. "

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:64
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:64
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:63
#: mm6/data/10LocLANG.icons/Spells.txt.py:65
msgctxt "spells"
msgid "Works if afraid less than 1 day per point of skill"
msgstr "유효시간은 겁먹은 이후부터 (기술 레벨) x 1 일까지입니다. "

