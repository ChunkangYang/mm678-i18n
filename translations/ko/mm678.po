msgid "Two-Handed Axe"
msgstr "양손도끼"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:37
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:39
msgctxt "items"
msgid "As much an implement for working wood as a weapon, this crude axe can still deliver a telling blow."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:38
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:40
msgctxt "items"
msgid "Footman's Axe"
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:38
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:40
msgctxt "items"
msgid "Capable of splitting armor, these two-handed axes are a favorite among soldiers facing mounted knights."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:39
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:41
msgctxt "items"
msgid "Minotaur War Axe"
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:39
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:41
msgctxt "items"
msgid "These two-handed axes are commonly used by Minotaurs who have the strength necessary to handle their great weight."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:40
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:42
msgctxt "items"
msgid "Elite Minotaur Axe"
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:40
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:42
msgctxt "items"
msgid "These axes of superior workmanship are issued only to members of The Blackened Horn, the elite warriors who guard Minotaur holy sites."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:43
msgctxt "items"
msgid "Minotaur Herdsman Axe"
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:41
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:43
msgctxt "items"
msgid "Minotaur herdsmen lead their troops into battle wielding these devastating war axes of superlative balance and workmanship."
msgstr ""

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:44
msgctxt "items"
msgid "Ogre Fighting Stick"
msgstr ""

