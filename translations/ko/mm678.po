msgid "East Pillar Key"
msgstr "동쪽 기둥 열쇠"

#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1458
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1459
#: mmmerge/Data/Text localization/LANG_ItemsTxt.txt.py:1460
