#: mm6/data/10LocLANG.icons/GLOBAL.TXT.py:443
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:253
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:353
#: mm6/data/10LocLANG.icons/Spells.txt.py:58
msgctxt "spells"
msgid "Heroism"
msgstr "헤로우이즘"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:57
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:57
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:57
msgctxt "spells"
msgid "Heroism increases the damage a character does on a successful attack by 5 + 1 point per point of skill in Spirit Magic. This spell affects the entire party at once."
msgstr "헤로우이즘(Heroism); 공격이 성공했을 때, 그 타격치가 5 + (기술 레벨) x 1만큼 증가합니다. 일행 전체에 걸리는 주문입니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:58
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:354
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:454
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:58
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:353
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:453
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:58
msgctxt "spells"
msgid "Spirit Lash"
msgstr "스피릿 래쉬"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:58
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:58
msgctxt "spells"
msgid "This spell weakens the link between a target's body and soul, causing 10 + 2-8 points of damage per point of skill in Spirit Magic to all monsters near the caster."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:59
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:355
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:455
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:59
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:354
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:454
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:59
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:255
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:355
#: mm6/data/10LocLANG.icons/Spells.txt.py:60
msgctxt "spells"
msgid "Raise Dead"
msgstr "레이즈 데드"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:59
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:59
msgctxt "spells"
msgid "Raises a character from the dead if you cast this spell in time.  The greater the skill and rank in Spirit Magic the longer a character can have been dead before the “point of no return” is reached.  After that, the only way to raise the character short of Divine Intervention is to visit a temple.  Casting this spell will leave your character in the weak condition."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:59
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:59
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:59
#: mm6/data/10LocLANG.icons/Spells.txt.py:60
msgctxt "spells"
msgid "Works if dead less than 1 day per point of skill"
msgstr " 유효시간은 죽은 이후부터 (기술 레벨) x 1 일까지 입니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:60
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:356
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:456
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:60
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:355
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:455
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:60
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:256
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:356
#: mm6/data/10LocLANG.icons/Spells.txt.py:61
msgctxt "spells"
msgid "Shared Life"
msgstr "쉐어드 라이프"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:60
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:60
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:60
msgctxt "spells"
msgid "Shared Life combines the life force of your characters and redistributes it amongst them as evenly as possible.  All current hit points are totaled and 3 extra points per point of skill in Spirit Magic is added to this total. Then the points are distributed back to the characters, with no individual character being allowed to have more points than his maximum total hit points."
msgstr "공동 생명력(Shared Life); 공동의 생명력을 통해서 4 캐릭터가 체력치를 똑같이 나누어 갖습니다. 공동의 생명력은 (현재 일원 모두의 체력치 합) + (기술 레벨에 비례란 보너스) 와 같습니다. 어느 누구도 더 많고 적지 않게 나눠가집니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:60
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:60
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:60
#: mm6/data/10LocLANG.icons/Spells.txt.py:61
msgctxt "spells"
msgid "Adds 3 hit points per point of skill to the pool"
msgstr "공동의 생명력은 (현재 일원 모두의 체력치 합) + (기술 레벨) x 3 과 같습니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:60
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:60
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:60
msgctxt "spells"
msgid "Adds 4 hit points per point of skill to the pool"
msgstr "공동의 생명력은 (현재 일원 모두의 체력치 합) + (기술 레벨) x 4 과 같습니다. "

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:61
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:357
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:457
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:61
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:356
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:456
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:61
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:257
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:357
#: mm6/data/10LocLANG.icons/Spells.txt.py:62
msgctxt "spells"
msgid "Resurrection"
msgstr "리서렉션"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:61
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:61
msgctxt "spells"
msgid "Resurrects a character whose body has been destroyed.  Recovery rate is very slow, but will be faster for characters with a higher skill in Spirit Magic.  The resurrected character will be in a weak condition after this spell is cast."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:63
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:358
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:458
