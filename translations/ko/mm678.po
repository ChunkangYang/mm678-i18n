#: mm6/data/10LocLANG.icons/Spells.txt.py:74
msgctxt "spells"
msgid "Telekinesis"
msgstr "염동"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:47
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:47
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:47
msgctxt "spells"
msgid "Telekinesis lets you manipulate an object at a distance.  Switches can be thrown, objects picked up, and doors opened with this spell, all from a nice safe distance from those nasty traps."
msgstr "염동(Telekinesis); 염력으로 멀리있는 물체를 만지거나 움직일 수 있습니다. 문을 열거나 아이템을 얻거나 보물 상자를 열 수 있습니다. 덫으로 부터 안전하게 스위치를 작동 시킬 수 있습니다."

