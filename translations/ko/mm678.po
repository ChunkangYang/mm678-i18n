#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:66
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:96
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:107
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:64
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:66
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:96
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:106
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:107
