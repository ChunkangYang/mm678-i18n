#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:324
#: mm6/data/10LocLANG.icons/Spells.txt.py:26
msgctxt "spells"
msgid "Starburst"
msgstr "스타버스트"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:25
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:25
msgctxt "spells"
msgid "Calls stars from the heavens to smite and burn your enemies.  Twenty stars are called, and the damage for each star is 20 points plus 1 per point of skill in Air Magic. Try not to get caught in the blast! This spell only works outdoors."
msgstr ""

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:325
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:425
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:324
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:424
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:225
#: mm6/data/10LocLANG.icons/ITEMS.TXT.py:325
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Awaken"
msgstr "기상"

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Automatically awakens all of your characters from a normal sleep and will awaken them from a magical sleep if they haven't had the sleep condition for too long.  The greater your skill in Water Magic, the longer the sleep condition could have been present before this spell becomes ineffective."
msgstr "기상(Awaken); 유효시간 내에 쓴다면, 휴식으로 혹은 마법에 의해 잠들어 있는 캐릭터를 깨웁니다. 유효시간 제한이 있어서 스킬 레벨이 높고 전문성이 뛰어날 수록, 길어집니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Works if asleep less than 3 minutes per point of skill"
msgstr "캐릭터가 잠든 뒤 (기술 레벨) x 3 분까지 유효합니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Works if asleep less than 1 hour per point of skill"
msgstr "유효시간은 잠든 이후 부터 (기술 레벨) x 1 시간 까지입니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:27
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:27
#: mm7/DATA/10LocLANG.events/SPELLS.TXT.py:27
#: mm6/data/10LocLANG.icons/Spells.txt.py:28
msgctxt "spells"
msgid "Works if asleep less than 1 day per point of skill"
msgstr "유효시간은 잠든 이후 부터 (기술 레벨) x 1 일 까지입니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:28
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:326
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:426
#: mm8/Data/10LocLANG.EnglishT/Spells.txt.py:28
#: mm7/DATA/10LocLANG.events/ITEMS.TXT.py:325
