msgid "Walk in the Light, friends."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCNews.txt.py:42
#: mm8/Data/10LocLANG.EnglishT/NPCNEWS.txt.py:42
msgctxt "npc conversation"
msgid "Welcome to our holy retreat. If you have business with our order, seek out the head priest, Oskar Tyre. His office is in the temple."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCNews.txt.py:43
#: mm8/Data/10LocLANG.EnglishT/NPCNEWS.txt.py:43
msgctxt "npc conversation"
msgid "What are you bothering me for? Talk to the Guildmaster, Sandro. He deals with guests. Not me!"
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCNews.txt.py:44
#: mm8/Data/10LocLANG.EnglishT/NPCNEWS.txt.py:44
msgctxt "npc conversation"
msgid "Out of my way, cretin! You interrupt my thoughts, and I'm thinking about important matters!"
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCNews.txt.py:45
#: mm8/Data/10LocLANG.EnglishT/NPCNEWS.txt.py:45
msgctxt "npc conversation"
msgid "I hope that this war against the Dragons never ends!  Charles Quixote pays mercenaries like myself very well for our services."
msgstr ""

#: mmmerge/Data/Text localization/LANG_NPCNews.txt.py:46
#: mmmerge/Data/Text localization/LANG_NPCNews.txt.py:47
#: mm8/Data/10LocLANG.EnglishT/NPCNEWS.txt.py:46
#: mm8/Data/10LocLANG.EnglishT/NPCNEWS.txt.py:47
msgctxt "npc conversation"
msgid "Our king, Deftclaw, has given you his protection, but watch your step. Cause any trouble, and I will make a snack out of you."
msgstr ""

