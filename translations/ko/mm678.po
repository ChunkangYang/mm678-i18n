#: mm6/data/10LocLANG.icons/Spells.txt.py:107
#: mm6/data/10LocLANG.icons/Spells.txt.py:108
msgctxt "spells"
msgid "Slow recovery rate"
msgstr "복귀속도가 느립니다."

#: mmmerge/Data/10LocLANG.T/Spells.txt.py:64
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:359
#: mm8/Data/10LocLANG.EnglishT/ITEMS.txt.py:459
